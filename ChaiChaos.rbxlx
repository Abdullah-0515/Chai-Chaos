} :: { Biome }
-- stylua: ignore end

Biomes.byId = {} :: { [string]: Biome }
Biomes.byRegion = {} :: { [string]: { Biome } } -- byRegion.Punjab[ring]
for index, biome in Biomes.list do
	biome.index = index
	biome.angle = Biomes.regionById[biome.region].angle
	Biomes.byId[biome.id] = biome
	Biomes.byRegion[biome.region] = Biomes.byRegion[biome.region] or {}
	Biomes.byRegion[biome.region][biome.ring] = biome
end

---------------------------------------------------------------------------
-- Geometry
---------------------------------------------------------------------------
-- A ground point `r` studs from the Chowk at `angle` degrees.
function Biomes.polar(angle: number, r: number): Vector3
	local a = math.rad(angle)
	return Vector3.new(math.cos(a) * r, Biomes.GROUND_Y, math.sin(a) * r)
end

-- The angle (degrees, -180 to 180) and distance of a position from the Chowk.
function Biomes.angleOf(position: Vector3): number
	return math.deg(math.atan2(position.Z, position.X))
end

function Biomes.radiusOf(position: Vector3): number
	return math.sqrt(position.X * position.X + position.Z * position.Z)
end

-- How far apart two angles are, from -180 to 180.
function Biomes.angleDiff(a: number, b: number): number
	return (a - b + 180) % 360 - 180
end

function Biomes.innerRadius(biome: Biome): number
	return Biomes.RINGS[biome.ring][1]
end

function Biomes.outerRadius(biome: Biome): number
	return Biomes.RINGS[biome.ring][2]
end

-- The direction (x, z) of a zone's middle from the Chowk.
function Biomes.direction(biome: Biome): Vector3
	local a = math.rad(biome.angle :: number)
	return Vector3.new(math.cos(a), 0, math.sin(a))
end

-- A point `distance` from the Chowk, turned `side` degrees off the middle of the zone.
function Biomes.point(biome: Biome, distance: number, side: number?): Vector3
	return Biomes.polar((biome.angle :: number) + (side or 0), distance)
end

function Biomes.center(biome: Biome): Vector3
	return Biomes.point(biome, (Biomes.innerRadius(biome) + Biomes.outerRadius(biome)) / 2)
end

-- Is the position inside this zone? `margin` (studs) keeps away from its edges.
function Biomes.contains(biome: Biome, position: Vector3, margin: number?): boolean
	local m = margin or 0
	local r = Biomes.radiusOf(position)
	if r < Biomes.innerRadius(biome) + m or r > Biomes.outerRadius(biome) - m then
		return false
	end
	local off = math.abs(Biomes.angleDiff(Biomes.angleOf(position), biome.angle :: number))
	return off * math.pi * r / 180 <= Biomes.SPAN * math.pi * r / 180 - m
end

-- The zone a position is in, or nil in the Chowk and the bazaar.
function Biomes.at(position: Vector3): Biome?
	local r = Biomes.radiusOf(position)
	if r < Biomes.TOWN_RADIUS or r > Biomes.WORLD_RADIUS then
		return nil
	end
	for _, biome in Biomes.list do
		if Biomes.contains(biome, position) then
			return biome
		end
	end
	return nil
end

-- The bazaar sector a position is in (in the town ring), or nil.
function Biomes.townSectorAt(position: Vector3)
	local r = Biomes.radiusOf(position)
	if r < Biomes.HUB_RADIUS or r > Biomes.TOWN_RADIUS then
		return nil
	end
	local angle = Biomes.angleOf(position)
	for _, sector in Biomes.TOWN_SECTORS do
		if math.abs(Biomes.angleDiff(angle, sector.angle)) <= 30 then
			return sector
		end
	end
	return nil
end

-- The gate into a zone: its angle (degrees) and radius (on the wall it is in).
function Biomes.gate(biome: Biome): (number, number)
	local mid = biome.angle :: number
	if biome.ring == 1 then
		return mid, Biomes.TOWN_RADIUS
	elseif biome.ring == 2 then
		return mid + 30, Biomes.RINGS[2][1]
	end
	return mid - 30, Biomes.RINGS[3][1]
end

-- The shortcut doors between neighbouring regions: one in every ring, on the
-- fence between region i and the next one clockwise.
function Biomes.shortcuts(): { { angle: number, radius: number, a: Biome, b: Biome } }
	local list = {}
	for i, region in Biomes.REGIONS do
		local nextRegion = Biomes.REGIONS[i % #Biomes.REGIONS + 1]
		for ring, span in Biomes.RINGS do
			table.insert(list, {
				angle = region.angle + Biomes.SPAN,
				radius = (span[1] + span[2]) / 2,
				a = Biomes.byRegion[region.id][ring],
				b = Biomes.byRegion[nextRegion.id][ring],
			})
		end
	end
	return list
end

-- The angle of haveli `index` (1-8) around the Chowk; it faces the middle.
-- The havelis sit between the 4 roads that lead out to the regions.
function Biomes.haveliAngle(index: number): number
	return math.rad(-67.5 + 45 * (index - 1))
end

---------------------------------------------------------------------------
-- Roads: from the Chowk out through the town gates, then zigzagging from
-- gate to gate through each region, and the bazaar street round the town.
---------------------------------------------------------------------------
Biomes.ROAD_WIDTH = 16
Biomes.BAZAAR_STREET = 245 -- the radius of the street round the bazaar

export type Road = { a: Vector3, b: Vector3, width: number, kind: string }

local roadCache: { Road }? = nil

function Biomes.roads(): { Road }
	if roadCache then
		return roadCache
	end
	local list: { Road } = {}
	local function add(a: Vector3, b: Vector3, width: number?, kind: string)
		table.insert(list, { a = a, b = b, width = width or Biomes.ROAD_WIDTH, kind = kind })
	end
	for _, region in Biomes.REGIONS do
		local mid = region.angle
		local zones = Biomes.byRegion[region.id]
		add(Biomes.polar(mid, Biomes.PLAZA_RADIUS - 4), Biomes.polar(mid, Biomes.TOWN_RADIUS), nil, "spoke")
		local a1, r1 = Biomes.gate(zones[2])
		local a2, r2 = Biomes.gate(zones[3])
		local p0, p1, p2 = Biomes.polar(mid, Biomes.TOWN_RADIUS), Biomes.polar(a1, r1), Biomes.polar(a2, r2)
		add(p0, p1, nil, "zone")
		add(p1, p2, nil, "zone")
		add(p2, Biomes.roadEnd(zones[3]), nil, "zone")
		-- an alley into the bazaar between this region and the next
		add(
			Biomes.polar(mid + Biomes.SPAN, Biomes.PLAZA_RADIUS - 4),
			Biomes.polar(mid + Biomes.SPAN, Biomes.HUB_RADIUS + 8),
			12,
			"alley"
		)
	end
	local steps = 48
	for i = 0, steps - 1 do
		add(
			Biomes.polar(i * 360 / steps, Biomes.BAZAAR_STREET),
			Biomes.polar((i + 1) * 360 / steps, Biomes.BAZAAR_STREET),
			18,
			"street"
		)
	end
	roadCache = list
	return list
end

-- Where the road ends in a ring 3 zone (the rickshaw stand that takes you home).
function Biomes.roadEnd(biome: Biome): Vector3
	return Biomes.polar(biome.angle :: number, Biomes.WORLD_RADIUS - 45)
end

-- How far a position is from the nearest road's edge (negative = on the road).
function Biomes.roadDistance(position: Vector3): number
	local best = math.huge
	local p = Vector3.new(position.X, 0, position.Z)
	for _, road in Biomes.roads() do
		local a = Vector3.new(road.a.X, 0, road.a.Z)
		local ab = Vector3.new(road.b.X, 0, road.b.Z) - a
		local t = math.clamp((p - a):Dot(ab) / ab:Dot(ab), 0, 1)
		local d = (p - (a + ab * t)).Magnitude - road.width / 2
		if d < best then
			best = d
		end
	end
	return best
end

-- Petrol pumps: one in the bazaar by every town gate, and one by every gate
-- out of ring 1 and ring 2, a little way off the road.
function Biomes.pumps(): { Vector3 }
	local list = {}
	for _, region in Biomes.REGIONS do
		local zones = Biomes.byRegion[region.id]
		local a1 = Biomes.gate(zones[2])
		local a2 = Biomes.gate(zones[3])
		table.insert(list, Biomes.polar(region.angle + 10, 272))
		table.insert(list, Biomes.polar(a1 + 6, 425))
		table.insert(list, Biomes.polar(a2 - 7, 530))
	end
	return list
end

---------------------------------------------------------------------------
-- The train in Railway Junction. It waits at one end, the crossing light
-- blinks, then it runs the curved track to the other end, and back again.
-- The server and every player's screen work out where it is from the clock,
-- so it is smooth everywhere and costs nothing to send.
---------------------------------------------------------------------------
Biomes.TRAIN = { zone = "RailwayJunction", radius = 372, from = -40, to = 40, length = 40 }

-- The train's angle (degrees), whether it is moving, the crossing light
-- ("green", "blink" or "red") and which way it faces (1 or -1) at server time `t`.
function Biomes.trainAt(t: number, wait: number, blink: number, speed: number): (number, boolean, string, number)
	local train = Biomes.TRAIN
	local mid = Biomes.byId[train.zone].angle :: number
	local from, to = mid + train.from, mid + train.to
	local runTime = (to - from) * math.pi * train.radius / 180 / speed
	local half = wait + blink + runTime
	local phase = t % (2 * half)
	local outward = phase < half
	local p = phase % half
	local start, finish = if outward then from else to, if outward then to else from
	local dir = if outward then 1 else -1
	if p < wait then
		return start, false, "green", dir
	elseif p < wait + blink then
		return start, false, "blink", dir
	end
	return start + (finish - start) * (p - wait - blink) / runTime, true, "red", dir
end

---------------------------------------------------------------------------
-- Unlocking
---------------------------------------------------------------------------
-- Is the zone open to a player with these unlocked zones and rebirths?
function Biomes.isOpen(biome: Biome, unlocked: { [string]: boolean }, rebirths: number): boolean
	if biome.rebirths > 0 then
		return rebirths >= biome.rebirths
	end
	return biome.price == 0 or unlocked[biome.id] == true
end

-- The zone you must have open before this one (the next ring in, same region).
function Biomes.before(biome: Biome): Biome?
	if biome.ring == 1 then
		return nil
	end
	return Biomes.byRegion[biome.region][biome.ring - 1]
end

-- What the gate costs, as text: "Free", "Rs 10,000" or "1 rebirth".
function Biomes.costText(biome: Biome): string
	if biome.rebirths > 0 then
		return ("%d rebirth%s"):format(biome.rebirths, if biome.rebirths == 1 then "" else "s")
	elseif biome.price == 0 then
		return "Free"
	end
	local text = tostring(biome.price):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
	return "Rs " .. text
end

-- Unlocked zones as "MangoBagh,RailwayJunction" for player attributes.
function Biomes.encode(unlocked: { [string]: boolean }): string
	local ids = {}
	for _, biome in Biomes.list do
		if unlocked[biome.id] then
			table.insert(ids, biome.id)
		end
	end
	return table.concat(ids, ",")
end

function Biomes.decode(text: string?): { [string]: boolean }
	local unlocked = {}
	for id in string.gmatch(text or "", "[^,]+") do
		unlocked[id] = true
	end
	return unlocked
end

return Biomes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Brainrots</string>
          <string name="Source"><![CDATA[-- All 36 brainrots from docs/game-design.md, 4 Secret brainrots that only hatch in
-- Barfani Pahar, and 6 special quest brainrots.
--
-- id     : the Model name to use in ServerStorage/Brainrots if you build your own model.
-- price  : the price from the design doc; the game multiplies it by Config.PRICE_MULTIPLIER.
-- shape  : the body of the blocky placeholder that is made when no model exists yet.
-- extras : small add-ons for the placeholder (glasses, crown, legs and so on).
-- float  : hovers above the ground instead of standing on it.
-- questOnly : never hatches; earned from the Collection Book. Cannot be stolen or sold.
--
-- Which brainrots hatch from which biome's eggs is in Biomes.luau.

local Config = require(script.Parent.Config)

local Brainrots = {}

-- The rarities that hatch from eggs (Secret only from Barfani Pahar's eggs,
-- never from Kismat Rolls).
Brainrots.RARITY_ORDER = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Secret" }
-- The Collection Book also shows the special quest brainrots.
Brainrots.BOOK_ORDER = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Secret", "Special" }

Brainrots.RARITY_COLORS = {
	Common = Color3.fromRGB(190, 190, 190),
	Uncommon = Color3.fromRGB(90, 210, 90),
	Rare = Color3.fromRGB(70, 150, 255),
	Epic = Color3.fromRGB(180, 90, 255),
	Legendary = Color3.fromRGB(255, 195, 40),
	Mythic = Color3.fromRGB(255, 80, 170),
	Secret = Color3.fromRGB(190, 230, 255),
	Special = Color3.fromRGB(40, 225, 200),
}

export type Def = {
	id: string,
	name: string,
	rarity: string,
	price: number,
	income: number,
	phrase: string,
	color: Color3,
	shape: string,
	extras: { string },
	float: boolean?,
	eyes: number?,
	questOnly: boolean?,
	basePrice: number?,
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

-- stylua: ignore start
Brainrots.list = {
	-- Batch 1
	{ id = "GolGappaGhostu", name = "Gol Gappa Ghostu", rarity = "Common", price = 25, income = 1, phrase = "Thora aur khatta daalo!", color = rgb(214, 160, 80), shape = "Ball", extras = {}, float = true },
	{ id = "SamosaSupremo", name = "Samosa Supremo", rarity = "Common", price = 50, income = 2, phrase = "Main course main hoon!", color = rgb(205, 140, 60), shape = "Wedge", extras = { "glasses" } },
	{ id = "ChaiyooKettlesaurus", name = "Chaiyoo Kettlesaurus", rarity = "Common", price = 100, income = 4, phrase = "Doodh patti, extra cheeni.", color = rgb(160, 165, 175), shape = "Cylinder", extras = { "legs", "tail" } },
	{ id = "ParathaPilot", name = "Paratha Pilot", rarity = "Uncommon", price = 300, income = 10, phrase = "Ghee landing in 3... 2... 1!", color = rgb(230, 190, 110), shape = "Disc", extras = { "goggles" }, float = true },
	{ id = "RickshawRaptor", name = "Rickshaw Raptor", rarity = "Uncommon", price = 600, income = 18, phrase = "Pon pon! Kahan jaana hai?", color = rgb(40, 150, 70), shape = "Block", extras = { "legs", "tail" } },
	{ id = "LoadSheddingLattoo", name = "Load Shedding Lattoo", rarity = "Rare", price = 1500, income = 40, phrase = "Light aa gayi!", color = rgb(240, 80, 60), shape = "Ball", extras = { "headband" } },
	{ id = "BiryaniBadshah", name = "Biryani Badshah", rarity = "Rare", price = 3000, income = 75, phrase = "Aloo wali biryani hi asli hai!", color = rgb(240, 170, 60), shape = "Cylinder", extras = { "crown" } },
	{ id = "ChipaSahab", name = "Chipa Sahab", rarity = "Epic", price = 8000, income = 180, phrase = "Beta, meri baat suno...", color = rgb(150, 110, 85), shape = "Ball", extras = { "moustache", "legs" } },
	{ id = "JalebiJinn", name = "Jalebi Jinn", rarity = "Epic", price = 15000, income = 320, phrase = "Teen wishes... teeno meethi!", color = rgb(255, 150, 30), shape = "Ball", extras = { "moustache", "crown" }, float = true },
	{ id = "TruckArtTotaa", name = "Truck Art Totaa", rarity = "Legendary", price = 40000, income = 800, phrase = "Dekh magar pyar se!", color = rgb(30, 170, 150), shape = "Ball", extras = { "wings", "tail" } },
	{ id = "SixerSher", name = "Sixer Sher", rarity = "Legendary", price = 75000, income = 1400, phrase = "Chakka! Sorry, sheesha toot gaya!", color = rgb(230, 160, 50), shape = "Block", extras = { "ears", "bat", "legs" } },
	{ id = "AmmiKiUdtiChappal", name = "Ammi ki Udti Chappal", rarity = "Mythic", price = 250000, income = 4000, phrase = "Whoooosh! Homework kiya?", color = rgb(60, 110, 210), shape = "Slab", extras = { "wings" }, float = true },

	-- Batch 2
	{ id = "ChanaChaatChacha", name = "Chana Chaat Chacha", rarity = "Common", price = 40, income = 2, phrase = "Imli wali, imli wali!", color = rgb(200, 150, 70), shape = "Cylinder", extras = { "moustache", "legs" } },
	{ id = "KulfiKangaroo", name = "Kulfi Kangaroo", rarity = "Common", price = 75, income = 3, phrase = "Pighla... phir jam gaya!", color = rgb(245, 225, 180), shape = "Tall", extras = { "ears", "legs" } },
	{ id = "PakoraPanda", name = "Pakora Panda", rarity = "Common", price = 120, income = 5, phrase = "Baarish? Pakora time!", color = rgb(190, 120, 40), shape = "Ball", extras = { "ears" } },
	{ id = "LassiLlama", name = "Lassi Llama", rarity = "Uncommon", price = 400, income = 13, phrase = "Malai moochh, full style!", color = rgb(250, 248, 235), shape = "Cylinder", extras = { "moustache", "ears" } },
	{ id = "BunKebabBhai", name = "Bun Kebab Bhai", rarity = "Uncommon", price = 800, income = 24, phrase = "Ek dum garam!", color = rgb(170, 100, 45), shape = "Disc", extras = { "legs" } },
	{ id = "RoohAfzaRhino", name = "Rooh Afza Rhino", rarity = "Uncommon", price = 1000, income = 30, phrase = "Sab kuch pink!", color = rgb(220, 30, 60), shape = "Block", extras = { "horn", "legs" } },
	{ id = "CricketBatBhaijaan", name = "Cricket Bat Bhaijaan", rarity = "Rare", price = 2000, income = 55, phrase = "Aur yeh gaya... chauka!", color = rgb(225, 200, 140), shape = "Tall", extras = { "headband", "legs" } },
	{ id = "DhabaDragon", name = "Dhaba Dragon", rarity = "Rare", price = 4000, income = 100, phrase = "Ek naan, extra garam!", color = rgb(200, 60, 40), shape = "Block", extras = { "wings", "horn", "tail" } },
	{ id = "MehndiMummy", name = "Mehndi Mummy", rarity = "Epic", price = 10000, income = 230, phrase = "Haath idhar karo!", color = rgb(160, 95, 45), shape = "Tall", extras = { "headband" } },
	{ id = "DholakDino", name = "Dholak Dino", rarity = "Epic", price = 20000, income = 400, phrase = "Dhak dhina dhin!", color = rgb(90, 170, 80), shape = "Cylinder", extras = { "legs", "tail" } },
	{ id = "TongaTornado", name = "Tonga Tornado", rarity = "Epic", price = 30000, income = 600, phrase = "Driver kaun hai?!", color = rgb(160, 110, 70), shape = "Wheel", extras = { "ears" } },
	{ id = "ChilgozaChachaChipka", name = "Chilgoza Chacha Chipka", rarity = "Legendary", price = 100000, income = 1800, phrase = "Ghar ka pankha hoon main!", color = rgb(175, 125, 85), shape = "Ball", extras = { "moustache", "wings" } },
	{ id = "MelaMaharaja", name = "Mela Maharaja", rarity = "Legendary", price = 150000, income = 2600, phrase = "Ek chakkar aur!", color = rgb(240, 80, 160), shape = "Wheel", extras = { "crown" } },
	{ id = "KiteKaptaan", name = "Kite Kaptaan", rarity = "Mythic", price = 500000, income = 8000, phrase = "Bo kata!", color = rgb(255, 60, 60), shape = "Kite", extras = { "tail" }, float = true },

	-- Batch 3
	{ id = "NaanNinja", name = "Naan Ninja", rarity = "Common", price = 60, income = 2, phrase = "Roti star! Hiyaa!", color = rgb(235, 200, 140), shape = "Disc", extras = { "headband" } },
	{ id = "PyaazPehelwan", name = "Pyaaz Pehelwan", rarity = "Common", price = 90, income = 4, phrase = "Ro kyun rahe ho?", color = rgb(170, 60, 120), shape = "Ball", extras = { "moustache", "legs" } },
	{ id = "GajarHalwaGorilla", name = "Gajar Halwa Gorilla", rarity = "Uncommon", price = 500, income = 15, phrase = "Sardi aa gayi!", color = rgb(240, 110, 30), shape = "Block", extras = { "ears", "legs" } },
	{ id = "DoodhPattiDolphin", name = "Doodh Patti Dolphin", rarity = "Uncommon", price = 900, income = 26, phrase = "Chai mein chhalaang!", color = rgb(185, 135, 95), shape = "Ball", extras = { "wings", "tail" }, float = true },
	{ id = "GeneratorGainda", name = "Generator Gainda", rarity = "Rare", price = 2500, income = 65, phrase = "Light gayi? Main aaya! Brrrr!", color = rgb(115, 115, 125), shape = "Block", extras = { "horn", "legs" } },
	{ id = "ShaadiShehnaiShark", name = "Shaadi Shehnai Shark", rarity = "Rare", price = 5000, income = 120, phrase = "Shaadi kahan hai?", color = rgb(90, 130, 185), shape = "Wedge", extras = { "wings" } },
	{ id = "TikkaTiger", name = "Tikka Tiger", rarity = "Epic", price = 12000, income = 270, phrase = "Apna tikka khud banata hoon!", color = rgb(245, 140, 30), shape = "Block", extras = { "ears", "tail", "legs" } },
	{ id = "RishtaAuntyRobot", name = "Rishta Aunty Robot", rarity = "Epic", price = 25000, income = 500, phrase = "Beta, kya karte ho?", color = rgb(200, 200, 215), shape = "Tall", extras = { "glasses" } },
	{ id = "CylinderCycleChacha", name = "Cylinder Cycle Chacha", rarity = "Legendary", price = 120000, income = 2200, phrase = "Cylinder le lo, cylinder!", color = rgb(200, 40, 40), shape = "Wheel", extras = { "moustache" } },
	{ id = "ChandRaatCheetah", name = "Chand Raat Cheetah", rarity = "Mythic", price = 400000, income = 6500, phrase = "Choorian chamak rahi hain!", color = rgb(250, 210, 80), shape = "Block", extras = { "ears", "tail", "legs" } },
	-- Secret brainrots: only from Barfani Pahar's eggs (4 rebirths)
	{ id = "KahwaYeti", name = "Kahwa Yeti", rarity = "Secret", price = 1200000, income = 15000, phrase = "Ek cup kahwa, garam garam!", color = rgb(240, 245, 250), shape = "Ball", extras = { "ears", "legs" } },
	{ id = "GolaGandaGolem", name = "Gola Ganda Golem", rarity = "Secret", price = 1800000, income = 21000, phrase = "Thanda thanda, rang birangi!", color = rgb(150, 220, 255), shape = "Block", extras = { "legs" } },
	{ id = "BarfiBarfaniBagh", name = "Barfi Barfani Bagh", rarity = "Secret", price = 2500000, income = 28000, phrase = "Barf bhi, barfi bhi!", color = rgb(245, 245, 235), shape = "Block", extras = { "ears", "tail", "legs" } },
	{ id = "JalebiMarkhor", name = "Jalebi Markhor", rarity = "Secret", price = 3500000, income = 36000, phrase = "Seengh meethe, dil bhi meetha!", color = rgb(200, 160, 110), shape = "Block", extras = { "horn", "legs" } },

	-- Special quest brainrots: rewards for finishing a rarity in the Collection Book
	{ id = "MithaiMamu", name = "Mithai Mamu", rarity = "Special", price = 2000, income = 60, phrase = "Ek aur laddoo, beta!", color = rgb(255, 170, 60), shape = "Block", extras = { "moustache", "legs" }, questOnly = true },
	{ id = "LassiLightning", name = "Lassi Lightning", rarity = "Special", price = 8000, income = 220, phrase = "Thandi thandi... ZAP!", color = rgb(235, 245, 255), shape = "Tall", extras = { "goggles", "wings" }, float = true, questOnly = true },
	{ id = "ChowkidarChoocha", name = "Chowkidar Choocha", rarity = "Special", price = 30000, income = 800, phrase = "Jaagte raho!", color = rgb(255, 225, 70), shape = "Ball", extras = { "headband", "legs" }, questOnly = true },
	{ id = "RangeelaRaja", name = "Rangeela Raja", rarity = "Special", price = 120000, income = 3000, phrase = "Rang hi rang!", color = rgb(40, 160, 220), shape = "Ball", extras = { "crown", "wings", "tail" }, questOnly = true },
	{ id = "ShalimarSultan", name = "Shalimar Sultan", rarity = "Special", price = 500000, income = 11000, phrase = "Bagh mein khush aamdeed!", color = rgb(60, 190, 120), shape = "Cylinder", extras = { "crown" }, float = true, questOnly = true },
	{ id = "TaaronWalaTonga", name = "Taaron Wala Tonga", rarity = "Special", price = 2000000, income = 40000, phrase = "Chalo, taaron ki sair!", color = rgb(70, 70, 170), shape = "Wheel", extras = { "ears", "crown" }, float = true, questOnly = true },
} :: { Def }
-- stylua: ignore end

Brainrots.byId = {} :: { [string]: Def }
Brainrots.byRarity = {} :: { [string]: { Def } }

for _, rarity in Brainrots.BOOK_ORDER do
	Brainrots.byRarity[rarity] = {}
end

for _, def in Brainrots.list do
	assert(Brainrots.byId[def.id] == nil, "Duplicate brainrot id: " .. def.id)
	assert(Brainrots.byRarity[def.rarity], "Unknown rarity: " .. def.rarity)
	def.basePrice = def.price
	def.price = def.price * Config.PRICE_MULTIPLIER
	Brainrots.byId[def.id] = def
	table.insert(Brainrots.byRarity[def.rarity], def)
end

-- Cheapest first inside each rarity, which is also the order of the collection book.
for _, pool in Brainrots.byRarity do
	table.sort(pool, function(a, b)
		return a.price < b.price
	end)
end

return Brainrots
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Every number you might want to tune while playtesting lives here.
-- The economy is tuned so a typical kid reaches their first Naya Safar in
-- about an hour (see README > Pacing).

local Config = {}

-- Money
Config.START_RUPEES = 1_000
Config.PRICE_MULTIPLIER = 2 -- brainrots are worth this many times their price in the design doc
Config.SELL_RATE = 0.5 -- sell for half the value
Config.SELL_DISTANCE = 22 -- how close to the Sell stall you must be to sell

-- Haveli levels: each level costs rupees, adds plots and sometimes a feature.
-- Plots 1-10 are on the ground floor, 11-20 on the second floor.
-- `incubators` is how many eggs can hatch at the same time.
Config.HAVELI_LEVELS = {
	{ plots = 4, incubators = 1, cost = 0, name = "Chhota Ghar" },
	{ plots = 6, incubators = 1, cost = 4_000, name = "Pakka Ghar" },
	{
		plots = 8,
		incubators = 2,
		cost = 12_000,
		name = "Laser Darwaza",
		unlock = "A second incubator, and the Laser Darwaza: your Taala blocks the door",
	},
	{ plots = 10, incubators = 2, cost = 30_000, name = "Bagh Wala Ghar", unlock = "A garden full of decorations" },
	{
		plots = 12,
		incubators = 3,
		cost = 80_000,
		name = "Do Manzila",
		unlock = "The second floor and a third incubator",
	},
	{ plots = 14, incubators = 3, cost = 180_000, name = "Chowkidar Wali", unlock = "A Chowkidar who catches thieves" },
	{ plots = 16, incubators = 4, cost = 350_000, name = "Bari Haveli", unlock = "A fourth incubator" },
	{
		plots = 18,
		incubators = 4,
		cost = 550_000,
		name = "Chhat Wali Haveli",
		unlock = "A rooftop with chhatris and kites",
	},
	{ plots = 20, incubators = 4, cost = 800_000, name = "Shahi Haveli", unlock = "The fanciest haveli in the bazaar" },
}
Config.LASER_LEVEL = 3
Config.GARDEN_LEVEL = 4
Config.UPPER_FLOOR_LEVEL = 5
Config.GUARD_LEVEL = 6
Config.ROOFTOP_LEVEL = 8
Config.LOCKER_PLOTS = 2 -- plots 1 and 2 can never be stolen from
Config.MAX_INCUBATORS = 4

-- Tracker (radar): shows eggs in every zone you have unlocked. Each level
-- sees further; level 3 finds golden eggs and level 5 treasure chests.
Config.TRACKER_LEVELS = {
	{ cost = 0, range = 180 },
	{ cost = 2_500, range = 220 },
	{ cost = 8_000, range = 260, golden = true },
	{ cost = 25_000, range = 300, golden = true },
	{ cost = 70_000, range = 340, golden = true, treasure = true },
	{ cost = 160_000, range = 390, golden = true, treasure = true },
	{ cost = 320_000, range = 440, golden = true, treasure = true },
	{ cost = 600_000, range = 520, golden = true, treasure = true },
}

-- Eggs
Config.EGGS_PER_BIOME = 8 -- eggs lying around in each zone at once
Config.EGG_RESPAWN = 6 -- seconds between new eggs in a biome that is short of eggs
Config.GOLDEN_EGG_CHANCE = 0.03 -- golden eggs always hatch a mutated brainrot and are luckier
Config.GOLDEN_EGG_LUCK = 2
Config.GOLDEN_EGG_TIME = 1.3 -- golden eggs last a bit longer...
Config.GOLDEN_HATCH_TIME = 1.5 -- ...and take longer to hatch
Config.EGG_HIT_PENALTY = 8 -- seconds a hazard knocks off a carried egg
Config.DROPPED_EGG_LIFETIME = 60 -- a dropped egg disappears after this long
Config.EGG_RUSH_EVERY = 240 -- an egg rush in a random zone every 4 minutes
Config.EGG_RUSH_DURATION = 60
Config.EGG_RUSH_EGGS = 14
Config.PICKUP_DISTANCE = 12

-- Treasure chests (need a Rope Ladder for cliff tops, a Shovel for buried ones)
Config.TREASURE_COOLDOWN = 600 -- each player can open each chest once every 10 minutes
Config.TREASURE_RUPEES = 1_200 -- times the zone's tier squared
Config.TREASURE_ROLL_CHANCE = 0.35 -- chance of a free Kismat Roll too

-- Vehicles (see Vehicles.luau for each vehicle's speed, tank and egg space)
Config.FUEL_PRICE = 0.25 -- rupees for every stud of fuel at a petrol pump
Config.FUEL_HOME_REFILL = 40 -- studs of fuel per second, free, while you are at your haveli
Config.PARK_DISTANCE = 14 -- driving this close to your own door parks your vehicle
Config.PUMP_DISTANCE = 16 -- how close to a petrol pump you must be to fill up
Config.DRIVE_SURFACE_SPEED = { mud = 0.6, sand = 0.75, sandstorm = 0.7, ice = 0.8, water = 0.45 }
-- Robux paint jobs (looks only): Developer Product ids. A paint with id = 0 is hidden.
Config.PAINT_PRODUCTS = {
	PhoolPatti = 0,
	Sona = 0,
	Rangeela = 0,
	Chamak = 0,
}

-- Blender props (see the README). If the imported meshes all face backwards,
-- set this to 180.
Config.PROP_MESH_TURN = 0

-- Players
Config.WALK_SPEED = 20 -- a bit faster than Roblox's 16, the world is big
Config.FUEL_EMPTY_SPEED = Config.WALK_SPEED -- a vehicle with an empty tank only goes this fast
Config.PROMPT_DISTANCE = 12 -- how close you must be to press E
Config.WALK_HOME_SPEED = 22 -- studs per second when a brainrot walks to its plot

-- Hazards (see Biomes.luau for which zone has which)
Config.HAZARD_SPEED = { water = 0.6, mud = 0.55, ice = 0.7, sandstorm = 0.65 }
Config.HAZARD_EGG_DRAIN = { water = 2, ice = 1.5, sandstorm = 2 } -- eggs crack this many times faster
Config.SANDSTORM_EVERY = 50
Config.SANDSTORM_DURATION = 15
Config.WAVE_EVERY = 35
Config.SNOWBALL_EVERY = 20
Config.SALT_FALL_EVERY = 6 -- a salt rock falls near someone in the Namak Caves this often
Config.SALT_WARNING = 1.5 -- seconds the red circle shows before the rock lands
Config.SALT_RADIUS = 7
-- The train in Railway Junction: it waits, the crossing light blinks, then it runs the track
Config.TRAIN_WAIT = 9
Config.TRAIN_BLINK = 3.2
Config.TRAIN_SPEED = 40
Config.TRAIN_HIT_RADIUS = 9
Config.KNOCKBACK = 70 -- how hard the train, waves and salt rocks push you (they never hurt)

-- Stealing
Config.STEAL_HOLD_TIME = 1.5
Config.STEAL_COOLDOWN = 15 -- a thief can steal once every 15 seconds
Config.SAME_HAVELI_COOLDOWN = 120 -- cannot rob the same haveli twice in a row within 2 minutes
Config.LOCK_TIME = 30 -- Taala lasts 30 seconds
Config.LOCK_COOLDOWN = 60 -- then needs 60 seconds before it can be used again
Config.NEW_PLAYER_PROTECTION = 180 -- 3 minutes of steal protection after joining
Config.STEAL_PRICE_CAP = 16_000 -- players who have not rebirthed can only steal brainrots worth up to this
Config.BONK_RANGE = 10
Config.BONK_COOLDOWN = 0.8
Config.CARRY_SPEED = { -- thieves walk this much slower while carrying a brainrot
	Common = 0.9,
	Uncommon = 0.85,
	Rare = 0.8,
	Epic = 0.72,
	Legendary = 0.65,
	Mythic = 0.58,
	Secret = 0.5,
}
Config.CARRY_MUTATION_SPEED = 0.93 -- extra slowdown for a mutated brainrot
Config.GUARD_RANGE = 12 -- the Chowkidar spots thieves this close to him
Config.GUARD_SPOT_TIME = 1.2 -- seconds a thief must stay in range before he catches them
Config.GUARD_COOLDOWN = 40 -- then he takes a nap

-- Rebirth ("Naya Safar"). Resets rupees, haveli, tracker and brainrots; keeps gear,
-- themes, the Collection Book and Kismat Rolls.
Config.REBIRTH_COST = 1_000_000
Config.REBIRTH_COST_GROWTH = 2.5 -- every Naya Safar costs this many times more than the last
Config.REBIRTH_BONUS = 0.5 -- +50% income for every rebirth

function Config.rebirthCost(rebirths: number): number
	return math.floor(Config.REBIRTH_COST * Config.REBIRTH_COST_GROWTH ^ rebirths)
end

-- Daily chai
Config.DAILY_MIN_RUPEES = 500
Config.DAILY_INCOME_SECONDS = 120 -- the rupee reward is worth this many seconds of your income
Config.DAILY_FREE_ROLLS = 1 -- free Kismat Rolls with every daily chai

-- Kismat Roll (RNG): spend rupees or a roll for a random brainrot
Config.ROLL_RUPEE_COST = 5_000
Config.ROLL_ODDS = { -- shown to players in the Kismat panel, keep it honest
	Common = 50,
	Uncommon = 30,
	Rare = 13,
	Epic = 5,
	Legendary = 1.8,
	Mythic = 0.2,
}
Config.ROLL_PITY = 30 -- an Epic or better is guaranteed at least once every 30 rolls
Config.ROLL_COOLDOWN = 2.5 -- seconds between rolls (the reveal takes about 2 seconds)

-- Robux packs. Create Developer Products on the Creator Dashboard
-- (your experience > Monetization > Developer Products), set their prices
-- there, and paste their ids here. A pack with id = 0 is hidden.
Config.ROLL_PRODUCTS = { -- Kismat Rolls
	{ id = 0, amount = 1 },
	{ id = 0, amount = 10 },
}
Config.STEAL_PRODUCTS = { -- Chor Passes: every steal uses one
	{ id = 0, amount = 1 },
	{ id = 0, amount = 5 },
}
Config.STEAL_COSTS_ROBUX = true -- set to false to make stealing free
Config.STEAL_REFUND_ON_FAIL = true -- give the Chor Pass back if the thief gets bonked, dies or the owner leaves
Config.DAILY_FREE_STEALS = 0 -- free Chor Passes with every daily chai

-- Stealing only costs a Chor Pass once a Chor Pass product id is set, so the
-- game stays testable before the products exist.
function Config.stealsCostRobux(): boolean
	if not Config.STEAL_COSTS_ROBUX then
		return false
	end
	for _, pack in Config.STEAL_PRODUCTS do
		if pack.id ~= 0 then
			return true
		end
	end
	return false
end

-- Events: every 15-20 minutes a 5 minute event starts in each server
Config.FIRST_EVENT_DELAY = 180
Config.EVENT_GAP_MIN = 900
Config.EVENT_GAP_MAX = 1200
Config.EVENT_DURATION = 300

-- Quests
Config.QUESTS_PER_DAY = 3
Config.QUEST_REWARD_SECONDS = 60 -- each quest pays this many seconds of your income...
Config.QUEST_MIN_REWARD = 1_500 -- ...but never less than this
Config.QUEST_BONUS_ROLLS = 2 -- Kismat Rolls for finishing all of today's quests

-- Collection Book rewards for discovering every brainrot of a rarity.
-- Rupees and rolls are given once; the special brainrot can be claimed again after every Naya Safar.
Config.COLLECTION_REWARDS = {
	Common = { rupees = 4_000, rolls = 1, special = "MithaiMamu" },
	Uncommon = { rupees = 16_000, rolls = 2, special = "LassiLightning" },
	Rare = { rupees = 60_000, rolls = 3, special = "ChowkidarChoocha" },
	Epic = { rupees = 240_000, rolls = 4, special = "RangeelaRaja" },
	Legendary = { rupees = 1_000_000, rolls = 5, special = "ShalimarSultan" },
	Mythic = { rupees = 4_000_000, rolls = 10, special = "TaaronWalaTonga" },
	Secret = { rupees = 20_000_000, rolls = 20 },
}

-- World
Config.DAY_LENGTH = 720 -- seconds for a full day and night (nights go by twice as fast)
Config.AUTOSAVE_INTERVAL = 120
Config.DATASTORE_NAME = "ChaiChaos_v1"

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Events</string>
          <string name="Source"><![CDATA[-- Multiplier events. Every 15-20 minutes one of these runs for 5 minutes.
--
-- cashMult     : everyone's income is multiplied
-- luckMult     : rarer brainrots and mutations are likelier in eggs
-- eggMult      : more eggs lie around in every biome
-- eggTimeMult  : eggs last longer before breaking
-- hatchMult    : eggs hatch faster
-- rollDiscount : Kismat Rolls cost this much less (0.3 = 30% off)
-- night        : it is night during the event
-- look         : which effects clients show (kites, rain, cricket, blackout, mela, snow)

local Events = {}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

export type Event = {
	id: string,
	name: string,
	blurb: string,
	color: Color3,
	look: string,
	cashMult: number?,
	luckMult: number?,
	eggMult: number?,
	eggTimeMult: number?,
	hatchMult: number?,
	rollDiscount: number?,
	night: boolean?,
}

Events.list = {
	{
		id = "Basant",
		name = "Basant Kite Festival",
		blurb = "Kites fill the sky! Cash x2 and Luck x2!",
		color = rgb(255, 215, 40),
		look = "kites",
		cashMult = 2,
		luckMult = 2,
	},
	{
		id = "Baarish",
		name = "Baarish!",
		blurb = "It's raining eggs! Twice as many eggs in every biome.",
		color = rgb(90, 160, 255),
		look = "rain",
		eggMult = 2,
		cashMult = 1.2,
	},
	{
		id = "CricketMania",
		name = "Cricket Mania",
		blurb = "Sixer! Cash x1.5 for everyone.",
		color = rgb(60, 200, 90),
		look = "cricket",
		cashMult = 1.5,
	},
	{
		id = "LoadShedding",
		name = "Load Shedding!",
		blurb = "Light gayi! In the dark, Luck x3 for glowing mutations.",
		color = rgb(150, 110, 255),
		look = "blackout",
		luckMult = 3,
		night = true,
	},
	{
		id = "MelaNight",
		name = "Mela Night",
		blurb = "Fireworks! Eggs hatch twice as fast and Kismat Rolls are 30% off.",
		color = rgb(255, 110, 200),
		look = "mela",
		hatchMult = 2,
		rollDiscount = 0.3,
	},
	{
		id = "Sardi",
		name = "Sardi Aa Gayi",
		blurb = "Winter! Cold keeps eggs fresh: eggs last 50% longer.",
		color = rgb(200, 235, 255),
		look = "snow",
		eggTimeMult = 1.5,
	},
} :: { Event }

Events.byId = {} :: { [string]: Event }
for _, event in Events.list do
	Events.byId[event.id] = event
end

-- The running event, read from workspace attributes (works on server and client).
function Events.current(): Event?
	local id = workspace:GetAttribute("EventId")
	return if type(id) == "string" then Events.byId[id] else nil
end

-- A multiplier from the running event, or 1.
function Events.mult(field: string): number
	local event = Events.current()
	return if event then (event :: any)[field] or 1 else 1
end

return Events
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[local Format = {}

-- 1234567 -> "1,234,567"
function Format.commas(n: number): string
	local whole = tostring(math.floor(math.abs(n)))
	local out = whole:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return if n < 0 then "-" .. out else out
end

-- "Rs 1,234"
function Format.rupees(n: number): string
	return "Rs " .. Format.commas(n)
end

-- Short form for small labels: 950 -> "950", 12500 -> "12.5K", 2000000 -> "2M"
function Format.short(n: number): string
	local abs = math.abs(n)
	local function trim(x: number, suffix: string): string
		local s = string.format("%.1f", x):gsub("%.0$", "")
		return s .. suffix
	end
	if abs >= 1e9 then
		return trim(n / 1e9, "B")
	elseif abs >= 1e6 then
		return trim(n / 1e6, "M")
	elseif abs >= 1e4 then
		return trim(n / 1e3, "K")
	end
	return Format.commas(n)
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Gear</string>
          <string name="Source"><![CDATA[-- Gear sold at the Chowk's Gear shop. Gear is bought once and kept forever,
-- even after a Naya Safar. It works by itself; nothing needs equipping.
--
-- kind:
--   speed    : run faster on foot (the best one you own counts)
--   egg      : eggs last longer before breaking (the best one counts)
--   treasure : needed to open some treasure chests
--   hazard   : protects you from one biome hazard

local Gear = {}

export type Item = {
	id: string,
	name: string,
	kind: string,
	cost: number,
	text: string,
	value: number?,
	protects: string?,
}

Gear.list = {
	{ id = "Joggers", name = "Joggers", kind = "speed", value = 1.1, cost = 3_000, text = "Run 10% faster" },
	{ id = "Tokri", name = "Padded Tokri", kind = "egg", value = 1.25, cost = 6_000, text = "Eggs last 25% longer" },
	{
		id = "GumBoots",
		name = "Gum Boots",
		kind = "hazard",
		protects = "mud",
		cost = 5_000,
		text = "Walk through mud without getting stuck",
	},
	{
		id = "LifeJacket",
		name = "Life Jacket",
		kind = "hazard",
		protects = "water",
		cost = 8_000,
		text = "Swim fast and keep eggs safe from water and waves",
	},
	{ id = "Shovel", name = "Belcha", kind = "treasure", cost = 20_000, text = "Dig up buried treasure chests" },
	{
		id = "SandGoggles",
		name = "Sand Goggles",
		kind = "hazard",
		protects = "sandstorm",
		cost = 30_000,
		text = "See and run through sandstorms",
	},
	{
		id = "RopeLadder",
		name = "Rassi Seedhi",
		kind = "treasure",
		cost = 40_000,
		text = "Climb to cliff-top treasure",
	},
	{
		id = "PeshawariChappal",
		name = "Peshawari Chappal",
		kind = "speed",
		value = 1.25,
		cost = 60_000,
		text = "Run 25% faster",
	},
	{ id = "Thermos", name = "Thermos Dabba", kind = "egg", value = 1.6, cost = 80_000, text = "Eggs last 60% longer" },
	{
		id = "SnowBoots",
		name = "Snow Boots",
		kind = "hazard",
		protects = "ice",
		cost = 120_000,
		text = "No slipping on ice, and snowballs miss you",
	},
	{
		id = "Lantern",
		name = "Lantern",
		kind = "hazard",
		protects = "dark",
		cost = 200_000,
		text = "Light up the salt caves and dodge falling salt",
	},
} :: { Item }

Gear.byId = {} :: { [string]: Item }
for _, item in Gear.list do
	Gear.byId[item.id] = item
end

-- The best multiplier of a kind ("speed" or "egg") among the gear owned.
function Gear.best(owned: { [string]: boolean }, kind: string): number
	local best = 1
	for id in owned do
		local item = Gear.byId[id]
		if item and item.kind == kind and item.value and item.value > best then
			best = item.value
		end
	end
	return best
end

-- Does the owned gear protect against this hazard?
function Gear.protects(owned: { [string]: boolean }, hazard: string): boolean
	for id in owned do
		local item = Gear.byId[id]
		if item and item.protects == hazard then
			return true
		end
	end
	return false
end

-- Gear owned as "Joggers,Lantern" for player attributes.
function Gear.encode(owned: { [string]: boolean }): string
	local ids = {}
	for id in owned do
		table.insert(ids, id)
	end
	table.sort(ids)
	return table.concat(ids, ",")
end

function Gear.decode(text: string?): { [string]: boolean }
	local owned = {}
	for id in string.gmatch(text or "", "[^,]+") do
		owned[id] = true
	end
	return owned
end

return Gear
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Motion</string>
          <string name="Source"><![CDATA[-- The walking maths shared by the server (Mover.luau) and every player's
-- screen (Smooth.client.luau), so both agree on where a brainrot is.

local Motion = {}

-- Where a brainrot walking from `from` to `to` at `speed` studs per second,
-- starting at `startedAt` (server time), is at server time `now`.
-- Returns the CFrame and whether it has arrived.
function Motion.at(from: CFrame, to: CFrame, startedAt: number, speed: number, now: number): (CFrame, boolean)
	local distance = (to.Position - from.Position).Magnitude
	local duration = math.max(distance / math.max(speed, 0.01), 0.05)
	local alpha = math.clamp((now - startedAt) / duration, 0, 1)
	if alpha >= 1 then
		return to, true
	end
	local position = from.Position:Lerp(to.Position, alpha)
	local flat = (to.Position - from.Position) * Vector3.new(1, 0, 1)
	if flat.Magnitude > 0.01 then
		return CFrame.lookAt(position, position + flat), false
	end
	return from.Rotation + position, false
end

function Motion.duration(from: CFrame, to: CFrame, speed: number): number
	return math.max((to.Position - from.Position).Magnitude / math.max(speed, 0.01), 0.05)
end

return Motion
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Mutations</string>
          <string name="Source"><![CDATA[-- Mutations: rare Golden, Diamond and Rainbow versions of any brainrot.
-- They earn more and are worth more. The chances are shown in the Kismat panel.
--
-- income : income multiplier
-- value  : value multiplier (for selling and Lockers)
-- egg    : chance when an egg hatches
-- golden : chance when a golden egg hatches (golden eggs always give a mutation)
-- roll   : chance in a Kismat Roll

local Mutations = {}

export type Mutation = {
	id: string,
	name: string,
	income: number,
	value: number,
	color: Color3,
	egg: number,
	golden: number,
	roll: number,
}

Mutations.list = {
	{
		id = "Golden",
		name = "Golden",
		income = 2,
		value = 1.5,
		color = Color3.fromRGB(255, 205, 50),
		egg = 0.04,
		golden = 0.75,
		roll = 0.08,
	},
	{
		id = "Diamond",
		name = "Diamond",
		income = 4,
		value = 2.5,
		color = Color3.fromRGB(120, 235, 255),
		egg = 0.01,
		golden = 0.2,
		roll = 0.02,
	},
	{
		id = "Rainbow",
		name = "Rainbow",
		income = 8,
		value = 4.5,
		color = Color3.fromRGB(255, 110, 210),
		egg = 0.0025,
		golden = 0.05,
		roll = 0.005,
	},
} :: { Mutation }

Mutations.byId = {} :: { [string]: Mutation }
for _, m in Mutations.list do
	Mutations.byId[m.id] = m
end

-- Picks a mutation (or nil for a normal brainrot). `source` is "egg", "golden"
-- or "roll"; `boost` multiplies every chance (luck from events and theme perks).
function Mutations.roll(source: string, boost: number?): string?
	local r = math.random()
	for i = #Mutations.list, 1, -1 do
		local m = Mutations.list[i]
		local chance = (m :: any)[source] * (boost or 1)
		if r < chance then
			return m.id
		end
		r -= chance
	end
	return nil
end

function Mutations.incomeMultiplier(id: string?): number
	local m = id and Mutations.byId[id]
	return if m then m.income else 1
end

function Mutations.valueMultiplier(id: string?): number
	local m = id and Mutations.byId[id]
	return if m then m.value else 1
end

-- What a brainrot is worth (its price with the mutation).
function Mutations.value(def, id: string?): number
	return math.floor(def.price * Mutations.valueMultiplier(id))
end

function Mutations.income(def, id: string?): number
	return def.income * Mutations.incomeMultiplier(id)
end

-- "Golden Samosa Supremo"
function Mutations.displayName(def, id: string?): string
	local m = id and Mutations.byId[id]
	return if m then m.name .. " " .. def.name else def.name
end

-- Saved brainrots are strings: "SamosaSupremo" or "SamosaSupremo:Golden".
function Mutations.key(defId: string, id: string?): string
	return if id then defId .. ":" .. id else defId
end

function Mutations.parse(key: string): (string, string?)
	local defId, id = key:match("^([^:]+):(.+)$")
	if defId then
		return defId, if Mutations.byId[id] then id else nil
	end
	return key, nil
end

return Mutations
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Quests</string>
          <string name="Source"><![CDATA[-- Daily quest types. Every day each player gets Config.QUESTS_PER_DAY of them.
--
-- text    : shown to the player; %s is the target
-- targets : one is picked at random
-- money   : the target is an amount of rupees that grows with your income
-- rolls   : extra Kismat Rolls on top of the rupee reward
-- needs   : only offered when this is possible ("upgrade", "undiscovered", "treasureGear")

local Quests = {}

export type QuestDef = {
	id: string,
	text: string,
	targets: { number }?,
	money: boolean?,
	rolls: number?,
	needs: string?,
}

Quests.list = {
	{ id = "eggHome", text = "Bring %s eggs home", targets = { 2, 3, 5 } },
	{ id = "hatchRare", text = "Hatch a Rare or better brainrot", targets = { 1 }, rolls = 1 },
	{ id = "goldenEgg", text = "Bring home a golden egg", targets = { 1 }, rolls = 2 },
	{ id = "treasure", text = "Open a treasure chest", targets = { 1 }, rolls = 1, needs = "treasureGear" },
	{ id = "collect", text = "Collect %s from your galla", money = true },
	{ id = "roll", text = "Do a Kismat Roll", targets = { 1 } },
	{ id = "mutation", text = "Get a Golden, Diamond or Rainbow brainrot", targets = { 1 }, rolls = 1 },
	{ id = "upgrade", text = "Upgrade your haveli or tracker", targets = { 1 }, needs = "upgrade" },
	{ id = "discover", text = "Discover a brainrot you have never had", targets = { 1 }, needs = "undiscovered" },
	{ id = "taala", text = "Lock your haveli with the Taala", targets = { 1 } },
	{ id = "eventEgg", text = "Bring an egg home during an event", targets = { 1 }, rolls = 1 },
	{ id = "biomes", text = "Bring eggs home from %s different biomes", targets = { 2, 3 } },
} :: { QuestDef }

Quests.byId = {} :: { [string]: QuestDef }
for _, quest in Quests.list do
	Quests.byId[quest.id] = quest
end

return Quests
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- RemoteEvents shared by the server and the client.
-- The server creates them; clients wait for them.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "ChaiChaosRemotes"
local NAMES = {
	"Notify", -- server -> client: (kind, text)
	"LockHaveli", -- client -> server: lock your haveli (Taala)
	"Rebirth", -- client -> server: start a Naya Safar
	"Roll", -- client -> server: ("rupees" or "token") do a Kismat Roll
	"BuyProduct", -- client -> server: ("rolls" or "steals", pack index) or ("paint", paint id): show a Robux purchase prompt
	"RollResult", -- server -> client: (brainrot id, mutation or "", isNew, wasPity)
	"UpgradeHaveli", -- client -> server: buy the next haveli level
	"SetTheme", -- client -> server: (theme id) change your haveli theme
	"ClaimQuest", -- client -> server: (quest index, or "bonus") claim a finished quest
	"ClaimCollection", -- client -> server: (rarity) claim a Collection Book reward
	"BuyGear", -- client -> server: (gear id) buy gear at the Chowk
	"UpgradeTracker", -- client -> server: buy the next tracker level
	"SellBrainrot", -- client -> server: (brainrot uid) sell at the Chowk's Sell stall
	"BuyVehicle", -- client -> server: (vehicle id) buy at the Gaari Showroom
	"UpgradeVehicle", -- client -> server: (vehicle id, upgrade id) buy an upgrade at Ustad's Workshop
	"Drive", -- client -> server: (vehicle id) get in and drive, or (nil) park and get out
	"SetPaint", -- client -> server: (paint id) pick the paint job for your vehicles
	"PlaySound", -- server -> client: (sound name, position or nil)
}

local folder: Instance
if RunService:IsServer() then
	folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME) or Instance.new("Folder")
	folder.Name = FOLDER_NAME
	for _, name in NAMES do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
	folder.Parent = ReplicatedStorage
else
	folder = ReplicatedStorage:WaitForChild(FOLDER_NAME)
end

return {
	Notify = folder:WaitForChild("Notify") :: RemoteEvent,
	LockHaveli = folder:WaitForChild("LockHaveli") :: RemoteEvent,
	Rebirth = folder:WaitForChild("Rebirth") :: RemoteEvent,
	Roll = folder:WaitForChild("Roll") :: RemoteEvent,
	BuyProduct = folder:WaitForChild("BuyProduct") :: RemoteEvent,
	RollResult = folder:WaitForChild("RollResult") :: RemoteEvent,
	UpgradeHaveli = folder:WaitForChild("UpgradeHaveli") :: RemoteEvent,
	SetTheme = folder:WaitForChild("SetTheme") :: RemoteEvent,
	ClaimQuest = folder:WaitForChild("ClaimQuest") :: RemoteEvent,
	ClaimCollection = folder:WaitForChild("ClaimCollection") :: RemoteEvent,
	BuyGear = folder:WaitForChild("BuyGear") :: RemoteEvent,
	UpgradeTracker = folder:WaitForChild("UpgradeTracker") :: RemoteEvent,
	SellBrainrot = folder:WaitForChild("SellBrainrot") :: RemoteEvent,
	BuyVehicle = folder:WaitForChild("BuyVehicle") :: RemoteEvent,
	UpgradeVehicle = folder:WaitForChild("UpgradeVehicle") :: RemoteEvent,
	Drive = folder:WaitForChild("Drive") :: RemoteEvent,
	SetPaint = folder:WaitForChild("SetPaint") :: RemoteEvent,
	PlaySound = folder:WaitForChild("PlaySound") :: RemoteEvent,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Sounds</string>
          <string name="Source"><![CDATA[-- Every sound in the game, by name.
--
-- The defaults are sounds that come with Roblox (rbxasset://sounds/...).
-- To use your own, find a sound in the Creator Store (Toolbox > Audio), copy
-- its id and paste it as "rbxassetid://123456789". An empty id plays nothing.
-- Music is empty until you add some: try searching the Creator Store for
-- "dhol", "tabla", "bazaar" or "desi".

local Sounds = {}

export type Sound = {
	id: string,
	volume: number,
	pitch: number?,
	looped: boolean?,
}

Sounds.list = {
	-- buttons and money
	Click = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.25, pitch = 1.6 },
	Coin = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.5, pitch = 1.3 },
	Purchase = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.6, pitch = 0.9 },
	Error = { id = "rbxasset://sounds/action_get_up.mp3", volume = 0.5, pitch = 0.7 },

	-- eggs
	EggPickup = { id = "rbxasset://sounds/action_jump.mp3", volume = 0.7, pitch = 1.3 },
	EggHome = { id = "rbxasset://sounds/action_jump_land.mp3", volume = 0.7, pitch = 1.2 },
	EggCrack = { id = "rbxasset://sounds/uuhhh.mp3", volume = 0.8 },
	EggHatch = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.8, pitch = 0.7 },
	Treasure = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.8, pitch = 1.1 },

	-- trouble
	Bonk = { id = "rbxasset://sounds/action_jump_land.mp3", volume = 1, pitch = 1.6 },
	ChorAlert = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 1, pitch = 0.5 },
	Splash = { id = "rbxasset://sounds/impact_water.mp3", volume = 0.9 },
	Hit = { id = "rbxasset://sounds/action_jump_land.mp3", volume = 0.9, pitch = 0.8 },
	Wind = { id = "rbxasset://sounds/action_falling.mp3", volume = 0.5, looped = true },

	-- big moments
	Upgrade = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.8, pitch = 1.2 },
	Rebirth = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 1, pitch = 0.6 },
	EventStart = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.9, pitch = 0.8 },
	RollSpin = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.2, pitch = 2 },
	RollReveal = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.8, pitch = 1 },

	-- music (add your own ids)
	MusicBazaar = { id = "", volume = 0.25, looped = true },
	MusicBiome = { id = "", volume = 0.25, looped = true },
	MusicEvent = { id = "", volume = 0.3, looped = true },
} :: { [string]: Sound }

return Sounds
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Themes</string>
          <string name="Source"><![CDATA[-- Haveli themes. Two are free; every Naya Safar unlocks the next one.
-- Each theme changes how your haveli looks and gives one small perk.
--
-- perk kinds:
--   income       : multiply your income
--   thiefSlow    : thieves carrying your brainrots walk this much slower
--   walkSpeed    : you walk this much faster
--   rollDiscount : Kismat Rolls cost this much less (0.15 = 15% off)
--   taalaBonus   : extra seconds on your Taala
--   rollMutation : multiply mutation chances in your Kismat Rolls
--   bonkRange    : multiply how far your chappal reaches
--   eventIncome  : multiply your income during events

local Themes = {}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

export type Theme = {
	id: string,
	name: string,
	rebirths: number,
	perkText: string,
	perk: string,
	value: number,
	wall: Color3,
	trim: Color3,
	accent: Color3,
	floor: Color3,
	wallMaterial: string,
	floorMaterial: string,
	reflectance: number?,
	decor: { string },
	upperDecor: string,
	roofDecor: string,
}

Themes.list = {
	{
		id = "MughalMarble",
		name = "Mughal Marble",
		rebirths = 0,
		perk = "income",
		value = 1.05,
		perkText = "Shahi Kamai: +5% income",
		wall = rgb(250, 246, 238),
		trim = rgb(215, 95, 65),
		accent = rgb(255, 200, 60),
		floor = rgb(240, 232, 214),
		wallMaterial = "Marble",
		floorMaterial = "Marble",
		decor = { "lantern", "planter", "fountain" },
		upperDecor = "lantern",
		roofDecor = "chhatri",
	},
	{
		id = "BaghGarden",
		name = "Bagh Garden",
		rebirths = 0,
		perk = "thiefSlow",
		value = 0.85,
		perkText = "Kaanton Wali Baarh: thieves carrying your brainrots are 15% slower",
		wall = rgb(255, 240, 205),
		trim = rgb(80, 175, 90),
		accent = rgb(255, 120, 165),
		floor = rgb(130, 205, 105),
		wallMaterial = "SmoothPlastic",
		floorMaterial = "Grass",
		decor = { "tree", "hedge", "planter" },
		upperDecor = "planter",
		roofDecor = "tree",
	},
	{
		id = "TruckArt",
		name = "Truck Art",
		rebirths = 1,
		perk = "walkSpeed",
		value = 1.12,
		perkText = "Pon Pon: you walk 12% faster",
		wall = rgb(255, 215, 50),
		trim = rgb(235, 40, 95),
		accent = rgb(30, 185, 230),
		floor = rgb(255, 245, 210),
		wallMaterial = "SmoothPlastic",
		floorMaterial = "SmoothPlastic",
		decor = { "bells", "banner", "lantern" },
		upperDecor = "bells",
		roofDecor = "kites",
	},
	{
		id = "ChaiDhaba",
		name = "Chai Dhaba",
		rebirths = 2,
		perk = "rollDiscount",
		value = 0.15,
		perkText = "Chai Break: Kismat Rolls cost 15% fewer rupees",
		wall = rgb(215, 150, 95),
		trim = rgb(115, 72, 40),
		accent = rgb(255, 175, 50),
		floor = rgb(195, 155, 110),
		wallMaterial = "Brick",
		floorMaterial = "WoodPlanks",
		decor = { "charpai", "kettle", "lantern" },
		upperDecor = "charpai",
		roofDecor = "chhatri",
	},
	{
		id = "SheeshMahal",
		name = "Sheesh Mahal",
		rebirths = 3,
		perk = "taalaBonus",
		value = 15,
		perkText = "Chamak: your Taala lasts 15 seconds longer",
		wall = rgb(205, 232, 255),
		trim = rgb(175, 135, 255),
		accent = rgb(255, 255, 255),
		floor = rgb(235, 245, 255),
		wallMaterial = "SmoothPlastic",
		floorMaterial = "Marble",
		reflectance = 0.25,
		decor = { "mirror", "crystal", "lantern" },
		upperDecor = "crystal",
		roofDecor = "chhatri",
	},
	{
		id = "BasantRooftop",
		name = "Basant Rooftop",
		rebirths = 4,
		perk = "rollMutation",
		value = 2,
		perkText = "Patang Luck: mutations are twice as likely in your Kismat Rolls",
		wall = rgb(255, 238, 90),
		trim = rgb(255, 140, 20),
		accent = rgb(120, 205, 60),
		floor = rgb(255, 250, 215),
		wallMaterial = "SmoothPlastic",
		floorMaterial = "SmoothPlastic",
		decor = { "kiteStand", "planter", "bunting" },
		upperDecor = "kiteStand",
		roofDecor = "kites",
	},
	{
		id = "CricketMaidan",
		name = "Cricket Maidan",
		rebirths = 5,
		perk = "bonkRange",
		value = 2,
		perkText = "Lambi Shot: your chappal reaches twice as far",
		wall = rgb(245, 245, 245),
		trim = rgb(30, 135, 65),
		accent = rgb(0, 95, 180),
		floor = rgb(110, 195, 85),
		wallMaterial = "SmoothPlastic",
		floorMaterial = "Grass",
		decor = { "stumps", "banner", "planter" },
		upperDecor = "stumps",
		roofDecor = "kites",
	},
	{
		id = "MelaLights",
		name = "Mela Lights",
		rebirths = 6,
		perk = "eventIncome",
		value = 1.25,
		perkText = "Mela Magic: +25% income during events",
		wall = rgb(255, 160, 205),
		trim = rgb(145, 65, 205),
		accent = rgb(255, 225, 60),
		floor = rgb(255, 235, 245),
		wallMaterial = "SmoothPlastic",
		floorMaterial = "SmoothPlastic",
		decor = { "balloons", "fairyLights", "bunting" },
		upperDecor = "balloons",
		roofDecor = "kites",
	},
} :: { Theme }

Themes.DEFAULT = "MughalMarble"
Themes.EMPTY = { -- an empty haveli
	wall = rgb(226, 196, 150),
	trim = rgb(190, 150, 105),
	accent = rgb(210, 180, 140),
	floor = rgb(235, 225, 205),
	wallMaterial = "SmoothPlastic",
	floorMaterial = "SmoothPlastic",
}

Themes.byId = {} :: { [string]: Theme }
for _, theme in Themes.list do
	Themes.byId[theme.id] = theme
end

function Themes.isUnlocked(id: string, rebirths: number): boolean
	local theme = Themes.byId[id]
	return theme ~= nil and rebirths >= theme.rebirths
end

-- The perk value if `themeId` has a perk of this kind, otherwise nil.
function Themes.perk(themeId: string?, kind: string): number?
	local theme = themeId and Themes.byId[themeId]
	if theme and theme.perk == kind then
		return theme.value
	end
	return nil
end

return Themes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Vehicles</string>
          <string name="Source"><![CDATA[-- Vehicles: how you get out to the zones and back with your eggs.
--
-- Buy them at the Gaari Showroom (Rickshaw Stand, in the bazaar), upgrade them
-- at Ustad's Workshop (Chai Dhaba Bazaar) and fill up at the petrol pumps.
-- Everything is bought with rupees and kept forever, even after a Naya Safar.
-- Robux only buys paint jobs, which change how vehicles look and nothing else.
--
-- speed : top speed in studs per second (walking is Config.WALK_SPEED)
-- tank  : how far it drives on a full tank, in studs
-- eggs  : eggs it carries in the boot
-- grip  : 0-3. 1 drives through mud, 2 through sand, 3 on ice without sliding
-- seats : friends who can ride along

local Vehicles = {}

export type Def = {
	id: string,
	name: string,
	cost: number,
	speed: number,
	tank: number,
	eggs: number,
	grip: number,
	seats: number,
	upgradeBase: number,
	text: string,
}

export type Upgrade = {
	id: string,
	name: string,
	max: number,
	costMult: number,
	text: string,
}

export type Levels = { speed: number, tank: number, eggs: number, grip: number }

Vehicles.list = {
	{
		id = "Motorbike",
		name = "Motorbike",
		cost = 3_000,
		speed = 34,
		tank = 1_500,
		eggs = 1,
		grip = 0,
		seats = 1,
		upgradeBase = 1_500,
		text = "Cheap and quick. Carries 1 egg and a friend on the back.",
	},
	{
		id = "Rickshaw",
		name = "Rickshaw",
		cost = 25_000,
		speed = 38,
		tank = 2_000,
		eggs = 2,
		grip = 0,
		seats = 2,
		upgradeBase = 8_000,
		text = "Pon pon! Carries 2 eggs and 2 friends.",
	},
	{
		id = "PiliTaxi",
		name = "Pili Taxi",
		cost = 150_000,
		speed = 46,
		tank = 2_800,
		eggs = 3,
		grip = 1,
		seats = 3,
		upgradeBase = 40_000,
		text = "A yellow city taxi. Fast, 3 eggs, 3 friends, drives through mud.",
	},
	{
		id = "PhoolPattiTruck",
		name = "Phool Patti Truck",
		cost = 1_200_000,
		speed = 42,
		tank = 4_500,
		eggs = 6,
		grip = 2,
		seats = 1,
		upgradeBase = 250_000,
		text = "A painted truck with bells. 6 eggs, a huge tank, drives through sand.",
	},
} :: { Def }

Vehicles.byId = {} :: { [string]: Def }
for _, def in Vehicles.list do
	Vehicles.byId[def.id] = def
end

Vehicles.UPGRADES = {
	{ id = "speed", name = "Engine", max = 5, costMult = 1, text = "+10% top speed" },
	{ id = "tank", name = "Fuel Tank", max = 5, costMult = 0.6, text = "+25% range" },
	{ id = "eggs", name = "Egg Space", max = 3, costMult = 1.4, text = "+1 egg in the boot" },
	{ id = "grip", name = "Tyres", max = 3, costMult = 1.2, text = "Better grip on mud, sand and ice" },
} :: { Upgrade }

Vehicles.upgradeById = {} :: { [string]: Upgrade }
for _, upgrade in Vehicles.UPGRADES do
	Vehicles.upgradeById[upgrade.id] = upgrade
end

Vehicles.GRIP_MAX = 3
Vehicles.SPEED_PER_LEVEL = 0.1
Vehicles.TANK_PER_LEVEL = 0.25
Vehicles.UPGRADE_GROWTH = 1.8 -- every level costs this many times more than the last

-- Paint jobs: bought with Robux (see Config.PAINT_PRODUCTS). Looks only.
Vehicles.PAINTS = {
	{ id = "Factory", name = "Factory Paint", text = "The colours it came with." },
	{ id = "PhoolPatti", name = "Phool Patti", text = "Bright truck-art colours on every panel." },
	{ id = "Sona", name = "Sona", text = "Shiny gold all over." },
	{ id = "Rangeela", name = "Rangeela", text = "Every colour of the rainbow, always changing." },
	{ id = "Chamak", name = "Chamak", text = "Glows in the dark." },
}
Vehicles.paintById = {}
for _, paint in Vehicles.PAINTS do
	Vehicles.paintById[paint.id] = paint
end

-- How many levels an upgrade can go up on this vehicle.
function Vehicles.maxLevel(def: Def, upgradeId: string): number
	local upgrade = Vehicles.upgradeById[upgradeId]
	if upgradeId == "grip" then
		return math.max(0, Vehicles.GRIP_MAX - def.grip)
	end
	return upgrade and upgrade.max or 0
end

-- What the next level of an upgrade costs (`level` is the level being bought).
function Vehicles.upgradeCost(def: Def, upgradeId: string, level: number): number
	local upgrade = Vehicles.upgradeById[upgradeId]
	local raw = def.upgradeBase * upgrade.costMult * Vehicles.UPGRADE_GROWTH ^ (level - 1)
	return math.floor(raw / 50 + 0.5) * 50
end

function Vehicles.levels(saved: any): Levels
	local t = if type(saved) == "table" then saved else {}
	return {
		speed = t.speed or 0,
		tank = t.tank or 0,
		eggs = t.eggs or 0,
		grip = t.grip or 0,
	}
end

-- A vehicle's stats with its upgrades.
function Vehicles.speed(def: Def, levels: Levels): number
	return def.speed * (1 + Vehicles.SPEED_PER_LEVEL * levels.speed)
end

function Vehicles.tank(def: Def, levels: Levels): number
	return math.floor(def.tank * (1 + Vehicles.TANK_PER_LEVEL * levels.tank))
end

function Vehicles.eggs(def: Def, levels: Levels): number
	return def.eggs + levels.eggs
end

function Vehicles.grip(def: Def, levels: Levels): number
	return math.min(Vehicles.GRIP_MAX, def.grip + levels.grip)
end

-- Does this grip get through this surface at full speed?
-- mud needs grip 1, sand 2, ice 3. Deep water always slows you down.
Vehicles.GRIP_NEEDED = { mud = 1, sand = 2, sandstorm = 2, ice = 3 }

function Vehicles.handles(grip: number, surface: string): boolean
	local needed = Vehicles.GRIP_NEEDED[surface]
	return needed ~= nil and grip >= needed
end

return Vehicles
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="15">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="16">
      <Properties>
        <string name="Name">ChaiChaosServer</string>
      </Properties>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">BiomeBuilder</string>
          <string name="Source"><![CDATA[-- Builds the 12 zones out of Roblox Terrain (grass, sand, salt, snow, water...)
-- and the props modelled in Blender (see Props.luau): each zone's landmark,
-- its trees and plants, and desi things like tents, camels, stalls and boats.
--
-- Every zone is planned from a fixed random seed, so the world is the same
-- every time. Planning (where eggs, chests and hazard areas go) always runs;
-- building (creating terrain and parts) only runs when the map is new.
--
-- Positions inside a zone are given as (rf, sf): rf goes from 0 at the zone's
-- inner edge to 1 at its outer edge, sf from -1 at one side to 1 at the other.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Biomes = require(Shared.Biomes)

local Props = require(script.Parent.Props)

local BiomeBuilder = {}

local GROUND_Y = Biomes.GROUND_Y
local EGG_SPOTS = 40
local CELL = 16
local EDGE = 10 -- studs kept clear along the zone's walls and fences
local GATE_CLEAR = 26 -- studs kept clear around gates and shortcut doors

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

export type Zone = {
	kind: string, -- water, mud, ice, shore, dark, sandstorm, sand
	center: Vector3?, -- circles
	radius: number?,
	inner: number?, -- bands: distance from the Chowk (inside this zone)
	outer: number?,
}

export type Chest = {
	position: Vector3,
	kind: string, -- "dig" (needs a Shovel) or "climb" (needs a Rope Ladder)
	base: Vector3?, -- where you climb from
	stand: Vector3?, -- where you land after climbing (next to the chest)
}

export type Plan = {
	biome: any,
	eggSpots: { Vector3 },
	chests: { Chest },
	zones: { Zone },
	balls: { { center: Vector3, radius: number } },
	rickshaw: Vector3?, -- ring 3: where the rickshaw home waits
}

---------------------------------------------------------------------------
-- Context helpers
---------------------------------------------------------------------------
local function newContext(biome, folder: Instance?)
	local r1, r2 = Biomes.innerRadius(biome), Biomes.outerRadius(biome)
	local ctx = {
		biome = biome,
		folder = folder,
		building = folder ~= nil,
		rng = Random.new(2000 + biome.index),
		r1 = r1,
		r2 = r2,
		mid = biome.angle,
		terrain = workspace.Terrain,
		plan = { biome = biome, eggSpots = {}, chests = {}, zones = {}, balls = {} } :: Plan,
		occupied = {}, -- round areas already taken: { position, radius, blocksEggs }
		clear = {}, -- spots that must stay open (gates and doors)
	}
	-- keep the gates in and out of this zone and its shortcut doors clear
	local angle, radius = Biomes.gate(biome)
	table.insert(ctx.clear, Biomes.polar(angle, radius))
	local outer = Biomes.byRegion[biome.region][biome.ring + 1]
	if outer then
		local a2, rr2 = Biomes.gate(outer)
		table.insert(ctx.clear, Biomes.polar(a2, rr2))
	end
	for _, door in Biomes.shortcuts() do
		if door.a == biome or door.b == biome then
			table.insert(ctx.clear, Biomes.polar(door.angle, door.radius))
		end
	end
	for _, pump in Biomes.pumps() do
		if Biomes.at(pump) == biome then
			table.insert(ctx.clear, pump)
		end
	end
	return ctx
end

-- A ground position in the zone: rf from 0 (inner edge) to 1 (outer edge),
-- sf from -1 to 1 across it.
local function at(ctx, rf: number, sf: number): Vector3
	local r = ctx.r1 + EDGE + rf * (ctx.r2 - ctx.r1 - 2 * EDGE)
	local span = Biomes.SPAN - math.deg(EDGE / r)
	return Biomes.polar(ctx.mid + sf * span, r)
end

-- The ground height at x, z (hills and dunes raise it).
local function surface(ctx, position: Vector3): number
	local height = GROUND_Y
	for _, ball in ctx.plan.balls do
		local dx, dz = position.X - ball.center.X, position.Z - ball.center.Z
		local flat = dx * dx + dz * dz
		if flat < ball.radius * ball.radius then
			height = math.max(height, ball.center.Y + math.sqrt(ball.radius * ball.radius - flat))
		end
	end
	return height
end

local function onGround(ctx, position: Vector3): Vector3
	return Vector3.new(position.X, surface(ctx, position), position.Z)
end

-- A raised ball of terrain (hill, dune, mountain). Recorded so things sit on top.
local function hill(ctx, center: Vector3, radius: number, material: Enum.Material)
	table.insert(ctx.plan.balls, { center = center, radius = radius })
	if ctx.building then
		ctx.terrain:FillBall(center, radius, material)
	end
end

-- Water, mud or ice that lies flush with the ground. Terrain is made of
-- 4-stud voxels and the ground's top layer (Y 0 to 4) is only a quarter full,
-- so a fill that stops below Y 0 would stay hidden under a crust of ground.
-- These clear that layer first, then fill up to the ground's surface.
local function pond(ctx, center: Vector3, radius: number, depth: number, material: Enum.Material)
	if ctx.building then
		ctx.terrain:FillCylinder(CFrame.new(center.X, GROUND_Y + 3, center.Z), 6, radius, Enum.Material.Air)
		ctx.terrain:FillCylinder(CFrame.new(center.X, GROUND_Y - depth / 2, center.Z), depth, radius, material)
	end
end

local function part(ctx, props: { [string]: any }): Part?
	if not ctx.building then
		return nil
	end
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	p.CastShadow = props.CastShadow ~= false
	for name, value in props do
		if name ~= "Parent" and name ~= "CastShadow" then
			(p :: any)[name] = value
		end
	end
	p.Parent = props.Parent or ctx.folder
	return p
end

local function zone(ctx, z: Zone)
	table.insert(ctx.plan.zones, z)
end

-- The whole zone is this kind (dark caves, sandy desert, sandstorms).
local function wholeZone(ctx, kind: string)
	zone(ctx, { kind = kind, inner = ctx.r1, outer = ctx.r2 })
end

local function chest(ctx, position: Vector3, kind: string, base: Vector3?, stand: Vector3?)
	table.insert(ctx.plan.chests, { position = position, kind = kind, base = base, stand = stand })
end

local function inZone(plan: Plan, position: Vector3, kinds: { [string]: boolean }): boolean
	local r = Biomes.radiusOf(position)
	for _, z in plan.zones do
		if kinds[z.kind] then
			if z.center then
				local dx, dz = position.X - z.center.X, position.Z - z.center.Z
				if dx * dx + dz * dz < (z.radius :: number) ^ 2 then
					return true
				end
			elseif z.inner and r >= z.inner and r <= (z.outer :: number) then
				return true
			end
		end
	end
	return false
end

-- Facing the Chowk.
local function facing(position: Vector3): CFrame
	local toward = Vector3.new(0, position.Y, 0)
	if (toward - position).Magnitude < 0.01 then
		return CFrame.new(position)
	end
	return CFrame.lookAt(position, toward)
end

-- Marks a round area as taken so scattered props keep out of it. With
-- `blocksEggs`, eggs keep out too (inside a fort's walls, under a hut).
local function occupy(ctx, position: Vector3, radius: number, blocksEggs: boolean?)
	table.insert(ctx.occupied, { position = position, radius = radius, blocksEggs = blocksEggs == true })
end

-- Is this spot free for something `radius` studs across: inside the zone, off
-- the roads, away from gates and doors and other props?
local function isFree(ctx, position: Vector3, radius: number, ignoreProps: boolean?): boolean
	if not Biomes.contains(ctx.biome, position, EDGE + radius) then
		return false
	end
	if Biomes.roadDistance(position) < radius + 3 then
		return false
	end
	for _, spot in ctx.clear do
		local dx, dz = position.X - spot.X, position.Z - spot.Z
		if dx * dx + dz * dz < (GATE_CLEAR + radius) ^ 2 then
			return false
		end
	end
	if ignoreProps then
		return true
	end
	for _, o in ctx.occupied do
		local dx, dz = position.X - o.position.X, position.Z - o.position.Z
		if dx * dx + dz * dz < (radius + o.radius) ^ 2 then
			return false
		end
	end
	return true
end

-- Every grid cell whose middle is inside the zone.
local function cells(ctx): { Vector3 }
	local list = {}
	local r = ctx.r2 + CELL
	for x = math.floor(-r / CELL) * CELL, r, CELL do
		for z = math.floor(-r / CELL) * CELL, r, CELL do
			local spot = Vector3.new(x, GROUND_Y, z)
			if Biomes.contains(ctx.biome, spot) then
				table.insert(list, spot)
			end
		end
	end
	return list
end

-- Fill the zone's ground with one terrain material (and some patches of a second).
local function ground(ctx, material: Enum.Material, patches: Enum.Material?, share: number?)
	if not ctx.building then
		return
	end
	local rng = Random.new(3000 + ctx.biome.index)
	for _, spot in cells(ctx) do
		local m = if patches and rng:NextNumber() < (share or 0.2) then patches else material
		ctx.terrain:FillBlock(CFrame.new(spot.X, GROUND_Y - 2, spot.Z), Vector3.new(CELL, 4, CELL), m)
	end
end

-- Builds a prop at `cf` (only when building; planning just needs the numbers).
local function place(ctx, name: string, cf: CFrame, scale: number?)
	if ctx.building then
		Props.place(name, cf, ctx.folder, scale)
	end
end

-- A prop standing on the ground: turned `yaw` degrees, or facing the Chowk.
local function prop(ctx, name: string, position: Vector3, yaw: number?, scale: number?): CFrame
	local base = onGround(ctx, position)
	local cf = if yaw then CFrame.new(base) * CFrame.Angles(0, math.rad(yaw), 0) else facing(base)
	place(ctx, name, cf, scale)
	return cf
end

-- A prop facing along the zone (its front towards angle `toward` round the circle).
local function propFacing(ctx, name: string, position: Vector3, target: Vector3, scale: number?): CFrame
	local base = onGround(ctx, position)
	local flatTarget = Vector3.new(target.X, base.Y, target.Z)
	local cf = if (flatTarget - base).Magnitude > 0.01 then CFrame.lookAt(base, flatTarget) else CFrame.new(base)
	place(ctx, name, cf, scale)
	return cf
end

-- A landmark: placed if there is room, it keeps eggs and props out of `radius`.
local function landmark(ctx, name: string, rf: number, sf: number, radius: number, yaw: number?): CFrame?
	for k = 0, 12 do
		local spot = at(ctx, rf, sf + (if k % 2 == 0 then 1 else -1) * math.floor((k + 1) / 2) * 0.06)
		if isFree(ctx, spot, radius) then
			local cf = prop(ctx, name, spot, yaw)
			occupy(ctx, spot, radius, true)
			return cf
		end
	end
	return nil
end

-- Writes on a prop's sign (see the anchors in PropData.luau).
local function sign(ctx, name: string, cf: CFrame, anchor: string, width: number, height: number, text: string)
	if ctx.building then
		Props.text(ctx.folder, cf, Props.anchor(name, anchor, cf), width, height, text)
	end
end

-- A treasure chest at a landmark's own anchors (top, where you climb from, where you land).
local function climbAnchors(ctx, name: string, cf: CFrame?, top: string, base: string, stand: string)
	if cf then
		chest(ctx, Props.anchor(name, top, cf), "climb", Props.anchor(name, base, cf), Props.anchor(name, stand, cf))
	end
end

-- A treasure chest on top of a landmark, reached with a Rope Ladder.
local function climbOn(ctx, name: string, cf: CFrame?, anchor: string, baseOffset: Vector3)
	if not cf then
		return
	end
	local top = Props.anchor(name, anchor, cf)
	local stand = top + cf.RightVector * 2.5
	chest(ctx, top + Vector3.new(0, 0.1, 0), "climb", cf * baseOffset, stand)
end

type ScatterOptions = {
	rMin: number?,
	rMax: number?,
	spacing: number?,
	scale: { number }?,
	avoid: { [string]: boolean }?,
}

-- Sprinkles `count` of a prop (or of a list of props) at random free spots.
local function scatter(ctx, names: string | { string }, count: number, opts: ScatterOptions?)
	local o = opts or {}
	local list = if type(names) == "string" then { names } else names
	local placed, tries = 0, 0
	while placed < count and tries < count * 12 do
		tries += 1
		local spot = at(ctx, ctx.rng:NextNumber(o.rMin or 0, o.rMax or 1), ctx.rng:NextNumber(-1, 1))
		local name = list[ctx.rng:NextInteger(1, #list)]
		local scale = if o.scale then ctx.rng:NextNumber(o.scale[1], o.scale[2]) else 1
		local radius = (o.spacing or 4) * scale
		if isFree(ctx, spot, radius) and not (o.avoid and inZone(ctx.plan, spot, o.avoid)) then
			prop(ctx, name, spot, ctx.rng:NextNumber(0, 360), scale)
			occupy(ctx, spot, radius * 0.6)
			placed += 1
		end
	end
end

-- Random egg spots on the ground, away from the given hazard kinds.
local function eggSpots(ctx, avoid: { [string]: boolean }?)
	local tries = 0
	while #ctx.plan.eggSpots < EGG_SPOTS and tries < 3000 do
		tries += 1
		local spot = at(ctx, ctx.rng:NextNumber(0.02, 0.98), ctx.rng:NextNumber(-0.97, 0.97))
		local blocked = false
		for _, o in ctx.occupied do
			if o.blocksEggs and ((spot - o.position) * Vector3.new(1, 0, 1)).Magnitude < o.radius then
				blocked = true
				break
			end
		end
		if not blocked and isFree(ctx, spot, 2, true) and not (avoid and inZone(ctx.plan, spot, avoid)) then
			table.insert(ctx.plan.eggSpots, onGround(ctx, spot))
		end
	end
end

-- Buried treasure under an X, dug up with a Belcha.
local function digChests(ctx, count: number, avoid: { [string]: boolean }?)
	local placed, tries = 0, 0
	while placed < count and tries < 400 do
		tries += 1
		local spot = at(ctx, ctx.rng:NextNumber(0.15, 0.95), ctx.rng:NextNumber(-0.9, 0.9))
		if isFree(ctx, spot, 5) and not (avoid and inZone(ctx.plan, spot, avoid)) then
			chest(ctx, onGround(ctx, spot), "dig")
			occupy(ctx, spot, 5, true)
			placed += 1
		end
	end
end

-- A simple farm animal made of parts (buffaloes, goats, yaks).
local function animal(ctx, position: Vector3, color: Color3, size: number, name: string)
	local base = onGround(ctx, position)
	local cf = CFrame.new(base) * CFrame.Angles(0, ctx.rng:NextNumber(0, math.pi * 2), 0)
	part(ctx, {
		Name = name,
		Size = Vector3.new(size * 0.9, size * 0.8, size * 1.8),
		CFrame = cf * CFrame.new(0, size * 1.1, 0),
		Color = color,
	})
	part(ctx, {
		Name = name .. "Head",
		Size = Vector3.new(size * 0.6, size * 0.6, size * 0.7),
		CFrame = cf * CFrame.new(0, size * 1.4, -size * 1.15),
		Color = color:Lerp(rgb(0, 0, 0), 0.15),
	})
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			part(ctx, {
				Name = "Leg",
				Size = Vector3.new(size * 0.22, size * 0.8, size * 0.22),
				CFrame = cf * CFrame.new(x * size * 0.3, size * 0.4, z * size * 0.65),
				Color = color:Lerp(rgb(0, 0, 0), 0.3),
			})
		end
	end
	occupy(ctx, base, size * 1.4)
end

-- A string of little flags between two points.
local function bunting(ctx, from: Vector3, to: Vector3)
	local colors = { rgb(230, 60, 60), rgb(250, 190, 40), rgb(40, 160, 90), rgb(60, 120, 220), rgb(230, 90, 170) }
	local count = math.max(2, math.floor((to - from).Magnitude / 3))
	for i = 1, count - 1 do
		local p = from:Lerp(to, i / count) - Vector3.new(0, math.sin(i / count * math.pi) * 1.5, 0)
		part(ctx, {
			Name = "Flag",
			Size = Vector3.new(1.2, 1.2, 0.1),
			CFrame = CFrame.lookAt(p, p + (to - from):Cross(Vector3.yAxis)) * CFrame.Angles(0, 0, math.rad(45)),
			Color = colors[i % #colors + 1],
			Material = Enum.Material.Fabric,
			CanCollide = false,
			CastShadow = false,
		})
	end
end

-- A band of sea along the zone's outer edge (with a beach strip before it).
local function sea(ctx, from: number, shoreWidth: number)
	local cellList = if ctx.building then cells(ctx) else {}
	for _, spot in cellList do
		local r = Biomes.radiusOf(spot)
		if r >= from then
			ctx.terrain:FillBlock(
				CFrame.new(spot.X, GROUND_Y + 3, spot.Z),
				Vector3.new(CELL, 6, CELL),
				Enum.Material.Air
			)
			ctx.terrain:FillBlock(
				CFrame.new(spot.X, GROUND_Y - 3, spot.Z),
				Vector3.new(CELL, 6, CELL),
				Enum.Material.Water
			)
		end
	end
	zone(ctx, { kind = "water", inner = from, outer = ctx.r2 + 40 })
	zone(ctx, { kind = "shore", inner = from - shoreWidth, outer = from })
end

-- The rickshaw at the end of the road in every ring 3 zone: a free ride home.
local function rickshawHome(ctx)
	local stand = Biomes.roadEnd(ctx.biome)
	ctx.plan.rickshaw = stand
	occupy(ctx, stand, 14, true)
	if not ctx.building then
		return
	end
	local cf = facing(stand)
	local side = cf * CFrame.new(11, 0, 0)
	Props.place("Rickshaw", side * CFrame.Angles(0, math.rad(90), 0), ctx.folder)
	local signCF = cf * CFrame.new(-11, 0, 0)
	Props.place("Signboard", signCF, ctx.folder)
	Props.text(ctx.folder, signCF, Props.anchor("Signboard", "Face", signCF), 5.2, 2.2, "RICKSHAW\nTO THE CHOWK")
	local pad = part(ctx, {
		Name = "RickshawHome",
		Size = Vector3.new(8, 0.4, 8),
		CFrame = side * CFrame.new(0, 0.3, 0),
		Color = rgb(255, 220, 120),
		Material = Enum.Material.Neon,
		Transparency = 0.4,
		CanCollide = false,
	}) :: Part
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "RickshawHome"
	prompt.ActionText = "Ride home"
	prompt.ObjectText = "Rickshaw to the Chowk"
	prompt.HoldDuration = 0.4
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = pad
end

---------------------------------------------------------------------------
-- The zones
---------------------------------------------------------------------------
local BUILDERS = {}

-------------------------------------------------------------------- Punjab
function BUILDERS.MangoBagh(ctx)
	ground(ctx, Enum.Material.Grass, Enum.Material.LeafyGrass, 0.3)
	-- tube wells with muddy puddles around them, and charpais in the shade
	for i, sf in { -0.55, 0.1, 0.65 } do
		local spot = at(ctx, 0.3 + (i % 2) * 0.35, sf)
		if isFree(ctx, spot, 12) then
			prop(ctx, "TubeWell", spot)
			pond(ctx, spot + Vector3.new(6, 0, 4), 9, 2, Enum.Material.Mud)
			zone(ctx, { kind = "mud", center = spot + Vector3.new(6, 0, 4), radius = 9 })
			occupy(ctx, spot, 12)
		end
	end
	scatter(ctx, "MangoTree", 34, { spacing = 9, scale = { 0.9, 1.2 }, avoid = { mud = true } })
	scatter(ctx, "KikarTree", 6, { spacing = 9 })
	scatter(ctx, "Charpai", 6, { spacing = 4 })
	scatter(ctx, { "Haystack", "Matka" }, 6, { spacing = 4 })
	for _ = 1, 4 do
		local spot = at(ctx, ctx.rng:NextNumber(0.2, 0.8), ctx.rng:NextNumber(-0.8, 0.8))
		if isFree(ctx, spot, 5) then
			animal(ctx, spot, rgb(50, 45, 45), 3, "Buffalo")
		end
	end
	local tank = landmark(ctx, "WaterTank", 0.8, -0.3, 10)
	climbAnchors(ctx, "WaterTank", tank, "Top", "Base", "TopStand")
	digChests(ctx, 2, { mud = true })
	eggSpots(ctx)
end

function BUILDERS.SarsonFields(ctx)
	ground(ctx, Enum.Material.Grass, Enum.Material.Mud, 0.08)
	-- muddy paths between the fields
	for _, rf in { 0.33, 0.66 } do
		for k = -6, 6 do
			local spot = at(ctx, rf, k / 6.5)
			if isFree(ctx, spot, 6, true) then
				pond(ctx, spot, 6, 2, Enum.Material.Mud)
				zone(ctx, { kind = "mud", center = spot, radius = 6 })
			end
		end
	end
	local fields = 0
	for row = 0, 2 do
		for col = -7, 7 do
			local spot = at(ctx, 0.16 + row * 0.33, col / 7.6)
			if isFree(ctx, spot, 11) and not inZone(ctx.plan, spot, { mud = true }) then
				prop(ctx, if (row + col) % 4 == 0 then "WheatField" else "SarsonField", spot, (col * 7) % 360)
				occupy(ctx, spot, 11)
				fields += 1
			end
		end
	end
	landmark(ctx, "TractorTrolley", 0.5, 0.45, 9, 20)
	for _, sf in { -0.6, 0.2, 0.75 } do
		landmark(ctx, "Scarecrow", 0.55, sf, 3)
	end
	landmark(ctx, "TubeWell", 0.85, -0.2, 5)
	scatter(ctx, { "KikarTree", "Poplar" }, 8, { spacing = 8, rMin = 0.85, rMax = 1 })
	local tank = landmark(ctx, "WaterTank", 0.9, 0.55, 10)
	climbAnchors(ctx, "WaterTank", tank, "Top", "Base", "TopStand")
	digChests(ctx, 2, { mud = true })
	eggSpots(ctx, { mud = true })
end

function BUILDERS.LahoreQila(ctx)
	ground(ctx, Enum.Material.Grass, Enum.Material.Brick, 0.06)
	-- the fort: a curved line of red walls with the gate where the road comes in
	local wallR = ctx.r1 + 80
	local road = Biomes.roads()
	local gateAngle = ctx.mid
	for _, r in road do
		if r.kind == "zone" and Biomes.at(r.a:Lerp(r.b, 0.5)) == ctx.biome then
			for t = 0, 1, 0.01 do
				local p = r.a:Lerp(r.b, t)
				if math.abs(Biomes.radiusOf(p) - wallR) < 2 then
					gateAngle = Biomes.angleOf(p)
				end
			end
		end
	end
	local gatePos = Biomes.polar(gateAngle, wallR)
	-- a moat in front of the walls, with a gap where the road crosses
	local moatR = wallR - 16
	for angle = ctx.mid - 38, ctx.mid + 38, 3 do
		local p = Biomes.polar(angle, moatR)
		if Biomes.roadDistance(p) > 6 then
			pond(ctx, p, 5, 4, Enum.Material.Water)
		end
	end
	zone(ctx, { kind = "water", inner = moatR - 4, outer = moatR + 4 })
	local gateCF = facing(onGround(ctx, gatePos))
	place(ctx, "QilaGate", gateCF)
	occupy(ctx, gatePos, 18, true)
	climbOn(ctx, "QilaGate", gateCF, "Top", Vector3.new(14, 0, -10))
	local step = math.deg(24 / wallR)
	for side = -1, 1, 2 do
		local angle = gateAngle + side * (math.deg(18 / wallR) + step / 2)
		while math.abs(Biomes.angleDiff(angle, ctx.mid)) < 36 do
			local p = Biomes.polar(angle, wallR)
			if Biomes.roadDistance(p) > 4 then
				place(ctx, "QilaWall", facing(onGround(ctx, p)))
			end
			occupy(ctx, p, 12, true)
			angle += side * step
		end
		local towerPos = Biomes.polar(angle, wallR)
		place(ctx, "QilaTower", facing(onGround(ctx, towerPos)))
		occupy(ctx, towerPos, 9, true)
	end
	-- inside the walls: pavilions and a garden
	for _, sf in { -0.35, 0.35 } do
		landmark(ctx, "Chhatri", 0.9, sf, 10)
	end
	scatter(ctx, "Poplar", 10, { spacing = 6, rMin = 0.82, rMax = 1 })
	scatter(ctx, { "Poplar", "MangoTree", "FlowerPatch" }, 14, { spacing = 6, rMax = 0.45 })
	rickshawHome(ctx)
	digChests(ctx, 2, { water = true })
	eggSpots(ctx, { water = true })
end

--------------------------------------------------------------------- Sindh
function BUILDERS.RailwayJunction(ctx)
	ground(ctx, Enum.Material.Ground, Enum.Material.Pavement, 0.15)
	local train = Biomes.TRAIN
	-- the curved track: two rails and sleepers
	local from, to = ctx.mid + train.from - 4, ctx.mid + train.to + 4
	local step = math.deg(16 / train.radius)
	local angle = from
	while angle < to do
		for _, offset in { -2.4, 2.4 } do
			local a, b = Biomes.polar(angle, train.radius + offset), Biomes.polar(angle + step, train.radius + offset)
			part(ctx, {
				Name = "Rail",
				Size = Vector3.new(0.5, 0.5, (b - a).Magnitude + 0.2),
				CFrame = CFrame.lookAt((a + b) / 2 + Vector3.new(0, 0.5, 0), b + Vector3.new(0, 0.5, 0)),
				Color = rgb(90, 90, 95),
				Material = Enum.Material.Metal,
			})
		end
		for k = 0, 1 do
			local a = Biomes.polar(angle + step * k / 2, train.radius)
			part(ctx, {
				Name = "Sleeper",
				Size = Vector3.new(7, 0.3, 1.2),
				CFrame = CFrame.lookAt(a + Vector3.new(0, 0.2, 0), Vector3.new(0, 0.2, 0)),
				Color = rgb(110, 80, 50),
				Material = Enum.Material.Wood,
			})
		end
		angle += step
	end
	zone(ctx, { kind = "track", inner = train.radius - 6, outer = train.radius + 6 })
	-- the station by the track, and the crossing light where the road crosses it
	local stationPos = Biomes.polar(ctx.mid - 24, train.radius - 20)
	local stationCF = CFrame.lookAt(onGround(ctx, stationPos), onGround(ctx, Biomes.polar(ctx.mid - 24, train.radius)))
	place(ctx, "RailwayStation", stationCF)
	sign(ctx, "RailwayStation", stationCF, "Sign", 9, 1.4, "JUNCTION")
	occupy(ctx, stationPos, 18, true)
	for _, r in Biomes.roads() do
		if r.kind == "zone" and Biomes.at(r.a:Lerp(r.b, 0.5)) == ctx.biome then
			for t = 0, 1, 0.005 do
				local p = r.a:Lerp(r.b, t)
				if math.abs(Biomes.radiusOf(p) - train.radius) < 1.5 then
					local post = p + (r.b - r.a).Unit:Cross(Vector3.yAxis) * 11
					part(ctx, {
						Name = "CrossingPost",
						Size = Vector3.new(0.6, 9, 0.6),
						CFrame = CFrame.new(post + Vector3.new(0, 4.5, 0)),
						Color = rgb(240, 240, 240),
					})
					part(ctx, {
						Name = "CrossingLight",
						Shape = Enum.PartType.Ball,
						Size = Vector3.one * 1.6,
						CFrame = CFrame.new(post + Vector3.new(0, 9.4, 0)),
						Color = rgb(80, 220, 80),
						Material = Enum.Material.Neon,
					})
					break
				end
			end
		end
	end
	-- the train itself: everyone's screen moves it along the track
	if ctx.building then
		local model = Props.place("Train", CFrame.new(Biomes.polar(ctx.mid + train.from, train.radius)), ctx.folder)
		model.Name = "Train"
		model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
		for _, p in model:GetDescendants() do
			if p:IsA("BasePart") then
				p.CanCollide = false
			end
		end
	end
	scatter(ctx, { "KikarTree", "Bench", "Lamppost" }, 10, { spacing = 5, avoid = { track = true } })
	scatter(ctx, { "PakoraStall", "FruitStall", "ChaiDhaba" }, 4, { spacing = 8, avoid = { track = true } })
	scatter(ctx, "Rickshaw", 3, { spacing = 6, avoid = { track = true } })
	digChests(ctx, 2, { track = true })
	eggSpots(ctx)
end

function BUILDERS.SahilBeach(ctx)
	ground(ctx, Enum.Material.Sand)
	wholeZone(ctx, "sand")
	sea(ctx, ctx.r2 - 52, 22)
	for i, sf in { -0.7, -0.35, 0.3, 0.65 } do
		landmark(ctx, ({ "BeachHutTeal", "BeachHutPink", "BeachHutYellow", "BeachHutTeal" })[i], 0.55, sf, 7)
	end
	scatter(ctx, "BeachUmbrella", 8, { spacing = 5, rMin = 0.3, rMax = 0.6 })
	scatter(ctx, "CoconutPalm", 16, { spacing = 6, rMax = 0.55 })
	scatter(ctx, "BeachRocks", 6, { spacing = 5, rMin = 0.55, rMax = 0.62 })
	scatter(ctx, { "GolaCart", "FruitStall" }, 3, { spacing = 6, rMax = 0.35 })
	for _ = 1, 4 do
		local spot = at(ctx, ctx.rng:NextNumber(0.15, 0.5), ctx.rng:NextNumber(-0.8, 0.8))
		if isFree(ctx, spot, 6) then
			prop(ctx, "Camel", spot, ctx.rng:NextNumber(0, 360))
			occupy(ctx, spot, 6)
		end
	end
	if ctx.building then
		for _, sf in { -0.5, 0.15, 0.55 } do
			local p = at(ctx, 0.93, sf)
			Props.place(
				"FishingBoat",
				CFrame.new(p.X, GROUND_Y - 0.6, p.Z) * CFrame.Angles(0, math.rad(sf * 90), 0),
				ctx.folder
			)
		end
	end
	local light = landmark(ctx, "Lighthouse", 0.68, -0.05, 10)
	climbAnchors(ctx, "Lighthouse", light, "Gallery", "Door", "GalleryStand")
	digChests(ctx, 3, { water = true, shore = true })
	eggSpots(ctx, { water = true })
end

function BUILDERS.KarachiPort(ctx)
	ground(ctx, Enum.Material.Concrete, Enum.Material.Asphalt, 0.3)
	sea(ctx, ctx.r2 - 22, 4)
	-- stacks of containers in rows
	local names = { "ContainerRed", "ContainerBlue", "ContainerYellow", "ContainerGreen" }
	for row = 0, 1 do
		for col = -6, 6 do
			local spot = at(ctx, 0.25 + row * 0.3, col / 6.8)
			if isFree(ctx, spot, 11) then
				local base = onGround(ctx, spot)
				local cf = facing(base) * CFrame.Angles(0, math.rad(90), 0)
				for level = 0, ctx.rng:NextInteger(0, 2) do
					place(ctx, names[ctx.rng:NextInteger(1, #names)], cf + Vector3.new(0, level * 8, 0))
				end
				occupy(ctx, spot, 11, true)
			end
		end
	end
	local cranes = {}
	for _, sf in { -0.45, 0.3 } do
		local spot = at(ctx, 0.86, sf)
		if isFree(ctx, spot, 10) then
			local cf = CFrame.lookAt(onGround(ctx, spot), onGround(ctx, spot) * 2)
			place(ctx, "PortCrane", cf)
			occupy(ctx, spot, 10, true)
			table.insert(cranes, cf)
		end
	end
	climbOn(ctx, "PortCrane", cranes[1], "Top", Vector3.new(0, 0, 9))
	if ctx.building then
		local p = at(ctx, 1.12, 0.05)
		local tangent = Biomes.polar(ctx.mid + 10, Biomes.radiusOf(p))
		Props.place(
			"CargoShip",
			CFrame.lookAt(Vector3.new(p.X, GROUND_Y - 2, p.Z), Vector3.new(tangent.X, GROUND_Y - 2, tangent.Z)),
			ctx.folder
		)
	end
	scatter(ctx, { "TruckArt", "Lamppost" }, 6, { spacing = 8, rMax = 0.7 })
	rickshawHome(ctx)
	digChests(ctx, 1, { water = true })
	eggSpots(ctx, { water = true })
end

---------------------------------------------------------------------- Thar
function BUILDERS.CamelMela(ctx)
	ground(ctx, Enum.Material.Sand, Enum.Material.Ground, 0.25)
	local tents = {}
	for i, sf in { -0.7, -0.4, -0.1, 0.25, 0.55, 0.8 } do
		local cf = landmark(ctx, "MelaTent", 0.35 + (i % 2) * 0.3, sf, 10)
		if cf then
			table.insert(tents, cf)
		end
	end
	for i = 1, #tents - 1 do
		bunting(ctx, tents[i].Position + Vector3.new(0, 12, 0), tents[i + 1].Position + Vector3.new(0, 12, 0))
	end
	for _ = 1, 9 do
		local spot = at(ctx, ctx.rng:NextNumber(0.1, 0.9), ctx.rng:NextNumber(-0.9, 0.9))
		if isFree(ctx, spot, 6) then
			prop(ctx, "Camel", spot, ctx.rng:NextNumber(0, 360))
			occupy(ctx, spot, 6)
		end
	end
	scatter(ctx, { "PakoraStall", "GolaCart", "FruitStall", "DesertTent" }, 6, { spacing = 8 })
	scatter(ctx, { "KikarDry", "DesertShrub" }, 10, { spacing = 6 })
	local tank = landmark(ctx, "WaterTank", 0.85, 0.05, 10)
	climbAnchors(ctx, "WaterTank", tank, "Top", "Base", "TopStand")
	digChests(ctx, 2)
	eggSpots(ctx)
end

function BUILDERS.TharDesert(ctx)
	ground(ctx, Enum.Material.Sand)
	wholeZone(ctx, "sand")
	wholeZone(ctx, "sandstorm")
	-- rolling dunes: big balls of sand sunk into the ground
	for _ = 1, 14 do
		local spot = at(ctx, ctx.rng:NextNumber(0.1, 0.95), ctx.rng:NextNumber(-0.9, 0.9))
		local radius = ctx.rng:NextNumber(12, 22)
		if isFree(ctx, spot, radius * 0.8) then
			hill(ctx, spot - Vector3.new(0, radius * 0.72, 0), radius, Enum.Material.Sand)
			occupy(ctx, spot, radius * 0.8)
		end
	end
	local fort = landmark(ctx, "DesertFort", 0.62, -0.1, 34)
	climbAnchors(ctx, "DesertFort", fort, "TowerTop", "TowerBase", "TowerStand")
	scatter(ctx, { "KikarDry", "DesertShrub", "DuneGrass", "RockMesa" }, 22, { spacing = 5 })
	for _ = 1, 3 do
		local spot = at(ctx, ctx.rng:NextNumber(0.2, 0.8), ctx.rng:NextNumber(-0.8, 0.8))
		if isFree(ctx, spot, 6) then
			prop(ctx, "Camel", spot, ctx.rng:NextNumber(0, 360))
			occupy(ctx, spot, 6)
		end
	end
	digChests(ctx, 3)
	eggSpots(ctx)
end

function BUILDERS.MohenjoDaro(ctx)
	ground(ctx, Enum.Material.Sand, Enum.Material.Ground, 0.4)
	wholeZone(ctx, "sand")
	wholeZone(ctx, "sandstorm")
	local bath = landmark(ctx, "GreatBath", 0.45, 0.25, 22)
	local mound = landmark(ctx, "RuinMound", 0.75, -0.35, 22)
	climbOn(ctx, "RuinMound", mound, "Top", Vector3.new(0, 0, -17))
	-- the old city's streets: rows of broken brick walls
	for row = 0, 3 do
		for col = -9, 9 do
			local spot = at(ctx, 0.12 + row * 0.25, col / 9.5)
			if ctx.rng:NextNumber() < 0.55 and isFree(ctx, spot, 7) then
				local name = if ctx.rng:NextNumber() < 0.5 then "RuinWallA" else "RuinWallB"
				prop(ctx, name, spot, (col * 90) % 360)
				occupy(ctx, spot, 7)
			end
		end
	end
	scatter(ctx, { "DesertShrub", "DuneGrass" }, 10, { spacing = 4 })
	if bath == nil then
		landmark(ctx, "GreatBath", 0.3, -0.5, 22)
	end
	rickshawHome(ctx)
	digChests(ctx, 3)
	eggSpots(ctx)
end

----------------------------------------------------------------------- KPK
function BUILDERS.QissaKhawani(ctx)
	ground(ctx, Enum.Material.Cobblestone, Enum.Material.Pavement, 0.3)
	-- two rows of tall houses with carved balconies over the street
	for row = 0, 1 do
		for col = -8, 8 do
			local spot = at(ctx, 0.12 + row * 0.76, col / 8.4)
			if isFree(ctx, spot, 9) then
				local inward = row == 0
				local name = if (col + row) % 2 == 0 then "QissaHouseA" else "QissaHouseB"
				local target = if inward then spot * 1.2 else spot * 0.8
				propFacing(ctx, name, spot, target)
				occupy(ctx, spot, 9, true)
			end
		end
	end
	local tower = landmark(ctx, "GhantaGhar", 0.5, -0.25, 9)
	climbOn(ctx, "GhantaGhar", tower, "Top", Vector3.new(0, 0, -8))
	for _, sf in { -0.6, 0.05, 0.6 } do
		landmark(ctx, "KahwaStall", 0.4, sf, 6)
	end
	landmark(ctx, "DryFruitStall", 0.6, 0.35, 7)
	local stage = landmark(ctx, "MelaStage", 0.55, 0.7, 14)
	if stage and ctx.building then
		part(ctx, {
			Name = "StorytellerCarpet",
			Size = Vector3.new(14, 0.2, 8),
			CFrame = stage * CFrame.new(0, 4.1, 0),
			Color = rgb(170, 30, 40),
			Material = Enum.Material.Fabric,
		})
	end
	scatter(ctx, { "Matka", "Charpai", "Bench", "Lamppost" }, 10, { spacing = 4, rMin = 0.25, rMax = 0.75 })
	digChests(ctx, 1)
	eggSpots(ctx)
end

function BUILDERS.NamakCaves(ctx)
	ground(ctx, Enum.Material.Salt, Enum.Material.Rock, 0.25)
	wholeZone(ctx, "dark")
	-- pink salt hills and rocks
	for _ = 1, 10 do
		local spot = at(ctx, ctx.rng:NextNumber(0.1, 0.95), ctx.rng:NextNumber(-0.9, 0.9))
		local radius = ctx.rng:NextNumber(9, 16)
		if isFree(ctx, spot, radius) then
			hill(ctx, spot - Vector3.new(0, radius * 0.5, 0), radius, Enum.Material.Salt)
			occupy(ctx, spot, radius, true)
		end
	end
	local entrance = landmark(ctx, "MineEntrance", 0.85, 0.1, 12)
	if entrance then
		sign(ctx, "MineEntrance", entrance, "Sign", 9, 1.6, "NAMAK CAVES")
	end
	for _, sf in { -0.5, 0.45 } do
		landmark(ctx, "CrystalCluster", 0.5, sf, 8)
	end
	scatter(ctx, { "SaltCrystals", "Stalagmites", "CaveSupport" }, 20, { spacing = 5 })
	scatter(ctx, { "MineCart" }, 3, { spacing = 6 })
	digChests(ctx, 3)
	eggSpots(ctx)
end

function BUILDERS.BarfaniPahar(ctx)
	ground(ctx, Enum.Material.Snow, Enum.Material.Glacier, 0.15)
	-- snowy mountains along the far edge
	for k = -6, 6 do
		local spot = at(ctx, 1.05, k / 6.5)
		hill(ctx, spot - Vector3.new(0, 6, 0), ctx.rng:NextNumber(18, 26), Enum.Material.Snow)
		occupy(ctx, spot, 18, true)
	end
	-- frozen lakes with eggs right in the middle of the ice
	for _, sf in { -0.55, 0.5 } do
		local spot = at(ctx, 0.45, sf)
		if isFree(ctx, spot, 22) then
			pond(ctx, spot, 20, 2, Enum.Material.Ice)
			zone(ctx, { kind = "ice", center = spot, radius = 20 })
			occupy(ctx, spot, 20)
		end
	end
	local caves = {}
	for _, sf in { -0.15, 0.2 } do
		local cave = landmark(ctx, "IceCave", 0.8, sf, 14)
		if cave then
			table.insert(caves, cave)
		end
	end
	if caves[1] then
		climbOn(ctx, "IceCave", caves[1], "Top", Vector3.new(16, 0, 0))
	end
	landmark(ctx, "MountainHut", 0.65, -0.75, 10)
	for _, sf in { -0.3, 0.05, 0.75 } do
		landmark(ctx, "Snowman", 0.25, sf, 4)
	end
	scatter(ctx, { "DeodarSnowy", "DeodarSnowy", "SnowRock", "Juniper" }, 26, { spacing = 6, avoid = { ice = true } })
	for _ = 1, 3 do
		local spot = at(ctx, ctx.rng:NextNumber(0.2, 0.7), ctx.rng:NextNumber(-0.8, 0.8))
		if isFree(ctx, spot, 5) and not inZone(ctx.plan, spot, { ice = true }) then
			animal(ctx, spot, rgb(60, 50, 45), 2.6, "Yak")
		end
	end
	rickshawHome(ctx)
	digChests(ctx, 2, { ice = true })
	eggSpots(ctx)
end

---------------------------------------------------------------------------
-- Public
---------------------------------------------------------------------------

-- Plans (and, with a folder, builds) every zone. Returns plans by zone id.
function BiomeBuilder.run(parent: Instance?): { [string]: Plan }
	local plans = {}
	for _, biome in Biomes.list do
		local folder = nil
		if parent then
			folder = Instance.new("Folder")
			folder.Name = biome.id
			folder.Parent = parent
		end
		local ctx = newContext(biome, folder)
		BUILDERS[biome.id](ctx)
		plans[biome.id] = ctx.plan
	end
	return plans
end

-- Is the position inside a hazard area of this kind?
function BiomeBuilder.inZone(plan: Plan, position: Vector3, kind: string): boolean
	return inZone(plan, position, { [kind] = true })
end

return BiomeBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Defenses</string>
          <string name="Source"><![CDATA[-- The Laser Darwaza: while a haveli with Level 3 or more is locked with the
-- Taala, its doorway physically blocks everyone except the owner.
--
-- Each haveli gets two collision groups: one for its laser and one for its
-- owner's character. They do not collide with each other, so only the owner
-- can walk through.

local PhysicsService = game:GetService("PhysicsService")

local Defenses = {}

local function laserGroup(index: number): string
	return "ChaiLaser" .. index
end

local function ownerGroup(index: number): string
	return "ChaiOwner" .. index
end

local function register(name: string)
	if not PhysicsService:IsCollisionGroupRegistered(name) then
		PhysicsService:RegisterCollisionGroup(name)
	end
end

local function setGroup(character: Model, group: string)
	for _, p in character:GetDescendants() do
		if p:IsA("BasePart") then
			p.CollisionGroup = group
		end
	end
end

function Defenses.init(map)
	for _, h in map.havelis do
		local laser, owner = laserGroup(h.index), ownerGroup(h.index)
		register(laser)
		register(owner)
		PhysicsService:CollisionGroupSetCollidable(laser, owner, false)
		h.barrier.CollisionGroup = laser
		h.barrier.CanCollide = false
	end
end

-- Put a player's character in their haveli's owner group (or back to Default).
-- Call when they claim or leave a haveli and every time their character spawns.
function Defenses.applyCharacter(profile)
	local character = profile.player.Character
	if not character then
		return
	end
	local group = if profile.haveli then ownerGroup(profile.haveli.index) else "Default"
	setGroup(character, group)
	if profile.groupConnection then
		profile.groupConnection:Disconnect()
	end
	profile.groupConnection = character.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("BasePart") then
			descendant.CollisionGroup = group
		end
	end)
end

function Defenses.setLaser(h, on: boolean)
	h.barrier.CanCollide = on
end

return Defenses
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">EggSystem</string>
          <string name="Source"><![CDATA[-- Eggs: they appear in the zones, players carry them home, and they hatch
-- into brainrots in the haveli's incubators.
--
-- * Each zone keeps a few eggs lying around; golden eggs are rare and luckier.
--   You can only pick up eggs in zones you have unlocked.
-- * Picking an egg up starts a countdown. Further zones have shorter ones.
--   Hazards knock time off. If it runs out, the egg cracks and is gone.
-- * On foot you carry one egg in your hands. In a vehicle, eggs go in the boot
--   (as many as its Egg Space).
-- * At your own haveli the countdown stops and the egg goes into a free
--   incubator. What hatches is rolled then, from the zone's pool and odds.
-- * A bonk with a chappal makes you drop an egg, and anyone can grab it.
-- * Every few minutes an egg rush fills one zone with extra eggs.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Config = require(Shared.Config)
local Brainrots = require(Shared.Brainrots)
local Biomes = require(Shared.Biomes)
local Events = require(Shared.Events)
local Gear = require(Shared.Gear)
local Mutations = require(Shared.Mutations)

local State = require(script.Parent.State)
local Models = require(script.Parent.Models)
local Havelis = require(script.Parent.Havelis)
local Picker = require(script.Parent.Picker)

local EggSystem = {}

local RARE_OR_BETTER = { Rare = true, Epic = true, Legendary = true, Mythic = true, Secret = true }
local GOLD = Color3.fromRGB(255, 205, 50)
local CARRY_OFFSET = CFrame.new(0, 0.4, 1.6)

local map = nil
local folder: Folder = nil
local eggs: { [Model]: any } = {} -- eggs lying on the ground
local live: { [string]: number } = {} -- natural eggs per biome

local function now(): number
	return workspace:GetServerTimeNow()
end

---------------------------------------------------------------------------
-- Egg models
---------------------------------------------------------------------------
local function eggModel(biome, golden: boolean): Model
	local model = Instance.new("Model")
	model.Name = if golden then "GoldenEgg" else biome.id .. "Egg"
	local shell = Instance.new("Part")
	shell.Name = "Shell"
	shell.Size = Vector3.new(2.6, 3.4, 2.6)
	shell.Color = if golden then GOLD else biome.eggColor
	shell.Material = if golden then Enum.Material.Foil else Enum.Material.SmoothPlastic
	shell.Anchored = true
	shell.CanCollide = false
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = shell
	shell.Parent = model
	model.PrimaryPart = shell
	for i = 1, 5 do
		local a = i * 1.3
		local h = -0.8 + (i % 3) * 0.7
		local rx = 1.3 * math.sqrt(math.max(0, 1 - (h / 1.7) ^ 2))
		local spot = Instance.new("Part")
		spot.Name = "Spot"
		spot.Shape = Enum.PartType.Ball
		spot.Size = Vector3.one * 0.7
		spot.Color = if golden then Color3.new(1, 1, 1) else biome.spotColor
		spot.Anchored = true
		spot.CanCollide = false
		spot.CFrame = CFrame.new(math.cos(a) * rx, h, math.sin(a) * rx)
		spot.Parent = model
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = shell
		weld.Part1 = spot
		weld.Parent = spot
	end

	local gui = Instance.new("BillboardGui")
	gui.Name = "EggGui"
	gui.Size = UDim2.fromScale(7, 1.6)
	gui.StudsOffset = Vector3.new(0, 3, 0)
	gui.MaxDistance = 70
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = if golden then GOLD else biome.eggColor
	label.Text = if golden then "GOLDEN EGG" else biome.name .. " Egg"
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = shell

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "EggPrompt"
	prompt.ActionText = "Pick up"
	prompt.ObjectText = if golden then "Golden " .. biome.name .. " Egg" else biome.name .. " Egg"
	prompt.HoldDuration = 0.25
	prompt.MaxActivationDistance = Config.PICKUP_DISTANCE
	prompt.RequiresLineOfSight = false
	prompt.Parent = shell

	if golden then
		local sparkles = Instance.new("ParticleEmitter")
		sparkles.Name = "GoldenSparkles"
		sparkles.Rate = 10
		sparkles.Lifetime = NumberRange.new(0.8, 1.4)
		sparkles.Speed = NumberRange.new(1, 3)
		sparkles.SpreadAngle = Vector2.new(180, 180)
		sparkles.Size = NumberSequence.new(0.5, 0)
		sparkles.LightEmission = 1
		sparkles.Color = ColorSequence.new(GOLD)
		sparkles.Parent = shell
		local glow = Instance.new("PointLight")
		glow.Color = GOLD
		glow.Range = 12
		glow.Brightness = 2
		glow.Parent = shell
	end
	model:SetAttribute("Biome", biome.id)
	model:SetAttribute("Golden", golden)
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	return model
end

local function setAnchored(model: Model, anchored: boolean)
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = anchored
			p.Massless = true
		end
	end
end

local function promptOf(model: Model): ProximityPrompt?
	local shell = model.PrimaryPart
	return shell and shell:FindFirstChild("EggPrompt") :: ProximityPrompt?
end

---------------------------------------------------------------------------
-- Spawning
---------------------------------------------------------------------------
local function freeSpot(plan): Vector3?
	for _ = 1, 12 do
		local spot = plan.eggSpots[math.random(#plan.eggSpots)]
		local taken = false
		for model in eggs do
			if model.PrimaryPart and (model.PrimaryPart.Position - spot).Magnitude < 6 then
				taken = true
				break
			end
		end
		if not taken then
			return spot
		end
	end
	return nil
end

function EggSystem.spawn(biome, golden: boolean?, position: Vector3?)
	local plan = map.biomes[biome.id]
	local spot = position or freeSpot(plan)
	if not spot then
		return nil
	end
	local isGolden = if golden == nil then math.random() < Config.GOLDEN_EGG_CHANCE else golden
	local model = eggModel(biome, isGolden)
	model:PivotTo(CFrame.new(spot + Vector3.new(0, 1.7, 0)))
	model.Parent = folder
	eggs[model] = { biome = biome, golden = isGolden, natural = true }
	live[biome.id] = (live[biome.id] or 0) + 1
	return model
end

local function target(biome): number
	local count = math.floor(Config.EGGS_PER_BIOME * Events.mult("eggMult"))
	if workspace:GetAttribute("EggRush") == biome.id then
		count += Config.EGG_RUSH_EGGS
	end
	return count
end

function EggSystem.refill(perBiome: number?)
	for _, biome in Biomes.list do
		for _ = 1, perBiome or 1 do
			if (live[biome.id] or 0) < target(biome) then
				EggSystem.spawn(biome)
			end
		end
	end
end

function EggSystem.startRush(biomeId: string?)
	local biome = Biomes.byId[biomeId or ""] or Biomes.list[math.random(#Biomes.list)]
	workspace:SetAttribute("EggRush", biome.id)
	workspace:SetAttribute("EggRushEndsAt", now() + Config.EGG_RUSH_DURATION)
	State.notifyAll(
		"rare",
		("EGG RUSH in %s! Lots of eggs for %d seconds!"):format(biome.name, Config.EGG_RUSH_DURATION)
	)
	State.soundAll("EventStart")
	EggSystem.refill(Config.EGG_RUSH_EGGS)
end

function EggSystem.stopRush()
	workspace:SetAttribute("EggRush", "")
end

---------------------------------------------------------------------------
-- Carrying
---------------------------------------------------------------------------
-- The HUD shows the egg that will crack first (in your hands or in the boot).
local function lead(profile)
	local best = profile.egg
	for _, egg in profile.boot do
		if not best or egg.timeLeft < best.timeLeft then
			best = egg
		end
	end
	return best
end

local function syncAttributes(profile)
	local player = profile.player
	local egg = lead(profile)
	player:SetAttribute("EggBiome", if egg then egg.biome.id else "")
	player:SetAttribute("EggGolden", if egg then egg.golden else false)
	player:SetAttribute("EggTimeLeft", if egg then math.max(0, math.floor(egg.timeLeft * 10) / 10) else 0)
	player:SetAttribute("EggTimeTotal", if egg then egg.total else 0)
	player:SetAttribute("EggCount", #profile.boot + (if profile.egg then 1 else 0))
	player:SetAttribute("BootEggs", #profile.boot)
end
EggSystem.syncAttributes = syncAttributes

local function endCarry(profile)
	local carry = profile.egg
	if not carry then
		return nil
	end
	profile.egg = nil
	for _, connection in carry.connections do
		connection:Disconnect()
	end
	local weld = carry.model.PrimaryPart and carry.model.PrimaryPart:FindFirstChild("CarryWeld")
	if weld then
		weld:Destroy()
	end
	syncAttributes(profile)
	return carry
end

-- Welds an egg into the vehicle's boot, in slot `slot`.
local function intoBoot(profile, record, slot: number)
	local drive = profile.driving
	local model = record.model
	local weld = model.PrimaryPart and model.PrimaryPart:FindFirstChild("CarryWeld")
	if weld then
		weld:Destroy()
	end
	setAnchored(model, false)
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			p.Massless = true
		end
	end
	model:PivotTo(drive.bootSpot(slot) * CFrame.new(0, 0, 0))
	local newWeld = Instance.new("WeldConstraint")
	newWeld.Name = "CarryWeld"
	newWeld.Part0 = drive.root
	newWeld.Part1 = model.PrimaryPart
	newWeld.Parent = model.PrimaryPart
	record.warned = false
end

local function takeFromBoot(profile, index: number)
	local record = table.remove(profile.boot, index)
	local weld = record.model.PrimaryPart and record.model.PrimaryPart:FindFirstChild("CarryWeld")
	if weld then
		weld:Destroy()
	end
	-- the rest shuffle up
	for slot, egg in profile.boot do
		intoBoot(profile, egg, slot)
	end
	syncAttributes(profile)
	return record
end

-- How long a fresh egg from this biome lasts for this player.
function EggSystem.eggTime(profile, biome, golden: boolean): number
	return biome.eggTime
		* Gear.best(profile.data.gear, "egg")
		* Events.mult("eggTimeMult")
		* (if golden then Config.GOLDEN_EGG_TIME else 1)
end

function EggSystem.isCarrying(player: Player): boolean
	local profile = State.profiles[player]
	return profile ~= nil and (profile.egg ~= nil or #profile.boot > 0)
end

function EggSystem.pickUp(player: Player, model: Model?)
	local profile = State.profiles[player]
	local egg = model and eggs[model]
	if not profile or not egg or not profile.haveli then
		return
	end
	if not State.isZoneOpen(profile, egg.biome) then
		State.notify(player, "bad", ("Unlock %s at its gate to collect its eggs!"):format(egg.biome.name))
		State.sound(player, "Error")
		return
	end
	local drive = profile.driving
	if drive and #profile.boot >= drive.space then
		State.notify(player, "bad", ("Your boot is full (%d eggs)! Take them home first."):format(drive.space))
		return
	end
	if not drive and profile.egg then
		State.notify(player, "bad", "You can only carry one egg at a time! A vehicle's boot holds more.")
		return
	end
	if profile.carryingBrainrot then
		State.notify(player, "bad", "Your hands are full with a stolen brainrot!")
		return
	end
	local root = State.rootPart(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if
		not root
		or not humanoid
		or not State.isNear(player, (model :: Model):GetPivot().Position, Config.PICKUP_DISTANCE + 4)
	then
		return
	end
	local m = model :: Model
	eggs[m] = nil
	if egg.natural then
		live[egg.biome.id] -= 1
	end
	local total = EggSystem.eggTime(profile, egg.biome, egg.golden)
	local timeLeft = egg.timeLeft or total

	local prompt = promptOf(m)
	if prompt then
		prompt.Enabled = false
	end
	if drive then
		local record = {
			model = m,
			biome = egg.biome,
			golden = egg.golden,
			timeLeft = timeLeft,
			total = total,
			warned = false,
		}
		table.insert(profile.boot, record)
		intoBoot(profile, record, #profile.boot)
		syncAttributes(profile)
		State.sound(player, "EggPickup")
		State.notify(
			player,
			"info",
			("Egg in the boot (%d/%d)! Drive it home before it cracks (%d seconds)."):format(
				#profile.boot,
				drive.space,
				math.floor(timeLeft)
			)
		)
		return
	end
	setAnchored(m, false)
	m:PivotTo(root.CFrame * CARRY_OFFSET)
	local weld = Instance.new("WeldConstraint")
	weld.Name = "CarryWeld"
	weld.Part0 = root
	weld.Part1 = m.PrimaryPart
	weld.Parent = m.PrimaryPart

	profile.egg = {
		model = m,
		biome = egg.biome,
		golden = egg.golden,
		timeLeft = timeLeft,
		total = total,
		warned = false,
		connections = {
			humanoid.Died:Connect(function()
				EggSystem.drop(player)
			end),
			player.CharacterRemoving:Connect(function()
				EggSystem.drop(player)
			end),
		},
	}
	syncAttributes(profile)
	State.sound(player, "EggPickup")
	State.notify(
		player,
		"info",
		("Got a %s! Run it home before it cracks (%d seconds)."):format(
			if egg.golden then "golden egg" else egg.biome.name .. " egg",
			math.floor(timeLeft)
		)
	)
end

-- Puts an egg on the ground where the player is; anyone can pick it up.
local function putDown(player: Player, carry, offset: Vector3?)
	local model = carry.model
	local root = State.rootPart(player)
	local spot = (if root then root.Position - Vector3.new(0, 1.2, 0) else model:GetPivot().Position)
		+ (offset or Vector3.zero)
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			p.Massless = false
		end
	end
	setAnchored(model, true)
	model:PivotTo(CFrame.new(spot))
	local prompt = promptOf(model)
	if prompt then
		prompt.Enabled = true
	end
	eggs[model] =
		{ biome = carry.biome, golden = carry.golden, natural = false, timeLeft = carry.timeLeft, droppedAt = now() }
end

-- Drops the egg in your hands (or, in a vehicle, one from the boot).
function EggSystem.drop(player: Player, reason: string?)
	local profile = State.profiles[player]
	if not profile then
		return
	end
	local carry = endCarry(profile)
	if not carry and #profile.boot > 0 then
		carry = takeFromBoot(profile, #profile.boot)
	end
	if not carry then
		return
	end
	putDown(player, carry)
	if reason == "bonk" then
		State.notify(player, "bad", "Bonk! You dropped an egg. Grab it back quick!")
	end
end

-- Getting in a vehicle: the egg in your hands goes in the boot.
function EggSystem.toBoot(profile)
	local drive = profile.driving
	if not drive or not profile.egg or #profile.boot >= drive.space then
		return
	end
	local carry = endCarry(profile)
	table.insert(profile.boot, carry)
	intoBoot(profile, carry, #profile.boot)
	syncAttributes(profile)
end

-- A hazard hit: the carried egg loses some time.
function EggSystem.hit(player: Player, seconds: number, message: string): boolean
	local profile = State.profiles[player]
	if not profile or (not profile.egg and #profile.boot == 0) then
		return false
	end
	if profile.egg then
		profile.egg.timeLeft -= seconds
	end
	for _, egg in profile.boot do
		egg.timeLeft -= seconds
	end
	syncAttributes(profile)
	State.notify(player, "bad", ("%s Your egg lost %d seconds."):format(message, seconds))
	return true
end

-- The egg in your hands cracks, or (with `bootIndex`) one in the boot.
local function crack(profile, bootIndex: number?)
	local carry = if bootIndex then takeFromBoot(profile, bootIndex) else endCarry(profile)
	if not carry then
		return
	end
	local position = carry.model:GetPivot().Position
	carry.model:Destroy()
	State.sound(profile.player, "EggCrack", position)
	State.notify(
		profile.player,
		"bad",
		"Oh no, your egg cracked! Faster vehicles and egg gear (Tokri, Thermos) help with far zones."
	)
end

---------------------------------------------------------------------------
-- Incubators and hatching
---------------------------------------------------------------------------
function EggSystem.incubatorCount(profile): number
	return Config.HAVELI_LEVELS[profile.data.level].incubators
end

local function freeIncubator(profile): number?
	for slot = 1, EggSystem.incubatorCount(profile) do
		if not profile.incubating[slot] then
			return slot
		end
	end
	return nil
end

local function nestCFrame(h, slot: number): CFrame
	return CFrame.new(h.incubators[slot].Position + Vector3.new(0, 2.2, 0))
end

-- Puts an egg (new or saved) into an incubator.
local function incubate(profile, slot: number, record)
	local h = profile.haveli
	local biome = Biomes.byId[record.biome]
	local model = record.model or eggModel(biome, record.golden)
	setAnchored(model, true)
	model:PivotTo(nestCFrame(h, slot))
	local prompt = promptOf(model)
	if prompt then
		prompt.Enabled = false
	end
	model.Parent = h.brainrotFolder
	record.model = model
	profile.incubating[slot] = record
end

-- What hatches: rolled when the egg goes into the incubator.
function EggSystem.roll(biome, golden: boolean)
	local luck = Events.mult("luckMult")
	local def = Picker.pick(biome.odds, biome.pool, luck * (if golden then Config.GOLDEN_EGG_LUCK else 1))
	local mutation = Mutations.roll(if golden then "golden" else "egg", luck)
	return def, mutation
end

local function deposit(profile, slot: number, bootIndex: number?)
	local carry = if bootIndex then takeFromBoot(profile, bootIndex) else endCarry(profile)
	if not carry then
		return
	end
	for _, p in carry.model:GetDescendants() do
		if p:IsA("BasePart") then
			p.Massless = false
		end
	end
	local biome = carry.biome
	local def, mutation = EggSystem.roll(biome, carry.golden)
	local seconds = biome.hatchTime * (if carry.golden then Config.GOLDEN_HATCH_TIME else 1) / Events.mult("hatchMult")
	incubate(profile, slot, {
		biome = biome.id,
		golden = carry.golden,
		id = def.id,
		mutation = mutation,
		hatchAt = os.time() + math.ceil(seconds),
		model = carry.model,
	})
	State.sound(profile.player, "EggHome")
	State.notify(profile.player, "good", ("Home safe! The egg hatches in %d seconds."):format(math.ceil(seconds)))
	State.track(profile, "eggHome")
	if carry.golden then
		State.track(profile, "goldenEgg")
	end
	if Events.current() then
		State.track(profile, "eventEgg")
	end
	State.trackBiome(profile, biome.id)
end

local function hatch(profile, slot: number)
	local record = profile.incubating[slot]
	profile.incubating[slot] = nil
	local h = profile.haveli
	local position = h.incubators[slot].Position
	if record.model then
		record.model:Destroy()
	end
	local def = Brainrots.byId[record.id]
	local model = Models.create(def, record.mutation)
	model:PivotTo(Models.stand(model, CFrame.new(position + Vector3.new(0, 0.6, 0))))
	local _, isNew = Havelis.adopt(profile, def, record.mutation, model, true)
	local name = Mutations.displayName(def, record.mutation)
	State.sound(profile.player, "EggHatch", position)
	State.notify(
		profile.player,
		if RARE_OR_BETTER[def.rarity] or record.mutation then "rare" else "good",
		("Your egg hatched: %s (%s)!%s"):format(name, def.rarity, if isNew then " NEW!" else "")
	)
	if RARE_OR_BETTER[def.rarity] then
		State.track(profile, "hatchRare")
	end
	if record.mutation then
		State.track(profile, "mutation")
	end
	if def.rarity == "Mythic" or def.rarity == "Secret" or record.mutation == "Rainbow" then
		State.notifyAll("rare", ("%s hatched a %s!"):format(profile.player.DisplayName, name))
	end
end

local function updateNests(profile)
	local h = profile.haveli
	if not h then
		return
	end
	local count = EggSystem.incubatorCount(profile)
	local t = os.time()
	for slot, label in h.incubatorLabels do
		local record = profile.incubating[slot]
		local text
		if slot > count then
			text = ""
		elseif not record then
			text = "Empty incubator"
		elseif t >= record.hatchAt then
			text = "Ready! Needs a free plot"
		else
			text = ("Hatching %ds"):format(record.hatchAt - t)
		end
		if label.Text ~= text then
			label.Text = text
		end
	end
end

-- Puts saved incubator eggs back after the player claims a haveli.
function EggSystem.restore(profile)
	profile.incubating = {}
	for _, saved in profile.data.incubators do
		local slot = saved.slot
		if
			Biomes.byId[saved.biome]
			and Brainrots.byId[saved.id]
			and slot <= EggSystem.incubatorCount(profile)
			and not profile.incubating[slot]
		then
			incubate(profile, slot, {
				biome = saved.biome,
				golden = saved.golden == true,
				id = saved.id,
				mutation = if Mutations.byId[saved.mutation or ""] then saved.mutation else nil,
				hatchAt = saved.hatchAt,
			})
		end
	end
	updateNests(profile)
end

function EggSystem.syncData(profile)
	if not profile.haveli then
		return
	end
	local list = {}
	for slot, record in profile.incubating do
		table.insert(list, {
			slot = slot,
			biome = record.biome,
			golden = record.golden,
			id = record.id,
			mutation = record.mutation,
			hatchAt = record.hatchAt,
		})
	end
	profile.data.incubators = list
end

-- Leaving: drop the carried egg; incubator eggs are already saved.
function EggSystem.release(profile)
	EggSystem.drop(profile.player)
	for _, record in profile.incubating do
		if record.model then
			record.model:Destroy()
		end
	end
	profile.incubating = {}
end

-- Naya Safar: carried and incubating eggs are gone.
function EggSystem.reset(profile)
	local carry = endCarry(profile)
	if carry then
		carry.model:Destroy()
	end
	while #profile.boot > 0 do
		takeFromBoot(profile, #profile.boot).model:Destroy()
	end
	for _, record in profile.incubating do
		if record.model then
			record.model:Destroy()
		end
	end
	profile.incubating = {}
	profile.data.incubators = {}
	updateNests(profile)
end

---------------------------------------------------------------------------
-- The boot
---------------------------------------------------------------------------
-- Driving home: eggs in the boot go into free incubators.
function EggSystem.deliverBoot(profile)
	while #profile.boot > 0 do
		local slot = freeIncubator(profile)
		if not slot then
			local first = profile.boot[1]
			if not first.warned then
				first.warned = true
				State.notify(profile.player, "bad", "Your incubators are full! The eggs wait in your boot.")
			end
			return
		end
		deposit(profile, slot, 1)
	end
end

-- Getting out: at home the eggs go in the incubators; anywhere else you take
-- one in your hands and the rest go on the ground (anyone can grab them).
function EggSystem.unloadBoot(profile, atHome: boolean)
	if #profile.boot == 0 then
		return
	end
	if atHome then
		EggSystem.deliverBoot(profile)
	end
	local player = profile.player
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local alive = humanoid ~= nil and humanoid.Health > 0
	local dropped = 0
	while #profile.boot > 0 do
		local record = takeFromBoot(profile, 1)
		local root = State.rootPart(player)
		if alive and not profile.egg and root and humanoid then
			setAnchored(record.model, false)
			record.model:PivotTo(root.CFrame * CARRY_OFFSET)
			local weld = Instance.new("WeldConstraint")
			weld.Name = "CarryWeld"
			weld.Part0 = root
			weld.Part1 = record.model.PrimaryPart
			weld.Parent = record.model.PrimaryPart
			record.connections = {
				humanoid.Died:Connect(function()
					EggSystem.drop(player)
				end),
				player.CharacterRemoving:Connect(function()
					EggSystem.drop(player)
				end),
			}
			profile.egg = record
		else
			dropped += 1
			putDown(player, record, Vector3.new(math.cos(dropped * 2) * 4, 0, math.sin(dropped * 2) * 4))
		end
	end
	syncAttributes(profile)
	if dropped > 0 and alive then
		State.notify(
			player,
			"bad",
			("You got out, so %d egg(s) fell out of the boot. Grab them quick!"):format(dropped)
		)
	end
end

local function nearHome(profile, position: Vector3): boolean
	local h = profile.haveli
	return h ~= nil
		and (
			Havelis.isInside(h, position)
			or ((position - h.doorOutside.Position) * Vector3.new(1, 0, 1)).Magnitude < Config.PARK_DISTANCE
		)
end

---------------------------------------------------------------------------
-- The loops
---------------------------------------------------------------------------
function EggSystem.tick(dt: number)
	for player, profile in State.profiles do
		local carry = profile.egg
		if carry then
			local root = State.rootPart(player)
			local h = profile.haveli
			if root and h and Havelis.isInside(h, root.Position) then
				local slot = freeIncubator(profile)
				if slot then
					deposit(profile, slot)
				elseif not carry.warned then
					carry.warned = true
					State.notify(player, "bad", "Your incubators are full! Wait for an egg to hatch.")
				end
			else
				carry.warned = false
				carry.timeLeft -= dt * (profile.eggDrain or 1)
				if carry.timeLeft <= 0 then
					crack(profile)
				end
			end
		end
		-- eggs in the boot count down too, except when you are home
		local root = State.rootPart(player)
		if #profile.boot > 0 and not (root and nearHome(profile, root.Position)) then
			for i = #profile.boot, 1, -1 do
				local egg = profile.boot[i]
				egg.timeLeft -= dt * (profile.eggDrain or 1)
				if egg.timeLeft <= 0 then
					crack(profile, i)
				end
			end
		end
		if profile.egg or #profile.boot > 0 then
			local egg = lead(profile)
			local shown = if egg then math.max(0, math.floor(egg.timeLeft * 10) / 10) else 0
			if player:GetAttribute("EggTimeLeft") ~= shown then
				syncAttributes(profile)
			end
		end
	end
	-- dropped eggs do not last forever
	local t = now()
	for model, egg in eggs do
		if egg.droppedAt and t - egg.droppedAt > Config.DROPPED_EGG_LIFETIME then
			eggs[model] = nil
			model:Destroy()
		end
	end
end

function EggSystem.hatchTick()
	local t = os.time()
	for _, profile in State.profiles do
		if profile.haveli then
			for slot = 1, Config.MAX_INCUBATORS do
				local record = profile.incubating[slot]
				if record and t >= record.hatchAt and Havelis.hasFreePlot(profile) then
					hatch(profile, slot)
				end
			end
			updateNests(profile)
		end
	end
end

function EggSystem.init(gameMap)
	map = gameMap
	folder = Instance.new("Folder")
	folder.Name = "ChaiChaosEggs"
	folder.Parent = workspace
	workspace:SetAttribute("EggRush", "")
	for _ = 1, Config.EGGS_PER_BIOME do
		EggSystem.refill(1)
	end
	task.spawn(function()
		while true do
			EggSystem.tick(task.wait(0.25))
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.5)
			EggSystem.hatchTick()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(Config.EGG_RESPAWN)
			EggSystem.refill(if workspace:GetAttribute("EggRush") ~= "" then 3 else 1)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(Config.EGG_RUSH_EVERY)
			EggSystem.startRush()
			task.wait(Config.EGG_RUSH_DURATION)
			EggSystem.stopRush()
		end
	end)
end

-- For tests and other modules: the eggs lying around.
function EggSystem.groundEggs()
	return eggs
end

return EggSystem
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">EventRunner</string>
          <string name="Source"><![CDATA[-- Runs the server events from Events.luau: the first one a few minutes after
-- the server starts, then one every 15-20 minutes, each lasting 5 minutes.
-- The running event is stored in workspace attributes so every script (and
-- every player's screen) can read it: EventId, EventEndsAt and NextEventAt.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Config = require(Shared.Config)
local Events = require(Shared.Events)

local State = require(script.Parent.State)
local World = require(script.Parent.World)

local EventRunner = {}

local lastId: string? = nil

local function now(): number
	return workspace:GetServerTimeNow()
end

function EventRunner.start(id: string)
	local event = Events.byId[id]
	if not event then
		return
	end
	lastId = id
	workspace:SetAttribute("EventId", id)
	workspace:SetAttribute("EventEndsAt", now() + Config.EVENT_DURATION)
	World.forceNight = event.night == true
	State.notifyAll("rare", ("EVENT: %s %s"):format(event.name, event.blurb))
	State.soundAll("EventStart")
end

function EventRunner.stop()
	local event = Events.current()
	workspace:SetAttribute("EventId", "")
	World.forceNight = false
	if event then
		State.notifyAll("info", event.name .. " is over. The next event is coming soon!")
	end
end

-- A random event, never the same one twice in a row.
function EventRunner.pick(): string
	local choices = {}
	for _, event in Events.list do
		if event.id ~= lastId then
			table.insert(choices, event.id)
		end
	end
	return choices[math.random(#choices)]
end

function EventRunner.init()
	workspace:SetAttribute("EventId", "")
	task.spawn(function()
		local gap = Config.FIRST_EVENT_DELAY
		while true do
			workspace:SetAttribute("NextEventAt", now() + gap)
			task.wait(gap)
			EventRunner.start(EventRunner.pick())
			task.wait(Config.EVENT_DURATION)
			EventRunner.stop()
			gap = math.random(Config.EVENT_GAP_MIN, Config.EVENT_GAP_MAX)
		end
	end)
end

return EventRunner
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Garage</string>
          <string name="Source"><![CDATA[-- Vehicles: buy them at the Gaari Showroom, upgrade them at Ustad's Workshop,
-- drive them out to the zones, fill up at petrol pumps and paint them.
--
-- * Driving: your vehicle appears under you and you sit in it. It is faster
--   than walking (each vehicle has its own top speed) and your friends can
--   hop on and ride along.
-- * Fuel: every stud you drive uses a stud of fuel. With an empty tank the
--   vehicle crawls at walking speed. Petrol pumps fill you up for rupees, and
--   parked vehicles fill up slowly for free while you are at your haveli.
-- * The boot: eggs you pick up while driving go in the boot (Egg Space). When
--   you drive home they go straight into your incubators and the vehicle parks.
-- * Grip: mud, sand and ice slow vehicles down (and ice makes them slide)
--   unless their tyres are good enough (see Vehicles.luau and Hazards.luau).
-- * Paint jobs (Robux, looks only) recolour the painted panels.
--
-- Vehicles and their upgrades are kept forever, even after a Naya Safar.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)
local Vehicles = require(Shared.Vehicles)

local State = require(script.Parent.State)
local Havelis = require(script.Parent.Havelis)
local Props = require(script.Parent.Props)
local Upgrades = require(script.Parent.Upgrades)
local EggSystem = require(script.Parent.EggSystem)

local Garage = {}

local SEAT_LIFT = 1.1 -- a sitting character's middle is this far above the seat
local HOME_REFILL_RANGE = 40 -- parked vehicles refill while you are this close to your door
local PHOOL_PATTI = {
	Color3.fromRGB(230, 50, 60),
	Color3.fromRGB(250, 190, 40),
	Color3.fromRGB(40, 170, 90),
	Color3.fromRGB(50, 120, 230),
	Color3.fromRGB(235, 90, 180),
	Color3.fromRGB(250, 130, 30),
}
local CHAMAK = { Color3.fromRGB(80, 255, 200), Color3.fromRGB(255, 80, 220), Color3.fromRGB(120, 180, 255) }

local map = nil

local function modelName(def): string
	return "Vehicle" .. def.id
end

---------------------------------------------------------------------------
-- Syncing to the player's screen
---------------------------------------------------------------------------
-- "Motorbike:2:1:0:0:1450,...": each vehicle's upgrade levels (speed, tank,
-- eggs, grip) and its fuel, for the Garage, Showroom and Workshop windows.
function Garage.sync(profile)
	local data = profile.data
	local list = {}
	for _, def in Vehicles.list do
		local e = data.vehicles[def.id]
		if e then
			table.insert(
				list,
				("%s:%d:%d:%d:%d:%d"):format(def.id, e.speed, e.tank, e.eggs, e.grip, math.floor(e.fuel))
			)
		end
	end
	local paints = {}
	for id in data.paints do
		table.insert(paints, id)
	end
	table.sort(paints)
	local player = profile.player
	player:SetAttribute("Vehicles", table.concat(list, ","))
	player:SetAttribute("Paint", data.paint)
	player:SetAttribute("Paints", table.concat(paints, ","))
	Garage.syncDrive(profile)
end

-- The vehicle you are driving: its fuel, boot and grip, for the HUD.
function Garage.syncDrive(profile)
	local drive = profile.driving
	local player = profile.player
	player:SetAttribute("Driving", if drive then drive.def.id else "")
	if drive then
		player:SetAttribute("Fuel", math.floor(drive.entry.fuel))
		player:SetAttribute("FuelMax", drive.tank)
		player:SetAttribute("BootSpace", drive.space)
		player:SetAttribute("Grip", drive.grip)
	end
	player:SetAttribute("BootEggs", #profile.boot)
end

---------------------------------------------------------------------------
-- Paint jobs
---------------------------------------------------------------------------
function Garage.paint(model: Model, paintId: string)
	local panels = {}
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") and p.Name == "Paint" then
			table.insert(panels, p)
		end
	end
	for i, p in panels do
		if p:GetAttribute("FactoryColor") == nil then
			p:SetAttribute("FactoryColor", p.Color)
			p:SetAttribute("FactoryMaterial", p.Material.Name)
		end
		p:SetAttribute("Tint", nil)
		p.Color = p:GetAttribute("FactoryColor")
		p.Material = (Enum.Material :: any)[p:GetAttribute("FactoryMaterial")]
		if paintId == "PhoolPatti" then
			p.Color = PHOOL_PATTI[i % #PHOOL_PATTI + 1]
			p.Material = Enum.Material.SmoothPlastic
		elseif paintId == "Sona" then
			p.Color = Color3.fromRGB(255, 200, 60)
			p.Material = Enum.Material.Foil
		elseif paintId == "Rangeela" then
			p:SetAttribute("Tint", true) -- the colour changes on everyone's screen (Driving.client.luau)
			p.Material = Enum.Material.SmoothPlastic
		elseif paintId == "Chamak" then
			p.Color = CHAMAK[i % #CHAMAK + 1]
			p.Material = Enum.Material.Neon
		end
	end
	model:SetAttribute("Paint", paintId)
end

function Garage.setPaint(player: Player, paintId: any)
	local profile = State.profiles[player]
	if not profile or type(paintId) ~= "string" or not Vehicles.paintById[paintId] then
		return
	end
	if paintId ~= "Factory" and not profile.data.paints[paintId] then
		return
	end
	profile.data.paint = paintId
	if profile.driving then
		Garage.paint(profile.driving.model, paintId)
	end
	Garage.sync(profile)
end

-- Called by Shop.luau when a Robux paint job is bought.
function Garage.onPaintBought(profile, paintId: string)
	profile.data.paints[paintId] = true
	profile.data.paint = paintId
	if profile.driving then
		Garage.paint(profile.driving.model, paintId)
	end
	Garage.sync(profile)
end

---------------------------------------------------------------------------
-- Buying and upgrading
---------------------------------------------------------------------------
function Garage.buy(player: Player, id: any)
	local profile = State.profiles[player]
	local def = type(id) == "string" and Vehicles.byId[id]
	if not profile or not def or not Upgrades.atShop(player, "Showroom") then
		return
	end
	local data = profile.data
	if data.vehicles[def.id] then
		return
	end
	if data.rupees < def.cost then
		State.notify(player, "bad", ("The %s costs %s."):format(def.name, Format.rupees(def.cost)))
		State.sound(player, "Error")
		return
	end
	State.addRupees(profile, -def.cost)
	local entry = { fuel = def.tank, speed = 0, tank = 0, eggs = 0, grip = 0 }
	data.vehicles[def.id] = entry
	data.vehicle = def.id
	Garage.sync(profile)
	State.sound(player, "Purchase")
	State.track(profile, "vehicle")
	State.notify(player, "good", ("You bought a %s! Press Gaari to drive it."):format(def.name))
end

-- Works out a vehicle's stats from its upgrades (when you get in, or upgrade it).
local function refreshStats(profile)
	local drive = profile.driving
	if not drive then
		return
	end
	local levels = Vehicles.levels(drive.entry)
	drive.topSpeed = Vehicles.speed(drive.def, levels)
	drive.tank = Vehicles.tank(drive.def, levels)
	drive.space = Vehicles.eggs(drive.def, levels)
	drive.grip = Vehicles.grip(drive.def, levels)
	drive.empty = drive.entry.fuel <= 0
	drive.model:SetAttribute("Grip", drive.grip)
	Havelis.applyWalkSpeed(profile)
end

function Garage.upgrade(player: Player, id: any, upgradeId: any)
	local profile = State.profiles[player]
	local def = type(id) == "string" and Vehicles.byId[id]
	local upgrade = type(upgradeId) == "string" and Vehicles.upgradeById[upgradeId]
	if not profile or not def or not upgrade or not Upgrades.atShop(player, "Workshop") then
		return
	end
	local entry = profile.data.vehicles[def.id]
	if not entry then
		State.notify(player, "bad", ("Buy the %s at the Gaari Showroom first."):format(def.name))
		return
	end
	local level = entry[upgrade.id] + 1
	if level > Vehicles.maxLevel(def, upgrade.id) then
		State.notify(player, "info", ("Your %s's %s is as good as it gets!"):format(def.name, upgrade.name))
		return
	end
	local cost = Vehicles.upgradeCost(def, upgrade.id, level)
	if profile.data.rupees < cost then
		State.notify(player, "bad", ("That upgrade costs %s."):format(Format.rupees(cost)))
		State.sound(player, "Error")
		return
	end
	State.addRupees(profile, -cost)
	entry[upgrade.id] = level
	if profile.driving and profile.driving.def == def then
		refreshStats(profile)
	end
	Garage.sync(profile)
	State.sound(player, "Upgrade")
	State.notify(player, "good", ("%s %s is now level %d. %s!"):format(def.name, upgrade.name, level, upgrade.text))
end

---------------------------------------------------------------------------
-- Driving
---------------------------------------------------------------------------
local function setMassless(character: Model, massless: boolean)
	for _, p in character:GetDescendants() do
		if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
			p.Massless = massless
		end
	end
end

local function anchorOr(name: string, anchor: string): Vector3?
	local ok, point = pcall(Props.anchor, name, anchor, CFrame.new())
	return if ok then point else nil
end

-- Where egg number `slot` rides in the boot (in the vehicle's own space).
function Garage.bootSpot(drive, slot: number): CFrame
	local name = modelName(drive.def)
	local point = anchorOr(name, "Boot" .. slot)
	if not point then
		local last, count = Vector3.new(0, 3, 2), 0
		for k = 1, 12 do
			local p = anchorOr(name, "Boot" .. k)
			if p then
				last, count = p, k
			end
		end
		point = last + Vector3.new(0, 3 * (slot - count), 0)
	end
	return drive.root.CFrame * CFrame.new(point - drive.seat + Vector3.new(0, 1.7, 0))
end

local function inAnyHaveli(position: Vector3): boolean
	for _, h in map.havelis do
		if Havelis.isInside(h, position) then
			return true
		end
	end
	return false
end

function Garage.atHome(profile, position: Vector3): boolean
	local h = profile.haveli
	if not h then
		return false
	end
	return Havelis.isInside(h, position)
		or ((position - h.doorOutside.Position) * Vector3.new(1, 0, 1)).Magnitude < Config.PARK_DISTANCE
end

-- Get out: your friends hop off, eggs in the boot come out (into your
-- incubators if you are home), and the vehicle goes back to the garage.
function Garage.park(profile)
	local drive = profile.driving
	if not drive then
		return
	end
	local root = State.rootPart(profile.player)
	EggSystem.unloadBoot(profile, root ~= nil and Garage.atHome(profile, root.Position))
	for _, connection in drive.connections do
		connection:Disconnect()
	end
	for _, seat in drive.seats do
		local occupant = seat.Occupant
		if occupant then
			occupant.Sit = false
			local weld = seat:FindFirstChild("SeatWeld")
			if weld then
				weld:Destroy()
			end
			if occupant.Parent then
				setMassless(occupant.Parent :: Model, false)
			end
		end
	end
	drive.model:Destroy()
	profile.driving = nil
	profile.surfaceSpeed = nil
	local character = profile.player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and profile.baseHipHeight then
		humanoid.HipHeight = profile.baseHipHeight
	end
	Havelis.applyWalkSpeed(profile)
	Garage.syncDrive(profile)
end

-- Get in and drive vehicle `id`, or park with nil.
function Garage.drive(player: Player, id: any)
	local profile = State.profiles[player]
	if not profile or not profile.haveli then
		return
	end
	if id == nil then
		Garage.park(profile)
		return
	end
	local def = type(id) == "string" and Vehicles.byId[id]
	local entry = def and profile.data.vehicles[def.id]
	if not def or not entry then
		State.notify(player, "bad", "Buy a vehicle at the Gaari Showroom in the bazaar first!")
		return
	end
	if profile.carryingBrainrot then
		State.notify(player, "bad", "You can't drive while carrying a brainrot!")
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = State.rootPart(player)
	if not character or not humanoid or humanoid.Health <= 0 or not root then
		return
	end
	if humanoid.SeatPart then
		State.notify(player, "bad", "Hop off first!")
		return
	end
	if inAnyHaveli(root.Position) then
		State.notify(player, "bad", "Step outside to get in your vehicle!")
		return
	end
	if profile.driving then
		if profile.driving.def == def then
			return
		end
		if #profile.boot > 0 then
			State.notify(player, "bad", "Take the eggs in your boot home before you swap vehicles!")
			return
		end
		Garage.park(profile)
	end

	-- build the vehicle (always from parts, so paint jobs work) around its seat
	local name = modelName(def)
	local model = Props.place(name, CFrame.new(), nil, 1, { parts = true, noColliders = true })
	model.Name = "Vehicle"
	local seat = Props.anchor(name, "Seat", CFrame.new())
	local vehicleRoot = Instance.new("Part")
	vehicleRoot.Name = "VehicleRoot"
	vehicleRoot.Size = Vector3.one
	vehicleRoot.Transparency = 1
	vehicleRoot.CFrame = CFrame.new(seat)
	vehicleRoot.Parent = model
	model.PrimaryPart = vehicleRoot
	local seats = {}
	for k = 1, def.seats do
		local point = anchorOr(name, "Seat" .. k)
		if point then
			local s = Instance.new("Seat")
			s.Name = "PassengerSeat"
			s.Size = Vector3.new(1.6, 0.4, 1.6)
			s.CFrame = CFrame.new(point + Vector3.new(0, 0.2, 0))
			s.Transparency = 1
			s.CanTouch = false -- nobody sits by bumping into it; they use the prompt
			s.Parent = model
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "RideAlong"
			prompt.ActionText = "Ride along"
			prompt.ObjectText = ("%s's %s"):format(player.DisplayName, def.name)
			prompt.MaxActivationDistance = 10
			prompt.RequiresLineOfSight = false
			prompt:SetAttribute("OwnerId", player.UserId)
			prompt.Parent = s
			table.insert(seats, s)
		end
	end
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = false
			p.CanCollide = false
			p.CanTouch = false
			p.Massless = true
			if p ~= vehicleRoot then
				local weld = Instance.new("WeldConstraint")
				weld.Name = "Hold"
				weld.Part0 = vehicleRoot
				weld.Part1 = p
				weld.Parent = p
			end
		end
	end
	Garage.paint(model, profile.data.paint)

	-- sit the driver on the seat: raise them so the wheels touch the ground
	profile.baseHipHeight = profile.baseHipHeight or humanoid.HipHeight
	local rootHalf = root.Size.Y / 2
	local legs = if humanoid.RigType == Enum.HumanoidRigType.R15 then 0 else 2
	local standing = legs + profile.baseHipHeight + rootHalf
	humanoid.HipHeight = profile.baseHipHeight + (seat.Y + SEAT_LIFT - standing)
	model:PivotTo(root.CFrame * CFrame.new(0, -SEAT_LIFT, 0))
	local weld = Instance.new("WeldConstraint")
	weld.Name = "VehicleWeld"
	weld.Part0 = root
	weld.Part1 = vehicleRoot
	weld.Parent = vehicleRoot
	model:SetAttribute("Owner", player.UserId)
	CollectionService:AddTag(model, "ChaiVehicle")
	model.Parent = character

	profile.driving = {
		def = def,
		entry = entry,
		model = model,
		root = vehicleRoot,
		seat = seat,
		seats = seats,
		lastPos = root.Position,
		leftHome = not Garage.atHome(profile, root.Position),
		connections = {
			humanoid.Died:Connect(function()
				Garage.park(profile)
			end),
		},
		topSpeed = 0,
		tank = 0,
		space = 0,
		grip = 0,
		empty = false,
	}
	local drive = profile.driving
	drive.bootSpot = function(slot: number): CFrame
		return Garage.bootSpot(drive, slot)
	end
	profile.data.vehicle = def.id
	refreshStats(profile)
	EggSystem.toBoot(profile)
	Garage.syncDrive(profile)
	State.sound(player, "Upgrade")
	if profile.driving.empty then
		State.notify(player, "bad", "Your tank is empty! Fill up at a petrol pump.")
	end
end

-- A friend hops on (the RideAlong prompt on a passenger seat).
function Garage.rideAlong(player: Player, seat: Instance?)
	local profile = State.profiles[player]
	if not profile or not seat or not seat:IsA("Seat") or seat.Occupant then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 or humanoid.SeatPart or profile.driving or profile.carryingBrainrot then
		return
	end
	local owner = seat.Parent and seat.Parent:GetAttribute("Owner")
	if owner == player.UserId then
		return
	end
	setMassless(character :: Model, true) -- so the driver's vehicle does not slow down
	seat:Sit(humanoid)
	local connection
	connection = seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		if seat.Occupant ~= humanoid then
			connection:Disconnect()
			if character and character.Parent then
				setMassless(character :: Model, false)
			end
		end
	end)
end

---------------------------------------------------------------------------
-- Petrol pumps
---------------------------------------------------------------------------
function Garage.refuel(player: Player, pad: Instance?)
	local profile = State.profiles[player]
	if not profile or not pad or not pad:IsA("BasePart") then
		return
	end
	if not State.isNear(player, pad.Position, Config.PUMP_DISTANCE + 8) then
		return
	end
	local drive = profile.driving
	if not drive then
		State.notify(player, "info", "Drive your vehicle up to the pump to fill up.")
		return
	end
	local missing = drive.tank - drive.entry.fuel
	if missing < 1 then
		State.notify(player, "info", "Your tank is already full!")
		return
	end
	local cost = math.ceil(missing * Config.FUEL_PRICE)
	local amount = missing
	if profile.data.rupees < cost then
		amount = math.floor(profile.data.rupees / Config.FUEL_PRICE)
		cost = math.ceil(amount * Config.FUEL_PRICE)
		if amount < 1 then
			State.notify(player, "bad", "You don't have enough rupees for petrol!")
			State.sound(player, "Error")
			return
		end
	end
	State.addRupees(profile, -cost)
	drive.entry.fuel = math.min(drive.tank, drive.entry.fuel + amount)
	refreshStats(profile)
	Garage.syncDrive(profile)
	State.sound(player, "Purchase")
	State.notify(
		player,
		"good",
		("Filled up for %s. Range: %d studs."):format(Format.rupees(cost), math.floor(drive.entry.fuel))
	)
end

---------------------------------------------------------------------------
-- The loop: fuel, parking at home and free refills
---------------------------------------------------------------------------
function Garage.tick(dt: number)
	for player, profile in State.profiles do
		local root = State.rootPart(player)
		local drive = profile.driving
		if drive and root then
			local position = root.Position
			local moved = ((position - drive.lastPos) * Vector3.new(1, 0, 1)).Magnitude
			drive.lastPos = position
			-- a rickshaw ride home or a respawn is not driving
			if moved < drive.topSpeed * dt * 2 + 8 then
				drive.entry.fuel = math.max(0, drive.entry.fuel - moved)
			end
			local empty = drive.entry.fuel <= 0
			if empty ~= drive.empty then
				drive.empty = empty
				Havelis.applyWalkSpeed(profile)
				if empty then
					State.sound(player, "Error")
					State.notify(
						player,
						"bad",
						("Out of petrol! Your %s crawls at walking speed. Find a petrol pump."):format(drive.def.name)
					)
				end
			end
			if math.floor(drive.entry.fuel) ~= player:GetAttribute("Fuel") then
				player:SetAttribute("Fuel", math.floor(drive.entry.fuel))
			end
			-- drove home: eggs go in the incubators, then the vehicle parks
			local home = Garage.atHome(profile, position)
			if not home then
				drive.leftHome = true
			elseif drive.leftHome then
				EggSystem.deliverBoot(profile)
				if #profile.boot == 0 then
					Garage.park(profile)
					Garage.sync(profile)
				end
			end
		elseif root and profile.haveli then
			-- parked vehicles fill up for free while you are home
			local near = ((root.Position - profile.haveli.doorOutside.Position) * Vector3.new(1, 0, 1)).Magnitude
			if near < HOME_REFILL_RANGE or Havelis.isInside(profile.haveli, root.Position) then
				local changed = false
				for id, entry in profile.data.vehicles do
					local tank = Vehicles.tank(Vehicles.byId[id], Vehicles.levels(entry))
					if entry.fuel < tank then
						entry.fuel = math.min(tank, entry.fuel + Config.FUEL_HOME_REFILL * dt)
						changed = true
					end
				end
				local t = os.clock()
				if changed and t - (profile.vehicleSyncAt or 0) > 1 then
					profile.vehicleSyncAt = t
					Garage.sync(profile)
				end
			end
		end
	end
end

-- A new character: the old vehicle went with the old character.
function Garage.reset(profile)
	if profile.driving then
		Garage.park(profile)
	end
	profile.baseHipHeight = nil
end

function Garage.init(gameMap)
	map = gameMap
	Remotes.BuyVehicle.OnServerEvent:Connect(Garage.buy)
	Remotes.UpgradeVehicle.OnServerEvent:Connect(Garage.upgrade)
	Remotes.Drive.OnServerEvent:Connect(Garage.drive)
	Remotes.SetPaint.OnServerEvent:Connect(Garage.setPaint)
	task.spawn(function()
		while true do
			Garage.tick(task.wait(0.25))
		end
	end)
end

return Garage
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">HaveliStyle</string>
          <string name="Source"><![CDATA[-- Paints a haveli in its owner's theme and adds decorations for its level.
--
-- Level 1: lanterns by the door and a little decor in the courtyard
-- Level 2: more courtyard decor
-- Level 4: the garden (the theme's third decoration everywhere)
-- Level 5: the second floor opens and gets decorations
-- Level 6: the Chowkidar stands guard by the door
-- Level 8: the rooftop with chhatris and kites
-- Level 9: golden fairy lights along the walls

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Config = require(Shared.Config)
local Themes = require(Shared.Themes)

local MapBuilder = require(script.Parent.MapBuilder)

local HaveliStyle = {}

local part = MapBuilder.part
local UP = CFrame.Angles(0, 0, math.rad(90))

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local BRIGHT = {
	rgb(255, 70, 90),
	rgb(255, 205, 40),
	rgb(70, 210, 110),
	rgb(70, 160, 255),
	rgb(255, 120, 220),
	rgb(255, 150, 40),
}

local function material(name: string): Enum.Material
	return (Enum.Material :: any)[name]
end

-- Small decoration parts never collide and cast no shadow.
local function deco(props: { [string]: any }): Part
	props.CanCollide = props.CanCollide or false
	props.CastShadow = false
	return part(props)
end

---------------------------------------------------------------------------
-- Decorations. Each takes (folder, cf, theme) where cf stands on the floor.
---------------------------------------------------------------------------
local DECOR = {}

function DECOR.lantern(folder, cf, theme)
	deco({
		Name = "Post",
		Size = Vector3.new(0.5, 6, 0.5),
		CFrame = cf * CFrame.new(0, 3, 0),
		Color = theme.trim,
		Parent = folder,
	})
	local lamp = deco({
		Name = "Lantern",
		Size = Vector3.new(1.4, 1.8, 1.4),
		CFrame = cf * CFrame.new(0, 6.6, 0),
		Color = rgb(255, 210, 110),
		Material = Enum.Material.Neon,
		Parent = folder,
	})
	deco({
		Name = "Cap",
		Size = Vector3.new(1.8, 0.4, 1.8),
		CFrame = cf * CFrame.new(0, 7.7, 0),
		Color = theme.accent,
		Parent = folder,
	})
	local light = Instance.new("PointLight")
	light.Color = rgb(255, 210, 140)
	light.Range = 14
	light.Brightness = 1.4
	light.Parent = lamp
end

function DECOR.planter(folder, cf, theme)
	deco({
		Name = "Pot",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.6, 2.4, 2.4),
		CFrame = cf * CFrame.new(0, 0.8, 0) * UP,
		Color = theme.trim,
		Parent = folder,
	})
	for i = 1, 5 do
		local angle = i * math.pi * 2 / 5
		deco({
			Name = "Flower",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.9,
			CFrame = cf * CFrame.new(math.cos(angle) * 0.7, 2.1 + (i % 2) * 0.3, math.sin(angle) * 0.7),
			Color = BRIGHT[i],
			Parent = folder,
		})
	end
	deco({
		Name = "Leaves",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 1.6,
		CFrame = cf * CFrame.new(0, 1.8, 0),
		Color = rgb(70, 175, 80),
		Parent = folder,
	})
end

function DECOR.fountain(folder, cf, theme)
	deco({
		Name = "Basin",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.2, 5, 5),
		CFrame = cf * CFrame.new(0, 0.6, 0) * UP,
		Color = theme.wall,
		Material = Enum.Material.Marble,
		CanCollide = true,
		Parent = folder,
	})
	deco({
		Name = "Water",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, 4.3, 4.3),
		CFrame = cf * CFrame.new(0, 1.15, 0) * UP,
		Color = rgb(80, 185, 255),
		Material = Enum.Material.Neon,
		Transparency = 0.3,
		Parent = folder,
	})
	deco({
		Name = "Top",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 1.2,
		CFrame = cf * CFrame.new(0, 2.4, 0),
		Color = theme.accent,
		Parent = folder,
	})
end

function DECOR.tree(folder, cf, _theme)
	deco({
		Name = "Trunk",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(5, 1.2, 1.2),
		CFrame = cf * CFrame.new(0, 2.5, 0) * UP,
		Color = rgb(140, 95, 60),
		Material = Enum.Material.Wood,
		Parent = folder,
	})
	for i, offset in { Vector3.new(0, 6, 0), Vector3.new(1.2, 5.2, 0.6), Vector3.new(-1, 5.4, -0.8) } do
		deco({
			Name = "Leaves",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * (3.6 - i * 0.4),
			CFrame = cf * CFrame.new(offset),
			Color = if i == 1 then rgb(80, 190, 90) else rgb(100, 210, 100),
			Parent = folder,
		})
	end
	deco({
		Name = "Fruit",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 0.6,
		CFrame = cf * CFrame.new(1.4, 5.8, -1),
		Color = rgb(255, 150, 30),
		Parent = folder,
	})
end

function DECOR.hedge(folder, cf, _theme)
	deco({
		Name = "Hedge",
		Size = Vector3.new(5, 1.8, 1.6),
		CFrame = cf * CFrame.new(0, 0.9, 0),
		Color = rgb(70, 170, 80),
		Material = Enum.Material.Grass,
		Parent = folder,
	})
	for i = -2, 2 do
		deco({
			Name = "Bloom",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.7,
			CFrame = cf * CFrame.new(i * 1, 1.9, 0),
			Color = BRIGHT[(i + 3) % #BRIGHT + 1],
			Parent = folder,
		})
	end
end

function DECOR.bells(folder, cf, theme)
	deco({
		Name = "Bar",
		Size = Vector3.new(6, 0.3, 0.3),
		CFrame = cf * CFrame.new(0, 6, 0),
		Color = theme.trim,
		Parent = folder,
	})
	for _, x in { -2.5, 2.5 } do
		deco({
			Name = "Post",
			Size = Vector3.new(0.4, 6, 0.4),
			CFrame = cf * CFrame.new(x, 3, 0),
			Color = theme.trim,
			Parent = folder,
		})
	end
	for i = -2, 2 do
		deco({
			Name = "Bell",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.8,
			CFrame = cf * CFrame.new(i, 5.1, 0),
			Color = rgb(255, 210, 60),
			Material = Enum.Material.Metal,
			Parent = folder,
		})
		deco({
			Name = "Chain",
			Size = Vector3.new(0.1, 0.6, 0.1),
			CFrame = cf * CFrame.new(i, 5.6, 0),
			Color = rgb(200, 200, 210),
			Parent = folder,
		})
	end
end

function DECOR.banner(folder, cf, theme)
	deco({
		Name = "Pole",
		Size = Vector3.new(0.4, 8, 0.4),
		CFrame = cf * CFrame.new(0, 4, 0),
		Color = theme.trim,
		Parent = folder,
	})
	for i = 0, 2 do
		deco({
			Name = "Cloth",
			Size = Vector3.new(2.4, 1.2, 0.1),
			CFrame = cf * CFrame.new(1.4, 7 - i * 1.2, 0),
			Color = if i % 2 == 0 then theme.accent else theme.trim,
			Material = Enum.Material.Fabric,
			Parent = folder,
		})
	end
end

function DECOR.charpai(folder, cf, _theme)
	for _, x in { -1.6, 1.6 } do
		for _, z in { -2.8, 2.8 } do
			deco({
				Name = "Leg",
				Size = Vector3.new(0.4, 1.4, 0.4),
				CFrame = cf * CFrame.new(x, 0.7, z),
				Color = rgb(130, 85, 50),
				Parent = folder,
			})
		end
	end
	deco({
		Name = "Frame",
		Size = Vector3.new(3.6, 0.4, 6),
		CFrame = cf * CFrame.new(0, 1.5, 0),
		Color = rgb(150, 100, 60),
		Material = Enum.Material.Wood,
		CanCollide = true,
		Parent = folder,
	})
	deco({
		Name = "Weave",
		Size = Vector3.new(3.2, 0.1, 5.6),
		CFrame = cf * CFrame.new(0, 1.75, 0),
		Color = rgb(235, 215, 165),
		Material = Enum.Material.Fabric,
		Parent = folder,
	})
end

function DECOR.kettle(folder, cf, _theme)
	deco({
		Name = "Stove",
		Size = Vector3.new(2.6, 1.6, 2.6),
		CFrame = cf * CFrame.new(0, 0.8, 0),
		Color = rgb(90, 85, 80),
		Material = Enum.Material.Slate,
		Parent = folder,
	})
	deco({
		Name = "Kettle",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 2.2,
		CFrame = cf * CFrame.new(0, 2.6, 0),
		Color = rgb(200, 200, 210),
		Material = Enum.Material.Metal,
		Parent = folder,
	})
	deco({
		Name = "Spout",
		Size = Vector3.new(0.4, 0.4, 1.4),
		CFrame = cf * CFrame.new(0, 2.8, -1.3) * CFrame.Angles(math.rad(30), 0, 0),
		Color = rgb(200, 200, 210),
		Parent = folder,
	})
	local fire = deco({
		Name = "Fire",
		Size = Vector3.new(1.2, 0.3, 1.2),
		CFrame = cf * CFrame.new(0, 1.7, 0),
		Color = rgb(255, 120, 30),
		Material = Enum.Material.Neon,
		Parent = folder,
	})
	local steam = Instance.new("ParticleEmitter")
	steam.Rate = 3
	steam.Lifetime = NumberRange.new(1.5, 2.5)
	steam.Speed = NumberRange.new(1, 2)
	steam.Size = NumberSequence.new(0.6, 1.4)
	steam.Transparency = NumberSequence.new(0.4, 1)
	steam.Color = ColorSequence.new(rgb(255, 255, 255))
	steam.Parent = fire
end

function DECOR.mirror(folder, cf, theme)
	deco({
		Name = "Frame",
		Size = Vector3.new(3.2, 6.2, 0.4),
		CFrame = cf * CFrame.new(0, 3.1, 0),
		Color = theme.trim,
		Parent = folder,
	})
	deco({
		Name = "Glass",
		Size = Vector3.new(2.6, 5.6, 0.2),
		CFrame = cf * CFrame.new(0, 3.1, -0.15),
		Color = rgb(220, 240, 255),
		Material = Enum.Material.Glass,
		Reflectance = 0.6,
		Parent = folder,
	})
end

function DECOR.crystal(folder, cf, theme)
	for i, h in { 3, 2.2, 1.6 } do
		deco({
			Name = "Crystal",
			Size = Vector3.new(0.9, h, 0.9),
			CFrame = cf
				* CFrame.new((i - 2) * 0.9, h / 2, (i % 2) * 0.5)
				* CFrame.Angles(0, math.rad(45), math.rad((i - 2) * 12)),
			Color = if i == 2 then theme.trim else rgb(170, 230, 255),
			Material = Enum.Material.Neon,
			Transparency = 0.2,
			Parent = folder,
		})
	end
end

function DECOR.kiteStand(folder, cf, theme)
	deco({
		Name = "Pole",
		Size = Vector3.new(0.3, 7, 0.3),
		CFrame = cf * CFrame.new(0, 3.5, 0),
		Color = rgb(150, 110, 70),
		Parent = folder,
	})
	deco({
		Name = "Kite",
		Size = Vector3.new(2.4, 2.4, 0.15),
		CFrame = cf * CFrame.new(0, 8.2, 0) * CFrame.Angles(0, 0, math.rad(45)),
		Color = theme.trim,
		Parent = folder,
	})
	deco({
		Name = "Tail",
		Size = Vector3.new(0.15, 2, 0.1),
		CFrame = cf * CFrame.new(0, 6.4, 0),
		Color = theme.accent,
		Parent = folder,
	})
end

function DECOR.stumps(folder, cf, _theme)
	for i = -1, 1 do
		deco({
			Name = "Stump",
			Size = Vector3.new(0.3, 2.6, 0.3),
			CFrame = cf * CFrame.new(i * 0.5, 1.3, 0),
			Color = rgb(250, 240, 220),
			Parent = folder,
		})
	end
	deco({
		Name = "Bails",
		Size = Vector3.new(1.4, 0.15, 0.2),
		CFrame = cf * CFrame.new(0, 2.65, 0),
		Color = rgb(230, 60, 60),
		Parent = folder,
	})
	deco({
		Name = "Bat",
		Size = Vector3.new(0.5, 3, 0.25),
		CFrame = cf * CFrame.new(1.8, 1.4, 0) * CFrame.Angles(0, 0, math.rad(-15)),
		Color = rgb(225, 195, 140),
		Parent = folder,
	})
	deco({
		Name = "Ball",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 0.5,
		CFrame = cf * CFrame.new(-1.4, 0.25, 0.6),
		Color = rgb(255, 230, 40),
		Parent = folder,
	})
end

function DECOR.balloons(folder, cf, _theme)
	for i = 1, 5 do
		local offset = Vector3.new(math.cos(i * 1.3) * 1.2, 6 + (i % 3) * 0.8, math.sin(i * 1.3) * 1.2)
		deco({
			Name = "Balloon",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 1.5,
			CFrame = cf * CFrame.new(offset),
			Color = BRIGHT[i],
			Parent = folder,
		})
		deco({
			Name = "String",
			Size = Vector3.new(0.05, offset.Y - 1, 0.05),
			CFrame = CFrame.lookAt((cf * CFrame.new(offset / 2)).Position, (cf * CFrame.new(offset)).Position)
				* CFrame.Angles(math.rad(90), 0, 0),
			Color = rgb(255, 255, 255),
			Parent = folder,
		})
	end
	deco({
		Name = "Weight",
		Size = Vector3.new(0.8, 0.6, 0.8),
		CFrame = cf * CFrame.new(0, 0.3, 0),
		Color = rgb(255, 205, 50),
		Parent = folder,
	})
end

function DECOR.fairyLights(folder, cf, _theme)
	for i = -4, 4 do
		deco({
			Name = "Light",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.5,
			CFrame = cf * CFrame.new(i * 0.9, 7 - math.abs(i) * 0.15, 0),
			Color = BRIGHT[(i + 5) % #BRIGHT + 1],
			Material = Enum.Material.Neon,
			Parent = folder,
		})
	end
	for _, x in { -4, 4 } do
		deco({
			Name = "Post",
			Size = Vector3.new(0.3, 7, 0.3),
			CFrame = cf * CFrame.new(x, 3.5, 0),
			Color = rgb(150, 110, 70),
			Parent = folder,
		})
	end
end

function DECOR.bunting(folder, cf, _theme)
	for i = -5, 5 do
		deco({
			Name = "Flag",
			Size = Vector3.new(0.9, 0.9, 0.1),
			CFrame = cf
				* CFrame.new(i * 0.9, 6.5 - math.cos(i / 5 * math.pi / 2) * 0.8, 0)
				* CFrame.Angles(0, 0, math.rad(45)),
			Color = BRIGHT[(i + 6) % #BRIGHT + 1],
			Material = Enum.Material.Fabric,
			Parent = folder,
		})
	end
	for _, x in { -5, 5 } do
		deco({
			Name = "Post",
			Size = Vector3.new(0.3, 7, 0.3),
			CFrame = cf * CFrame.new(x, 3.5, 0),
			Color = rgb(150, 110, 70),
			Parent = folder,
		})
	end
end

function DECOR.chhatri(folder, cf, theme)
	for _, x in { -1.5, 1.5 } do
		for _, z in { -1.5, 1.5 } do
			deco({
				Name = "Pillar",
				Size = Vector3.new(0.5, 4, 0.5),
				CFrame = cf * CFrame.new(x, 2, z),
				Color = theme.trim,
				Parent = folder,
			})
		end
	end
	deco({
		Name = "Slab",
		Size = Vector3.new(4.4, 0.5, 4.4),
		CFrame = cf * CFrame.new(0, 4.25, 0),
		Color = theme.wall,
		Parent = folder,
	})
	deco({
		Name = "Dome",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 3.6,
		CFrame = cf * CFrame.new(0, 5.2, 0),
		Color = theme.accent,
		Parent = folder,
	})
end

function DECOR.kites(folder, cf, _theme)
	for i = 1, 4 do
		local offset = Vector3.new((i - 2.5) * 5, 12 + (i % 2) * 4, (i % 3) * 3)
		deco({
			Name = "Kite",
			Size = Vector3.new(3, 3, 0.15),
			CFrame = cf * CFrame.new(offset) * CFrame.Angles(0, math.rad(i * 25), math.rad(45)),
			Color = BRIGHT[i + 1],
			Parent = folder,
		})
		deco({
			Name = "Tail",
			Size = Vector3.new(0.2, 3, 0.1),
			CFrame = cf * CFrame.new(offset - Vector3.new(0, 2.6, 0)),
			Color = BRIGHT[i],
			Parent = folder,
		})
	end
end

---------------------------------------------------------------------------
-- The Chowkidar (level 6)
---------------------------------------------------------------------------
local function buildChowkidar(folder: Instance, cf: CFrame): Model
	local guard = Instance.new("Model")
	guard.Name = "Chowkidar"
	local khaki = rgb(195, 170, 110)
	local root = deco({
		Name = "Body",
		Size = Vector3.new(2, 3, 1.4),
		CFrame = cf * CFrame.new(0, 2.4, 0),
		Color = khaki,
		Parent = guard,
	})
	for _, x in { -0.5, 0.5 } do
		deco({
			Name = "Leg",
			Size = Vector3.new(0.7, 1.4, 0.8),
			CFrame = cf * CFrame.new(x, 0.7, 0),
			Color = rgb(90, 75, 55),
			Parent = guard,
		})
	end
	deco({
		Name = "Head",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 1.8,
		CFrame = cf * CFrame.new(0, 4.8, 0),
		Color = rgb(225, 170, 120),
		Parent = guard,
	})
	deco({
		Name = "Cap",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 1.9, 1.9),
		CFrame = cf * CFrame.new(0, 5.7, 0) * UP,
		Color = rgb(60, 80, 140),
		Parent = guard,
	})
	for _, side in { -1, 1 } do
		deco({
			Name = "Moustache",
			Size = Vector3.new(0.8, 0.25, 0.25),
			CFrame = cf * CFrame.new(side * 0.4, 4.4, -0.85) * CFrame.Angles(0, 0, math.rad(side * -15)),
			Color = rgb(30, 25, 25),
			Parent = guard,
		})
		deco({
			Name = "Eye",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.35,
			CFrame = cf * CFrame.new(side * 0.35, 5, -0.8),
			Color = rgb(20, 20, 20),
			Parent = guard,
		})
	end
	deco({
		Name = "Lathi",
		Size = Vector3.new(0.3, 5, 0.3),
		CFrame = cf * CFrame.new(1.5, 2.6, -0.3) * CFrame.Angles(0, 0, math.rad(-10)),
		Color = rgb(130, 85, 45),
		Parent = guard,
	})
	guard.PrimaryPart = root

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Status"
	billboard.Size = UDim2.fromScale(7, 1.6)
	billboard.StudsOffset = Vector3.new(0, 4.5, 0)
	billboard.MaxDistance = 70
	billboard.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = rgb(255, 235, 120)
	label.Text = "Jaagte Raho!"
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Parent = label
	label.Parent = billboard
	billboard.Parent = root
	guard.Parent = folder
	return guard
end

---------------------------------------------------------------------------
-- Painting
---------------------------------------------------------------------------
local FRONT_SPOTS = { -- courtyard (x, z), clear of the door path, galla, incubators, stairs and plots
	{ -24, -8 },
	{ 31, -9 },
	{ -16, -24 },
	{ 16, -24 },
	{ 31, -24 },
	{ -10, -8 },
}
local UPPER_SPOTS = { { -30, 23 }, { 0, 24 }, { 30, 23 }, { -14, 24 }, { 15, 24 } }
local ROOF_SPOTS = { { -31, -2 }, { 31, -2 }, { -31, 22 }, { 31, 22 } }

local function paint(parts: { BasePart }, color: Color3, mat: Enum.Material?, reflectance: number?)
	for _, p in parts do
		p.Color = color
		if mat then
			p.Material = mat
		end
		p.Reflectance = reflectance or 0
	end
end

local function place(h, kind: string, theme, spots, y: number, from: number, to: number)
	local add = DECOR[kind]
	if not add then
		warn("[ChaiChaos] Unknown decoration " .. kind)
		return
	end
	for i = from, math.min(to, #spots) do
		local spot = spots[i]
		add(h.decor, h.origin * CFrame.new(spot[1], y, spot[2]), theme)
	end
end

-- Returns the Chowkidar model if this level has one.
function HaveliStyle.apply(h, themeId: string?, level: number): Model?
	local theme = themeId and Themes.byId[themeId]
	local look = theme or Themes.EMPTY
	paint(h.walls, look.wall, material(look.wallMaterial), look.reflectance)
	paint(h.trims, look.trim)
	paint(h.accents, look.accent, Enum.Material.SmoothPlastic)
	paint(h.floors, look.floor, material(look.floorMaterial))

	local upstairs = theme ~= nil and level >= Config.UPPER_FLOOR_LEVEL
	for _, gate in h.stairGates do
		gate.Transparency = if upstairs then 1 else (if gate.Name == "StairSign" then 0 else 0.5)
		gate.CanCollide = not upstairs
		local gui = gate:FindFirstChildOfClass("SurfaceGui")
		if gui then
			gui.Enabled = not upstairs
		end
	end
	-- egg incubators: more of them at higher levels
	local nests = if theme then Config.HAVELI_LEVELS[level].incubators else 1
	for i, nest in h.incubators do
		local on = i <= nests
		nest.Transparency = if on then 0 else 1
		nest.CanCollide = false
		local gui = nest:FindFirstChildOfClass("BillboardGui")
		if gui then
			gui.Enabled = on
		end
	end

	local rooftop = theme ~= nil and level >= Config.ROOFTOP_LEVEL
	if h.roof then
		h.roof.Transparency = if rooftop then 0 else 1
		h.roof.CanCollide = rooftop
		h.roof.Color = look.trim
	end

	h.decor:ClearAllChildren()
	if not theme then
		return nil
	end

	-- lanterns either side of the door, on the lane side
	for _, x in { -10, 10 } do
		DECOR.lantern(h.decor, h.origin * CFrame.new(x, 0, -h.size.Z / 2 - 1.5), theme)
	end
	place(h, theme.decor[1], theme, FRONT_SPOTS, 0, 1, 2)
	if level >= 2 then
		place(h, theme.decor[2], theme, FRONT_SPOTS, 0, 3, 4)
	end
	if level >= Config.GARDEN_LEVEL then
		place(h, theme.decor[3], theme, FRONT_SPOTS, 0, 5, 6)
	end
	if upstairs then
		place(h, theme.upperDecor, theme, UPPER_SPOTS, h.upperY, 1, 3)
	end
	local guard = nil
	if level >= Config.GUARD_LEVEL then
		guard = buildChowkidar(h.decor, h.guardSpot)
	end
	if rooftop then
		local roofY = h.roof and (h.origin:PointToObjectSpace(h.roof.Position).Y + h.roof.Size.Y / 2) or (h.upperY + 9)
		place(h, "chhatri", theme, ROOF_SPOTS, roofY, 1, 4)
		place(h, theme.roofDecor, theme, { { 0, 10 } }, roofY, 1, 1)
	end
	if level >= #Config.HAVELI_LEVELS then
		for _, x in { -18, 18 } do
			DECOR.fairyLights(h.decor, h.origin * CFrame.new(x, h.upperY - 0.4, -h.size.Z / 2 + 1), theme)
		end
		place(h, theme.upperDecor, theme, UPPER_SPOTS, h.upperY, 4, 5)
	end
	return guard
end

return HaveliStyle
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">Havelis</string>
          <string name="Source"><![CDATA[-- Havelis: who lives where, haveli levels and themes, which brainrot stands on
-- which plot, the galla, selling, the Taala lock and the Laser Darwaza.
--
-- Plots 1 and 2 are Lockers. Brainrots are always sorted so your most
-- valuable ones stand in the Lockers, where nobody can steal them.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Config = require(Shared.Config)
local Brainrots = require(Shared.Brainrots)
local Format = require(Shared.Format)
local Mutations = require(Shared.Mutations)
local Themes = require(Shared.Themes)
local Events = require(Shared.Events)
local Gear = require(Shared.Gear)

local State = require(script.Parent.State)
local Models = require(script.Parent.Models)
local Mover = require(script.Parent.Mover)
local MapBuilder = require(script.Parent.MapBuilder)
local HaveliStyle = require(script.Parent.HaveliStyle)
local Defenses = require(script.Parent.Defenses)

local Havelis = {}

local havelis = {}
local gameMap = nil
local nextUid = 0
local gallaCooldown: { [Player]: number } = {}

local LOCKER_COLOR = Color3.fromRGB(110, 175, 245)
local PLOT_COLOR = Color3.fromRGB(245, 235, 210)
local LOCKED_COLOR = Color3.fromRGB(95, 85, 75)

function Havelis.isLocker(plot: number): boolean
	return plot >= 1 and plot <= Config.LOCKER_PLOTS
end

function Havelis.plotCount(profile): number
	return Config.HAVELI_LEVELS[profile.data.level].plots
end

function Havelis.entryValue(entry): number
	return Mutations.value(entry.def, entry.mutation)
end

function Havelis.entryIncome(entry): number
	return Mutations.income(entry.def, entry.mutation)
end

-- Rebirths, the theme perk and the running event all multiply income.
function Havelis.incomeMultiplier(profile): number
	local theme = profile.data.theme
	local mult = (1 + Config.REBIRTH_BONUS * profile.data.rebirths) * (Themes.perk(theme, "income") or 1)
	local event = Events.current()
	if event then
		mult *= (event.cashMult or 1) * (Themes.perk(theme, "eventIncome") or 1)
	end
	return mult
end

function Havelis.incomePerSecond(profile): number
	local total = 0
	for _, entry in profile.owned do
		if not entry.carrier then
			total += Havelis.entryIncome(entry)
		end
	end
	return total * Havelis.incomeMultiplier(profile)
end

function Havelis.hasFreePlot(profile): boolean
	return profile.haveli ~= nil and #profile.owned < Havelis.plotCount(profile)
end

-- Running speed on foot: the theme perk and speed gear.
function Havelis.walkSpeed(profile): number
	return Config.WALK_SPEED
		* (Themes.perk(profile.data.theme, "walkSpeed") or 1)
		* Gear.best(profile.data.gear, "speed")
end

-- Sets the player's speed: on foot (slower while carrying a stolen brainrot
-- and in hazards like mud and sandstorms) or driving (see Vehicles.luau).
function Havelis.applyWalkSpeed(profile)
	local character = profile.player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		local drive = profile.driving
		if drive then
			humanoid.WalkSpeed = if drive.empty
				then Config.FUEL_EMPTY_SPEED
				else drive.topSpeed * (profile.surfaceSpeed or 1)
		else
			humanoid.WalkSpeed = Havelis.walkSpeed(profile) * (profile.carrySpeed or 1) * (profile.hazardSpeed or 1)
		end
	end
end

function Havelis.taalaTime(profile): number
	return Config.LOCK_TIME + (Themes.perk(profile.data.theme, "taalaBonus") or 0)
end

local function plotGround(h, index: number): CFrame
	local plot = h.plots[index]
	return plot.CFrame * CFrame.new(0, plot.Size.Y / 2, 0)
end

local function localPosition(h, position: Vector3): Vector3
	return h.origin:PointToObjectSpace(position)
end

function Havelis.isInside(h, position: Vector3): boolean
	local p = localPosition(h, position)
	return math.abs(p.X) < h.size.X / 2 and math.abs(p.Z) < h.size.Z / 2 and p.Y > -4 and p.Y < h.upperY + 14
end

local function findPrompt(model: Model, name: string): ProximityPrompt?
	local primary = model.PrimaryPart
	return primary and primary:FindFirstChild(name) :: ProximityPrompt?
end

-- The level that unlocks plot `index`.
local function levelForPlot(index: number): number
	for level, info in Config.HAVELI_LEVELS do
		if info.plots >= index then
			return level
		end
	end
	return #Config.HAVELI_LEVELS
end

local function paintPlots(h, profile)
	local unlocked = if profile then Havelis.plotCount(profile) else Config.HAVELI_LEVELS[1].plots
	for i, plot in h.plots do
		local label = h.plotLabels[i]
		if i <= unlocked then
			plot.Transparency = 0
			plot.Color = if Havelis.isLocker(i) then LOCKER_COLOR else PLOT_COLOR
			label.Text = if Havelis.isLocker(i) then "LOCKER" else ""
		else
			plot.Transparency = 0.55
			plot.Color = LOCKED_COLOR
			label.Text = if profile then ("Level %d"):format(levelForPlot(i)) else ""
		end
	end
end

local function updateSign(h)
	local profile = h.owner
	if not profile then
		h.signLabel.Text = "Khaali Haveli"
		return
	end
	local locked = workspace:GetServerTimeNow() < profile.lockedUntil
	h.signLabel.Text = ("%s%s ki Haveli · Lv %d"):format(
		if locked then "LOCKED · " else "",
		profile.player.DisplayName,
		profile.data.level
	)
end

function Havelis.updateGalla(profile)
	local h = profile.haveli
	if h then
		h.gallaLabel.Text = "Galla\n" .. Format.rupees(profile.data.galla)
	end
	profile.player:SetAttribute("Galla", math.floor(profile.data.galla))
end

-- Tells the player's screen which brainrots they own, for the Brainrots
-- window (ride and sell): "uid|key|carried" separated by commas.
function Havelis.syncOwned(profile)
	local items = {}
	for _, entry in profile.owned do
		table.insert(
			items,
			("%d|%s|%s"):format(
				entry.uid,
				Mutations.key(entry.def.id, entry.mutation),
				if entry.carrier then "1" else "0"
			)
		)
	end
	local text = table.concat(items, ",")
	if profile.player:GetAttribute("Owned") ~= text then
		profile.player:SetAttribute("Owned", text)
	end
end

-- Turns steal prompts on or off and updates the sign, the laser and the
-- player's list of brainrots.
function Havelis.refreshPrompts(profile)
	Havelis.syncOwned(profile)
	local h = profile.haveli
	if not h then
		return
	end
	local now = workspace:GetServerTimeNow()
	local locked = now < profile.lockedUntil
	local open = not locked and now >= profile.protectedUntil
	for _, entry in profile.owned do
		local steal = findPrompt(entry.model, "StealPrompt")
		if steal then
			steal:SetAttribute(
				"Active",
				open and entry.carrier == nil and entry.arrived and not Havelis.isLocker(entry.plot)
			)
		end
	end
	paintPlots(h, profile)
	updateSign(h)
	h.barrier.Transparency = if locked then 0.45 else 1
	Defenses.setLaser(h, locked and profile.data.level >= Config.LASER_LEVEL)
end

-- Repaints and redecorates for the owner's theme and level.
function Havelis.restyle(profile)
	local h = profile.haveli
	if not h then
		return
	end
	h.guard = HaveliStyle.apply(h, profile.data.theme, profile.data.level)
	Havelis.refreshPrompts(profile)
end

local function isUpstairs(h, position: Vector3): boolean
	return localPosition(h, position).Y > h.upperY / 2
end

local function sendToPlot(profile, entry, instant: boolean?)
	local h = profile.haveli
	local model = entry.model
	local target = Models.stand(model, plotGround(h, entry.plot))
	if instant then
		Mover.place(model, target)
		entry.arrived = true
		return
	end
	local here = Mover.pivot(model).Position
	local points = {}
	if not Havelis.isInside(h, here) then
		table.insert(points, Models.stand(model, h.doorOutside))
		table.insert(points, Models.stand(model, h.doorInside))
		here = h.doorInside.Position
	end
	local fromUp = isUpstairs(h, here)
	local toUp = entry.plot > MapBuilder.PLOTS_PER_FLOOR
	if fromUp ~= toUp then
		local first, second = h.stairBottom, h.stairTop
		if fromUp then
			first, second = h.stairTop, h.stairBottom
		end
		table.insert(points, Models.stand(model, first))
		table.insert(points, Models.stand(model, second))
	end
	table.insert(points, target)
	Mover.walk(model, points, Config.WALK_HOME_SPEED, function()
		if State.entries[model] == entry and not entry.carrier then
			entry.arrived = true
			Havelis.refreshPrompts(profile)
		end
	end)
end

-- Gives every brainrot a plot, most valuable first (so the best ones sit in
-- Lockers). Quest brainrots cannot be stolen, so they go last.
-- A brainrot being carried by a thief keeps its plot free for when it comes back.
function Havelis.arrange(profile, instant: boolean?)
	if not profile.haveli then
		return
	end
	local reserved = {}
	local waiting = {}
	for _, entry in profile.owned do
		if entry.carrier then
			reserved[entry.plot] = true
		else
			table.insert(waiting, entry)
		end
	end
	table.sort(waiting, function(a, b)
		local aQuest, bQuest = a.def.questOnly == true, b.def.questOnly == true
		if aQuest ~= bQuest then
			return bQuest
		end
		local aValue, bValue = Havelis.entryValue(a), Havelis.entryValue(b)
		if aValue ~= bValue then
			return aValue > bValue
		end
		return a.uid < b.uid
	end)
	local nextIndex = 1
	for plot = 1, Havelis.plotCount(profile) do
		local entry = waiting[nextIndex]
		if not entry then
			break
		end
		if not reserved[plot] then
			nextIndex += 1
			if entry.plot ~= plot or instant then
				entry.plot = plot
				sendToPlot(profile, entry, instant)
			end
		end
	end
end

local function makePrompt(
	parent: Instance,
	name: string,
	action: string,
	hold: number,
	showFor: string
): ProximityPrompt
	local prompt = parent:FindFirstChild(name) :: ProximityPrompt?
	if not prompt then
		local created = Instance.new("ProximityPrompt")
		created.Name = name
		created.ActionText = action
		created.HoldDuration = hold
		created.MaxActivationDistance = Config.PROMPT_DISTANCE
		created.RequiresLineOfSight = false
		created:SetAttribute("ShowFor", showFor)
		created.Parent = parent
		prompt = created
	end
	return prompt :: ProximityPrompt
end

local function addEntry(profile, def, mutation: string?, model: Model, arrived: boolean)
	local h = profile.haveli
	model.Parent = h.brainrotFolder
	model:SetAttribute("OwnerId", profile.player.UserId)
	nextUid += 1
	local entry = {
		uid = nextUid,
		def = def,
		mutation = mutation,
		model = model,
		plot = 0,
		carrier = nil,
		arrived = arrived,
		owner = profile,
	}
	table.insert(profile.owned, entry)
	State.entries[model] = entry

	local primary = model.PrimaryPart :: BasePart
	local name = Mutations.displayName(def, mutation)
	if not def.questOnly then
		local stealText = if Config.stealsCostRobux() then "Steal (1 Chor Pass)" else "Steal"
		local steal = makePrompt(primary, "StealPrompt", stealText, Config.STEAL_HOLD_TIME, "others")
		steal.ObjectText = ("%s (%s)"):format(name, def.rarity)
		steal:SetAttribute("OwnerId", profile.player.UserId)
	end
	Models.setInfo(
		model,
		("%s ka  ·  +%s/s"):format(profile.player.DisplayName, Format.short(Havelis.entryIncome(entry)))
	)
	return entry
end

-- Adds a brainrot to a player's haveli. Pass the model if it already exists
-- (stolen, or coming back from a ride); otherwise a new one walks in from the door.
-- Returns the entry and whether this is the first time the player got it.
-- `quiet` skips the Collection Book message (the Kismat reveal shows it instead).
function Havelis.adopt(profile, def, mutation: string?, model: Model?, quiet: boolean?)
	local h = profile.haveli
	if not h then
		return nil, false
	end
	if not model then
		local created = Models.create(def, mutation)
		created:PivotTo(Models.stand(created, h.doorOutside))
		model = created
	end
	local entry = addEntry(profile, def, mutation, model :: Model, false)
	local isNew = State.discover(profile, def, mutation)
	if isNew then
		State.track(profile, "discover")
		if not quiet then
			State.notify(profile.player, "rare", "New in your Collection Book: " .. def.name .. "!")
		end
	end
	Havelis.arrange(profile)
	Havelis.refreshPrompts(profile)
	return entry, isNew
end

-- Takes a brainrot out of a haveli without destroying its model.
function Havelis.remove(profile, entry)
	local index = table.find(profile.owned, entry)
	if index then
		table.remove(profile.owned, index)
	end
	if State.entries[entry.model] == entry then
		State.entries[entry.model] = nil
	end
	Havelis.arrange(profile)
	Havelis.refreshPrompts(profile)
end

-- A stolen brainrot that got away from its thief walks back home.
function Havelis.returnHome(entry)
	local profile = entry.owner
	entry.carrier = nil
	entry.arrived = false
	entry.plot = 0
	Havelis.arrange(profile)
	Havelis.refreshPrompts(profile)
end

function Havelis.clearBrainrots(profile)
	for _, entry in profile.owned do
		if State.entries[entry.model] == entry then
			State.entries[entry.model] = nil
		end
		entry.model:Destroy()
	end
	table.clear(profile.owned)
	Havelis.syncOwned(profile)
end

-- Gives the player the first empty haveli and puts their saved brainrots on their plots.
function Havelis.claim(profile): boolean
	for _, h in havelis do
		if h.owner then
			continue
		end
		h.owner = profile
		profile.haveli = h
		for _, key in profile.data.owned do
			local id, mutation = Mutations.parse(key)
			local def = Brainrots.byId[id]
			if def then
				addEntry(profile, def, mutation, Models.create(def, mutation), true)
			end
		end
		Havelis.restyle(profile)
		Havelis.arrange(profile, true)
		Havelis.refreshPrompts(profile)
		Havelis.updateGalla(profile)
		Defenses.applyCharacter(profile)
		return true
	end
	return false
end

function Havelis.release(profile)
	local h = profile.haveli
	if not h then
		return
	end
	Havelis.clearBrainrots(profile)
	gallaCooldown[profile.player] = nil
	h.owner = nil
	h.guard = nil
	profile.haveli = nil
	HaveliStyle.apply(h, nil, 1)
	paintPlots(h, nil)
	updateSign(h)
	h.barrier.Transparency = 1
	Defenses.setLaser(h, false)
	h.gallaLabel.Text = "Galla"
	Defenses.applyCharacter(profile)
end

-- Copies the brainrots currently owned into the save data. Only while the
-- player has a haveli: before claiming one (full server) or after leaving,
-- profile.owned is empty and must not overwrite what was loaded.
function Havelis.syncData(profile)
	if not profile.haveli then
		return
	end
	local keys = {}
	for _, entry in profile.owned do
		table.insert(keys, Mutations.key(entry.def.id, entry.mutation))
	end
	profile.data.owned = keys
end

function Havelis.teleportHome(profile)
	local h = profile.haveli
	local character = profile.player.Character
	if h and character then
		if workspace.StreamingEnabled then
			-- load the haveli on the player's screen first, so they don't fall through the floor
			pcall(function()
				profile.player:RequestStreamAroundAsync(h.spawn.Position, 3)
			end)
		end
		character:PivotTo(h.spawn)
	end
end

function Havelis.upgrade(player: Player)
	local profile = State.profiles[player]
	if not profile or not profile.haveli then
		return
	end
	local data = profile.data
	local nextLevel = Config.HAVELI_LEVELS[data.level + 1]
	if not nextLevel then
		State.notify(player, "info", "Your haveli is already as big as it gets!")
		return
	end
	if data.rupees < nextLevel.cost then
		State.notify(player, "bad", ("You need %s to upgrade your haveli."):format(Format.rupees(nextLevel.cost)))
		return
	end
	State.addRupees(profile, -nextLevel.cost)
	data.level += 1
	State.syncStats(profile)
	Havelis.restyle(profile)
	State.notify(
		player,
		"rare",
		("Haveli Level %d: %s!%s"):format(
			data.level,
			nextLevel.name,
			if nextLevel.unlock then " " .. nextLevel.unlock .. "." else ""
		)
	)
	State.sound(player, "Upgrade")
	State.track(profile, "upgrade")
end

function Havelis.setTheme(player: Player, themeId: any)
	local profile = State.profiles[player]
	if not profile or type(themeId) ~= "string" or not Themes.byId[themeId] then
		return
	end
	if not Themes.isUnlocked(themeId, profile.data.rebirths) then
		State.notify(
			player,
			"bad",
			("%s unlocks after %d Naya Safar."):format(Themes.byId[themeId].name, Themes.byId[themeId].rebirths)
		)
		return
	end
	if profile.data.theme == themeId then
		return
	end
	profile.data.theme = themeId
	State.syncStats(profile)
	Havelis.restyle(profile)
	Havelis.applyWalkSpeed(profile)
	State.notify(
		player,
		"good",
		("Your haveli is now %s! %s"):format(Themes.byId[themeId].name, Themes.byId[themeId].perkText)
	)
end

-- Taala: lock your haveli. From Level 3 the Laser Darwaza also blocks the door.
function Havelis.lock(player: Player)
	local profile = State.profiles[player]
	local h = profile and profile.haveli
	if not h then
		return
	end
	local now = workspace:GetServerTimeNow()
	if now < profile.lockReadyAt then
		State.notify(player, "bad", ("Your taala is not ready yet (%ds)."):format(math.ceil(profile.lockReadyAt - now)))
		return
	end
	local duration = Havelis.taalaTime(profile)
	profile.lockedUntil = now + duration
	profile.lockReadyAt = now + duration + Config.LOCK_COOLDOWN
	player:SetAttribute("LockedUntil", profile.lockedUntil)
	player:SetAttribute("LockReadyAt", profile.lockReadyAt)
	Havelis.refreshPrompts(profile)

	local laser = profile.data.level >= Config.LASER_LEVEL
	if laser then
		-- nobody gets trapped inside: other players are moved out of the door
		for _, other in Players:GetPlayers() do
			local root = State.rootPart(other)
			if other ~= player and root and Havelis.isInside(h, root.Position) then
				(other.Character :: Model):PivotTo(h.doorOutside + Vector3.new(0, 4, 0))
			end
		end
	end
	State.notify(
		player,
		"good",
		("Taala laga diya! Your haveli is locked for %d seconds%s."):format(
			duration,
			if laser then " and the Laser Darwaza is on" else ""
		)
	)
	State.track(profile, "taala")
	task.delay(duration + 0.1, function()
		if State.profiles[player] == profile then
			Havelis.refreshPrompts(profile)
			State.notify(player, "info", "Your taala is open again.")
		end
	end)
end

local function collectGalla(h, hit: BasePart)
	local profile = h.owner
	if not profile or Players:GetPlayerFromCharacter(hit.Parent) ~= profile.player then
		return
	end
	local player = profile.player
	local now = os.clock()
	if (gallaCooldown[player] or 0) > now then
		return
	end
	gallaCooldown[player] = now + 0.5
	local amount = math.floor(profile.data.galla)
	if amount <= 0 then
		return
	end
	profile.data.galla -= amount
	State.addRupees(profile, amount)
	Havelis.updateGalla(profile)
	State.notify(player, "good", "+" .. Format.rupees(amount) .. " from your galla!")
	State.sound(player, "Coin")
	State.track(profile, "collect", amount)
end

function Havelis.init(map)
	gameMap = map
	havelis = map.havelis
	for i, h in havelis do
		-- Havelis are looked up by the index stored on their plots, so keep them in order.
		h.index = i
		for _, plot in h.plots do
			plot:SetAttribute("HaveliIndex", i)
		end
		h.galla.Touched:Connect(function(hit)
			collectGalla(h, hit)
		end)
		HaveliStyle.apply(h, nil, 1)
		paintPlots(h, nil)
		updateSign(h)
	end
end

function Havelis.byIndex(index: number)
	return havelis[index]
end

-- The whole map (gates, doors, pumps...), for other modules and the tests.
function Havelis.map()
	return gameMap
end

function Havelis.all()
	return havelis
end

return Havelis
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">Hazards</string>
          <string name="Source"><![CDATA[-- Zone hazards. They slow you down, knock you back and knock time off your
-- eggs, but they never hurt you. Gear from the Chowk's Gear shop protects
-- you on foot; a vehicle's tyres (Grip) protect it.
--
--   train     (Railway Junction: watch the crossing light!)     : nothing, just dodge it
--   water     (Sahil Beach and Karachi Port sea, Lahore's moat) : Life Jacket
--   waves     (Sahil Beach, every so often)                     : Life Jacket
--   mud       (Mango Bagh puddles, Sarson Fields paths)         : Gum Boots (Grip 1 in a vehicle)
--   sandstorm (Thar Desert and Mohenjo-daro, every so often)    : Sand Goggles (Grip 2)
--   salt      (Namak Caves: rocks fall on the red circles)      : Lantern
--   ice       (Barfani Pahar's frozen lakes)                    : Snow Boots (Grip 3)
--   snowballs (Barfani Pahar, every so often)                   : Snow Boots
--
-- Sand (Sahil Beach, Thar Desert, Mohenjo-daro) slows vehicles without Grip 2.
-- The roads are always safe: no water, mud or ice on a road.

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Config = require(Shared.Config)
local Biomes = require(Shared.Biomes)
local Gear = require(Shared.Gear)
local Vehicles = require(Shared.Vehicles)

local State = require(script.Parent.State)
local Havelis = require(script.Parent.Havelis)
local BiomeBuilder = require(script.Parent.BiomeBuilder)
local EggSystem = require(script.Parent.EggSystem)

local Hazards = {}

local GEAR_FOR = {
	water = "Life Jacket",
	mud = "Gum Boots",
	ice = "Snow Boots",
	sandstorm = "Sand Goggles",
	waves = "Life Jacket",
	snowballs = "Snow Boots",
	salt = "Lantern",
}

local map = nil
local pushedAt: { [Player]: number } = {}
local rockFolder: Folder = nil

local function now(): number
	return workspace:GetServerTimeNow()
end

local function sandstorm(): boolean
	return workspace:GetAttribute("Sandstorm") == true
end

local function has(biome, hazard: string): boolean
	return table.find(biome.hazards, hazard) ~= nil
end

-- What is under a position in a zone: water, ice, mud, sandstorm, sand or nil.
function Hazards.surfaceAt(position: Vector3): string?
	local biome = Biomes.at(position)
	if not biome then
		return nil
	end
	local plan = map.biomes[biome.id]
	local onRoad = Biomes.roadDistance(position) < 0
	if not onRoad then
		if position.Y < Biomes.GROUND_Y + 4 and BiomeBuilder.inZone(plan, position, "water") then
			return "water"
		elseif BiomeBuilder.inZone(plan, position, "ice") then
			return "ice"
		elseif BiomeBuilder.inZone(plan, position, "mud") then
			return "mud"
		end
	end
	if sandstorm() and BiomeBuilder.inZone(plan, position, "sandstorm") then
		return "sandstorm"
	end
	if not onRoad and (BiomeBuilder.inZone(plan, position, "sand") or BiomeBuilder.inZone(plan, position, "shore")) then
		return "sand"
	end
	return nil
end

-- The hazard a player on foot is standing in right now that their gear does
-- not protect them from, if any.
function Hazards.standingIn(profile, position: Vector3): string?
	local surface = Hazards.surfaceAt(position)
	if surface == nil or surface == "sand" then
		return nil
	end
	if Gear.protects(profile.data.gear, surface) then
		return nil
	end
	return surface
end

function Hazards.tick()
	for player, profile in State.profiles do
		local root = State.rootPart(player)
		local drive = profile.driving
		local text = ""
		if drive then
			-- in a vehicle: good tyres get you through mud, sand and ice
			local surface = if root then Hazards.surfaceAt(root.Position) else nil
			local slow = surface ~= nil and not Vehicles.handles(drive.grip, surface)
			local speed = if slow then Config.DRIVE_SURFACE_SPEED[surface :: string] or 1 else 1
			if profile.surfaceSpeed ~= speed then
				profile.surfaceSpeed = speed
				Havelis.applyWalkSpeed(profile)
			end
			profile.eggDrain = if surface == "water" or surface == "sandstorm"
				then Config.HAZARD_EGG_DRAIN[surface] or 1
				else 1
			if slow then
				local needed = Vehicles.GRIP_NEEDED[surface :: string]
				text = if needed
					then ("%s! Tyres level %d drive right through"):format(
						(surface :: string):sub(1, 1):upper() .. (surface :: string):sub(2),
						needed
					)
					else "Deep water! Vehicles go slowly here"
			end
			if profile.hazardSpeed ~= 1 then
				profile.hazardSpeed = 1
			end
		else
			local hazard = if root then Hazards.standingIn(profile, root.Position) else nil
			local speed = if hazard then Config.HAZARD_SPEED[hazard] or 1 else 1
			if profile.hazardSpeed ~= speed then
				profile.hazardSpeed = speed
				Havelis.applyWalkSpeed(profile)
			end
			profile.eggDrain = if hazard then Config.HAZARD_EGG_DRAIN[hazard] or 1 else 1
			if hazard then
				text = ("%s! %s helps"):format(hazard:sub(1, 1):upper() .. hazard:sub(2), GEAR_FOR[hazard])
			end
		end
		if player:GetAttribute("Hazard") ~= text then
			player:SetAttribute("Hazard", text)
		end
	end
end

-- Pushes a player away from `from` (never hurts). Works in vehicles too.
function Hazards.push(player: Player, from: Vector3, power: number?)
	local root = State.rootPart(player)
	if not root then
		return
	end
	local t = now()
	if t - (pushedAt[player] or 0) < 1 then
		return
	end
	pushedAt[player] = t
	local away = (root.Position - from) * Vector3.new(1, 0, 1)
	if away.Magnitude < 0.1 then
		away = Vector3.new(0, 0, 1)
	end
	local attachment = Instance.new("Attachment")
	attachment.Name = "KnockAttachment"
	attachment.Parent = root
	local velocity = Instance.new("LinearVelocity")
	velocity.Name = "Knockback"
	velocity.Attachment0 = attachment
	velocity.MaxForce = math.huge
	velocity.VectorVelocity = away.Unit * (power or Config.KNOCKBACK) + Vector3.new(0, 40, 0)
	velocity.Parent = root
	Debris:AddItem(attachment, 0.25)
	Debris:AddItem(velocity, 0.25)
end

-- Hits every unprotected player in a zone (waves, snowballs), or only in some
-- of its hazard areas. Each player is hit at most once.
local function strike(biomeId: string, zoneKinds: { string }?, protectedBy: string, sound: string, message: string)
	local plan = map.biomes[biomeId]
	for player, profile in State.profiles do
		local root = State.rootPart(player)
		if root then
			local biome = Biomes.at(root.Position)
			local inArea = zoneKinds == nil
			for _, kind in zoneKinds or {} do
				inArea = inArea or BiomeBuilder.inZone(plan, root.Position, kind)
			end
			if biome and biome.id == biomeId and inArea then
				State.sound(player, sound, root.Position)
				if not Gear.protects(profile.data.gear, protectedBy) then
					EggSystem.hit(player, Config.EGG_HIT_PENALTY, message)
					if sound == "Splash" then
						-- the wave pushes you back towards the land
						Hazards.push(player, root.Position * 1.2, Config.KNOCKBACK * 0.8)
					end
				end
			end
		end
	end
end

local function zoneWith(hazard: string): { string }
	local list = {}
	for _, biome in Biomes.list do
		if has(biome, hazard) then
			table.insert(list, biome.id)
		end
	end
	return list
end

function Hazards.wave()
	workspace:SetAttribute("WaveAt", now())
	for _, id in zoneWith("waves") do
		strike(id, { "shore", "water" }, "water", "Splash", "SPLASH! A big wave got you!")
	end
end

function Hazards.snowball()
	for _, id in zoneWith("snowballs") do
		strike(id, nil, "ice", "Hit", "THWACK! A snowball hit you!")
	end
end

-- Namak Caves: a red circle appears near every player there, then a salt rock
-- lands on it. Step out of the circle! A Lantern lets you see them coming.
function Hazards.salt()
	for player in State.profiles do
		local root = State.rootPart(player)
		local biome = root and Biomes.at(root.Position)
		if root and biome and has(biome, "salt") then
			local a = math.random() * math.pi * 2
			local spot = Vector3.new(
				root.Position.X + math.cos(a) * math.random() * 5,
				Biomes.GROUND_Y,
				root.Position.Z + math.sin(a) * math.random() * 5
			)
			local mark = Instance.new("Part")
			mark.Name = "SaltWarning"
			mark.Shape = Enum.PartType.Cylinder
			mark.Size = Vector3.new(0.3, Config.SALT_RADIUS * 2, Config.SALT_RADIUS * 2)
			mark.CFrame = CFrame.new(spot + Vector3.new(0, 0.4, 0)) * CFrame.Angles(0, 0, math.rad(90))
			mark.Anchored = true
			mark.CanCollide = false
			mark.CanQuery = false
			mark.Material = Enum.Material.Neon
			mark.Color = Color3.fromRGB(255, 60, 60)
			mark.Transparency = 0.3
			mark.Parent = rockFolder
			Debris:AddItem(mark, Config.SALT_WARNING + 0.5)
			task.delay(Config.SALT_WARNING, function()
				local rock = Instance.new("Part")
				rock.Name = "SaltRock"
				rock.Shape = Enum.PartType.Ball
				rock.Size = Vector3.one * 6
				rock.Color = Color3.fromRGB(245, 170, 185)
				rock.Material = Enum.Material.Glass
				rock.Anchored = true
				rock.CanCollide = false
				rock.CFrame = CFrame.new(spot + Vector3.new(0, 3, 0))
				rock.Parent = rockFolder
				Debris:AddItem(rock, 1.5)
				for other, profile in State.profiles do
					local r = State.rootPart(other)
					if r and ((r.Position - spot) * Vector3.new(1, 0, 1)).Magnitude < Config.SALT_RADIUS then
						State.sound(other, "Hit", spot)
						if not Gear.protects(profile.data.gear, "dark") then
							EggSystem.hit(other, Config.EGG_HIT_PENALTY, "Ouch! A salt rock fell on you!")
							Hazards.push(other, spot)
						end
					end
				end
			end)
		end
	end
end

-- Railway Junction: the train runs the curved track (see Biomes.trainAt).
function Hazards.trainTick()
	local train = Biomes.TRAIN
	local angle, moving = Biomes.trainAt(now(), Config.TRAIN_WAIT, Config.TRAIN_BLINK, Config.TRAIN_SPEED)
	if not moving then
		return
	end
	local halfAngle = math.deg(train.length / 2 / train.radius)
	for player in State.profiles do
		local root = State.rootPart(player)
		if root then
			local r = Biomes.radiusOf(root.Position)
			local off = math.abs(Biomes.angleDiff(Biomes.angleOf(root.Position), angle))
			if
				math.abs(r - train.radius) < Config.TRAIN_HIT_RADIUS - 3
				and off < halfAngle
				and root.Position.Y < 20
			then
				local trackPoint = Biomes.polar(Biomes.angleOf(root.Position), train.radius)
				State.sound(player, "Hit", root.Position)
				EggSystem.hit(player, Config.EGG_HIT_PENALTY, "TOOT TOOT! The train bumped you off the track!")
				Hazards.push(player, trackPoint, Config.KNOCKBACK * 1.2)
			end
		end
	end
end

function Hazards.init(gameMap)
	map = gameMap
	rockFolder = Instance.new("Folder")
	rockFolder.Name = "ChaiChaosHazards"
	rockFolder.Parent = workspace
	workspace:SetAttribute("Sandstorm", false)
	task.spawn(function()
		while true do
			task.wait(0.25)
			Hazards.tick()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.1)
			Hazards.trainTick()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(Config.SANDSTORM_EVERY)
			workspace:SetAttribute("Sandstorm", true)
			task.wait(Config.SANDSTORM_DURATION)
			workspace:SetAttribute("Sandstorm", false)
		end
	end)
	for _, timer in
		{
			{ Config.WAVE_EVERY, Hazards.wave },
			{ Config.SNOWBALL_EVERY, Hazards.snowball },
			{ Config.SALT_FALL_EVERY, Hazards.salt },
		}
	do
		task.spawn(function()
			while true do
				task.wait(timer[1])
				timer[2]()
			end
		end)
	end
end

return Hazards
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">Kismat</string>
          <string name="Source"><![CDATA[-- Kismat Roll: an RNG roll for a random brainrot.
--
-- Pay rupees or use a Kismat Roll. Rolls come free with daily chai and quests
-- and can be bought with Robux (see Shop.luau and Config.ROLL_PRODUCTS).
--
-- The odds are in Config.ROLL_ODDS and Mutations.luau and are shown in the
-- Kismat panel before anyone buys. Every ROLL_PITY rolls an Epic or better is
-- guaranteed; a Legendary or Mythic is never guaranteed.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)
local Mutations = require(Shared.Mutations)
local Themes = require(Shared.Themes)
local Events = require(Shared.Events)

local State = require(script.Parent.State)
local Havelis = require(script.Parent.Havelis)
local Picker = require(script.Parent.Picker)

local Kismat = {}

local EPIC_PLUS = { Epic = true, Legendary = true, Mythic = true }

local lastRoll: { [Player]: number } = {}

-- Picks a brainrot with the Kismat odds. With `pity`, only Epic or better.
-- Luck from events does not apply, so the odds in the panel are exact.
function Kismat.pick(pity: boolean)
	if not pity then
		return Picker.pick(Config.ROLL_ODDS)
	end
	local odds = {}
	for rarity, weight in Config.ROLL_ODDS do
		odds[rarity] = if EPIC_PLUS[rarity] then weight else 0
	end
	return Picker.pick(odds)
end

-- Rupee price after the Chai Dhaba perk and the Mela Night discount.
function Kismat.cost(profile): number
	local event = Events.current()
	local discount = (1 - (Themes.perk(profile.data.theme, "rollDiscount") or 0))
		* (1 - (if event then event.rollDiscount or 0 else 0))
	return math.floor(Config.ROLL_RUPEE_COST * discount)
end

-- How much likelier mutations are for this player right now.
function Kismat.mutationBoost(profile): number
	local event = Events.current()
	return (Themes.perk(profile.data.theme, "rollMutation") or 1) * (if event then event.mutationMult or 1 else 1)
end

function Kismat.roll(player: Player, method: any)
	local profile = State.profiles[player]
	if not profile or not profile.haveli or (method ~= "rupees" and method ~= "token") then
		return
	end
	local now = os.clock()
	if now < (lastRoll[player] or -math.huge) + Config.ROLL_COOLDOWN then
		return
	end
	local data = profile.data
	if not Havelis.hasFreePlot(profile) then
		State.notify(player, "bad", "No empty plot for a new brainrot! Unlock a plot or sell one first.")
		return
	end
	if method == "token" then
		if data.rollTokens < 1 then
			State.notify(player, "bad", "You have no Kismat Rolls left.")
			return
		end
		data.rollTokens -= 1
	else
		local cost = Kismat.cost(profile)
		if data.rupees < cost then
			State.notify(player, "bad", ("A Kismat Roll costs %s."):format(Format.rupees(cost)))
			return
		end
		State.addRupees(profile, -cost)
	end
	lastRoll[player] = now

	local pity = data.rollPity + 1 >= Config.ROLL_PITY
	local def = Kismat.pick(pity)
	local mutation = Mutations.roll("roll", Kismat.mutationBoost(profile))
	data.rollPity = if EPIC_PLUS[def.rarity] then 0 else data.rollPity + 1
	local _, isNew = Havelis.adopt(profile, def, mutation, nil, true)
	State.syncTokens(profile)
	Remotes.RollResult:FireClient(player, def.id, mutation or "", isNew, pity)
	State.track(profile, "roll")
	if mutation then
		State.track(profile, "mutation")
	end

	if def.rarity == "Legendary" or def.rarity == "Mythic" or mutation == "Rainbow" then
		-- wait for the roller's reveal before telling everyone
		task.delay(Config.ROLL_COOLDOWN, function()
			State.notifyAll(
				"rare",
				("%s rolled a %s %s!"):format(
					player.DisplayName,
					def.rarity:upper(),
					Mutations.displayName(def, mutation)
				)
			)
		end)
	end
end

function Kismat.forget(player: Player)
	lastRoll[player] = nil
end

function Kismat.init()
	Remotes.Roll.OnServerEvent:Connect(Kismat.roll)
end

return Kismat
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">Leaderboard</string>
          <string name="Source"><![CDATA[-- The big board at the Chowk: the top players by Naya Safar, then rupees.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Format = require(Shared.Format)

local State = require(script.Parent.State)

local Leaderboard = {}

local ROWS = 9 -- a title and 8 players

local function row(list: Frame, order: number): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = "Row" .. order
	label.LayoutOrder = order
	label.Size = UDim2.fromScale(1, 1 / ROWS)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = if order == 0 then Color3.fromRGB(255, 215, 80) else Color3.new(1, 1, 1)
	label.Text = if order == 0 then "TOP PLAYERS" else ""
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Parent = label
	label.Parent = list
	return label
end

function Leaderboard.refresh(rows: { TextLabel })
	local entries = {}
	for _, player in Players:GetPlayers() do
		local profile = State.profiles[player]
		if profile then
			table.insert(
				entries,
				{ name = player.DisplayName, rebirths = profile.data.rebirths, rupees = profile.data.rupees }
			)
		end
	end
	table.sort(entries, function(a, b)
		if a.rebirths ~= b.rebirths then
			return a.rebirths > b.rebirths
		end
		return a.rupees > b.rupees
	end)
	for i = 1, ROWS - 1 do
		local entry = entries[i]
		rows[i].Text = if entry
			then ("%d. %s  ·  Safar %d  ·  Rs %s"):format(i, entry.name, entry.rebirths, Format.short(entry.rupees))
			else ""
	end
end

function Leaderboard.init(map)
	local list = map.leaderboard
	if not list then
		return
	end
	list:ClearAllChildren()
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list
	row(list, 0)
	local rows = {}
	for i = 1, ROWS - 1 do
		rows[i] = row(list, i)
	end
	task.spawn(function()
		while true do
			Leaderboard.refresh(rows)
			task.wait(5)
		end
	end)
end

return Leaderboard
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="27">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Chai Chaos server entry point. Wires the world (the Chowk, the ring of
-- havelis and the eight biomes), players, income, eggs, hazards, treasure, the
-- Chowk shops, riding, the Taala lock, the chappal, daily chai, quests, events,
-- Kismat Rolls, Robux purchases and Naya Safar (rebirth) together.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Config = require(Shared.Config)
local Brainrots = require(Shared.Brainrots)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)
local Themes = require(Shared.Themes)

local State = require(script.Parent.State)
local PlayerData = require(script.Parent.PlayerData)
local MapBuilder = require(script.Parent.MapBuilder)
local Models = require(script.Parent.Models)
local Havelis = require(script.Parent.Havelis)
local Stealing = require(script.Parent.Stealing)
local Shop = require(script.Parent.Shop)
local Kismat = require(script.Parent.Kismat)
local World = require(script.Parent.World)
local Defenses = require(script.Parent.Defenses)
local EventRunner = require(script.Parent.EventRunner)
local QuestBook = require(script.Parent.QuestBook)
local Leaderboard = require(script.Parent.Leaderboard)
local EggSystem = require(script.Parent.EggSystem)
local Hazards = require(script.Parent.Hazards)
local Treasure = require(script.Parent.Treasure)
local Upgrades = require(script.Parent.Upgrades)
local Garage = require(script.Parent.Garage)
local Zones = require(script.Parent.Zones)

World.init()
local map = MapBuilder.ensure()
Havelis.init(map)
Defenses.init(map)
Stealing.init(map)
EggSystem.init(map)
Hazards.init(map)
Treasure.init(map)
Upgrades.init(map)
Garage.init(map)
Shop.init()
Shop.paintHook = Garage.onPaintBought
Kismat.init()
QuestBook.init()
EventRunner.init()
Leaderboard.init(map)

---------------------------------------------------------------------------
-- The chappal tool: bonk a thief to make them drop your brainrot
---------------------------------------------------------------------------
local chappalTemplate = Instance.new("Tool")
chappalTemplate.Name = "Chappal"
chappalTemplate.ToolTip = "Bonk a chor to get your brainrot back"
chappalTemplate.CanBeDropped = false
do
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.5, 0.2, 1.8)
	handle.Color = Color3.fromRGB(60, 110, 210)
	handle.Material = Enum.Material.SmoothPlastic
	handle.CanCollide = false
	handle.Massless = true
	handle.Parent = chappalTemplate
	local strap = Instance.new("Part")
	strap.Name = "Strap"
	strap.Size = Vector3.new(0.6, 0.25, 0.35)
	strap.Color = Color3.fromRGB(25, 25, 30)
	strap.CanCollide = false
	strap.Massless = true
	strap.CFrame = handle.CFrame * CFrame.new(0, 0.2, -0.3)
	strap.Parent = chappalTemplate
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = strap
	weld.Parent = handle
end

local function giveChappal(player: Player)
	local backpack = player:WaitForChild("Backpack", 10)
	if not backpack or backpack:FindFirstChild("Chappal") then
		return
	end
	if player.Character and player.Character:FindFirstChild("Chappal") then
		return
	end
	local tool = chappalTemplate:Clone()
	tool.Activated:Connect(function()
		-- plays the default sword-slash animation
		local anim = Instance.new("StringValue")
		anim.Name = "toolanim"
		anim.Value = "Slash"
		anim.Parent = tool
		Debris:AddItem(anim, 1)
		Stealing.bonk(player)
	end)
	tool.Parent = backpack
end

---------------------------------------------------------------------------
-- Players joining and leaving
---------------------------------------------------------------------------
local function makeLeaderstats(player: Player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local rupees = Instance.new("IntValue")
	rupees.Name = "Rupees"
	rupees.Parent = stats
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = stats
	stats.Parent = player
end

local function today(): number
	return math.floor(os.time() / 86400)
end

local function plural(count: number, one: string, many: string): string
	return ("%d %s"):format(count, if count == 1 then one else many)
end

local function dailyChai(profile)
	local data = profile.data
	if data.lastDaily >= today() then
		return
	end
	data.lastDaily = today()

	local extras = {}
	if Config.DAILY_FREE_ROLLS > 0 then
		data.rollTokens += Config.DAILY_FREE_ROLLS
		table.insert(extras, plural(Config.DAILY_FREE_ROLLS, "free Kismat Roll", "free Kismat Rolls"))
	end
	if Config.DAILY_FREE_STEALS > 0 then
		data.stealTokens += Config.DAILY_FREE_STEALS
		table.insert(extras, plural(Config.DAILY_FREE_STEALS, "free Chor Pass", "free Chor Passes"))
	end
	State.syncTokens(profile)
	local bonus = if #extras > 0 then " Plus " .. table.concat(extras, " and ") .. "!" else ""

	if math.random() < 0.5 and Havelis.hasFreePlot(profile) then
		local pool = {}
		for _, rarity in { "Common", "Uncommon" } do
			for _, def in Brainrots.byRarity[rarity] do
				table.insert(pool, def)
			end
		end
		local def = pool[math.random(#pool)]
		Havelis.adopt(profile, def)
		State.notify(
			profile.player,
			"good",
			("Daily chai! A free %s is walking into your haveli.%s"):format(def.name, bonus)
		)
	else
		local amount = math.max(
			Config.DAILY_MIN_RUPEES,
			math.floor(Havelis.incomePerSecond(profile) * Config.DAILY_INCOME_SECONDS)
		)
		State.addRupees(profile, amount)
		State.notify(
			profile.player,
			"good",
			("Daily chai! Here is %s to start your day.%s"):format(Format.rupees(amount), bonus)
		)
	end
end

local function startProtection(profile)
	profile.protectedUntil = workspace:GetServerTimeNow() + Config.NEW_PLAYER_PROTECTION
	profile.player:SetAttribute("ProtectedUntil", profile.protectedUntil)
	task.delay(Config.NEW_PLAYER_PROTECTION + 0.1, function()
		if State.profiles[profile.player] == profile then
			Havelis.refreshPrompts(profile)
		end
	end)
end

local function onCharacterAdded(profile, character: Model)
	character:WaitForChild("HumanoidRootPart", 10)
	task.wait()
	if State.profiles[profile.player] == profile then
		profile.carrySpeed = nil
		Garage.reset(profile)
		Havelis.teleportHome(profile)
		Havelis.applyWalkSpeed(profile)
		Defenses.applyCharacter(profile)
	end
end

local function onPlayerAdded(player: Player)
	makeLeaderstats(player)
	player.CharacterAdded:Connect(function()
		giveChappal(player)
	end)
	if player.Character then
		task.spawn(giveChappal, player)
	end

	local data, canSave = PlayerData.load(player.UserId)
	if not player.Parent then
		return -- left while loading
	end

	local profile = State.newProfile(player, data, canSave)
	State.profiles[player] = profile
	State.syncStats(profile)
	State.syncDiscovered(profile)
	player:SetAttribute("Income", 0)
	player:SetAttribute("LockedUntil", 0)
	player:SetAttribute("LockReadyAt", 0)

	State.syncGear(profile)
	State.syncZones(profile)
	Garage.sync(profile)
	if Havelis.claim(profile) then
		player:SetAttribute("HaveliIndex", profile.haveli.index)
		player:SetAttribute("HomePosition", profile.haveli.doorOutside.Position)
		EggSystem.restore(profile)
	else
		State.notify(
			player,
			"bad",
			"Every haveli is taken, so there is no haveli for you right now. Try another server!"
		)
	end

	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(profile, character)
	end)
	if player.Character then
		task.spawn(onCharacterAdded, profile, player.Character)
	end

	startProtection(profile)
	Havelis.refreshPrompts(profile)
	State.syncTokens(profile)
	task.spawn(Shop.setup, profile)
	QuestBook.ensure(profile)
	State.syncQuests(profile)
	dailyChai(profile)
	State.notify(
		player,
		"info",
		"Welcome to Chai Chaos! Follow your radar out through the town gate to Mango Bagh, find eggs and carry them home to hatch. Buy a vehicle at the Gaari Showroom to go further!"
	)
	if next(data.discovered) == nil then
		State.notify(player, "info", "Open the Haveli menu to pick your haveli's theme!")
	end
	if not canSave then
		State.notify(player, "bad", "Saving is off right now, so your progress will not be kept.")
		if RunService:IsStudio() then
			warn(
				"[ChaiChaos] To test saving in Studio: publish the place, then turn on "
					.. "Game Settings > Security > Enable Studio Access to API Services."
			)
		end
	end
end

local function saveProfile(profile)
	if profile.canSave then
		Havelis.syncData(profile)
		EggSystem.syncData(profile)
		PlayerData.save(profile.player.UserId, profile.data)
	end
end

local function onPlayerRemoving(player: Player)
	local profile = State.profiles[player]
	Stealing.forget(player)
	Kismat.forget(player)
	if not profile then
		return
	end
	Stealing.releasePlayer(profile)
	Garage.park(profile)
	Havelis.syncData(profile)
	EggSystem.syncData(profile)
	EggSystem.release(profile)
	Havelis.release(profile)
	State.profiles[player] = nil
	saveProfile(profile)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

game:BindToClose(function()
	local pending = 0
	for _, profile in State.profiles do
		pending += 1
		task.spawn(function()
			saveProfile(profile)
			pending -= 1
		end)
	end
	local started = os.clock()
	while pending > 0 and os.clock() - started < 25 do
		task.wait(0.1)
	end
end)

task.spawn(function()
	while true do
		task.wait(Config.AUTOSAVE_INTERVAL)
		for _, profile in State.profiles do
			task.spawn(saveProfile, profile)
		end
	end
end)

---------------------------------------------------------------------------
-- Income: every brainrot drops rupees into its owner's galla each second
---------------------------------------------------------------------------
task.spawn(function()
	while true do
		task.wait(1)
		for player, profile in State.profiles do
			local income = Havelis.incomePerSecond(profile)
			profile.data.galla += income
			player:SetAttribute("Income", income)
			Havelis.updateGalla(profile)
		end
	end
end)

---------------------------------------------------------------------------
-- Every ProximityPrompt in the game is handled here
---------------------------------------------------------------------------
-- (ShopPrompts at the Chowk only open a window on the player's screen.)
ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, player: Player)
	local name = prompt.Name
	if name == "EggPrompt" then
		EggSystem.pickUp(player, prompt:FindFirstAncestorOfClass("Model"))
	elseif name == "TreasurePrompt" then
		Treasure.open(player, prompt:FindFirstAncestorOfClass("Model"))
	elseif name == "ClimbPrompt" then
		Treasure.climb(player, prompt:FindFirstAncestorOfClass("Model"))
	elseif name == "StealPrompt" then
		local model = Models.ownerModel(prompt)
		if model then
			Stealing.start(player, model)
		end
	elseif name == "GatePrompt" then
		Zones.unlock(player, prompt.Parent)
	elseif name == "PumpPrompt" then
		Garage.refuel(player, prompt.Parent)
	elseif name == "RideAlong" then
		Garage.rideAlong(player, prompt.Parent)
	elseif name == "RickshawHome" then
		Zones.rideHome(player, prompt.Parent)
	end
end)

---------------------------------------------------------------------------
-- Haveli buttons: Taala lock, upgrades and themes
---------------------------------------------------------------------------
Remotes.LockHaveli.OnServerEvent:Connect(Havelis.lock)
Remotes.UpgradeHaveli.OnServerEvent:Connect(Havelis.upgrade)
Remotes.SetTheme.OnServerEvent:Connect(Havelis.setTheme)

---------------------------------------------------------------------------
-- Naya Safar (rebirth) at the Chowk: costs more every time, unlocks a new
-- theme. You keep your gear, vehicles, unlocked zones, Kismat Rolls, Chor
-- Passes and Collection Book. Each rebirth opens more ring 3 zones.
---------------------------------------------------------------------------
Remotes.Rebirth.OnServerEvent:Connect(function(player: Player)
	local profile = State.profiles[player]
	if not profile or not profile.haveli then
		return
	end
	if not Upgrades.atShop(player, "Rebirth") then
		State.notify(player, "bad", "Go to the Naya Safar stall in the Chowk to rebirth.")
		return
	end
	local data = profile.data
	local cost = Config.rebirthCost(data.rebirths)
	if data.rupees < cost then
		State.notify(player, "bad", ("You need %s for a Naya Safar."):format(Format.rupees(cost)))
		return
	end
	Stealing.releasePlayer(profile)
	Garage.park(profile)
	EggSystem.reset(profile)
	Havelis.clearBrainrots(profile)
	data.rebirths += 1
	data.rupees = Config.START_RUPEES
	data.level = 1
	data.trackerLevel = 1
	data.galla = 0
	data.owned = {}
	State.syncStats(profile)
	State.syncGear(profile)
	Zones.refresh(profile)
	State.sound(player, "Rebirth")
	State.syncQuests(profile)
	Havelis.restyle(profile)
	State.notifyAll(
		"rare",
		("%s started a Naya Safar! Rebirth %d, now earning +%d%% forever."):format(
			player.DisplayName,
			data.rebirths,
			math.floor(Config.REBIRTH_BONUS * data.rebirths * 100)
		)
	)
	for _, theme in Themes.list do
		if theme.rebirths == data.rebirths then
			State.notify(player, "rare", ("New haveli theme unlocked: %s! %s"):format(theme.name, theme.perkText))
		end
	end
	for _, biome in require(Shared.Biomes).list do
		if biome.rebirths == data.rebirths then
			State.notify(player, "rare", ("%s's gate is open for you now! %s"):format(biome.name, biome.blurb))
		end
	end
	task.spawn(saveProfile, profile)
end)

print(
	("[ChaiChaos] Ready with %d brainrots, %d havelis and %d zones."):format(
		#Brainrots.list,
		#map.havelis,
		#require(Shared.Biomes).list
	)
)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[-- Builds the world if the place does not have one yet, then finds all the
-- important parts.
--
-- The Chowk (town square) is in the middle with the fountain and the shops:
-- Sell, Gear, Tracker, Kismat Kettle, Naya Safar, Quests and the leaderboard.
-- The 8 havelis stand in a ring around it, facing the fountain. Around them is
-- the Lahore bazaar (with the Gaari Showroom and Ustad's Workshop) inside the
-- town wall. Four roads lead out through the town gates to the 4 regions,
-- and zigzag from gate to gate through their 3 rings of zones (see
-- Biomes.luau for the layout and BiomeBuilder.luau for the zones).
--
-- Haveli layout (looking from the Chowk): the door is in the front wall, the
-- courtyard has the galla, the egg incubators and the stairs, plots 1-10 are on
-- the ground floor and plots 11-20 on the second floor above them.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Config = require(Shared.Config)
local Themes = require(Shared.Themes)
local Biomes = require(Shared.Biomes)

local BiomeBuilder = require(script.Parent.BiomeBuilder)
local Props = require(script.Parent.Props)

local MapBuilder = {}

local MAP_NAME = "ChaiChaosMap"
local GROUND_Y = Biomes.GROUND_Y
local HAVELI_W = 72
local HAVELI_D = 52
local WALL_H = 12 -- ground floor height (the second floor is on top of it)
local UPPER_H = 9 -- second floor wall height
local DOOR_W = 14
local DOOR_H = 9
local FLOOR_TOP = 0.4
local PLOT_SIZE = 8
local PLOT_COLUMNS = { -20, -9, 2, 13, 24 }
local PLOT_ROWS = { 18, 6 } -- plots 1-5 at the back, 6-10 in front (same for 11-20 upstairs)
local DECK_FRONT = -6 -- the second floor covers z from here to the back wall
local STAIR_X = -31.5
local STAIR_W = 7
local STAIR_START = -22
local STAIR_STEPS = 16
local PLOTS_PER_FLOOR = 10
local INCUBATOR_SPOTS = { { 11, -11 }, { 19, -11 }, { -17, -11 }, { -21, -18 } }
local SHOP_RADIUS = 50

MapBuilder.PLOTS_PER_FLOOR = PLOTS_PER_FLOOR

export type Haveli = {
	index: number,
	model: Model,
	origin: CFrame, -- centre of the floor's top, facing the Chowk
	size: Vector3,
	upperY: number, -- height of the second floor above the ground floor
	plots: { BasePart },
	plotLabels: { TextLabel },
	incubators: { BasePart },
	incubatorLabels: { TextLabel },
	galla: BasePart,
	gallaLabel: TextLabel,
	door: BasePart,
	barrier: BasePart,
	signLabel: TextLabel,
	walls: { BasePart },
	trims: { BasePart },
	accents: { BasePart },
	floors: { BasePart },
	stairGates: { BasePart },
	roof: BasePart?,
	decor: Folder,
	guardSpot: CFrame,
	spawn: CFrame,
	doorInside: CFrame,
	doorOutside: CFrame,
	stairBottom: CFrame,
	stairTop: CFrame,
	brainrotFolder: Folder,
	owner: any, -- the profile of the player living here
	guard: Model?,
}

export type Map = {
	model: Model,
	havelis: { Haveli },
	shops: { [string]: BasePart },
	leaderboard: Frame?,
	biomes: { [string]: any },
	gates: { [string]: BasePart }, -- the barrier across each zone's gate (not the free one)
	doors: { BasePart }, -- the shortcut doors between regions
	pumps: { BasePart }, -- petrol pumps
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	local parent = props.Parent
	for name, value in props do
		if name ~= "Parent" then
			(p :: any)[name] = value
		end
	end
	p.Parent = parent
	return p
end
MapBuilder.part = part

local UP = CFrame.Angles(0, 0, math.rad(90)) -- turns a cylinder upright
local function cylinderUp(cf: CFrame): CFrame
	return cf * UP
end

local function surfaceText(target: BasePart, face: Enum.NormalId, text: string, color: Color3?): TextLabel
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Gui"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.Text = text
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = target
	return label
end
MapBuilder.surfaceText = surfaceText

local BRIGHT = {
	rgb(255, 70, 90),
	rgb(255, 205, 40),
	rgb(70, 210, 110),
	rgb(70, 160, 255),
	rgb(255, 120, 220),
	rgb(255, 150, 40),
}

local function buildHaveli(parent: Instance, index: number, center: Vector3)
	local origin = CFrame.lookAt(center, Vector3.new(0, center.Y, 0))
	local function at(x: number, y: number, z: number): CFrame
		return origin * CFrame.new(x, y, z)
	end
	local look = Themes.EMPTY
	local halfW, halfD = HAVELI_W / 2, HAVELI_D / 2
	local deckY = FLOOR_TOP + WALL_H
	local front = -halfD + 0.5

	local haveli = Instance.new("Model")
	haveli.Name = "Haveli" .. index
	haveli:SetAttribute("HaveliIndex", index)

	part({
		Name = "Floor",
		Size = Vector3.new(HAVELI_W, FLOOR_TOP, HAVELI_D),
		CFrame = at(0, FLOOR_TOP / 2, 0),
		Color = look.floor,
		Parent = haveli,
	})
	local deckDepth = halfD - DECK_FRONT
	part({
		Name = "Deck",
		Size = Vector3.new(HAVELI_W - 2, 1, deckDepth),
		CFrame = at(0, deckY - 0.5, DECK_FRONT + deckDepth / 2),
		Color = look.floor,
		Parent = haveli,
	})

	local walls = Instance.new("Folder")
	walls.Name = "Walls"
	walls.Parent = haveli
	local trim = Instance.new("Folder")
	trim.Name = "Trim"
	trim.Parent = haveli
	local accent = Instance.new("Folder")
	accent.Name = "Accent"
	accent.Parent = haveli

	local segment = (HAVELI_W - DOOR_W) / 2
	local upperY = deckY + UPPER_H / 2
	local wallPieces = {
		-- back wall, both floors
		{ Vector3.new(HAVELI_W, WALL_H + UPPER_H, 1), at(0, FLOOR_TOP + (WALL_H + UPPER_H) / 2, halfD - 0.5) },
		-- side walls, ground floor
		{ Vector3.new(1, WALL_H, HAVELI_D), at(-halfW + 0.5, FLOOR_TOP + WALL_H / 2, 0) },
		{ Vector3.new(1, WALL_H, HAVELI_D), at(halfW - 0.5, FLOOR_TOP + WALL_H / 2, 0) },
		-- side walls, second floor
		{ Vector3.new(1, UPPER_H, deckDepth), at(-halfW + 0.5, upperY, DECK_FRONT + deckDepth / 2) },
		{ Vector3.new(1, UPPER_H, deckDepth), at(halfW - 0.5, upperY, DECK_FRONT + deckDepth / 2) },
		-- front wall with the door gap
		{ Vector3.new(segment, WALL_H, 1), at(-(DOOR_W / 2 + segment / 2), FLOOR_TOP + WALL_H / 2, front) },
		{ Vector3.new(segment, WALL_H, 1), at(DOOR_W / 2 + segment / 2, FLOOR_TOP + WALL_H / 2, front) },
		{ Vector3.new(DOOR_W, WALL_H - DOOR_H, 1), at(0, FLOOR_TOP + DOOR_H + (WALL_H - DOOR_H) / 2, front) },
	}
	for _, piece in wallPieces do
		part({ Name = "Wall", Size = piece[1], CFrame = piece[2], Color = look.wall, Parent = walls })
	end

	-- corner towers with domes
	for _, corner in { { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } } do
		local height = if corner[2] < 0 then WALL_H + 3 else WALL_H + UPPER_H + 3
		local x, z = corner[1] * halfW, corner[2] * halfD
		part({
			Name = "Tower",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(height, 4, 4),
			CFrame = cylinderUp(at(x, FLOOR_TOP + height / 2, z)),
			Color = look.trim,
			Parent = trim,
		})
		part({
			Name = "Dome",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 4.6,
			CFrame = at(x, FLOOR_TOP + height + 0.8, z),
			Color = look.accent,
			Parent = accent,
		})
	end
	for _, x in { -DOOR_W / 2, DOOR_W / 2 } do
		part({
			Name = "DoorPillar",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(WALL_H + 1, 1.8, 1.8),
			CFrame = cylinderUp(at(x, FLOOR_TOP + (WALL_H + 1) / 2, front - 0.2)),
			Color = look.trim,
			Parent = trim,
		})
	end
	-- top edge of the front wall and second floor railing
	part({
		Name = "Parapet",
		Size = Vector3.new(HAVELI_W, 1, 1.4),
		CFrame = at(0, FLOOR_TOP + WALL_H + 0.5, front),
		Color = look.trim,
		Parent = trim,
	})
	local railFrom = STAIR_X + STAIR_W / 2
	local railLength = halfW - 1 - railFrom
	part({
		Name = "Railing",
		Size = Vector3.new(railLength, 3, 0.6),
		CFrame = at(railFrom + railLength / 2, deckY + 1.5, DECK_FRONT),
		Color = look.trim,
		Parent = trim,
	})
	for _, x in { -20, -4, 12, 28 } do
		part({
			Name = "DeckPillar",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(WALL_H, 1.6, 1.6),
			CFrame = cylinderUp(at(x, FLOOR_TOP + WALL_H / 2, DECK_FRONT)),
			Color = look.trim,
			Parent = trim,
		})
	end

	-- stairs up to the second floor
	local stepH = WALL_H / STAIR_STEPS
	for i = 1, STAIR_STEPS do
		part({
			Name = "Step",
			Size = Vector3.new(STAIR_W, stepH * i, 1),
			CFrame = at(STAIR_X, FLOOR_TOP + stepH * i / 2, STAIR_START + i - 0.5),
			Color = look.trim,
			Parent = trim,
		})
	end
	-- blocked until the second floor is unlocked
	local gates = Instance.new("Folder")
	gates.Name = "StairGates"
	gates.Parent = haveli
	local gateStripe = rgb(255, 150, 30)
	part({
		Name = "StairGate",
		Size = Vector3.new(STAIR_W, 10, 0.6),
		CFrame = at(STAIR_X, FLOOR_TOP + 5, STAIR_START - 0.6),
		Color = gateStripe,
		Material = Enum.Material.Neon,
		Transparency = 0.5,
		Parent = gates,
	})
	part({
		Name = "StairGate",
		Size = Vector3.new(0.6, WALL_H + 3, STAIR_STEPS + 0.6),
		CFrame = at(STAIR_X + STAIR_W / 2 + 0.3, FLOOR_TOP + (WALL_H + 3) / 2, STAIR_START + STAIR_STEPS / 2 - 0.3),
		Color = gateStripe,
		Material = Enum.Material.Neon,
		Transparency = 0.5,
		Parent = gates,
	})
	local gateSign = part({
		Name = "StairSign",
		Size = Vector3.new(STAIR_W, 2, 0.3),
		CFrame = at(STAIR_X, FLOOR_TOP + 7, STAIR_START - 1),
		Color = rgb(40, 40, 45),
		Parent = gates,
	})
	surfaceText(gateSign, Enum.NormalId.Front, ("2nd floor at Level %d"):format(Config.UPPER_FLOOR_LEVEL))

	part({
		Name = "Roof",
		Size = Vector3.new(HAVELI_W, 1, deckDepth),
		CFrame = at(0, deckY + UPPER_H + 0.5, DECK_FRONT + deckDepth / 2),
		Color = look.trim,
		Transparency = 1,
		CanCollide = false,
		Parent = haveli,
	})

	-- door, laser barrier and sign
	part({
		Name = "Door",
		Size = Vector3.new(DOOR_W - 1, DOOR_H, 2),
		CFrame = at(0, FLOOR_TOP + DOOR_H / 2, front),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		Parent = haveli,
	})
	part({
		Name = "Barrier",
		Size = Vector3.new(DOOR_W, DOOR_H, 0.5),
		CFrame = at(0, FLOOR_TOP + DOOR_H / 2, front),
		Color = rgb(255, 50, 70),
		Material = Enum.Material.Neon,
		Transparency = 1,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		Parent = haveli,
	})
	local sign = part({
		Name = "Sign",
		Size = Vector3.new(24, 3.6, 0.6),
		CFrame = at(0, FLOOR_TOP + WALL_H + 2.8, front),
		Color = rgb(30, 130, 100),
		Parent = haveli,
	})
	surfaceText(sign, Enum.NormalId.Front, "Khaali Haveli", rgb(255, 240, 160))

	for i = 1, 2 * PLOTS_PER_FLOOR do
		local j = (i - 1) % PLOTS_PER_FLOOR + 1
		local upstairs = i > PLOTS_PER_FLOOR
		local column = PLOT_COLUMNS[(j - 1) % #PLOT_COLUMNS + 1]
		local row = PLOT_ROWS[math.ceil(j / #PLOT_COLUMNS)]
		local plot = part({
			Name = "Plot" .. i,
			Size = Vector3.new(PLOT_SIZE, 0.3, PLOT_SIZE),
			CFrame = at(column, (if upstairs then deckY else FLOOR_TOP) + 0.15, row),
			Color = rgb(240, 230, 205),
			Parent = haveli,
		})
		plot:SetAttribute("HaveliIndex", index)
		plot:SetAttribute("PlotIndex", i)
		surfaceText(plot, Enum.NormalId.Top, "", rgb(255, 255, 255))
	end

	local galla = part({
		Name = "Galla",
		Size = Vector3.new(5, 3.5, 3.5),
		CFrame = at(26, FLOOR_TOP + 1.75, -18),
		Color = rgb(120, 75, 40),
		Material = Enum.Material.WoodPlanks,
		Parent = haveli,
	})
	part({
		Name = "GallaTrim",
		Size = Vector3.new(5.2, 0.5, 1),
		CFrame = at(26, FLOOR_TOP + 3.6, -18),
		Color = rgb(255, 205, 60),
		Material = Enum.Material.Metal,
		CanCollide = false,
		Parent = haveli,
	})
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "GallaGui"
	billboard.Size = UDim2.fromScale(8, 2.4)
	billboard.StudsOffset = Vector3.new(0, 3.8, 0)
	billboard.MaxDistance = 80
	billboard.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = rgb(255, 225, 90)
	label.Text = "Galla"
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Parent = label
	label.Parent = billboard
	billboard.Parent = galla

	for name, cf in
		{
			Spawn = at(0, FLOOR_TOP + 0.5, -16) * CFrame.Angles(0, math.pi, 0),
			GuardSpot = at(-10, FLOOR_TOP, -21),
		}
	do
		part({
			Name = name,
			Size = Vector3.new(4, 1, 4),
			CFrame = cf,
			Transparency = 1,
			CanCollide = false,
			CanTouch = false,
			CanQuery = false,
			Parent = haveli,
		})
	end

	-- egg incubators (nests) in the courtyard; haveli levels unlock more of them
	for i, spot in INCUBATOR_SPOTS do
		local nest = part({
			Name = "Incubator" .. i,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1.2, 5, 5),
			CFrame = at(spot[1], FLOOR_TOP + 0.6, spot[2]) * CFrame.Angles(0, 0, math.rad(90)),
			Color = rgb(150, 105, 60),
			Material = Enum.Material.Fabric,
			Parent = haveli,
		})
		nest:SetAttribute("IncubatorIndex", i)
		local straw = Instance.new("BillboardGui")
		straw.Name = "IncubatorGui"
		straw.Size = UDim2.fromScale(7, 1.8)
		straw.StudsOffset = Vector3.new(0, 4.2, 0)
		straw.MaxDistance = 60
		straw.LightInfluence = 0
		local text = Instance.new("TextLabel")
		text.Name = "Label"
		text.Size = UDim2.fromScale(1, 1)
		text.BackgroundTransparency = 1
		text.Font = Enum.Font.FredokaOne
		text.TextScaled = true
		text.TextColor3 = rgb(255, 240, 180)
		text.Text = "Incubator"
		local outline = Instance.new("UIStroke")
		outline.Thickness = 2
		outline.Parent = text
		text.Parent = straw
		straw.Parent = nest
	end

	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	decor.Parent = haveli
	local brainrots = Instance.new("Folder")
	brainrots.Name = "Brainrots"
	brainrots.Parent = haveli

	haveli.Parent = parent
end

---------------------------------------------------------------------------
-- The Chowk
---------------------------------------------------------------------------
local function shopPrompt(target: BasePart, shop: string, label: string)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "ShopPrompt"
	prompt.ActionText = "Open"
	prompt.ObjectText = label
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("Shop", shop)
	prompt.Parent = target
	target:SetAttribute("Shop", shop)
end

local function shopStall(parent: Instance, cf: CFrame, shop: string, title: string, color: Color3)
	local stall = Instance.new("Model")
	stall.Name = shop .. "Shop"
	local counter = part({
		Name = "Counter",
		Size = Vector3.new(12, 3.5, 4),
		CFrame = cf * CFrame.new(0, 1.75, 0),
		Color = rgb(150, 95, 55),
		Material = Enum.Material.WoodPlanks,
		Parent = stall,
	})
	for _, x in { -5.6, 5.6 } do
		part({
			Name = "Pole",
			Size = Vector3.new(0.6, 9, 0.6),
			CFrame = cf * CFrame.new(x, 4.5, 1.6),
			Color = rgb(110, 70, 45),
			Parent = stall,
		})
	end
	for i = 0, 3 do
		part({
			Name = "Awning",
			Size = Vector3.new(13.5 / 4, 0.5, 6.5),
			CFrame = cf * CFrame.new(-5 + i * 3.375, 9.2, 0.4) * CFrame.Angles(math.rad(-12), 0, 0),
			Color = if i % 2 == 0 then color else rgb(255, 255, 255),
			Material = Enum.Material.Fabric,
			Parent = stall,
		})
	end
	local sign = part({
		Name = "Sign",
		Size = Vector3.new(11, 2.2, 0.4),
		CFrame = cf * CFrame.new(0, 10.8, -2.6),
		Color = color:Lerp(rgb(0, 0, 0), 0.35),
		Parent = stall,
	})
	surfaceText(sign, Enum.NormalId.Front, title, rgb(255, 240, 160))
	shopPrompt(counter, shop, title)
	stall.Parent = parent
	return counter
end

local function buildHub(map: Model): { [string]: BasePart }
	local terrain = workspace.Terrain
	-- grass everywhere, a paved bazaar around the Chowk
	terrain:FillCylinder(CFrame.new(0, GROUND_Y - 4, 0), 8, Biomes.WORLD_RADIUS + 30, Enum.Material.Grass)
	terrain:FillCylinder(CFrame.new(0, GROUND_Y - 2, 0), 4, 130, Enum.Material.Pavement)

	local center = Vector3.new(0, GROUND_Y, 0)
	part({
		Name = "Plaza",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, Biomes.PLAZA_RADIUS * 2, Biomes.PLAZA_RADIUS * 2),
		CFrame = cylinderUp(CFrame.new(center + Vector3.new(0, 0.3, 0))),
		Color = rgb(235, 215, 185),
		Material = Enum.Material.Slate,
		Parent = map,
	})
	-- a tiered fountain
	for i, tier in { { 2, 26, 0 }, { 1.6, 14, 2.4 }, { 1.2, 6, 4.6 } } do
		part({
			Name = "FountainTier",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(tier[1], tier[2], tier[2]),
			CFrame = cylinderUp(CFrame.new(center + Vector3.new(0, 1 + tier[3], 0))),
			Color = rgb(245, 245, 250),
			Material = Enum.Material.Marble,
			Parent = map,
		})
		part({
			Name = "FountainWater",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.3, tier[2] - 1.5, tier[2] - 1.5),
			CFrame = cylinderUp(CFrame.new(center + Vector3.new(0, 1.9 + tier[3] + (tier[1] - 2) / 2, 0))),
			Color = rgb(70, 180, 255),
			Material = Enum.Material.Neon,
			Transparency = 0.3,
			CanCollide = false,
			Parent = map,
		})
		if i == 3 then
			local top = part({
				Name = "FountainTop",
				Shape = Enum.PartType.Ball,
				Size = Vector3.one * 2.4,
				CFrame = CFrame.new(center + Vector3.new(0, 7.2, 0)),
				Color = rgb(255, 205, 60),
				Material = Enum.Material.Metal,
				Parent = map,
			})
			local spray = Instance.new("ParticleEmitter")
			spray.Name = "Spray"
			spray.Color = ColorSequence.new(rgb(170, 225, 255))
			spray.Rate = 40
			spray.Lifetime = NumberRange.new(1.2, 1.6)
			spray.Speed = NumberRange.new(10, 13)
			spray.SpreadAngle = Vector2.new(20, 20)
			spray.Acceleration = Vector3.new(0, -20, 0)
			spray.Size = NumberSequence.new(0.5, 0.1)
			spray.Transparency = NumberSequence.new(0.2, 1)
			spray.Parent = top
		end
	end

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "ChowkSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(8, 1, 8)
	spawn.Position = center + Vector3.new(22, 0.4, 0)
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.Color = rgb(255, 210, 80)
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = map

	-- the shops, around the fountain and facing it
	local shops = {}
	local function spot(k: number): CFrame
		local a = math.rad(45 * k)
		local position = center + Vector3.new(math.cos(a), 0, math.sin(a)) * SHOP_RADIUS
		return CFrame.lookAt(position, center)
	end
	shops.Sell = shopStall(map, spot(0), "Sell", "BECHO (Sell)", rgb(60, 170, 90))
	shops.Gear = shopStall(map, spot(1), "Gear", "GEAR SHOP", rgb(60, 130, 220))
	shops.Tracker = shopStall(map, spot(2), "Tracker", "RADAR WALA", rgb(150, 70, 210))

	-- the Kismat Kettle
	local kettleCF = spot(3)
	local kettle = part({
		Name = "KismatKettle",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 9,
		CFrame = kettleCF * CFrame.new(0, 5, 0),
		Color = rgb(255, 175, 40),
		Material = Enum.Material.Metal,
		Parent = map,
	})
	part({
		Name = "KismatSpout",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(6, 1.6, 1.6),
		CFrame = kettleCF * CFrame.new(5, 7, 0) * CFrame.Angles(0, 0, math.rad(35)),
		Color = rgb(255, 175, 40),
		Material = Enum.Material.Metal,
		Parent = map,
	})
	local kettleSign = part({
		Name = "KismatSign",
		Size = Vector3.new(10, 2.4, 0.4),
		CFrame = kettleCF * CFrame.new(0, 11.5, 0),
		Color = rgb(140, 60, 200),
		Parent = map,
	})
	surfaceText(kettleSign, Enum.NormalId.Front, "KISMAT KETTLE", rgb(255, 230, 90))
	shopPrompt(kettle, "Kismat", "Kismat Roll")
	shops.Kismat = kettle

	-- the Naya Safar gate
	local gateCF = spot(4)
	for _, x in { -5, 5 } do
		part({
			Name = "SafarPillar",
			Size = Vector3.new(2, 14, 2),
			CFrame = gateCF * CFrame.new(x, 7, 0),
			Color = rgb(255, 205, 60),
			Material = Enum.Material.Marble,
			Parent = map,
		})
	end
	part({
		Name = "SafarArch",
		Size = Vector3.new(12, 2, 2),
		CFrame = gateCF * CFrame.new(0, 15, 0),
		Color = rgb(255, 205, 60),
		Material = Enum.Material.Marble,
		Parent = map,
	})
	local portal = part({
		Name = "SafarPortal",
		Size = Vector3.new(8, 13, 0.4),
		CFrame = gateCF * CFrame.new(0, 7.5, 0),
		Color = rgb(190, 120, 255),
		Material = Enum.Material.Neon,
		Transparency = 0.35,
		CanCollide = false,
		Parent = map,
	})
	local safarSign = part({
		Name = "SafarSign",
		Size = Vector3.new(12, 2.4, 0.4),
		CFrame = gateCF * CFrame.new(0, 17.4, 0),
		Color = rgb(90, 40, 140),
		Parent = map,
	})
	surfaceText(safarSign, Enum.NormalId.Front, "NAYA SAFAR", rgb(255, 230, 90))
	shopPrompt(portal, "Rebirth", "Naya Safar")
	shops.Rebirth = portal

	-- the quest board
	local boardCF = spot(5)
	local questBoard = part({
		Name = "QuestBoard",
		Size = Vector3.new(10, 7, 0.6),
		CFrame = boardCF * CFrame.new(0, 5, 0),
		Color = rgb(130, 85, 50),
		Material = Enum.Material.WoodPlanks,
		Parent = map,
	})
	surfaceText(questBoard, Enum.NormalId.Front, "QUESTS", rgb(255, 235, 150))
	for _, x in { -4.5, 4.5 } do
		part({
			Name = "BoardLeg",
			Size = Vector3.new(0.6, 5, 0.6),
			CFrame = boardCF * CFrame.new(x, 1.5, 0.4),
			Color = rgb(100, 65, 40),
			Parent = map,
		})
	end
	shopPrompt(questBoard, "Quests", "Quests")
	shops.Quests = questBoard

	-- the leaderboard
	local lbCF = spot(6)
	local board = part({
		Name = "Leaderboard",
		Size = Vector3.new(16, 11, 0.6),
		CFrame = lbCF * CFrame.new(0, 7, 0),
		Color = rgb(40, 30, 25),
		Parent = map,
	})
	local boardGui = Instance.new("SurfaceGui")
	boardGui.Name = "Gui"
	boardGui.Face = Enum.NormalId.Front
	boardGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	boardGui.PixelsPerStud = 30
	boardGui.LightInfluence = 0
	local list = Instance.new("Frame")
	list.Name = "List"
	list.Size = UDim2.fromScale(1, 1)
	list.BackgroundTransparency = 1
	list.Parent = boardGui
	boardGui.Parent = board

	-- a chai dhaba, a fruit cart and parked rickshaws (props modelled in Blender)
	local dhaba = spot(7)
	Props.place("ChaiDhaba", dhaba, map)
	Props.text(map, dhaba, Props.anchor("ChaiDhaba", "Sign", dhaba), 5.6, 1.2, "CHAI")
	Props.place("Charpai", dhaba * CFrame.new(9, 0, -2) * CFrame.Angles(0, math.rad(80), 0), map)
	Props.place("FruitStall", CFrame.lookAt(center + Vector3.new(-18, 0, -40), center), map)
	Props.place("Rickshaw", CFrame.new(center + Vector3.new(30, 0, 40)) * CFrame.Angles(0, math.rad(30), 0), map)
	Props.place("Rickshaw", CFrame.new(center + Vector3.new(-36, 0, 30)) * CFrame.Angles(0, math.rad(-50), 0), map)

	-- string lights around the plaza
	local i = 0
	for degree = 0, 355, 5 do
		i += 1
		local a = math.rad(degree)
		local bulb = part({
			Name = "Bulb",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.8,
			Position = center + Vector3.new(math.cos(a) * 68, 9 - (i % 6 == 0 and 0 or 0.6), math.sin(a) * 68),
			Color = BRIGHT[i % #BRIGHT + 1],
			Material = Enum.Material.Neon,
			CanCollide = false,
			CastShadow = false,
			Parent = map,
		})
		if i % 9 == 0 then
			local light = Instance.new("PointLight")
			light.Color = bulb.Color
			light.Range = 16
			light.Brightness = 1.2
			light.Parent = bulb
			part({
				Name = "LightPole",
				Size = Vector3.new(0.5, 9, 0.5),
				Position = center + Vector3.new(math.cos(a) * 68, 4.5, math.sin(a) * 68),
				Color = rgb(110, 70, 45),
				Parent = map,
			})
		end
	end
	return shops
end

---------------------------------------------------------------------------
-- Roads, walls, gates, shortcut doors, petrol pumps and the edge of the world
---------------------------------------------------------------------------
local ROAD_COLORS = {
	spoke = rgb(75, 75, 82),
	zone = rgb(75, 75, 82),
	street = rgb(200, 175, 140),
	alley = rgb(200, 175, 140),
}

local function buildRoads(map: Model)
	local roads = Instance.new("Folder")
	roads.Name = "Roads"
	roads.Parent = map
	for _, road in Biomes.roads() do
		local a, b = road.a + Vector3.new(0, 0.15, 0), road.b + Vector3.new(0, 0.15, 0)
		local cf = CFrame.lookAt((a + b) / 2, b)
		local paved = road.kind == "street" or road.kind == "alley"
		part({
			Name = "Road",
			Size = Vector3.new(road.width, 0.3, (b - a).Magnitude + road.width * 0.25),
			CFrame = cf,
			Color = ROAD_COLORS[road.kind],
			Material = if paved then Enum.Material.Cobblestone else Enum.Material.Asphalt,
			Parent = roads,
		})
		if not paved then
			part({
				Name = "RoadLine",
				Size = Vector3.new(0.5, 0.32, (b - a).Magnitude),
				CFrame = cf,
				Color = rgb(250, 210, 60),
				CanCollide = false,
				Parent = roads,
			})
		end
	end
end

-- A round wall made of straight pieces, with openings at the given angles.
local function ringWall(
	parent: Instance,
	name: string,
	radius: number,
	height: number,
	color: Color3,
	material: Enum.Material,
	gaps: { number },
	gapWidth: number
)
	local count = math.ceil(2 * math.pi * radius / 20)
	local step = 360 / count
	local length = 2 * math.pi * radius * step / 360 + 0.6
	for i = 0, count - 1 do
		local angle = (i + 0.5) * step
		local open = false
		for _, gap in gaps do
			local off = math.abs(Biomes.angleDiff(angle, gap)) * math.pi * radius / 180
			if off < gapWidth / 2 + length / 2 then
				open = true
			end
		end
		if not open then
			local position = Biomes.polar(angle, radius) + Vector3.new(0, height / 2, 0)
			part({
				Name = name,
				Size = Vector3.new(length, height, 2.4),
				CFrame = CFrame.lookAt(position, Vector3.new(0, position.Y, 0)),
				Color = color,
				Material = material,
				Parent = parent,
			})
		end
	end
end

-- A straight fence along a radius, from r1 to r2.
local function radialFence(parent: Instance, angle: number, r1: number, r2: number, height: number)
	local a, b = Biomes.polar(angle, r1), Biomes.polar(angle, r2)
	part({
		Name = "RegionFence",
		Size = Vector3.new(2.4, height, (b - a).Magnitude),
		CFrame = CFrame.lookAt((a + b) / 2 + Vector3.new(0, height / 2, 0), b + Vector3.new(0, height / 2, 0)),
		Color = rgb(150, 105, 65),
		Material = Enum.Material.WoodPlanks,
		Parent = parent,
	})
end

local function forceField(props: { [string]: any }): Part
	local p = part(props)
	p.Material = Enum.Material.ForceField
	p.Transparency = 0.45
	p.CastShadow = false
	return p
end

local function buildWalls(map: Model)
	local walls = Instance.new("Folder")
	walls.Name = "Walls"
	walls.Parent = map
	local regionGaps, ring2Gaps, ring3Gaps = {}, {}, {}
	for _, region in Biomes.REGIONS do
		local zones = Biomes.byRegion[region.id]
		table.insert(regionGaps, region.angle)
		table.insert(ring2Gaps, (Biomes.gate(zones[2])))
		table.insert(ring3Gaps, (Biomes.gate(zones[3])))
	end
	local gateW = Biomes.GATE_WIDTH
	ringWall(walls, "TownWall", Biomes.TOWN_RADIUS, 10, rgb(196, 120, 80), Enum.Material.Brick, regionGaps, gateW)
	ringWall(walls, "Ring2Wall", Biomes.RINGS[2][1], 9, rgb(150, 105, 65), Enum.Material.WoodPlanks, ring2Gaps, gateW)
	ringWall(
		walls,
		"Ring3Wall",
		Biomes.RINGS[3][1],
		11,
		rgb(170, 160, 150),
		Enum.Material.Cobblestone,
		ring3Gaps,
		gateW
	)

	-- the fences between regions, each with a shortcut door in every ring
	local doors = Instance.new("Folder")
	doors.Name = "ShortcutDoors"
	doors.Parent = map
	local doorWidth = 24
	for _, region in Biomes.REGIONS do
		local angle = region.angle + Biomes.SPAN
		local r = Biomes.TOWN_RADIUS
		for _, span in Biomes.RINGS do
			local mid = (span[1] + span[2]) / 2
			radialFence(walls, angle, r, mid - doorWidth / 2, 9)
			r = mid + doorWidth / 2
		end
		radialFence(walls, angle, r, Biomes.WORLD_RADIUS, 9)
	end
	for _, door in Biomes.shortcuts() do
		local position = Biomes.polar(door.angle, door.radius) + Vector3.new(0, 6, 0)
		local cf = CFrame.lookAt(position, Vector3.new(0, position.Y, 0))
		local field = forceField({
			Name = "ShortcutDoor",
			Size = Vector3.new(1.2, 12, doorWidth),
			CFrame = cf,
			Color = rgb(80, 200, 255),
			Parent = doors,
		})
		field:SetAttribute("ZoneA", door.a.id)
		field:SetAttribute("ZoneB", door.b.id)
		local board = part({
			Name = "DoorSign",
			Size = Vector3.new(0.4, 3.2, 16),
			CFrame = cf * CFrame.new(0, 8, 0),
			Color = rgb(30, 60, 110),
			Parent = doors,
		})
		local text = ("SHORTCUT\n%s / %s"):format(door.a.name:upper(), door.b.name:upper())
		surfaceText(board, Enum.NormalId.Left, text, rgb(170, 230, 255))
		surfaceText(board, Enum.NormalId.Right, text, rgb(170, 230, 255))
	end

	-- the gates: an arch over every zone's way in, with a barrier until you unlock it
	local gates = Instance.new("Folder")
	gates.Name = "Gates"
	gates.Parent = map
	for _, biome in Biomes.list do
		local angle, radius = Biomes.gate(biome)
		local ground = Biomes.polar(angle, radius)
		local cf = CFrame.lookAt(ground, Vector3.new(0, ground.Y, 0))
		Props.place("ZoneGate", cf, gates)
		local best = ""
		for _, rarity in { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Secret" } do
			if (biome.odds[rarity] or 0) > 0 then
				best = rarity
			end
		end
		Props.text(
			gates,
			cf,
			Props.anchor("ZoneGate", "Sign", cf),
			20,
			3,
			("%s\n%s · up to %s"):format(biome.name:upper(), Biomes.costText(biome), best)
		)
		Props.text(
			gates,
			cf * CFrame.Angles(0, math.pi, 0),
			Props.anchor("ZoneGate", "SignBack", cf),
			20,
			3,
			biome.name:upper()
		)
		if biome.price > 0 or biome.rebirths > 0 then
			local barrier = forceField({
				Name = "GateBarrier",
				Size = Vector3.new(Biomes.GATE_WIDTH, 16, 1.2),
				CFrame = cf * CFrame.new(0, 8, 0),
				Color = rgb(255, 190, 50),
				Parent = gates,
			})
			barrier:SetAttribute("Zone", biome.id)
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "GatePrompt"
			prompt.ActionText = if biome.rebirths > 0 then "Open" else "Unlock"
			prompt.ObjectText = ("%s (%s)"):format(biome.name, Biomes.costText(biome))
			prompt.HoldDuration = 0.8
			prompt.MaxActivationDistance = 16
			prompt.RequiresLineOfSight = false
			prompt.Parent = barrier
		end
	end

	-- petrol pumps
	local pumps = Instance.new("Folder")
	pumps.Name = "PetrolPumps"
	pumps.Parent = map
	for _, spot in Biomes.pumps() do
		local cf = CFrame.lookAt(spot, Vector3.new(0, spot.Y, 0))
		Props.place("PetrolPump", cf, pumps)
		Props.text(pumps, cf, Props.anchor("PetrolPump", "Sign", cf), 7.6, 1.4, "PETROL")
		local pad = part({
			Name = "PumpPad",
			Size = Vector3.new(14, 0.4, 10),
			CFrame = cf * CFrame.new(0, 0.5, 0),
			Color = rgb(255, 230, 120),
			Material = Enum.Material.Neon,
			Transparency = 0.7,
			CanCollide = false,
			Parent = pumps,
		})
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "PumpPrompt"
		prompt.ActionText = "Fill up"
		prompt.ObjectText = "Petrol Pump"
		prompt.HoldDuration = 0.5
		prompt.MaxActivationDistance = Config.PUMP_DISTANCE
		prompt.RequiresLineOfSight = false
		prompt.Parent = pad
	end

	-- the edge of the world: an invisible wall, with mountains beyond it
	local edge = Instance.new("Folder")
	edge.Name = "WorldEdge"
	edge.Parent = map
	for k = 0, 47 do
		local a = k * 7.5
		local position = Biomes.polar(a, Biomes.WORLD_RADIUS) + Vector3.new(0, 100, 0)
		part({
			Name = "Edge",
			Size = Vector3.new(Biomes.WORLD_RADIUS * math.rad(7.5) + 4, 220, 4),
			CFrame = CFrame.lookAt(position, Vector3.new(0, 100, 0)),
			Transparency = 1,
			CanQuery = false,
			Parent = edge,
		})
	end
	local terrain = workspace.Terrain
	local rng = Random.new(91)
	for k = 0, 59 do
		local a = k * 6
		local region = nil
		for _, r in Biomes.REGIONS do
			if math.abs(Biomes.angleDiff(a, r.angle)) <= 45 then
				region = r.id
			end
		end
		local material = if region == "KPK"
			then Enum.Material.Snow
			elseif region == "Thar" then Enum.Material.Sandstone
			elseif region == "Sindh" then Enum.Material.Rock
			else Enum.Material.Grass
		local radius = rng:NextNumber(40, 70)
		terrain:FillBall(
			Biomes.polar(a, Biomes.WORLD_RADIUS + 30 + radius * 0.6) - Vector3.new(0, 10, 0),
			radius,
			material
		)
	end
end

---------------------------------------------------------------------------
-- The Lahore bazaar: the town ring between the havelis and the town wall.
-- Two rows of stalls along the bazaar street, and 6 sectors: Brainrot Mandi,
-- Kite Point, Cricket Gali, Mela Ground, Chai Dhaba Bazaar (with Ustad's
-- Workshop) and the Rickshaw Stand (with the Gaari Showroom).
---------------------------------------------------------------------------
local function buildTown(map: Model)
	local town = Instance.new("Folder")
	town.Name = "Bazaar"
	town.Parent = map
	workspace.Terrain:FillCylinder(CFrame.new(0, GROUND_Y - 2, 0), 4, Biomes.TOWN_RADIUS, Enum.Material.Pavement)
	local function at(angle: number, r: number): Vector3
		return Biomes.polar(angle, r)
	end
	local function facingIn(position: Vector3): CFrame
		return CFrame.lookAt(position, Vector3.new(0, position.Y, 0))
	end
	local function facingOut(position: Vector3): CFrame
		return CFrame.lookAt(position, position * 2 - Vector3.new(0, position.Y, 0))
	end
	-- angles to keep clear of stalls: roads, pumps and the big landmarks
	local keepClear = {}
	for _, region in Biomes.REGIONS do
		table.insert(keepClear, { angle = region.angle, width = 7 })
		table.insert(keepClear, { angle = region.angle + 45, width = 5 })
		table.insert(keepClear, { angle = region.angle + 10, width = 5 })
	end
	for _, landmark in { { -30, 7 }, { 30, 9 }, { 76, 7 }, { 104, 8 }, { 150, 8 }, { 162, 5 }, { 210, 8 }, { 224, 6 } } do
		table.insert(keepClear, { angle = landmark[1], width = landmark[2] })
	end
	local function clear(angle: number): boolean
		for _, k in keepClear do
			if math.abs(Biomes.angleDiff(angle, k.angle)) < k.width then
				return false
			end
		end
		return true
	end
	local stalls = { "BazaarStallRed", "BazaarStallGreen", "BazaarStallBlue", "BazaarStallYellow" }
	local n = 0
	for angle = 4, 360, 9 do
		if clear(angle) then
			n += 1
			Props.place(stalls[n % #stalls + 1], facingOut(at(angle, 218)), town)
		end
	end
	for angle = 0, 360, 7.5 do
		if clear(angle) then
			n += 1
			Props.place(stalls[n % #stalls + 1], facingIn(at(angle, 274)), town)
		end
	end
	-- string lights over the bazaar street
	for k = 0, 35 do
		local angle = k * 10 + 5
		for _, r in { 233, 257 } do
			part({
				Name = "LightPole",
				Size = Vector3.new(0.5, 11, 0.5),
				Position = at(angle, r) + Vector3.new(0, 5.5, 0),
				Color = rgb(110, 70, 45),
				Parent = town,
			})
		end
		local bulb = part({
			Name = "Bulb",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 1.1,
			Position = at(angle, Biomes.BAZAAR_STREET) + Vector3.new(0, 10.5, 0),
			Color = BRIGHT[k % #BRIGHT + 1],
			Material = Enum.Material.Neon,
			CanCollide = false,
			CastShadow = false,
			Parent = town,
		})
		if k % 3 == 0 then
			local light = Instance.new("PointLight")
			light.Color = bulb.Color
			light.Range = 18
			light.Brightness = 1.2
			light.Parent = bulb
		end
	end
	-- a sign for every sector
	for _, sector in Biomes.TOWN_SECTORS do
		local spot = at(sector.angle + 4, 262)
		local cf = facingIn(spot)
		Props.place("Signboard", cf, town)
		Props.text(town, cf, Props.anchor("Signboard", "Face", cf), 5.2, 2.2, sector.name:upper())
	end
	-- Kite Point
	Props.place("KiteTower", facingIn(at(-30, 262)), town)
	Props.place("KiteLine", facingIn(at(-22, 262)) * CFrame.Angles(0, math.rad(90), 0), town)
	-- Cricket Gali: a pitch, stumps at both ends and a bench
	local pitchCF = facingIn(at(30, 262)) * CFrame.Angles(0, math.rad(90), 0)
	part({
		Name = "Pitch",
		Size = Vector3.new(8, 0.3, 40),
		CFrame = pitchCF * CFrame.new(0, 0.15, 0),
		Color = rgb(210, 190, 140),
		Material = Enum.Material.Ground,
		Parent = town,
	})
	Props.place("CricketStumps", pitchCF * CFrame.new(0, 0, -18), town)
	Props.place("CricketStumps", pitchCF * CFrame.new(0, 0, 18) * CFrame.Angles(0, math.pi, 0), town)
	Props.place("Bench", facingIn(at(38, 262)), town)
	-- Mela Ground
	Props.place("MelaStage", facingIn(at(76, 266)), town)
	Props.place("FerrisWheel", facingIn(at(104, 268)) * CFrame.Angles(0, math.rad(90), 0), town)
	Props.place("GolaCart", facingIn(at(84, 262)), town)
	-- Chai Dhaba Bazaar, with Ustad's Workshop where vehicles are upgraded
	local workshopCF = facingIn(at(150, 270))
	Props.place("Workshop", workshopCF, town)
	Props.text(town, workshopCF, Props.anchor("Workshop", "Sign", workshopCF), 15, 2.2, "USTAD'S WORKSHOP")
	local dhabaCF = facingIn(at(163, 266))
	Props.place("ChaiDhaba", dhabaCF, town)
	Props.text(town, dhabaCF, Props.anchor("ChaiDhaba", "Sign", dhabaCF), 5.6, 1.2, "CHAI")
	Props.place("Tandoor", facingIn(at(167, 258)), town)
	-- the Rickshaw Stand, with the Gaari Showroom where vehicles are sold
	local showroomCF = facingIn(at(210, 270))
	Props.place("Showroom", showroomCF, town)
	Props.text(town, showroomCF, Props.anchor("Showroom", "Sign", showroomCF), 17, 2.4, "GAARI SHOWROOM")
	Props.place("VehiclePiliTaxi", showroomCF * CFrame.new(0, 0.9, 1.5), town)
	for k, angle in { 220, 224, 228 } do
		Props.place("Rickshaw", facingIn(at(angle, 262)) * CFrame.Angles(0, math.rad(90 + k * 4), 0), town)
	end
	-- the counters you talk to at the workshop and the showroom
	for _, shop in
		{ { "Workshop", workshopCF, "Ustad's Workshop", 9 }, { "Showroom", showroomCF, "Gaari Showroom", 10 } }
	do
		local counter = part({
			Name = shop[1] .. "Counter",
			Size = Vector3.new(6, 3, 2),
			CFrame = (shop[2] :: CFrame) * CFrame.new(0, 1.5, -(shop[4] :: number)),
			Color = rgb(150, 100, 60),
			Material = Enum.Material.WoodPlanks,
			Parent = town,
		})
		shopPrompt(counter, shop[1] :: string, shop[3] :: string)
	end
end

local function build(): (Model, { [string]: any })
	local map = Instance.new("Model")
	map.Name = MAP_NAME
	buildHub(map)
	local havelis = Instance.new("Folder")
	havelis.Name = "Havelis"
	havelis.Parent = map
	for index = 1, 8 do
		local a = Biomes.haveliAngle(index)
		buildHaveli(
			havelis,
			index,
			Vector3.new(math.cos(a), 0, math.sin(a)) * Biomes.HAVELI_RADIUS + Vector3.new(0, GROUND_Y, 0)
		)
	end
	buildRoads(map)
	buildWalls(map)
	buildTown(map)
	local biomes = Instance.new("Folder")
	biomes.Name = "Biomes"
	biomes.Parent = map
	local plans = BiomeBuilder.run(biomes)
	map.Parent = workspace
	return map, plans
end

local function child(parent: Instance, name: string): any
	local found = parent:FindFirstChild(name)
	assert(found, ("[ChaiChaos] %s is missing %s"):format(parent:GetFullName(), name))
	return found
end

local function labelIn(parent: Instance): TextLabel
	local label = parent:FindFirstChild("Label", true)
	assert(
		label and label:IsA("TextLabel"),
		("[ChaiChaos] %s needs a TextLabel named Label"):format(parent:GetFullName())
	)
	return label
end

local function partsIn(model: Instance, name: string): { BasePart }
	local list = {}
	local folder = model:FindFirstChild(name)
	if folder then
		for _, p in folder:GetDescendants() do
			if p:IsA("BasePart") then
				table.insert(list, p)
			end
		end
	end
	return list
end

function MapBuilder.read(map: Model, plans: { [string]: any }): Map
	local havelis: { Haveli } = {}
	for _, model in child(map, "Havelis"):GetChildren() do
		if not model:IsA("Model") then
			continue
		end
		local floor: BasePart = child(model, "Floor")
		local deck: BasePart = child(model, "Deck")
		local origin = floor.CFrame * CFrame.new(0, floor.Size.Y / 2, 0)
		local halfDepth = floor.Size.Z / 2
		local upperY = origin:PointToObjectSpace(deck.Position).Y + deck.Size.Y / 2

		local plots, plotLabels = {}, {}
		for i = 1, 2 * PLOTS_PER_FLOOR do
			local plot: BasePart = child(model, "Plot" .. i)
			plots[i] = plot
			plotLabels[i] = labelIn(plot)
		end
		local incubators, incubatorLabels = {}, {}
		for i = 1, Config.MAX_INCUBATORS do
			local nest: BasePart = child(model, "Incubator" .. i)
			incubators[i] = nest
			incubatorLabels[i] = labelIn(nest)
		end

		local galla: BasePart = child(model, "Galla")
		local brainrotFolder = model:FindFirstChild("Brainrots")
		if not brainrotFolder then
			brainrotFolder = Instance.new("Folder")
			brainrotFolder.Name = "Brainrots"
			brainrotFolder.Parent = model
		end
		local decor = model:FindFirstChild("Decor")
		if not decor then
			decor = Instance.new("Folder")
			decor.Name = "Decor"
			decor.Parent = model
		end

		local index = model:GetAttribute("HaveliIndex") or tonumber(model.Name:match("%d+")) or (#havelis + 1)
		table.insert(havelis, {
			index = index,
			model = model,
			origin = origin,
			size = floor.Size,
			upperY = upperY,
			plots = plots,
			plotLabels = plotLabels,
			incubators = incubators,
			incubatorLabels = incubatorLabels,
			galla = galla,
			gallaLabel = labelIn(galla),
			door = child(model, "Door"),
			barrier = child(model, "Barrier"),
			signLabel = labelIn(child(model, "Sign")),
			walls = partsIn(model, "Walls"),
			trims = partsIn(model, "Trim"),
			accents = partsIn(model, "Accent"),
			floors = { floor, deck },
			stairGates = partsIn(model, "StairGates"),
			roof = model:FindFirstChild("Roof"),
			decor = decor,
			guardSpot = (child(model, "GuardSpot") :: BasePart).CFrame,
			spawn = (child(model, "Spawn") :: BasePart).CFrame + Vector3.new(0, 3, 0),
			doorInside = origin * CFrame.new(0, 0, -halfDepth + 6),
			doorOutside = origin * CFrame.new(0, 0, -halfDepth - 5),
			stairBottom = origin * CFrame.new(STAIR_X, 0, STAIR_START - 2),
			stairTop = origin * CFrame.new(STAIR_X, upperY, DECK_FRONT + 2),
			brainrotFolder = brainrotFolder,
			owner = nil,
			guard = nil,
		})
	end
	table.sort(havelis, function(a, b)
		return a.index < b.index
	end)

	local shops = {}
	for _, d in map:GetDescendants() do
		if d:IsA("BasePart") and type(d:GetAttribute("Shop")) == "string" then
			shops[d:GetAttribute("Shop")] = d
		end
	end
	local board = map:FindFirstChild("Leaderboard")
	local list = board and board:FindFirstChild("List", true)
	local gates, doors, pumps = {}, {}, {}
	for _, d in map:GetDescendants() do
		if d:IsA("BasePart") then
			if d.Name == "GateBarrier" and type(d:GetAttribute("Zone")) == "string" then
				gates[d:GetAttribute("Zone")] = d
			elseif d.Name == "ShortcutDoor" then
				table.insert(doors, d)
			elseif d.Name == "PumpPad" then
				table.insert(pumps, d)
			end
		end
	end
	return {
		model = map,
		havelis = havelis,
		shops = shops,
		leaderboard = if list and list:IsA("Frame") then list else nil,
		biomes = plans,
		gates = gates,
		doors = doors,
		pumps = pumps,
	}
end

function MapBuilder.ensure(): Map
	local existing = workspace:FindFirstChild(MAP_NAME)
	if existing then
		return MapBuilder.read(existing, BiomeBuilder.run(nil))
	end
	local map, plans = build()
	return MapBuilder.read(map, plans)
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">Models</string>
          <string name="Source"><![CDATA[-- Makes the 3D model for a brainrot. It picks the first of these that exists:
--
--   1. Your own model: a Model in ServerStorage > Brainrots named after the
--      brainrot's id (for example "SamosaSupremo").
--   2. The Blender model from blender/brainrots_*.py (all 42 have one). It is
--      built from parts, or uses the smoother imported mesh if you imported
--      assets/props/ChaiChaosProps.fbx (see the README).
--   3. A blocky placeholder made from the shape, colour and extras in Brainrots.luau.
--
-- The front of a model is its -Z side (the way Roblox models face by default).
--
-- Mutated brainrots (Golden, Diamond, Rainbow) are tinted; Rainbow ones change
-- colour on every player's screen (see Smooth.client.luau). They always use the
-- parts version, so every part can be tinted while the eyes keep their colour.

local CollectionService = game:GetService("CollectionService")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Brainrots = require(Shared.Brainrots)
local Format = require(Shared.Format)
local Mutations = require(Shared.Mutations)

local Props = require(script.Parent.Props)

local Models = {}

-- Blender models are shrunk if needed so they fit on an 8x8 plot and under the upstairs roof.
local MAX_FOOTPRINT = 7.4
local MAX_HEIGHT = 7.6

-- Writing on a brainrot (an anchor in its Blender model, and which way the text faces).
local SIGNS = {
	TruckArtTotaa = {
		anchor = "Tail",
		text = "Dekh magar pyar se",
		width = 1.25,
		height = 0.42,
		turn = CFrame.Angles(0, math.pi, 0) * CFrame.Angles(math.rad(35), 0, 0), -- faces back and up
		color = Color3.fromRGB(215, 35, 45),
	},
}

local RARITY_SIZE = {
	Common = 3,
	Uncommon = 3.5,
	Rare = 4,
	Epic = 4.6,
	Legendary = 5.4,
	Mythic = 6.4,
	Special = 5,
}

local PARTICLE_RATE = {
	Epic = 4,
	Legendary = 8,
	Mythic = 16,
	Special = 10,
}

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.fromRGB(25, 25, 30)

local function newPart(
	model: Model,
	name: string,
	size: Vector3,
	cf: CFrame,
	color: Color3,
	shape: Enum.PartType?
): BasePart
	local p = Instance.new("Part")
	p.Name = name
	if shape then
		p.Shape = shape
	end
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

local UP = CFrame.Angles(0, 0, math.rad(90)) -- turns a cylinder upright

-- Builds the body and returns where the face and add-ons should go.
local function buildBody(model: Model, shape: string, s: number, color: Color3)
	local body = {
		w = s,
		h = s,
		d = s,
		eyeY = s * 0.15,
		eyeX = 0,
		eyeGap = s * 0.2,
		front = -s / 2,
	}
	if shape == "Ball" then
		newPart(model, "Body", Vector3.one * s, CFrame.new(), color, Enum.PartType.Ball)
		body.front = -s * 0.42
	elseif shape == "Block" then
		body.h, body.d = s * 0.85, s * 0.9
		newPart(model, "Body", Vector3.new(body.w, body.h, body.d), CFrame.new(), color)
		body.front = -body.d / 2
		body.eyeY = body.h * 0.15
	elseif shape == "Tall" then
		body.w, body.h, body.d = s * 0.7, s * 1.4, s * 0.7
		newPart(model, "Body", Vector3.new(body.w, body.h, body.d), CFrame.new(), color)
		body.front = -body.d / 2
		body.eyeY = body.h * 0.25
	elseif shape == "Cylinder" then
		body.h = s * 1.1
		newPart(model, "Body", Vector3.new(body.h, s, s), UP, color, Enum.PartType.Cylinder)
		body.front = -s * 0.47
		body.eyeY = body.h * 0.2
	elseif shape == "Disc" then
		body.w, body.h, body.d = s * 1.3, s * 0.4, s * 1.3
		newPart(model, "Body", Vector3.new(body.h, body.w, body.d), UP, color, Enum.PartType.Cylinder)
		body.front = -body.d * 0.47
		body.eyeY = 0
		body.eyeGap = s * 0.25
	elseif shape == "Wheel" then
		body.w, body.h, body.d = s * 1.4, s * 1.4, s * 0.4
		newPart(
			model,
			"Body",
			Vector3.new(body.d, body.h, body.w),
			CFrame.Angles(0, math.rad(90), 0),
			color,
			Enum.PartType.Cylinder
		)
		body.front = -body.d / 2
		-- spokes so it reads as a wheel
		for i = 0, 3 do
			newPart(
				model,
				"Spoke",
				Vector3.new(body.w * 0.95, 0.25, 0.25),
				CFrame.new(0, 0, body.front - 0.05) * CFrame.Angles(0, 0, math.rad(45 * i)),
				color:Lerp(WHITE, 0.5)
			)
		end
		body.front -= 0.15
	elseif shape == "Wedge" then
		-- a wedge turned sideways so its triangle faces the front (samosa shape)
		body.h, body.d = s * 0.95, s * 0.8
		local wedge = Instance.new("WedgePart")
		wedge.Name = "Body"
		wedge.Size = Vector3.new(body.d, body.h, body.w)
		wedge.CFrame = CFrame.Angles(0, math.rad(90), 0)
		wedge.Color = color
		wedge.Material = Enum.Material.SmoothPlastic
		wedge.Parent = model
		body.front = -body.d / 2
		body.eyeX = s * 0.17
		body.eyeY = -body.h * 0.2
		body.eyeGap = s * 0.13
	elseif shape == "Slab" then
		body.w, body.h, body.d = s * 0.75, s * 1.3, s * 0.3
		newPart(model, "Body", Vector3.new(body.w, body.h, body.d), CFrame.new(), color)
		-- the chappal strap
		newPart(
			model,
			"Strap",
			Vector3.new(body.w * 1.05, s * 0.18, body.d * 1.3),
			CFrame.new(0, body.h * 0.22, 0),
			BLACK
		)
		body.front = -body.d / 2
		body.eyeY = -body.h * 0.05
	elseif shape == "Kite" then
		body.w, body.h, body.d = s * 1.3, s * 1.3, s * 0.15
		newPart(model, "Body", Vector3.new(s, s, body.d), CFrame.Angles(0, 0, math.rad(45)), color)
		newPart(model, "Stripe", Vector3.new(s * 1.4, 0.2, body.d + 0.05), CFrame.new(), color:Lerp(WHITE, 0.6))
		body.front = -body.d / 2
		body.eyeY = s * 0.1
	else
		newPart(model, "Body", Vector3.one * s, CFrame.new(), color)
	end
	return body
end

local function addEyes(model: Model, body, count: number)
	local size = math.clamp(body.w * 0.26, 0.6, 1.6)
	local xs = { body.eyeX - body.eyeGap, body.eyeX + body.eyeGap }
	if count == 1 then
		size *= 1.6
		xs = { body.eyeX }
	end
	for _, x in xs do
		local z = body.front - size * 0.1
		newPart(model, "Eye", Vector3.one * size, CFrame.new(x, body.eyeY, z), WHITE, Enum.PartType.Ball)
		newPart(
			model,
			"Pupil",
			Vector3.one * size * 0.5,
			CFrame.new(x, body.eyeY - size * 0.05, z - size * 0.32),
			BLACK,
			Enum.PartType.Ball
		)
	end
	return size
end

local EXTRAS = {}

function EXTRAS.glasses(model, body, eye, _color)
	newPart(
		model,
		"Glasses",
		Vector3.new(body.eyeGap * 2 + eye * 1.3, eye * 0.6, 0.25),
		CFrame.new(body.eyeX, body.eyeY, body.front - eye * 0.5),
		BLACK
	)
end

function EXTRAS.goggles(model, body, eye, _color)
	local y = body.eyeY + eye * 0.75
	newPart(
		model,
		"GoggleBand",
		Vector3.new(body.w * 1.04, eye * 0.35, body.d * 1.04),
		CFrame.new(0, y, 0),
		Color3.fromRGB(110, 70, 40)
	)
	for _, x in { body.eyeX - body.eyeGap, body.eyeX + body.eyeGap } do
		local lens = newPart(
			model,
			"Lens",
			Vector3.one * eye * 0.8,
			CFrame.new(x, y, body.front - 0.1),
			Color3.fromRGB(120, 230, 255),
			Enum.PartType.Ball
		)
		lens.Material = Enum.Material.Neon
	end
end

function EXTRAS.moustache(model, body, eye, _color)
	local y = body.eyeY - eye * 0.95
	for _, side in { -1, 1 } do
		newPart(
			model,
			"Moustache",
			Vector3.new(eye * 1.1, eye * 0.3, 0.3),
			CFrame.new(body.eyeX + side * eye * 0.5, y, body.front - 0.15) * CFrame.Angles(0, 0, math.rad(side * -15)),
			BLACK
		)
	end
end

function EXTRAS.crown(model, body, _eye, _color)
	local gold = Color3.fromRGB(255, 200, 40)
	local height = math.max(body.h * 0.25, 0.8)
	local crown = newPart(
		model,
		"Crown",
		Vector3.new(height, body.w * 0.5, body.w * 0.5),
		CFrame.new(0, body.h / 2 + height / 2, 0) * UP,
		gold,
		Enum.PartType.Cylinder
	)
	crown.Material = Enum.Material.Metal
	newPart(
		model,
		"Jewel",
		Vector3.one * height * 0.5,
		CFrame.new(0, body.h / 2 + height / 2, -body.w * 0.25),
		Color3.fromRGB(230, 30, 60),
		Enum.PartType.Ball
	)
end

function EXTRAS.headband(model, body, eye, _color)
	newPart(
		model,
		"Headband",
		Vector3.new(body.w * 1.04, eye * 0.4, body.d * 1.04),
		CFrame.new(0, body.eyeY + eye * 0.8, 0),
		Color3.fromRGB(200, 30, 40)
	)
end

function EXTRAS.legs(model, body, _eye, color)
	local legH = math.max(body.h * 0.35, 0.8)
	local legW = math.max(body.w * 0.18, 0.5)
	for _, side in { -1, 1 } do
		newPart(
			model,
			"Leg",
			Vector3.new(legW, legH, legW),
			CFrame.new(side * body.w * 0.22, -body.h / 2 - legH / 2 + 0.1, 0),
			color:Lerp(BLACK, 0.35)
		)
	end
end

function EXTRAS.horn(model, body, eye, _color)
	newPart(
		model,
		"Horn",
		Vector3.new(eye * 0.45, eye * 1.2, eye * 0.45),
		CFrame.new(0, body.eyeY + eye * 1.1, body.front - eye * 0.1) * CFrame.Angles(math.rad(-25), 0, 0),
		Color3.fromRGB(245, 240, 225)
	)
end

function EXTRAS.ears(model, body, _eye, color)
	local size = Vector3.new(body.w * 0.22, body.h * 0.28, body.w * 0.12)
	for _, side in { -1, 1 } do
		newPart(
			model,
			"Ear",
			size,
			CFrame.new(side * body.w * 0.3, body.h / 2 + size.Y / 2 - 0.1, 0),
			color:Lerp(BLACK, 0.2)
		)
	end
end

function EXTRAS.wings(model, body, _eye, color)
	local size = Vector3.new(body.w * 0.7, 0.25, body.d * 0.6)
	for _, side in { -1, 1 } do
		newPart(
			model,
			"Wing",
			size,
			CFrame.new(side * (body.w / 2 + size.X / 2 - 0.2), body.h * 0.1, 0)
				* CFrame.Angles(0, 0, math.rad(side * 25)),
			color:Lerp(WHITE, 0.4)
		)
	end
end

function EXTRAS.bat(model, body, _eye, _color)
	newPart(
		model,
		"Bat",
		Vector3.new(0.5, body.h * 1.1, 0.3),
		CFrame.new(body.w / 2 + 0.6, 0, body.front * 0.4) * CFrame.Angles(0, 0, math.rad(-30)),
		Color3.fromRGB(225, 195, 140)
	)
end

function EXTRAS.tail(model, body, _eye, color)
	local length = math.max(body.d * 0.6, 1)
	newPart(
		model,
		"Tail",
		Vector3.new(0.45, 0.45, length),
		CFrame.new(0, -body.h * 0.1, -body.front + length / 2 - 0.1) * CFrame.Angles(math.rad(20), 0, 0),
		color:Lerp(BLACK, 0.25)
	)
end

local function buildPlaceholder(def: Brainrots.Def): Model
	local model = Instance.new("Model")
	model.Name = def.id

	local root = newPart(model, "Root", Vector3.one, CFrame.new(), WHITE)
	root.Transparency = 1
	model.PrimaryPart = root

	local size = RARITY_SIZE[def.rarity] or 3
	local body = buildBody(model, def.shape, size, def.color)
	local eye = addEyes(model, body, def.eyes or 2)
	for _, extra in def.extras do
		local add = EXTRAS[extra]
		if add then
			add(model, body, eye, def.color)
		else
			warn("[ChaiChaos] Unknown extra '" .. extra .. "' on " .. def.id)
		end
	end
	return model
end

-- The brainrot's Blender model (see blender/brainrots_*.py), or nil if it has none.
local function buildFromBlender(def: Brainrots.Def, mutation: string?): Model?
	if not Props.exists(def.id) then
		return nil
	end
	local size = Props.size(def.id)
	local scale = math.min(1, MAX_FOOTPRINT / math.max(size.X, size.Z), MAX_HEIGHT / size.Y)
	-- mutations tint every part, so they need the parts version even if a mesh was imported
	local model = Props.place(def.id, CFrame.new(), nil, scale, { parts = mutation ~= nil, noColliders = true })

	-- an invisible Root in the middle holds everything together
	local root = newPart(model, "Root", Vector3.one, CFrame.new(0, size.Y * scale / 2, 0), WHITE)
	root.Transparency = 1
	model.PrimaryPart = root

	local sign = SIGNS[def.id]
	if sign then
		local at = Props.anchor(def.id, sign.anchor, CFrame.new(), scale)
		Props.text(model, sign.turn, at, sign.width * scale, sign.height * scale, sign.text, sign.color)
	end
	return model
end

local function newLabel(name: string, position: number, height: number, color: Color3): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.Size = UDim2.fromScale(1, height)
	label.Position = UDim2.fromScale(0, position)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 1.5
	stroke.Parent = label
	return label
end

local NOT_TINTED = { Eye = true, Pupil = true, Root = true }

local function tint(model: Model, mutation: string?)
	local m = mutation and Mutations.byId[mutation]
	if not m then
		return
	end
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") and not NOT_TINTED[p.Name] and p.Transparency < 1 then
			p:SetAttribute("Tint", true)
			if m.id == "Golden" then
				p.Color = m.color:Lerp(p.Color, 0.15)
				p.Material = Enum.Material.Foil
			elseif m.id == "Diamond" then
				p.Color = m.color
				p.Material = Enum.Material.Glass
				p.Reflectance = 0.25
				p.Transparency = 0.1
			else
				p.Color = m.color
				p.Material = Enum.Material.Neon
			end
		end
	end
end

-- Anchors the model, adds the rarity ring, sparkles and the name pop-up.
local function decorate(model: Model, def: Brainrots.Def, mutation: string?)
	local primary = model.PrimaryPart :: BasePart
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = true
			p.CanCollide = false
			p.CastShadow = false
		end
	end
	tint(model, mutation)

	local rarityColor = Brainrots.RARITY_COLORS[def.rarity]
	local boxCFrame, boxSize = model:GetBoundingBox()
	local pivot = model:GetPivot()
	local center = pivot:PointToObjectSpace(boxCFrame.Position)
	local bottom = center.Y - boxSize.Y / 2
	model:SetAttribute("Height", boxSize.Y)

	local ringSize = math.max(boxSize.X, boxSize.Z) * 1.15
	local ring = newPart(
		model,
		"RarityRing",
		Vector3.new(0.2, ringSize, ringSize),
		pivot * CFrame.new(center.X, bottom - 0.1, center.Z) * UP,
		rarityColor,
		Enum.PartType.Cylinder
	)
	ring.Material = Enum.Material.Neon
	ring.Transparency = 0.35
	ring.Anchored = true
	ring.CanCollide = false
	ring.CastShadow = false

	local hover = if def.float then 1.5 else 0
	model:SetAttribute("GroundOffset", -(bottom - 0.2) + hover)
	model:SetAttribute("BrainrotId", def.id)
	model:SetAttribute("Mutation", mutation)

	-- welds hold the parts together while a thief carries the brainrot
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") and p ~= primary then
			local weld = Instance.new("WeldConstraint")
			weld.Name = "Hold"
			weld.Part0 = primary
			weld.Part1 = p
			weld.Parent = p
		end
	end

	local m = mutation and Mutations.byId[mutation]
	if m then
		local glitter = Instance.new("ParticleEmitter")
		glitter.Name = "MutationSparkles"
		glitter.Rate = 8
		glitter.Lifetime = NumberRange.new(0.8, 1.4)
		glitter.Speed = NumberRange.new(1, 2.5)
		glitter.SpreadAngle = Vector2.new(180, 180)
		glitter.Size = NumberSequence.new(0.5, 0)
		glitter.LightEmission = 1
		glitter.Color = ColorSequence.new(m.color)
		glitter.Parent = primary
	end

	local rate = PARTICLE_RATE[def.rarity]
	if rate then
		local sparkles = Instance.new("ParticleEmitter")
		sparkles.Name = "RaritySparkles"
		sparkles.Rate = rate
		sparkles.Lifetime = NumberRange.new(1, 1.8)
		sparkles.Speed = NumberRange.new(1.5, 3)
		sparkles.SpreadAngle = Vector2.new(180, 180)
		sparkles.Size = NumberSequence.new(0.4, 0)
		sparkles.LightEmission = 1
		if def.rarity == "Mythic" then
			sparkles.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 60)),
				ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 220, 60)),
				ColorSequenceKeypoint.new(0.5, Color3.fromRGB(60, 220, 100)),
				ColorSequenceKeypoint.new(0.75, Color3.fromRGB(60, 140, 255)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 80, 255)),
			})
		else
			sparkles.Color = ColorSequence.new(rarityColor)
		end
		sparkles.Parent = primary
	end

	local primaryTop = primary.CFrame:PointToObjectSpace(boxCFrame.Position).Y + boxSize.Y / 2
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Popup"
	billboard.Size = UDim2.fromScale(9, 3.4)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, primaryTop + 2.2, 0)
	billboard.MaxDistance = 90
	billboard.LightInfluence = 0

	local nameLabel = newLabel("NameLabel", 0, 0.3, if m then m.color else WHITE)
	nameLabel.Text = Mutations.displayName(def, mutation)
	nameLabel.Parent = billboard
	local rarityLabel = newLabel("RarityLabel", 0.3, 0.2, rarityColor)
	rarityLabel.Text = def.rarity
	rarityLabel.Parent = billboard
	local phraseLabel = newLabel("PhraseLabel", 0.5, 0.26, Color3.fromRGB(255, 230, 120))
	phraseLabel.Text = '"' .. def.phrase .. '"'
	phraseLabel.Parent = billboard
	local infoLabel = newLabel("InfoLabel", 0.76, 0.24, Color3.fromRGB(140, 255, 140))
	infoLabel.Text = ("%s  ·  +%s/s"):format(
		Format.rupees(Mutations.value(def, mutation)),
		Format.short(Mutations.income(def, mutation))
	)
	infoLabel.Parent = billboard
	billboard.Parent = primary
	CollectionService:AddTag(model, "ChaiBrainrot")
end

function Models.create(def: Brainrots.Def, mutation: string?): Model
	local folder = ServerStorage:FindFirstChild("Brainrots")
	local template = folder and folder:FindFirstChild(def.id)
	local model: Model
	if template and template:IsA("Model") then
		model = template:Clone()
		if not model.PrimaryPart then
			local biggest: BasePart? = nil
			for _, p in model:GetDescendants() do
				if p:IsA("BasePart") and (not biggest or p.Size.Magnitude > biggest.Size.Magnitude) then
					biggest = p
				end
			end
			assert(biggest, "[ChaiChaos] The model " .. def.id .. " in ServerStorage.Brainrots has no parts")
			model.PrimaryPart = biggest
		end
	else
		model = buildFromBlender(def, mutation) or buildPlaceholder(def)
	end
	model.Name = def.id
	decorate(model, def, mutation)
	return model
end

-- Welds the brainrot onto a thief so it moves smoothly with their character.
function Models.attach(model: Model, root: BasePart, offset: CFrame)
	model:SetAttribute("Carried", true)
	model:PivotTo(root.CFrame * offset)
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			p.Massless = true
			p.Anchored = false
		end
	end
	local weld = Instance.new("WeldConstraint")
	weld.Name = "CarryWeld"
	weld.Part0 = root
	weld.Part1 = model.PrimaryPart
	weld.Parent = model.PrimaryPart
end

function Models.detach(model: Model)
	local primary = model.PrimaryPart
	local weld = primary and primary:FindFirstChild("CarryWeld")
	if weld then
		weld:Destroy()
	end
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = true
		end
	end
	model:SetAttribute("Carried", false)
end

-- The brainrot model that a prompt (or any part) belongs to.
function Models.ownerModel(instance: Instance): Model?
	local node = instance.Parent
	while node and node ~= workspace do
		if node:IsA("Model") and node:GetAttribute("BrainrotId") then
			return node
		end
		node = node.Parent
	end
	return nil
end

-- Where the model's pivot must go so it stands on `ground` (a CFrame on a floor).
function Models.stand(model: Model, ground: CFrame): CFrame
	return ground * CFrame.new(0, model:GetAttribute("GroundOffset") or 0, 0)
end

local function popupLabel(model: Model, name: string): TextLabel?
	local primary = model.PrimaryPart
	local popup = primary and primary:FindFirstChild("Popup")
	return popup and popup:FindFirstChild(name) :: TextLabel?
end

function Models.setInfo(model: Model, text: string)
	local label = popupLabel(model, "InfoLabel")
	if label then
		label.Text = text
	end
end

-- While being stolen, the brainrot panics.
function Models.setPanic(model: Model, def: Brainrots.Def, panicking: boolean)
	local label = popupLabel(model, "PhraseLabel")
	if not label then
		return
	end
	if panicking then
		label.Text = "AAAA! " .. def.phrase:upper()
		label.TextColor3 = Color3.fromRGB(255, 80, 80)
	else
		label.Text = '"' .. def.phrase .. '"'
		label.TextColor3 = Color3.fromRGB(255, 230, 120)
	end
end

return Models
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">Mover</string>
          <string name="Source"><![CDATA[-- Moves brainrot models: walking home from the door or walking to a plot.
--
-- For smooth movement the server does not move models every frame. When a
-- brainrot starts walking, the server writes where from, where to, when and
-- how fast into attributes, and every player's screen animates it smoothly
-- (Smooth.client.luau). The server still updates the real position 10 times
-- a second so prompts and distance checks stay right.
--
-- Carrying a brainrot is done with a weld (Models.attach), not here.

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Motion = require(Shared.Motion)

local Mover = {}

local UPDATE_EVERY = 0.1

local jobs: { [Model]: any } = {}
local sinceUpdate = 0

local function now(): number
	return workspace:GetServerTimeNow()
end

local function rest(model: Model, cf: CFrame)
	model:SetAttribute("MoveSpeed", 0)
	model:SetAttribute("Rest", cf)
end

local function startSegment(model: Model, job)
	job.from = model:GetPivot()
	job.startedAt = now()
	model:SetAttribute("MoveFrom", job.from)
	model:SetAttribute("MoveTo", job.points[job.index])
	model:SetAttribute("MoveStart", job.startedAt)
	model:SetAttribute("MoveSpeed", job.speed)
end

local function current(job, t: number): (CFrame, boolean)
	return Motion.at(job.from, job.points[job.index], job.startedAt, job.speed, t)
end

-- Walk through each CFrame in `points` at `speed` studs per second.
-- `onDone` runs after the last point is reached (not if the walk is replaced or stopped).
function Mover.walk(model: Model, points: { CFrame }, speed: number, onDone: (() -> ())?)
	local old = jobs[model]
	if old then
		model:PivotTo((current(old, now())))
	end
	local job = { points = points, index = 1, speed = speed, onDone = onDone }
	jobs[model] = job
	startSegment(model, job)
end

-- Put a model somewhere instantly.
function Mover.place(model: Model, cf: CFrame)
	jobs[model] = nil
	model:PivotTo(cf)
	rest(model, cf)
end

-- Stop walking right where it is.
function Mover.stop(model: Model)
	local job = jobs[model]
	if not job then
		return
	end
	jobs[model] = nil
	local cf = current(job, now())
	model:PivotTo(cf)
	rest(model, cf)
end

-- Where a model is right now, even mid-walk.
function Mover.pivot(model: Model): CFrame
	local job = jobs[model]
	if job then
		return (current(job, now()))
	end
	return model:GetPivot()
end

function Mover.isWalking(model: Model): boolean
	return jobs[model] ~= nil
end

RunService.Heartbeat:Connect(function(dt)
	sinceUpdate += dt
	if sinceUpdate < UPDATE_EVERY then
		return
	end
	sinceUpdate = 0
	local t = now()

	local finished = {}
	for model, job in jobs do
		if model.Parent == nil then
			jobs[model] = nil
			continue
		end
		local cf, arrived = current(job, t)
		model:PivotTo(cf)
		if arrived then
			if job.index < #job.points then
				job.index += 1
				startSegment(model, job)
			else
				jobs[model] = nil
				rest(model, cf)
				if job.onDone then
					table.insert(finished, job.onDone)
				end
			end
		end
	end

	-- Run callbacks after the loop so they can safely start new walks.
	for _, callback in finished do
		task.spawn(callback)
	end
end)

return Mover
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">Picker</string>
          <string name="Source"><![CDATA[-- Picks a brainrot: first a rarity using weights, then a brainrot of that
-- rarity from a pool. Luck makes Rare and better more likely.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Brainrots = require(Shared.Brainrots)

local Picker = {}

local LUCKY = { Rare = true, Epic = true, Legendary = true, Mythic = true }

-- `odds`: rarity -> weight. `pool`: brainrot ids (default: everything that hatches).
function Picker.pick(odds: { [string]: number }, pool: { string }?, luck: number?): Brainrots.Def
	local byRarity = {}
	if pool then
		for _, id in pool do
			local def = Brainrots.byId[id]
			if def and not def.questOnly then
				byRarity[def.rarity] = byRarity[def.rarity] or {}
				table.insert(byRarity[def.rarity], def)
			end
		end
	else
		for _, rarity in Brainrots.RARITY_ORDER do
			byRarity[rarity] = Brainrots.byRarity[rarity]
		end
	end

	local tiers, total = {}, 0
	for _, rarity in Brainrots.RARITY_ORDER do
		local list = byRarity[rarity]
		local weight = (odds[rarity] or 0) * (if LUCKY[rarity] then luck or 1 else 1)
		if list and #list > 0 and weight > 0 then
			table.insert(tiers, { weight = weight, list = list })
			total += weight
		end
	end
	assert(#tiers > 0, "[ChaiChaos] nothing to pick from")
	local roll = math.random() * total
	for _, tier in tiers do
		roll -= tier.weight
		if roll <= 0 then
			return tier.list[math.random(#tier.list)]
		end
	end
	local last = tiers[#tiers]
	return last.list[math.random(#last.list)]
end

return Picker
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">PlayerData</string>
          <string name="Source"><![CDATA[-- Saving and loading with DataStoreService.
--
-- In Studio, saving only works when the place is published and
-- Game Settings > Security > "Enable Studio Access to API Services" is on.
-- Without it the game still runs, it just starts fresh every time.

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Config = require(Shared.Config)
local Brainrots = require(Shared.Brainrots)
local Mutations = require(Shared.Mutations)
local Themes = require(Shared.Themes)
local Gear = require(Shared.Gear)
local Biomes = require(Shared.Biomes)
local Vehicles = require(Shared.Vehicles)

local PlayerData = {}

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DATASTORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[ChaiChaos] DataStore is not available, progress will not be saved:", result)
	end
end

local function storeKey(userId: number): string
	return "player_" .. userId
end

function PlayerData.default()
	return {
		version = 4,
		rupees = Config.START_RUPEES,
		galla = 0,
		rebirths = 0,
		level = 1, -- haveli level (see Config.HAVELI_LEVELS)
		theme = Themes.DEFAULT,
		owned = {}, -- brainrot keys: "SamosaSupremo" or "SamosaSupremo:Golden"
		discovered = {}, -- [id] = true
		mutations = {}, -- ["SamosaSupremo:Golden"] = true, for the Collection Book
		lastDaily = 0, -- day number of the last daily chai
		rollTokens = 0, -- Kismat Rolls from daily chai, quests and Robux packs
		rollPity = 0, -- rolls since the last Epic or better
		stealTokens = 0, -- Chor Passes, one is used for every steal
		receipts = {}, -- recent Robux purchase ids, so a purchase is never granted twice
		quests = { day = 0, list = {}, bonusClaimed = false },
		collection = {}, -- [rarity] = { rewarded = true, specialRebirth = n }
		trackerLevel = 1, -- egg tracker level (see Config.TRACKER_LEVELS)
		gear = {}, -- [gear id] = true
		incubators = {}, -- { slot, biome, golden, id, mutation, hatchAt } eggs waiting to hatch
		zones = {}, -- [zone id] = true for zones bought at their gate (ring 3 opens with rebirths)
		vehicles = {}, -- [vehicle id] = { fuel, speed, tank, eggs, grip } (upgrade levels)
		vehicle = nil, -- the vehicle you drove last
		paints = {}, -- [paint id] = true for Robux paint jobs
		paint = "Factory", -- the paint job on your vehicles
	}
end

-- Version 3 had 8 biomes; eggs waiting in an incubator keep hatching as one of the new zones.
local OLD_BIOMES = {
	Khet = "MangoBagh",
	Jungle = "CamelMela",
	Samandar = "SahilBeach",
	Jheel = "SarsonFields",
	Registan = "TharDesert",
	Delta = "QissaKhawani",
	Pahar = "BarfaniPahar",
	NamakKaan = "NamakCaves",
}

-- Brainrots that were renamed, so old saves keep them under their new id.
local RENAMED = {
	CycleWalaCyclops = "CylinderCycleChacha",
}
PlayerData.RENAMED = RENAMED

-- A saved brainrot key ("Id" or "Id:Mutation") as its current id and mutation.
local function parseKey(key: string): (string, string?)
	local id, mutation = Mutations.parse(key)
	return RENAMED[id] or id, mutation
end

local function whole(value: any, minimum: number): number?
	if type(value) == "number" and value == value then
		return math.max(minimum, math.floor(value))
	end
	return nil
end

-- Fill in anything missing or broken so old saves keep working.
local function reconcile(saved: any)
	local data = PlayerData.default()
	if type(saved) ~= "table" then
		return data
	end
	data.rupees = whole(saved.rupees, 0) or data.rupees
	data.galla = if type(saved.galla) == "number" then math.max(0, saved.galla) else 0
	data.rebirths = whole(saved.rebirths, 0) or 0
	data.lastDaily = whole(saved.lastDaily, 0) or 0
	data.rollTokens = whole(saved.rollTokens, 0) or 0
	data.stealTokens = whole(saved.stealTokens, 0) or 0
	data.rollPity = whole(saved.rollPity, 0) or 0

	if type(saved.level) == "number" then
		data.level = math.clamp(math.floor(saved.level), 1, #Config.HAVELI_LEVELS)
	elseif type(saved.plots) == "number" then
		-- version 1 saved a plot count instead of a level
		for level, info in Config.HAVELI_LEVELS do
			if info.plots <= saved.plots then
				data.level = level
			end
		end
	end
	if type(saved.theme) == "string" and Themes.isUnlocked(saved.theme, data.rebirths) then
		data.theme = saved.theme
	end
	if type(saved.trackerLevel) == "number" then
		data.trackerLevel = math.clamp(math.floor(saved.trackerLevel), 1, #Config.TRACKER_LEVELS)
	end
	if type(saved.gear) == "table" then
		for id, value in saved.gear do
			if value == true and type(id) == "string" and Gear.byId[id] then
				data.gear[id] = true
			end
		end
	end

	if type(saved.receipts) == "table" then
		for _, id in saved.receipts do
			if type(id) == "string" then
				table.insert(data.receipts, id)
			end
		end
	end
	if type(saved.discovered) == "table" then
		for id, value in saved.discovered do
			id = RENAMED[id] or id
			if value == true and Brainrots.byId[id] then
				data.discovered[id] = true
			end
		end
	end
	if type(saved.mutations) == "table" then
		for key, value in saved.mutations do
			local id, mutation = parseKey(key)
			if value == true and Brainrots.byId[id] and mutation then
				data.mutations[Mutations.key(id, mutation)] = true
			end
		end
	end
	local plots = Config.HAVELI_LEVELS[data.level].plots
	if type(saved.zones) == "table" then
		for id, value in saved.zones do
			local biome = Biomes.byId[id]
			if value == true and biome and biome.price > 0 then
				data.zones[id] = true
			end
		end
	end
	if type(saved.vehicles) == "table" then
		for id, entry in saved.vehicles do
			local def = Vehicles.byId[id]
			if def and type(entry) == "table" then
				local levels = { fuel = 0 }
				for _, upgrade in Vehicles.UPGRADES do
					levels[upgrade.id] =
						math.clamp(whole(entry[upgrade.id], 0) or 0, 0, Vehicles.maxLevel(def, upgrade.id))
				end
				local tank = Vehicles.tank(def, Vehicles.levels(levels))
				levels.fuel = if type(entry.fuel) == "number" and entry.fuel == entry.fuel
					then math.clamp(entry.fuel, 0, tank)
					else tank
				data.vehicles[id] = levels
			end
		end
	end
	if type(saved.vehicle) == "string" and data.vehicles[saved.vehicle] then
		data.vehicle = saved.vehicle
	end
	if type(saved.paints) == "table" then
		for id, value in saved.paints do
			if value == true and Vehicles.paintById[id] and id ~= "Factory" then
				data.paints[id] = true
			end
		end
	end
	if type(saved.paint) == "string" and (saved.paint == "Factory" or data.paints[saved.paint]) then
		data.paint = saved.paint
	end
	if type(saved.incubators) == "table" then
		local used = {}
		for _, egg in saved.incubators do
			local eggId = type(egg) == "table" and type(egg.id) == "string" and (RENAMED[egg.id] or egg.id)
			local eggBiome = type(egg) == "table"
				and type(egg.biome) == "string"
				and (OLD_BIOMES[egg.biome] or egg.biome)
			local slot = type(egg) == "table" and whole(egg.slot, 1)
			if
				slot
				and not used[slot]
				and slot <= Config.HAVELI_LEVELS[data.level].incubators
				and eggBiome
				and Biomes.byId[eggBiome]
				and eggId
				and Brainrots.byId[eggId]
				and type(egg.hatchAt) == "number"
			then
				used[slot] = true
				table.insert(data.incubators, {
					slot = slot,
					biome = eggBiome,
					golden = egg.golden == true,
					id = eggId,
					mutation = if type(egg.mutation) == "string" and Mutations.byId[egg.mutation]
						then egg.mutation
						else nil,
					hatchAt = math.floor(egg.hatchAt),
				})
			end
		end
	end
	if type(saved.owned) == "table" then
		for _, key in saved.owned do
			if type(key) == "string" then
				local id, mutation = parseKey(key)
				if Brainrots.byId[id] and #data.owned < plots then
					table.insert(data.owned, Mutations.key(id, mutation))
					data.discovered[id] = true
				end
			end
		end
	end
	-- Version 3 let you ride a brainrot. Riding is gone, so it walks back to a
	-- plot; if every plot is full you get its full value in rupees instead.
	if type(saved.ride) == "string" then
		local id, mutation = parseKey(saved.ride)
		local def = Brainrots.byId[id]
		if def and not def.questOnly then
			data.discovered[id] = true
			if #data.owned < plots then
				table.insert(data.owned, Mutations.key(id, mutation))
			else
				data.rupees += Mutations.value(def, mutation)
			end
		end
	end
	if type(saved.quests) == "table" and type(saved.quests.list) == "table" then
		local quests =
			{ day = whole(saved.quests.day, 0) or 0, list = {}, bonusClaimed = saved.quests.bonusClaimed == true }
		for _, q in saved.quests.list do
			if type(q) == "table" and type(q.id) == "string" and type(q.target) == "number" then
				table.insert(quests.list, {
					id = q.id,
					target = q.target,
					progress = whole(q.progress, 0) or 0,
					claimed = q.claimed == true,
				})
			end
		end
		data.quests = quests
	end
	if type(saved.collection) == "table" then
		for rarity, entry in saved.collection do
			if Config.COLLECTION_REWARDS[rarity] and type(entry) == "table" then
				data.collection[rarity] = {
					rewarded = entry.rewarded == true,
					specialRebirth = whole(entry.specialRebirth, -1),
				}
			end
		end
	end
	return data
end
PlayerData.reconcile = reconcile

-- Returns the data and whether it is safe to save over it later.
-- If loading fails we never save, so a hiccup cannot wipe someone's progress.
function PlayerData.load(userId: number): (any, boolean)
	if not store then
		return PlayerData.default(), false
	end
	local attempts = if RunService:IsStudio() then 1 else 3
	for attempt = 1, attempts do
		local ok, result = pcall(function()
			return store:GetAsync(storeKey(userId))
		end)
		if ok then
			return reconcile(result), true
		end
		warn(("[ChaiChaos] Could not load data for %d (try %d): %s"):format(userId, attempt, tostring(result)))
		if attempt < attempts then
			task.wait(attempt * 2)
		end
	end
	return PlayerData.default(), false
end

function PlayerData.save(userId: number, data: any): boolean
	if not store then
		return false
	end
	local ok, err = pcall(function()
		store:UpdateAsync(storeKey(userId), function()
			return data
		end)
	end)
	if not ok then
		warn(("[ChaiChaos] Could not save data for %d: %s"):format(userId, tostring(err)))
	end
	return ok
end

return PlayerData
]]></string>
        </Properties>
      </Item>
