      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">Props</string>
          <string name="Source"><![CDATA[-- Props modelled in Blender: landmarks, trees, dhabas, trucks and the rest.
-- The models live in blender/ and are turned into PropData.luau.
--
-- Every prop can be built from plain Roblox parts, so the game works with no
-- imports at all. If you import the Blender meshes (assets/props/ChaiChaosProps.fbx)
-- into ServerStorage > ChaiChaosProps (see the README), each prop uses its
-- smoother mesh instead. The parts it would have used become invisible walls,
-- so you can still walk on bridges, jetties and decks.

local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Config = require(Shared.Config)

local PropData = require(script.Parent.PropData)

local Props = {}

local NOCOLLIDE, KEEP, GLASS, LIGHT, NOSHADOW, EYE, PAINT = 1, 2, 4, 8, 16, 64, 128
local SHAPES = { B = Enum.PartType.Block, C = Enum.PartType.Cylinder, L = Enum.PartType.Ball }
local MESH_FOLDER = "ChaiChaosProps"

local palette: { Color3 } = {}
for i, rgb in PropData.palette do
	palette[i] = Color3.fromRGB(rgb[1], rgb[2], rgb[3])
end
local materials: { Enum.Material } = {}
for i, name in PropData.materials do
	materials[i] = (Enum.Material :: any)[name]
end

local function v3(t: { number }, scale: number?): Vector3
	local s = scale or 1
	return Vector3.new(t[1] * s, t[2] * s, t[3] * s)
end

local function hasFlag(flags: number, flag: number): boolean
	return flags // flag % 2 == 1
end

---------------------------------------------------------------------------
-- Imported meshes
---------------------------------------------------------------------------
local meshes: { [string]: BasePart } = {}
local meshesLoaded = false

-- Looks for imported meshes again (for example after you add the folder).
function Props.reload()
	table.clear(meshes)
	meshesLoaded = true
	local folder = ServerStorage:FindFirstChild(MESH_FOLDER)
	if not folder then
		return
	end
	for name in PropData.props do
		local found = folder:FindFirstChild(name, true)
		if found and found:IsA("Model") then
			found = found:FindFirstChildWhichIsA("MeshPart", true)
		end
		if found and found:IsA("BasePart") then
			meshes[name] = found
		end
	end
end

function Props.meshFor(name: string): BasePart?
	if not meshesLoaded then
		Props.reload()
	end
	return meshes[name]
end

-- The 3D importer can bring a mesh in lying on its side (Z up instead of Y up).
-- Compares the imported size with the size the mesh should have and returns
-- the size to give it in its own axes and the turn that stands it up again.
local FIXES = {
	{ order = { 1, 2, 3 }, turn = CFrame.new() },
	{ order = { 1, 3, 2 }, turn = CFrame.Angles(math.rad(-90), 0, 0) }, -- height along its Z
	{ order = { 2, 1, 3 }, turn = CFrame.Angles(0, 0, math.rad(90)) }, -- height along its X
	{ order = { 3, 2, 1 }, turn = CFrame.Angles(0, math.rad(90), 0) }, -- turned sideways
}

local function shapeError(a: Vector3, b: Vector3): number
	local function logs(v: Vector3)
		local m = math.max(v.X, v.Y, v.Z, 1e-3)
		return math.log(math.max(v.X, 1e-3) / m), math.log(math.max(v.Y, 1e-3) / m), math.log(math.max(v.Z, 1e-3) / m)
	end
	local ax, ay, az = logs(a)
	local bx, by, bz = logs(b)
	return math.abs(ax - bx) + math.abs(ay - by) + math.abs(az - bz)
end

function Props.meshFit(imported: Vector3, expected: Vector3): (Vector3, CFrame)
	local e = { expected.X, expected.Y, expected.Z }
	local best, bestError = FIXES[1], math.huge
	for i, fix in FIXES do
		local candidate = Vector3.new(e[fix.order[1]], e[fix.order[2]], e[fix.order[3]])
		-- the importer's own guess wins unless another fits clearly better
		local err = shapeError(imported, candidate) + (if i == 1 then 0 else 0.15)
		if err < bestError then
			best, bestError = fix, err
		end
	end
	return Vector3.new(e[best.order[1]], e[best.order[2]], e[best.order[3]]), best.turn
end

---------------------------------------------------------------------------
-- Building
---------------------------------------------------------------------------
function Props.exists(name: string): boolean
	return PropData.props[name] ~= nil
end

-- The prop's size (width, height, depth) at a scale.
function Props.size(name: string, scale: number?): Vector3
	return v3(PropData.props[name].size, scale)
end

-- Where a named point of the prop ends up when it is placed at `cf`.
function Props.anchor(name: string, anchorName: string, cf: CFrame, scale: number?): Vector3
	local spec = PropData.props[name]
	local point = spec and spec.anchors and spec.anchors[anchorName]
	assert(point, ("[ChaiChaos] prop %s has no anchor %s"):format(name, anchorName))
	return cf * v3(point, scale)
end

local function newPart(entry, cf: CFrame, scale: number, visible: boolean): Part
	local flags = entry[14]
	local p = Instance.new("Part")
	p.Shape = SHAPES[entry[1]]
	p.Size = Vector3.new(entry[5] * scale, entry[6] * scale, entry[7] * scale)
	p.CFrame = cf
		* CFrame.new(entry[2] * scale, entry[3] * scale, entry[4] * scale, entry[8], entry[9], entry[10], entry[11])
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = not hasFlag(flags, NOCOLLIDE)
	if visible then
		if hasFlag(flags, EYE) then
			p.Name = "Eye" -- eyes keep their colour on Golden, Diamond and Rainbow brainrots
		elseif hasFlag(flags, PAINT) then
			p.Name = "Paint" -- a vehicle's panels: paint jobs recolour these
		end
		p.Color = palette[entry[12]]
		p.Material = materials[entry[13]]
		p.CastShadow = not hasFlag(flags, NOSHADOW)
		if hasFlag(flags, GLASS) then
			p.Transparency = 0.5
		end
		if hasFlag(flags, LIGHT) then
			local light = Instance.new("PointLight")
			light.Color = p.Color
			light.Range = 16
			light.Brightness = 1.6
			light.Parent = p
		end
	else
		-- an invisible wall where the mesh is
		p.Transparency = 1
		p.CastShadow = false
		p.Name = "Collider"
	end
	return p
end

export type PlaceOptions = {
	parts: boolean?, -- always build from parts, even if a mesh was imported
	noColliders: boolean?, -- with a mesh, leave out the invisible walls
}

-- Builds a prop standing at `cf` (its ground point; it faces cf's front).
-- Pass nil as the parent to get the model without putting it anywhere yet.
function Props.place(name: string, cf: CFrame, parent: Instance?, scale: number?, options: PlaceOptions?): Model
	local spec = PropData.props[name]
	assert(spec, "[ChaiChaos] unknown prop " .. name)
	local s = scale or 1
	local model = Instance.new("Model")
	model.Name = name
	local mesh = spec.mesh and not (options and options.parts) and Props.meshFor(name)
	local colliders = not (options and options.noColliders)
	for _, entry in spec.parts do
		local flags = entry[14]
		local keep = hasFlag(flags, KEEP)
		if not mesh or keep then
			newPart(entry, cf, s, true).Parent = model
		elseif colliders and not hasFlag(flags, NOCOLLIDE) then
			newPart(entry, cf, s, false).Parent = model
		end
	end
	if mesh then
		local copy = mesh:Clone()
		local size, turn = Props.meshFit(mesh.Size, v3(spec.mesh.size, s))
		copy.Name = name
		copy.Anchored = true
		copy.CanCollide = false
		copy.Size = size
		copy.CFrame = cf
			* CFrame.Angles(0, math.rad(Config.PROP_MESH_TURN), 0)
			* CFrame.new(v3(spec.mesh.center, s))
			* turn
		copy.Parent = model
	end
	model.WorldPivot = cf
	model.Parent = parent
	return model
end

-- Writes text on a prop's sign: an invisible board at `position` (a sign
-- anchor), facing the same way as the prop placed at `cf`.
function Props.text(
	parent: Instance,
	cf: CFrame,
	position: Vector3,
	width: number,
	height: number,
	text: string,
	color: Color3?
): Part
	local board = Instance.new("Part")
	board.Name = "SignText"
	board.Anchored = true
	board.CanCollide = false
	board.CanQuery = false
	board.CanTouch = false
	board.CastShadow = false
	board.Transparency = 1
	board.Size = Vector3.new(width, height, 0.05)
	board.CFrame = cf.Rotation + position + cf.LookVector * 0.06
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Gui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0.4
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.Text = text
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(30, 20, 15)
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = board
	board.Parent = parent
	return board
end

return Props
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">QuestBook</string>
          <string name="Source"><![CDATA[-- Daily quests and Collection Book rewards.
--
-- Every day (UTC) each player gets Config.QUESTS_PER_DAY quests from
-- Quests.luau. Each finished quest pays rupees (and sometimes a Kismat Roll);
-- finishing all of them pays bonus Kismat Rolls.
--
-- Discovering every brainrot of a rarity unlocks a Collection Book reward:
-- rupees and Kismat Rolls once, plus a special quest brainrot that can be
-- claimed again after every Naya Safar.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Config = require(Shared.Config)
local Brainrots = require(Shared.Brainrots)
local Format = require(Shared.Format)
local Quests = require(Shared.Quests)
local Remotes = require(Shared.Remotes)

local State = require(script.Parent.State)
local Havelis = require(script.Parent.Havelis)

local QuestBook = {}

local function today(): number
	return math.floor(os.time() / 86400)
end

-- 12345 -> 12000, so targets and rewards look tidy.
local function tidy(n: number): number
	if n < 100 then
		return math.floor(n)
	end
	local step = 10 ^ (math.floor(math.log10(n)) - 1)
	return math.floor(n / step) * step
end

local function canOffer(profile, quest): boolean
	local data = profile.data
	if quest.needs == "upgrade" then
		return data.level < #Config.HAVELI_LEVELS or data.trackerLevel < #Config.TRACKER_LEVELS
	elseif quest.needs == "treasureGear" then
		return data.gear.Shovel == true or data.gear.RopeLadder == true
	elseif quest.needs == "undiscovered" then
		for _, def in Brainrots.list do
			if not def.questOnly and not data.discovered[def.id] then
				return true
			end
		end
		return false
	end
	return true
end

function QuestBook.moneyTarget(profile): number
	return tidy(math.max(2_000, Havelis.incomePerSecond(profile) * 120))
end

function QuestBook.reward(profile): number
	return tidy(math.max(Config.QUEST_MIN_REWARD, Havelis.incomePerSecond(profile) * Config.QUEST_REWARD_SECONDS))
end

-- Gives the player today's quests if they do not have them yet.
function QuestBook.ensure(profile)
	local quests = profile.data.quests
	if quests.day == today() and #quests.list > 0 then
		return
	end
	local pool = {}
	for _, quest in Quests.list do
		if canOffer(profile, quest) then
			table.insert(pool, quest)
		end
	end
	local list = {}
	for _ = 1, math.min(Config.QUESTS_PER_DAY, #pool) do
		local quest = table.remove(pool, math.random(#pool))
		local target = if quest.money
			then QuestBook.moneyTarget(profile)
			else quest.targets[math.random(#quest.targets)]
		table.insert(list, { id = quest.id, target = target, progress = 0, claimed = false })
	end
	profile.data.quests = { day = today(), list = list, bonusClaimed = false }
	State.syncQuests(profile)
end

function QuestBook.track(profile, kind: string, amount: number)
	QuestBook.ensure(profile)
	local changed = false
	for _, quest in profile.data.quests.list do
		if quest.id == kind and not quest.claimed and quest.progress < quest.target then
			quest.progress = math.min(quest.target, quest.progress + amount)
			changed = true
			if quest.progress >= quest.target then
				State.notify(profile.player, "good", "Quest done! Claim your reward in the Quests menu.")
			end
		end
	end
	if changed then
		State.syncQuests(profile)
	end
end

-- "Bring eggs home from N different biomes": counts each biome once.
function QuestBook.trackBiome(profile, biomeId: string)
	QuestBook.ensure(profile)
	for _, quest in profile.data.quests.list do
		if quest.id == "biomes" and not quest.claimed then
			quest.seen = quest.seen or {}
			if not table.find(quest.seen, biomeId) then
				table.insert(quest.seen, biomeId)
				QuestBook.track(profile, "biomes", 1)
			end
		end
	end
end

function QuestBook.claim(player: Player, which: any)
	local profile = State.profiles[player]
	if not profile then
		return
	end
	QuestBook.ensure(profile)
	local quests = profile.data.quests
	if which == "bonus" then
		for _, quest in quests.list do
			if not quest.claimed then
				return
			end
		end
		if quests.bonusClaimed then
			return
		end
		quests.bonusClaimed = true
		profile.data.rollTokens += Config.QUEST_BONUS_ROLLS
		State.syncTokens(profile)
		State.notify(
			player,
			"rare",
			("All quests done! Here are %d free Kismat Rolls. Shabash!"):format(Config.QUEST_BONUS_ROLLS)
		)
	else
		local quest = type(which) == "number" and quests.list[which]
		if not quest or quest.claimed or quest.progress < quest.target then
			return
		end
		quest.claimed = true
		local rupees = QuestBook.reward(profile)
		State.addRupees(profile, rupees)
		local rolls = (Quests.byId[quest.id] and Quests.byId[quest.id].rolls) or 0
		if rolls > 0 then
			profile.data.rollTokens += rolls
			State.syncTokens(profile)
		end
		State.notify(
			player,
			"good",
			("Quest reward: %s%s"):format(
				Format.rupees(rupees),
				if rolls > 0 then (" and %d Kismat Roll"):format(rolls) else ""
			)
		)
	end
	State.syncQuests(profile)
end

-- How many brainrots of a rarity the player has discovered.
function QuestBook.collectionProgress(profile, rarity: string): (number, number)
	local found, total = 0, 0
	for _, def in Brainrots.byRarity[rarity] or {} do
		total += 1
		if profile.data.discovered[def.id] then
			found += 1
		end
	end
	return found, total
end

function QuestBook.claimCollection(player: Player, rarity: any)
	local profile = State.profiles[player]
	local reward = type(rarity) == "string" and Config.COLLECTION_REWARDS[rarity]
	if not profile or not reward then
		return
	end
	local found, total = QuestBook.collectionProgress(profile, rarity)
	if found < total then
		return
	end
	local data = profile.data
	local entry = data.collection[rarity] or { rewarded = false }
	data.collection[rarity] = entry
	local given = {}
	if not entry.rewarded then
		entry.rewarded = true
		State.addRupees(profile, reward.rupees)
		data.rollTokens += reward.rolls
		State.syncTokens(profile)
		table.insert(given, ("%s and %d Kismat Rolls"):format(Format.rupees(reward.rupees), reward.rolls))
	end
	local special = Brainrots.byId[reward.special]
	if special and entry.specialRebirth ~= data.rebirths then
		if Havelis.hasFreePlot(profile) then
			entry.specialRebirth = data.rebirths
			Havelis.adopt(profile, special, nil, nil, true)
			table.insert(given, special.name)
		else
			State.notify(player, "bad", ("Make room on a plot to get %s!"):format(special.name))
		end
	end
	if #given > 0 then
		State.notify(player, "rare", ("Collection Book reward: %s!"):format(table.concat(given, " and ")))
	end
	State.syncQuests(profile)
end

function QuestBook.init()
	State.tracker = QuestBook.track
	State.biomeTracker = QuestBook.trackBiome
	Remotes.ClaimQuest.OnServerEvent:Connect(QuestBook.claim)
	Remotes.ClaimCollection.OnServerEvent:Connect(QuestBook.claimCollection)
	-- new quests at midnight (UTC) for players who are still playing
	task.spawn(function()
		while true do
			task.wait(60)
			for _, profile in State.profiles do
				QuestBook.ensure(profile)
			end
		end
	end)
end

return QuestBook
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">Shop</string>
          <string name="Source"><![CDATA[-- Robux purchases (Developer Products) for Kismat Rolls, Chor Passes and
-- vehicle paint jobs (looks only).
--
-- Roblox calls ProcessReceipt for every purchase, and calls it again later if
-- we return NotProcessedYet. We only say PurchaseGranted once the item is given
-- and saved, and we never give the same purchase twice.
--
-- Kismat Rolls are paid random items, so they are never offered to players
-- where PolicyService says paid random items are restricted.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local PolicyService = game:GetService("PolicyService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local State = require(script.Parent.State)
local PlayerData = require(script.Parent.PlayerData)
local Havelis = require(script.Parent.Havelis)

local Shop = {}

local MAX_RECEIPTS = 50

-- Set by Main: gives a bought paint job (see Garage.onPaintBought).
Shop.paintHook = nil :: ((any, string) -> ())?

local paintPacks = {}
for paintId, productId in Config.PAINT_PRODUCTS do
	table.insert(paintPacks, { id = productId, amount = 1, paint = paintId })
end

-- What each kind of pack gives and which save field it adds to.
Shop.KINDS = {
	rolls = {
		field = "rollTokens",
		packs = Config.ROLL_PRODUCTS,
		one = "Kismat Roll",
		many = "Kismat Rolls",
		random = true,
	},
	steals = {
		field = "stealTokens",
		packs = Config.STEAL_PRODUCTS,
		one = "Chor Pass",
		many = "Chor Passes",
		random = false,
	},
	paint = {
		packs = paintPacks,
		one = "paint job",
		many = "paint jobs",
		random = false,
	},
}

function Shop.give(profile, field: string, amount: number)
	profile.data[field] += amount
	State.syncTokens(profile)
end

-- Gives (or takes back, if saving failed) what a pack is worth.
local function grant(profile, kind, pack, undo: boolean?)
	if kind.field then
		Shop.give(profile, kind.field, if undo then -pack.amount else pack.amount)
	elseif undo then
		profile.data.paints[pack.paint] = nil
		if profile.data.paint == pack.paint then
			profile.data.paint = "Factory"
		end
	elseif Shop.paintHook then
		Shop.paintHook(profile, pack.paint)
	else
		profile.data.paints[pack.paint] = true
	end
end

-- Shows the Robux purchase prompt for pack `index` of `kindName`.
function Shop.prompt(player: Player, kindName: any, index: any): boolean
	local kind = Shop.KINDS[kindName]
	if not kind then
		return false
	end
	local pack = nil
	if kindName == "paint" then
		for _, p in kind.packs do
			if p.paint == index then
				pack = p
			end
		end
		local profile = State.profiles[player]
		if pack and profile and profile.data.paints[pack.paint] then
			State.notify(player, "info", "You already have that paint job!")
			return false
		end
	elseif type(index) == "number" then
		pack = kind.packs[index]
	end
	if not pack or pack.id == 0 then
		return false
	end
	if kind.random and player:GetAttribute("PaidRollsAllowed") ~= true then
		State.notify(player, "bad", "Robux rolls are not available for your account. You can still roll with rupees!")
		return false
	end
	MarketplaceService:PromptProductPurchase(player, pack.id)
	return true
end

local function find(productId: number)
	for _, kind in Shop.KINDS do
		for _, pack in kind.packs do
			if pack.id ~= 0 and pack.id == productId then
				return kind, pack
			end
		end
	end
	return nil, nil
end

function Shop.processReceipt(receipt)
	local kind, pack = find(receipt.ProductId)
	if not kind then
		warn("[ChaiChaos] Unknown Developer Product " .. tostring(receipt.ProductId) .. ", add it to Config")
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local profile = player and State.profiles[player]
	if not profile then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- not loaded yet, Roblox will retry
	end

	local data = profile.data
	local purchaseId = tostring(receipt.PurchaseId)
	if table.find(data.receipts, purchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	local function undo()
		grant(profile, kind, pack, true)
		local index = table.find(data.receipts, purchaseId)
		if index then
			table.remove(data.receipts, index)
		end
	end

	grant(profile, kind, pack)
	table.insert(data.receipts, purchaseId)
	while #data.receipts > MAX_RECEIPTS do
		table.remove(data.receipts, 1)
	end

	if profile.canSave then
		Havelis.syncData(profile)
		if not PlayerData.save(player.UserId, data) then
			undo()
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
	elseif not RunService:IsStudio() then
		-- their data did not load, so we cannot save this yet; Roblox will retry
		undo()
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	if pack.paint then
		State.notify(player, "good", ("Shukriya! Your vehicles now have the %s paint job."):format(pack.paint))
	else
		State.notify(
			player,
			"good",
			("Shukriya! You got %d %s."):format(pack.amount, if pack.amount == 1 then kind.one else kind.many)
		)
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

-- Call when a player joins (it waits on Roblox, so run it in its own thread).
function Shop.setup(profile)
	State.syncTokens(profile)
	local ok, info = pcall(function()
		return PolicyService:GetPolicyInfoForPlayerAsync(profile.player)
	end)
	-- If Roblox cannot tell us, play it safe and do not offer paid rolls.
	local allowed = ok and type(info) == "table" and info.ArePaidRandomItemsRestricted == false
	profile.player:SetAttribute("PaidRollsAllowed", allowed)
end

function Shop.init()
	Remotes.BuyProduct.OnServerEvent:Connect(Shop.prompt)
	MarketplaceService.ProcessReceipt = Shop.processReceipt

	for _, kind in Shop.KINDS do
		local configured = false
		for _, pack in kind.packs do
			if pack.id ~= 0 then
				configured = true
			end
		end
		if not configured then
			print(
				("[ChaiChaos] %s Robux packs are hidden until you add Developer Product ids to Config."):format(
					kind.one
				)
			)
		end
	end
	if not Config.stealsCostRobux() then
		print("[ChaiChaos] Stealing is free until Config.STEAL_PRODUCTS has a Developer Product id.")
	end
end

return Shop
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">State</string>
          <string name="Source"><![CDATA[-- Shared server state: one profile per player and one entry per owned brainrot.

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Gear = require(Shared.Gear)
local Biomes = require(Shared.Biomes)

local State = {}

-- profiles[player] = {
--   player, data (saved), canSave, haveli, owned = { entry },
--   lockedUntil, lockReadyAt, protectedUntil (all in workspace:GetServerTimeNow() time)
-- }
State.profiles = {} :: { [Player]: any }

-- entries[model] = { uid, def, mutation, model, plot, carrier, arrived, owner (a profile) }
State.entries = {} :: { [Model]: any }

function State.newProfile(player: Player, data: any, canSave: boolean)
	return {
		player = player,
		data = data,
		canSave = canSave,
		haveli = nil,
		owned = {},
		lockedUntil = 0,
		lockReadyAt = 0,
		protectedUntil = 0,
		incubating = {}, -- [slot] = egg hatching in that incubator
		egg = nil, -- the egg being carried in your hands
		boot = {}, -- eggs in your vehicle's boot while you drive
		driving = nil, -- { def, model, levels, ... } the vehicle you are driving
	}
end

-- Quest progress: any module can report what a player did; QuestBook listens.
State.tracker = nil :: ((any, string, number) -> ())?
State.biomeTracker = nil :: ((any, string) -> ())?
function State.track(profile, kind: string, amount: number?)
	if State.tracker then
		State.tracker(profile, kind, amount or 1)
	end
end
function State.trackBiome(profile, biomeId: string)
	if State.biomeTracker then
		State.biomeTracker(profile, biomeId)
	end
end

-- Sounds play on the player's screen (see Sounds.luau and Sounds.client.luau).
function State.sound(player: Player, name: string, position: Vector3?)
	Remotes.PlaySound:FireClient(player, name, position)
end
function State.soundAll(name: string)
	Remotes.PlaySound:FireAllClients(name, nil)
end

-- Gear and tracker level, for the HUD and the radar.
function State.syncGear(profile)
	profile.player:SetAttribute("Gear", Gear.encode(profile.data.gear))
	profile.player:SetAttribute("TrackerLevel", profile.data.trackerLevel)
end

-- The zones open to a player (bought at their gate, free, or opened by rebirths).
function State.openZones(profile): { [string]: boolean }
	local open = {}
	for _, biome in Biomes.list do
		if Biomes.isOpen(biome, profile.data.zones, profile.data.rebirths) then
			open[biome.id] = true
		end
	end
	return open
end

function State.isZoneOpen(profile, biome): boolean
	return Biomes.isOpen(biome, profile.data.zones, profile.data.rebirths)
end

-- "MangoBagh,RailwayJunction": the gates and doors use it on the player's screen.
function State.syncZones(profile)
	profile.player:SetAttribute("OpenZones", Biomes.encode(State.openZones(profile)))
end

function State.notify(player: Player, kind: string, text: string)
	Remotes.Notify:FireClient(player, kind, text)
end

function State.notifyAll(kind: string, text: string)
	Remotes.Notify:FireAllClients(kind, text)
end

local function leaderstat(player: Player, name: string): IntValue?
	local stats = player:FindFirstChild("leaderstats")
	local value = stats and stats:FindFirstChild(name)
	return value :: IntValue?
end

-- Push saved numbers to the player list and to attributes the HUD reads.
function State.syncStats(profile)
	local rupees = leaderstat(profile.player, "Rupees")
	if rupees then
		rupees.Value = profile.data.rupees
	end
	local rebirths = leaderstat(profile.player, "Rebirths")
	if rebirths then
		rebirths.Value = profile.data.rebirths
	end
	profile.player:SetAttribute("RebirthCost", Config.rebirthCost(profile.data.rebirths))
	profile.player:SetAttribute("HaveliLevel", profile.data.level)
	profile.player:SetAttribute("Theme", profile.data.theme)
end

-- Quests and Collection Book claims, as JSON for the HUD.
function State.syncQuests(profile)
	local data = profile.data
	profile.player:SetAttribute(
		"QuestState",
		HttpService:JSONEncode({ quests = data.quests, collection = data.collection, rebirths = data.rebirths })
	)
end

function State.addRupees(profile, amount: number)
	profile.data.rupees = math.max(0, math.floor(profile.data.rupees + amount))
	State.syncStats(profile)
end

-- Kismat Rolls, Chor Passes and the pity counter, for the HUD.
function State.syncTokens(profile)
	local player, data = profile.player, profile.data
	player:SetAttribute("RollTokens", data.rollTokens)
	player:SetAttribute("StealTokens", data.stealTokens)
	player:SetAttribute("RollPity", data.rollPity)
end

function State.syncDiscovered(profile)
	local ids = {}
	for id in profile.data.discovered do
		table.insert(ids, id)
	end
	for key in profile.data.mutations do
		table.insert(ids, key)
	end
	table.sort(ids)
	profile.player:SetAttribute("Discovered", table.concat(ids, ","))
end

-- Returns true the first time a player gets this brainrot.
function State.discover(profile, def, mutation: string?): boolean
	local data = profile.data
	local isNew = not data.discovered[def.id]
	local mutationKey = mutation and (def.id .. ":" .. mutation)
	local newMutation = mutationKey ~= nil and not data.mutations[mutationKey]
	if not isNew and not newMutation then
		return false
	end
	data.discovered[def.id] = true
	if mutationKey then
		data.mutations[mutationKey] = true
	end
	State.syncDiscovered(profile)
	return isNew
end

function State.rootPart(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return root :: BasePart?
end

-- Is the player's character alive and within `range` studs of `position`?
function State.isNear(player: Player, position: Vector3, range: number): boolean
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = State.rootPart(player)
	if not humanoid or humanoid.Health <= 0 or not root then
		return false
	end
	return (root.Position - position).Magnitude <= range
end

return State
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">Stealing</string>
          <string name="Source"><![CDATA[-- Stealing brainrots from other havelis.
--
-- Hold E for 1.5 seconds on someone else's brainrot and it rides on your back.
-- Run through your own haveli door to keep it. If you die, fall off the map,
-- reset or leave, or someone bonks you with a chappal, it walks back home.
--
-- Every steal uses one Chor Pass, bought with Robux (Config.STEAL_PRODUCTS).
-- If the steal fails, the Chor Pass is given back (Config.STEAL_REFUND_ON_FAIL).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Mutations = require(Shared.Mutations)
local Themes = require(Shared.Themes)

local State = require(script.Parent.State)
local Models = require(script.Parent.Models)
local Mover = require(script.Parent.Mover)
local Havelis = require(script.Parent.Havelis)
local Shop = require(script.Parent.Shop)
local EggSystem = require(script.Parent.EggSystem)

local Stealing = {}

local CARRY_OFFSET = CFrame.new(0, 2.6, 2)

-- carrying[thief] = { entry, connections, marker, tag, usedPass }
local carrying: { [Player]: any } = {}
local lastSteal: { [Player]: number } = {}
local lastTarget: { [Player]: { ownerId: number, time: number } } = {}
local lastBonk: { [Player]: number } = {}

local function cleanup(carry)
	for _, connection in carry.connections do
		connection:Disconnect()
	end
	if carry.marker then
		carry.marker:Destroy()
	end
	if carry.tag then
		carry.tag:Destroy()
	end
end

local function markThief(character: Model)
	local marker = Instance.new("Highlight")
	marker.Name = "ChorMarker"
	marker.FillColor = Color3.fromRGB(255, 40, 40)
	marker.FillTransparency = 0.6
	marker.OutlineColor = Color3.fromRGB(255, 220, 60)
	marker.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	marker.Parent = character

	local tag = Instance.new("BillboardGui")
	tag.Name = "ChorTag"
	tag.Size = UDim2.fromScale(5, 1.5)
	tag.StudsOffsetWorldSpace = Vector3.new(0, 6.5, 0)
	tag.AlwaysOnTop = true
	tag.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 70, 70)
	label.Text = "CHOR!"
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Parent = label
	label.Parent = tag
	tag.Parent = character:FindFirstChild("Head") or character.PrimaryPart
	return marker, tag
end

-- A failed steal gives the thief their Chor Pass back.
local function refund(thief: Player, carry)
	if not carry.usedPass or not Config.STEAL_REFUND_ON_FAIL then
		return
	end
	local profile = State.profiles[thief]
	if profile then
		profile.data.stealTokens += 1
		State.syncTokens(profile)
		if thief.Parent then
			State.notify(thief, "info", "Your Chor Pass was given back.")
		end
	end
end

-- Puts the thief's walking speed back to normal.
local function unslow(thief: Player)
	local profile = State.profiles[thief]
	if profile then
		profile.carrySpeed = nil
		profile.carryingBrainrot = false
		Havelis.applyWalkSpeed(profile)
	end
end

-- Sends a carried brainrot back to its owner.
function Stealing.returnToOwner(thief: Player, reason: string?)
	local carry = carrying[thief]
	if not carry then
		return
	end
	carrying[thief] = nil
	cleanup(carry)
	refund(thief, carry)
	unslow(thief)

	local entry = carry.entry
	Models.detach(entry.model)
	Models.setPanic(entry.model, entry.def, false)
	if State.entries[entry.model] ~= entry or not entry.model.Parent then
		return
	end
	Havelis.returnHome(entry)
	local owner = entry.owner.player
	local name = Mutations.displayName(entry.def, entry.mutation)
	if reason == "bonk" then
		State.notify(owner, "good", ("Bonk! Your %s is coming back home."):format(name))
	elseif reason == "guard" then
		State.notify(owner, "good", ("Your Chowkidar caught the chor! Your %s is safe."):format(name))
	else
		State.notify(owner, "good", ("Your %s escaped from the chor and is walking home!"):format(name))
	end
	if thief.Parent then
		if reason == "guard" then
			State.notify(thief, "bad", "Seeti! The Chowkidar caught you and took it back!")
		else
			State.notify(thief, "bad", ("You dropped %s!"):format(name))
		end
	end
end

function Stealing.complete(thief: Player)
	local carry = carrying[thief]
	local thiefProfile = State.profiles[thief]
	if not carry or not thiefProfile then
		return
	end
	if not Havelis.hasFreePlot(thiefProfile) then
		State.notify(thief, "bad", "No empty plot for it, so it ran back home!")
		Stealing.returnToOwner(thief)
		return
	end
	carrying[thief] = nil
	cleanup(carry)
	unslow(thief)

	local entry = carry.entry
	local ownerProfile = entry.owner
	Models.detach(entry.model)
	Models.setPanic(entry.model, entry.def, false)
	Havelis.remove(ownerProfile, entry)
	Havelis.adopt(thiefProfile, entry.def, entry.mutation, entry.model)

	local name = Mutations.displayName(entry.def, entry.mutation)
	State.notify(thief, "good", ("You got away with %s!"):format(name))
	State.notify(ownerProfile.player, "bad", ("%s got away with your %s."):format(thief.DisplayName, name))
end

local function deny(player: Player, text: string)
	State.notify(player, "bad", text)
end

function Stealing.start(thief: Player, model: Model)
	local thiefProfile = State.profiles[thief]
	local entry = State.entries[model]
	if not thiefProfile or not thiefProfile.haveli or not entry then
		return
	end
	local owner = entry.owner
	if owner == thiefProfile or entry.carrier or not entry.arrived then
		return
	end
	if carrying[thief] then
		return deny(thief, "You are already carrying a brainrot!")
	end
	if thiefProfile.egg then
		return deny(thief, "Take your egg home first!")
	end
	if thiefProfile.driving then
		return deny(thief, "Get out of your vehicle to steal!")
	end

	local now = workspace:GetServerTimeNow()
	if entry.def.questOnly then
		return deny(thief, "Quest brainrots cannot be stolen.")
	end
	if Havelis.isLocker(entry.plot) then
		return deny(thief, "Locker plots cannot be robbed.")
	end
	if now < owner.lockedUntil then
		return deny(thief, "This haveli has a taala on it!")
	end
	if now < owner.protectedUntil then
		return deny(thief, owner.player.DisplayName .. " is new here and is protected for a bit.")
	end
	local remaining = Config.STEAL_COOLDOWN - (now - (lastSteal[thief] or -math.huge))
	if remaining > 0 then
		return deny(thief, ("Catch your breath! You can steal again in %d seconds."):format(math.ceil(remaining)))
	end
	local target = lastTarget[thief]
	if target and target.ownerId == owner.player.UserId and now - target.time < Config.SAME_HAVELI_COOLDOWN then
		return deny(thief, "You just robbed this haveli. Try a different one!")
	end
	if Havelis.entryValue(entry) > Config.STEAL_PRICE_CAP and thiefProfile.data.rebirths < 1 then
		return deny(
			thief,
			("Do a Naya Safar first to steal brainrots worth more than %s."):format(
				Format.rupees(Config.STEAL_PRICE_CAP)
			)
		)
	end
	if not Havelis.hasFreePlot(thiefProfile) then
		return deny(thief, "You have no empty plot to keep it in!")
	end
	if not State.isNear(thief, Mover.pivot(model).Position, Config.PROMPT_DISTANCE + 4) then
		return
	end

	-- Everything else is fine, so now it costs a Chor Pass.
	local usedPass = false
	if Config.stealsCostRobux() then
		if thiefProfile.data.stealTokens < 1 then
			State.notify(thief, "info", "Stealing needs a Chor Pass. Get one, then hold E again!")
			Shop.prompt(thief, "steals", 1)
			return
		end
		thiefProfile.data.stealTokens -= 1
		State.syncTokens(thiefProfile)
		usedPass = true
	end

	local character = thief.Character :: Model
	local humanoid = character:FindFirstChildOfClass("Humanoid") :: Humanoid
	local root = State.rootPart(thief) :: BasePart

	lastSteal[thief] = now
	lastTarget[thief] = { ownerId = owner.player.UserId, time = now }
	entry.carrier = thief
	Havelis.refreshPrompts(owner)
	Mover.stop(model)
	Models.attach(model, root, CARRY_OFFSET)
	Models.setPanic(model, entry.def, true)

	-- heavier (rarer) brainrots slow the thief down more
	local slow = (Config.CARRY_SPEED[entry.def.rarity] or 0.8)
		* (if entry.mutation then Config.CARRY_MUTATION_SPEED else 1)
		* (Themes.perk(owner.data.theme, "thiefSlow") or 1)
	thiefProfile.carrySpeed = slow
	thiefProfile.carryingBrainrot = true
	Havelis.applyWalkSpeed(thiefProfile)

	local marker, tag = markThief(character)
	carrying[thief] = {
		entry = entry,
		marker = marker,
		tag = tag,
		usedPass = usedPass,
		guardSeen = 0,
		connections = {
			humanoid.Died:Connect(function()
				Stealing.returnToOwner(thief)
			end),
			thief.CharacterRemoving:Connect(function()
				Stealing.returnToOwner(thief)
			end),
		},
	}

	local name = Mutations.displayName(entry.def, entry.mutation)
	State.notify(
		owner.player,
		"alert",
		("Chor! Chor! %s stole your %s! Bonk them with your chappal!"):format(thief.DisplayName, name)
	)
	State.sound(owner.player, "ChorAlert")
	State.notify(thief, "info", "Run through your own haveli door to keep it! You are slower while carrying it.")
end

-- Swinging the chappal near a thief makes them drop what they are carrying.
function Stealing.bonk(player: Player)
	local now = os.clock()
	if (lastBonk[player] or 0) > now then
		return
	end
	lastBonk[player] = now + Config.BONK_COOLDOWN
	local root = State.rootPart(player)
	if not root then
		return
	end
	local profile = State.profiles[player]
	local range = Config.BONK_RANGE * (Themes.perk(profile and profile.data.theme, "bonkRange") or 1)
	for thief in carrying do
		local thiefRoot = State.rootPart(thief)
		if thief ~= player and thiefRoot and (thiefRoot.Position - root.Position).Magnitude <= range then
			State.notify(thief, "bad", player.DisplayName .. " bonked you with a chappal!")
			State.sound(thief, "Bonk")
			State.sound(player, "Bonk")
			Stealing.returnToOwner(thief, "bonk")
			return
		end
	end
	-- a bonk also knocks an egg out of someone's hands
	for other, otherProfile in State.profiles do
		local otherRoot = State.rootPart(other)
		if
			other ~= player
			and (otherProfile.egg or #otherProfile.boot > 0)
			and otherRoot
			and (otherRoot.Position - root.Position).Magnitude <= range
		then
			State.sound(other, "Bonk")
			State.sound(player, "Bonk")
			EggSystem.drop(other, "bonk")
			return
		end
	end
end

-- The Chowkidar (haveli Level 6+) catches thieves who stay near him too long.
local guardNaps: { [any]: number } = {}

local function guardStatus(h, text: string)
	local guard = h.guard
	local label = guard and guard:FindFirstChild("Label", true)
	if label and label:IsA("TextLabel") then
		label.Text = text
	end
end

function Stealing.guardTick(dt: number)
	local now = os.clock()
	for h, wakeAt in guardNaps do
		if now >= wakeAt then
			guardNaps[h] = nil
			guardStatus(h, "Jaagte Raho!")
		end
	end
	for thief, carry in carrying do
		local owner = carry.entry.owner
		local h = owner.haveli
		local root = State.rootPart(thief)
		if not h or not h.guard or guardNaps[h] or not root or owner.data.level < Config.GUARD_LEVEL then
			carry.guardSeen = 0
			continue
		end
		if (root.Position - h.guardSpot.Position).Magnitude <= Config.GUARD_RANGE then
			carry.guardSeen += dt
			if carry.guardSeen >= Config.GUARD_SPOT_TIME then
				guardNaps[h] = now + Config.GUARD_COOLDOWN
				guardStatus(h, "Zzz...")
				Stealing.returnToOwner(thief, "guard")
			end
		else
			carry.guardSeen = 0
		end
	end
end

-- Call when a player leaves or rebirths.
function Stealing.releasePlayer(profile)
	local player = profile.player
	if carrying[player] then
		Stealing.returnToOwner(player)
	end
	for thief, carry in carrying do
		if carry.entry.owner == profile then
			carrying[thief] = nil
			cleanup(carry)
			refund(thief, carry)
			unslow(thief)
			carry.entry.carrier = nil
			Models.detach(carry.entry.model)
			State.notify(thief, "bad", ("The %s ran away!"):format(carry.entry.def.name))
		end
	end
end

function Stealing.forget(player: Player)
	lastSteal[player] = nil
	lastTarget[player] = nil
	lastBonk[player] = nil
end

function Stealing.isCarrying(player: Player): boolean
	return carrying[player] ~= nil
end

function Stealing.init(map)
	task.spawn(function()
		while true do
			Stealing.guardTick(task.wait(0.2))
		end
	end)
	for _, h in map.havelis do
		h.door.Touched:Connect(function(hit)
			local player = Players:GetPlayerFromCharacter(hit.Parent)
			if player and carrying[player] and h.owner and h.owner.player == player then
				Stealing.complete(player)
			end
		end)
	end
end

return Stealing
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">Treasure</string>
          <string name="Source"><![CDATA[-- Treasure chests hidden in every zone.
--
-- "dig" chests are buried under an X: you need a Belcha (shovel) to dig them up.
-- "climb" chests sit on a clock tower, a fort gate, a crane or an ice cave:
-- you need a Rassi Seedhi (rope ladder) to climb up from the marked spot.
-- Each player can open each chest once every 10 minutes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Biomes = require(Shared.Biomes)

local State = require(script.Parent.State)
local Havelis = require(script.Parent.Havelis)

local Treasure = {}

local GOLD = Color3.fromRGB(255, 205, 50)

local chests = {} -- { model, biome, kind, opened = { [userId] = time } }

local function now(): number
	return workspace:GetServerTimeNow()
end

local function newPart(model: Instance, name: string, size: Vector3, cf: CFrame, color: Color3): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

local function prompt(parent: BasePart, name: string, action: string, object: string)
	local p = Instance.new("ProximityPrompt")
	p.Name = name
	p.ActionText = action
	p.ObjectText = object
	p.HoldDuration = 0.6
	p.MaxActivationDistance = 12
	p.RequiresLineOfSight = false
	p.Parent = parent
	return p
end

local function build(folder: Instance, biome, spot, index: number)
	local model = Instance.new("Model")
	model.Name = ("%sTreasure%d"):format(biome.id, index)
	local cf = CFrame.new(spot.position)
	if spot.kind == "dig" then
		local mound = newPart(
			model,
			"Mound",
			Vector3.new(6, 1, 6),
			cf * CFrame.new(0, 0.3, 0),
			biome.color:Lerp(Color3.new(0, 0, 0), 0.3)
		)
		mound.Material = Enum.Material.Ground
		for _, angle in { 45, -45 } do
			newPart(
				model,
				"X",
				Vector3.new(0.6, 0.2, 4.5),
				cf * CFrame.new(0, 0.85, 0) * CFrame.Angles(0, math.rad(angle), 0),
				Color3.fromRGB(200, 40, 40)
			)
		end
		model.PrimaryPart = mound
		prompt(mound, "TreasurePrompt", "Dig", "Buried Treasure (needs Belcha)")
	else
		local box =
			newPart(model, "Chest", Vector3.new(3.6, 2.4, 2.4), cf * CFrame.new(0, 1.2, 0), Color3.fromRGB(140, 85, 40))
		box.Material = Enum.Material.WoodPlanks
		newPart(model, "Lid", Vector3.new(3.8, 0.8, 2.6), cf * CFrame.new(0, 2.6, 0), Color3.fromRGB(120, 70, 35))
		local trim = newPart(model, "Trim", Vector3.new(3.9, 0.4, 2.7), cf * CFrame.new(0, 2.1, 0), GOLD)
		trim.Material = Enum.Material.Metal
		local glow = Instance.new("PointLight")
		glow.Color = GOLD
		glow.Range = 10
		glow.Parent = trim
		model.PrimaryPart = box
		prompt(box, "TreasurePrompt", "Open", "Treasure Chest")
		-- the place to climb up from
		local base = newPart(
			model,
			"ClimbSpot",
			Vector3.new(5, 0.4, 5),
			CFrame.new(spot.base + Vector3.new(0, 0.3, 0)),
			Color3.fromRGB(255, 220, 120)
		)
		base.Material = Enum.Material.Neon
		base.Transparency = 0.4
		base.CanCollide = false
		prompt(base, "ClimbPrompt", "Climb", "Rope up (needs Rassi Seedhi)")
	end
	model:SetAttribute("Biome", biome.id)
	model:SetAttribute("Kind", spot.kind)
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	model.Parent = folder
	table.insert(
		chests,
		{ model = model, biome = biome, kind = spot.kind, top = spot.position, stand = spot.stand, opened = {} }
	)
end

local function find(model: Model?)
	for _, chest in chests do
		if chest.model == model then
			return chest
		end
	end
	return nil
end

function Treasure.climb(player: Player, model: Model?)
	local profile = State.profiles[player]
	local chest = find(model)
	if not profile or not chest then
		return
	end
	if not profile.data.gear.RopeLadder then
		State.notify(player, "bad", "You need a Rassi Seedhi (rope ladder) from the Gear shop to climb up!")
		State.sound(player, "Error")
		return
	end
	local character = player.Character
	if character then
		-- land next to the chest (on the gallery, the lid, the tower top...)
		character:PivotTo(
			CFrame.new(if chest.stand then chest.stand + Vector3.new(0, 3, 0) else chest.top + Vector3.new(3, 4, 0))
		)
	end
end

function Treasure.open(player: Player, model: Model?)
	local profile = State.profiles[player]
	local chest = find(model)
	if not profile or not chest or not chest.model.PrimaryPart then
		return
	end
	if not State.isNear(player, chest.model.PrimaryPart.Position, 16) then
		return
	end
	if not State.isZoneOpen(profile, chest.biome) then
		State.notify(player, "bad", ("Unlock %s to open its treasure!"):format(chest.biome.name))
		return
	end
	if chest.kind == "dig" and not profile.data.gear.Shovel then
		State.notify(player, "bad", "You need a Belcha (shovel) from the Gear shop to dig this up!")
		State.sound(player, "Error")
		return
	end
	local userId = player.UserId
	local remaining = Config.TREASURE_COOLDOWN - (now() - (chest.opened[userId] or -math.huge))
	if remaining > 0 then
		State.notify(
			player,
			"info",
			("This chest is empty. It refills in %d minutes."):format(math.ceil(remaining / 60))
		)
		return
	end
	chest.opened[userId] = now()
	local tier = chest.biome.tier
	local rupees = math.floor(Config.TREASURE_RUPEES * tier * tier * (1 + Config.REBIRTH_BONUS * profile.data.rebirths))
	State.addRupees(profile, rupees)
	local roll = math.random() < Config.TREASURE_ROLL_CHANCE
	if roll then
		profile.data.rollTokens += 1
		State.syncTokens(profile)
	end
	State.sound(player, "Treasure", chest.model.PrimaryPart.Position)
	State.notify(
		player,
		"rare",
		("Treasure! %s%s"):format(Format.rupees(rupees), if roll then " and a free Kismat Roll" else "")
	)
	State.track(profile, "treasure")
	Havelis.updateGalla(profile)
end

function Treasure.init(map)
	local folder = Instance.new("Folder")
	folder.Name = "ChaiChaosTreasure"
	folder.Parent = workspace
	for _, biome in Biomes.list do
		for index, spot in map.biomes[biome.id].chests do
			build(folder, biome, spot, index)
		end
	end
end

function Treasure.all()
	return chests
end

return Treasure
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">Upgrades</string>
          <string name="Source"><![CDATA[-- The Chowk's shops: Gear, the Tracker (radar) and the Sell stall.
-- You have to stand at the shop to use it.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Gear = require(Shared.Gear)
local Mutations = require(Shared.Mutations)
local Remotes = require(Shared.Remotes)

local State = require(script.Parent.State)
local Havelis = require(script.Parent.Havelis)

local Upgrades = {}

local map = nil

-- Is the player standing at this Chowk shop?
function Upgrades.atShop(player: Player, shop: string, distance: number?): boolean
	local part = map and map.shops[shop]
	return part ~= nil and State.isNear(player, part.Position, distance or 24)
end

function Upgrades.buyGear(player: Player, id: any)
	local profile = State.profiles[player]
	local item = type(id) == "string" and Gear.byId[id]
	if not profile or not item or not Upgrades.atShop(player, "Gear") then
		return
	end
	local data = profile.data
	if data.gear[item.id] then
		return
	end
	if data.rupees < item.cost then
		State.notify(player, "bad", ("%s costs %s."):format(item.name, Format.rupees(item.cost)))
		State.sound(player, "Error")
		return
	end
	State.addRupees(profile, -item.cost)
	data.gear[item.id] = true
	State.syncGear(profile)
	Havelis.applyWalkSpeed(profile)
	State.sound(player, "Purchase")
	State.notify(player, "good", ("You got the %s! %s."):format(item.name, item.text))
end

function Upgrades.upgradeTracker(player: Player)
	local profile = State.profiles[player]
	if not profile or not Upgrades.atShop(player, "Tracker") then
		return
	end
	local data = profile.data
	local nextLevel = Config.TRACKER_LEVELS[data.trackerLevel + 1]
	if not nextLevel then
		State.notify(player, "info", "Your tracker is the best there is!")
		return
	end
	if data.rupees < nextLevel.cost then
		State.notify(player, "bad", ("The next tracker costs %s."):format(Format.rupees(nextLevel.cost)))
		State.sound(player, "Error")
		return
	end
	State.addRupees(profile, -nextLevel.cost)
	data.trackerLevel += 1
	State.syncGear(profile)
	State.sound(player, "Upgrade")
	State.notify(
		player,
		"rare",
		("Tracker level %d! It now finds eggs in %d biomes, %d studs away."):format(
			data.trackerLevel,
			data.trackerLevel,
			nextLevel.range
		)
	)
	State.track(profile, "upgrade")
end

function Upgrades.sell(player: Player, uid: any)
	local profile = State.profiles[player]
	if not profile or type(uid) ~= "number" then
		return
	end
	if not Upgrades.atShop(player, "Sell", Config.SELL_DISTANCE) then
		State.notify(player, "bad", "Selling happens at the BECHO stall in the Chowk.")
		return
	end
	local entry = nil
	for _, e in profile.owned do
		if e.uid == uid then
			entry = e
		end
	end
	if not entry or entry.carrier or entry.def.questOnly then
		return
	end
	local amount = math.floor(Havelis.entryValue(entry) * Config.SELL_RATE)
	Havelis.remove(profile, entry)
	entry.model:Destroy()
	State.addRupees(profile, amount)
	State.sound(player, "Coin")
	State.notify(
		player,
		"good",
		("Sold %s for %s"):format(Mutations.displayName(entry.def, entry.mutation), Format.rupees(amount))
	)
	State.track(profile, "sell")
end

function Upgrades.init(gameMap)
	map = gameMap
	Remotes.BuyGear.OnServerEvent:Connect(Upgrades.buyGear)
	Remotes.UpgradeTracker.OnServerEvent:Connect(Upgrades.upgradeTracker)
	Remotes.SellBrainrot.OnServerEvent:Connect(Upgrades.sell)
end

return Upgrades
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[-- Bright, warm, kid-friendly lighting and the day and night cycle.
-- Nights go by twice as fast. Events can force night (Load Shedding).

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Config = require(Shared.Config)

local World = {}

World.forceNight = false

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local function effect(className: string, name: string): any
	local existing = Lighting:FindFirstChild(name)
	if existing then
		return existing
	end
	local created = Instance.new(className)
	created.Name = name
	created.Parent = Lighting
	return created
end

function World.isNight(): boolean
	local t = Lighting.ClockTime
	return t >= 18.5 or t < 5.5
end

function World.init()
	Lighting.ClockTime = 13
	Lighting.Brightness = 3
	Lighting.Ambient = rgb(135, 125, 115)
	Lighting.OutdoorAmbient = rgb(180, 170, 160)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.4
	Lighting.ExposureCompensation = 0.15
	Lighting.GlobalShadows = true

	local color = effect("ColorCorrectionEffect", "ChaiChaosColor")
	color.Saturation = 0.22
	color.Contrast = 0.06
	color.Brightness = 0.02
	color.TintColor = rgb(255, 249, 238)
	local bloom = effect("BloomEffect", "ChaiChaosBloom")
	bloom.Intensity = 0.35
	bloom.Size = 24
	bloom.Threshold = 1.7
	local atmosphere = effect("Atmosphere", "ChaiChaosAir")
	atmosphere.Density = 0.22
	atmosphere.Offset = 0.1
	atmosphere.Color = rgb(255, 232, 205)
	atmosphere.Decay = rgb(255, 205, 160)
	atmosphere.Glare = 0
	atmosphere.Haze = 0.6

	task.spawn(function()
		local savedTime: number? = nil
		while true do
			local dt = task.wait(0.25)
			if World.forceNight then
				savedTime = savedTime or Lighting.ClockTime
				Lighting.ClockTime = 0
			else
				if savedTime then
					Lighting.ClockTime = savedTime
					savedTime = nil
				end
				local speed = if World.isNight() then 2 else 1
				Lighting.ClockTime = (Lighting.ClockTime + dt * speed * 24 / Config.DAY_LENGTH) % 24
			end
		end
	end)
end

return World
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">Zones</string>
          <string name="Source"><![CDATA[-- Zone gates. Ring 1 and ring 2 zones are unlocked with rupees at their gate
-- (Mango Bagh is free); ring 3 zones open once you have enough rebirths.
-- You must unlock the zone in front of a gate before the one behind it.
-- Unlocks are kept forever, even after a Naya Safar.
--
-- The gate barriers and shortcut doors are solid on the server. Each player's
-- screen lets them through the ones they have unlocked (Gates.client.luau),
-- and the server only lets you collect eggs and treasure in your open zones.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Biomes = require(Shared.Biomes)
local Format = require(Shared.Format)

local State = require(script.Parent.State)
local Havelis = require(script.Parent.Havelis)

local Zones = {}

local GATE_REACH = 22

function Zones.unlock(player: Player, barrier: Instance?)
	local profile = State.profiles[player]
	local biome = barrier and Biomes.byId[barrier:GetAttribute("Zone") or ""]
	if not profile or not biome or not barrier:IsA("BasePart") then
		return
	end
	if not State.isNear(player, barrier.Position, GATE_REACH) then
		return
	end
	local data = profile.data
	if State.isZoneOpen(profile, biome) then
		State.notify(player, "info", ("%s is already open for you. Walk right through!"):format(biome.name))
		return
	end
	if biome.rebirths > 0 then
		State.notify(
			player,
			"bad",
			("%s opens after %s. You have %d. Start a Naya Safar at the Chowk!"):format(
				biome.name,
				Biomes.costText(biome),
				data.rebirths
			)
		)
		State.sound(player, "Error")
		return
	end
	local before = Biomes.before(biome)
	if before and not State.isZoneOpen(profile, before) then
		State.notify(player, "bad", ("Unlock %s first!"):format(before.name))
		return
	end
	if data.rupees < biome.price then
		State.notify(player, "bad", ("%s costs %s to unlock."):format(biome.name, Format.rupees(biome.price)))
		State.sound(player, "Error")
		return
	end
	State.addRupees(profile, -biome.price)
	data.zones[biome.id] = true
	State.syncZones(profile)
	State.sound(player, "Purchase")
	State.track(profile, "zone")
	State.notify(player, "rare", ("%s unlocked! %s"):format(biome.name, biome.blurb))
end

-- The rickshaw at the end of every ring 3 road takes you back to the Chowk.
function Zones.rideHome(player: Player, pad: Instance?)
	local profile = State.profiles[player]
	if not profile or not pad or not pad:IsA("BasePart") then
		return
	end
	if not State.isNear(player, pad.Position, 18) then
		return
	end
	if profile.carryingBrainrot then
		State.notify(player, "bad", "The rickshaw wala won't take a stolen brainrot!")
		return
	end
	local character = player.Character
	if character then
		character:PivotTo(CFrame.new(Vector3.new(24, Biomes.GROUND_Y + 4, 0)))
		State.sound(player, "Purchase")
		State.notify(player, "good", "Pon pon! The rickshaw dropped you at the Chowk.")
	end
end

-- After a Naya Safar (ring 3 zones open with rebirths).
function Zones.refresh(profile)
	State.syncZones(profile)
	Havelis.applyWalkSpeed(profile)
end

return Zones
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="43">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="44">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="45">
        <Properties>
          <string name="Name">ChaiChaosClient</string>
        </Properties>
        <Item class="LocalScript" referent="46">
          <Properties>
            <string name="Name">Driving</string>
            <string name="Source"><![CDATA[-- Driving on this player's screen.
--
-- * Steering: push the stick (or WASD) the way you want to go and the vehicle
--   turns towards it like a car, instead of spinning on the spot. On ice it
--   slides and on sand it turns slowly, unless its tyres (Grip) are good enough.
-- * You sit in the seat (the default sit animation).
-- * A fuel gauge, the eggs in your boot and a Park button while you drive.
-- * Rangeela (rainbow) paint jobs change colour on everyone's screen.
-- The server sets the speed, uses the fuel and decides everything else.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Remotes = require(Shared:WaitForChild("Remotes"))
local Vehicles = require(Shared:WaitForChild("Vehicles"))
local Ui = require(script.Parent:WaitForChild("Ui"))

local rgb, create, label = Ui.rgb, Ui.create, Ui.label
local player = Players.LocalPlayer
local gui = player:WaitForChild("PlayerGui"):WaitForChild("ChaiChaosHud")

local BIND = "ChaiChaosDrive"
local ICE = { [Enum.Material.Ice] = true, [Enum.Material.Glacier] = true }
local SAND = { [Enum.Material.Sand] = true }

---------------------------------------------------------------------------
-- The dashboard: fuel, boot and the Park button
---------------------------------------------------------------------------
local dash = create("Frame", {
	Name = "Dashboard",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -12),
	Size = UDim2.fromOffset(330, 74),
	BackgroundColor3 = rgb(40, 30, 25),
	BackgroundTransparency = 0.15,
	Visible = false,
	Parent = gui,
}, { Ui.corner(14) })
local vehicleName = label({
	Name = "Vehicle",
	Position = UDim2.fromOffset(10, 4),
	Size = UDim2.new(1, -110, 0, 24),
	TextXAlignment = Enum.TextXAlignment.Left,
	Parent = dash,
})
local fuelBar = create("Frame", {
	Name = "FuelBar",
	Position = UDim2.fromOffset(10, 32),
	Size = UDim2.new(1, -110, 0, 16),
	BackgroundColor3 = rgb(80, 70, 60),
	Parent = dash,
}, { Ui.corner(8) })
local fuelFill = create("Frame", {
	Name = "Fill",
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = rgb(70, 200, 90),
	Parent = fuelBar,
}, { Ui.corner(8) })
local fuelText = label({
	Name = "FuelText",
	Position = UDim2.fromOffset(10, 50),
	Size = UDim2.new(1, -110, 0, 20),
	TextColor3 = rgb(255, 230, 170),
	TextXAlignment = Enum.TextXAlignment.Left,
	Parent = dash,
})
local parkButton = Ui.textButton({
	Name = "Park",
	AnchorPoint = Vector2.new(1, 0.5),
	Position = UDim2.new(1, -8, 0.5, 0),
	Size = UDim2.fromOffset(90, 56),
	BackgroundColor3 = rgb(190, 70, 50),
	Text = "Park",
	Parent = dash,
})
parkButton.Activated:Connect(function()
	Remotes.Drive:FireServer(nil)
end)

local function refreshDash()
	local id = player:GetAttribute("Driving") or ""
	local def = Vehicles.byId[id]
	dash.Visible = def ~= nil
	if not def then
		return
	end
	local fuel = player:GetAttribute("Fuel") or 0
	local tank = math.max(1, player:GetAttribute("FuelMax") or 1)
	local share = math.clamp(fuel / tank, 0, 1)
	fuelFill.Size = UDim2.fromScale(share, 1)
	fuelFill.BackgroundColor3 = if share > 0.4
		then rgb(70, 200, 90)
		elseif share > 0.15 then rgb(240, 190, 40)
		else rgb(220, 60, 50)
	vehicleName.Text = def.name
	local boot = player:GetAttribute("BootEggs") or 0
	local space = player:GetAttribute("BootSpace") or def.eggs
	fuelText.Text = if fuel <= 0
		then "Out of petrol! Find a pump"
		else ("Petrol %d studs  ·  Boot %d/%d eggs"):format(fuel, boot, space)
end
for _, name in { "Driving", "Fuel", "FuelMax", "BootEggs", "BootSpace" } do
	player:GetAttributeChangedSignal(name):Connect(refreshDash)
end
refreshDash()

---------------------------------------------------------------------------
-- Steering and sitting
---------------------------------------------------------------------------
local sitTrack: AnimationTrack? = nil
local heading = Vector3.new(0, 0, -1)
local moveDir = heading
local throttle = 0

local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return if f.Magnitude > 1e-4 then f.Unit else Vector3.zero
end

local function stopDriving(humanoid: Humanoid?)
	RunService:UnbindFromRenderStep(BIND)
	if sitTrack then
		sitTrack:Stop()
		sitTrack = nil
	end
	if humanoid then
		humanoid.AutoRotate = true
	end
end

local function startDriving(character: Model, humanoid: Humanoid, root: BasePart)
	stopDriving(nil)
	humanoid.AutoRotate = false
	heading = flat(root.CFrame.LookVector)
	if heading.Magnitude == 0 then
		heading = Vector3.new(0, 0, -1)
	end
	moveDir = heading
	throttle = 0
	-- sit in the seat with the character's own sit animation
	local animate = character:FindFirstChild("Animate")
	local sit = animate and animate:FindFirstChild("sit")
	local anim = sit and sit:FindFirstChildWhichIsA("Animation")
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if anim and animator then
		local ok, track = pcall(function()
			return animator:LoadAnimation(anim)
		end)
		if ok and track then
			track.Priority = Enum.AnimationPriority.Action
			track.Looped = true
			track:Play(0.2)
			sitTrack = track
		end
	end
	-- runs right after the controls have read the stick, so we can steer
	RunService:BindToRenderStep(BIND, Enum.RenderPriority.Input.Value + 1, function(dt: number)
		if not root.Parent or humanoid.Health <= 0 then
			return
		end
		local grip = player:GetAttribute("Grip") or 0
		local floor = humanoid.FloorMaterial
		local icy = ICE[floor] == true and grip < 3
		local sandy = SAND[floor] == true and grip < 2
		local raw = humanoid.MoveDirection or Vector3.zero
		local input = flat(raw)
		local strength = math.min(1, raw.Magnitude)
		local target = 0
		if strength > 0.05 then
			local turnRate = math.rad(if icy then 80 elseif sandy then 110 else 170)
			local angle = math.atan2(heading:Cross(input).Y, heading:Dot(input))
			local step = math.clamp(angle, -turnRate * dt, turnRate * dt)
			heading = (CFrame.Angles(0, step, 0) * heading).Unit
			-- slow down while turning hard, like a real car
			target = strength * math.clamp((heading:Dot(input) + 0.4) / 1.4, 0.3, 1)
		end
		throttle += (target - throttle) * math.min(1, (if icy then 0.8 else 6) * dt)
		-- on ice the vehicle keeps sliding the way it was going
		moveDir = (moveDir:Lerp(heading, math.min(1, (if icy then 1.2 else 14) * dt))).Unit
		humanoid:Move(moveDir * throttle, false)
		root.CFrame = CFrame.lookAt(root.Position, root.Position + heading)
	end)
end

local function refreshDriving()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local driving = (player:GetAttribute("Driving") or "") ~= ""
	if driving and character and humanoid and root and root:IsA("BasePart") then
		startDriving(character, humanoid, root)
	else
		stopDriving(humanoid)
	end
end
player:GetAttributeChangedSignal("Driving"):Connect(refreshDriving)
player.CharacterAdded:Connect(function()
	stopDriving(nil)
	task.wait(0.2)
	refreshDriving()
end)

---------------------------------------------------------------------------
-- Rangeela paint: every colour of the rainbow
---------------------------------------------------------------------------
local painted: { [Model]: { BasePart } } = {}
local function track(model: Instance)
	if model:IsA("Model") then
		local list = {}
		for _, p in model:GetDescendants() do
			if p:IsA("BasePart") and p.Name == "Paint" then
				table.insert(list, p)
			end
		end
		painted[model] = list
	end
end
CollectionService:GetInstanceAddedSignal("ChaiVehicle"):Connect(track)
CollectionService:GetInstanceRemovedSignal("ChaiVehicle"):Connect(function(model)
	painted[model :: Model] = nil
end)
for _, model in CollectionService:GetTagged("ChaiVehicle") do
	track(model)
end

local frame = 0
RunService.RenderStepped:Connect(function()
	frame += 1
	if frame % 2 ~= 0 then
		return
	end
	local t = os.clock()
	for model, parts in painted do
		if model.Parent == nil then
			painted[model] = nil
		else
			for i, p in parts do
				if p:GetAttribute("Tint") then
					p.Color = Color3.fromHSV((t * 0.3 + i * 0.08) % 1, 0.7, 1)
				end
			end
		end
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="47">
          <Properties>
            <string name="Name">Events</string>
            <string name="Source"><![CDATA[-- The event banner (with the event's boosts) and each event's look: Basant
-- kites, rain, cricket confetti, the Load Shedding blackout, Mela fireworks
-- and Sardi snow. The sky effects follow your camera, so you see them
-- wherever you are in the world. Everything here is only on this player's screen.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Events = require(Shared:WaitForChild("Events"))
local Ui = require(script.Parent:WaitForChild("Ui"))

local rgb = Ui.rgb
local player = Players.LocalPlayer
local gui = player:WaitForChild("PlayerGui"):WaitForChild("ChaiChaosHud")

---------------------------------------------------------------------------
-- Banner
---------------------------------------------------------------------------
local banner = Ui.create("Frame", {
	Name = "EventBanner",
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -10, 0, 8),
	Size = UDim2.fromOffset(250, 80),
	BackgroundColor3 = rgb(45, 30, 22),
	BackgroundTransparency = 0.15,
	Parent = gui,
}, {
	Ui.corner(12),
	Ui.create(
		"UIStroke",
		{ Name = "Edge", Thickness = 2, Color = Ui.GOLD, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }
	),
})
local title =
	Ui.label({ Name = "Title", Size = UDim2.new(1, -12, 0, 28), Position = UDim2.fromOffset(6, 3), Parent = banner })
local timer = Ui.label({
	Name = "Timer",
	Size = UDim2.new(1, -12, 0, 20),
	Position = UDim2.fromOffset(6, 33),
	TextColor3 = rgb(255, 230, 150),
	Parent = banner,
})

local perks = Ui.label({
	Name = "Perks",
	Size = UDim2.new(1, -12, 0, 20),
	Position = UDim2.fromOffset(6, 55),
	TextColor3 = rgb(160, 255, 170),
	Parent = banner,
})

-- "Cash x2 · Luck x2" for the running event
local PERKS = {
	{ "cashMult", "Cash x%s" },
	{ "luckMult", "Luck x%s" },
	{ "eggMult", "Eggs x%s" },
	{ "hatchMult", "Hatching x%s" },
	{ "eggTimeMult", "Egg time x%s" },
}
local function perkText(event): string
	local parts = {}
	for _, perk in PERKS do
		local value = event[perk[1]]
		if value and value ~= 1 then
			table.insert(parts, perk[2]:format(tostring(value)))
		end
	end
	if event.rollDiscount then
		table.insert(parts, ("Kismat -%d%%"):format(math.floor(event.rollDiscount * 100 + 0.5)))
	end
	return table.concat(parts, " · ")
end

local function formatTime(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	return ("%d:%02d"):format(seconds // 60, seconds % 60)
end

---------------------------------------------------------------------------
-- Effects
---------------------------------------------------------------------------
local effects = Instance.new("Folder")
effects.Name = "ChaiChaosEventEffects"
local cleanup: { () -> () } = {}
-- parts that move with the camera: { part, offset } (offset from the camera, in studs)
local followers: { { part: BasePart, offset: Vector3 } } = {}

local function weather(color: Color3, rate: number, speed: number, size: number, streak: boolean)
	local cloud = Instance.new("Part")
	cloud.Name = "Weather"
	cloud.Anchored = true
	cloud.CanCollide = false
	cloud.CanQuery = false
	cloud.CanTouch = false
	cloud.Transparency = 1
	cloud.Size = Vector3.new(160, 1, 160)
	cloud.Parent = effects
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color)
	emitter.Rate = rate
	emitter.Lifetime = NumberRange.new(2, 3)
	emitter.Speed = NumberRange.new(speed, speed * 1.2)
	emitter.EmissionDirection = Enum.NormalId.Bottom
	emitter.Size = NumberSequence.new(size)
	emitter.Transparency = NumberSequence.new(0.2)
	if streak then
		emitter.Orientation = Enum.ParticleOrientation.FacingCameraWorldUp
		emitter.Squash = NumberSequence.new(2.5)
	end
	emitter.Parent = cloud
	table.insert(followers, { part = cloud, offset = Vector3.new(0, 40, 0) })
end

local function kites()
	local colors = { rgb(255, 60, 90), rgb(255, 205, 40), rgb(70, 200, 110), rgb(70, 160, 255), rgb(255, 120, 220) }
	local list = {}
	-- a ring of patang all around you, bobbing and drifting in the wind
	for i = 1, 24 do
		local color = colors[(i - 1) % #colors + 1]
		local kite = Instance.new("Part")
		kite.Name = "Kite"
		kite.Anchored = true
		kite.CanCollide = false
		kite.CanQuery = false
		kite.CanTouch = false
		kite.CastShadow = false
		kite.Size = Vector3.new(5, 5, 0.2)
		kite.Color = color
		kite.Material = Enum.Material.SmoothPlastic
		kite.Parent = effects
		local tail = Instance.new("Part")
		tail.Name = "KiteTail"
		tail.Anchored = true
		tail.CanCollide = false
		tail.CanQuery = false
		tail.CanTouch = false
		tail.CastShadow = false
		tail.Size = Vector3.new(0.4, 4, 0.1)
		tail.Color = colors[i % #colors + 1]
		tail.Parent = effects
		table.insert(list, {
			part = kite,
			tail = tail,
			angle = math.rad(i * 15),
			distance = 50 + (i % 4) * 22,
			height = 45 + (i % 5) * 7,
			phase = i,
		})
	end
	local connection = RunService.RenderStepped:Connect(function()
		local t = os.clock()
		local camera = workspace.CurrentCamera
		local here = if camera then camera.CFrame.Position else Vector3.zero
		for _, k in list do
			local a = k.angle + t * 0.03
			local pos = Vector3.new(
				here.X + math.cos(a) * k.distance + math.sin(t * 0.4 + k.phase) * 6,
				here.Y + k.height + math.sin(t + k.phase) * 4,
				here.Z + math.sin(a) * k.distance
			)
			local facing = CFrame.lookAt(pos, Vector3.new(here.X, pos.Y, here.Z))
			local sway = math.sin(t * 2 + k.phase) * 0.3
			k.part.CFrame = facing * CFrame.Angles(0, 0, math.rad(45) + sway * 0.3)
			k.tail.CFrame = facing * CFrame.new(0, -5.2, 0) * CFrame.Angles(0, 0, sway)
		end
	end)
	table.insert(cleanup, function()
		connection:Disconnect()
	end)
end

local function bursts(colors: { Color3 }, height: number, every: number)
	local emitters = {}
	for i = 1, 6 do
		local spot = Instance.new("Part")
		spot.Name = "Burst"
		spot.Anchored = true
		spot.CanCollide = false
		spot.CanQuery = false
		spot.CanTouch = false
		spot.Transparency = 1
		spot.Size = Vector3.one
		spot.Parent = effects
		table.insert(
			followers,
			{ part = spot, offset = Vector3.new(-210 + i * 60, height, if i % 2 == 0 then 30 else -30) }
		)
		local emitter = Instance.new("ParticleEmitter")
		emitter.Rate = 0
		emitter.Lifetime = NumberRange.new(1, 1.6)
		emitter.Speed = NumberRange.new(18, 26)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Acceleration = Vector3.new(0, -12, 0)
		emitter.LightEmission = 1
		emitter.Size = NumberSequence.new(0.8, 0)
		emitter.Color = ColorSequence.new(colors[(i - 1) % #colors + 1])
		emitter.Parent = spot
		table.insert(emitters, emitter)
	end
	local running = true
	task.spawn(function()
		while running do
			local emitter = emitters[math.random(#emitters)]
			emitter:Emit(60)
			task.wait(every)
		end
	end)
	table.insert(cleanup, function()
		running = false
	end)
end

local function tint(color: Color3, brightness: number, saturation: number)
	local correction = Instance.new("ColorCorrectionEffect")
	correction.Name = "ChaiChaosEventTint"
	correction.TintColor = color
	correction.Brightness = brightness
	correction.Saturation = saturation
	correction.Parent = Lighting
	table.insert(cleanup, function()
		correction:Destroy()
	end)
end

local LOOKS = {
	rain = function()
		weather(rgb(170, 200, 255), 400, 60, 0.15, true)
		tint(rgb(215, 225, 255), -0.03, -0.1)
	end,
	snow = function()
		weather(rgb(255, 255, 255), 250, 8, 0.35, false)
		tint(rgb(230, 240, 255), 0.03, -0.15)
	end,
	kites = function()
		kites()
		tint(rgb(255, 245, 215), 0.02, 0.1)
	end,
	cricket = function()
		bursts({ rgb(40, 200, 90), rgb(255, 255, 255), rgb(30, 120, 220) }, 30, 0.8)
	end,
	blackout = function()
		tint(rgb(170, 160, 255), -0.08, -0.2)
	end,
	mela = function()
		bursts({ rgb(255, 80, 120), rgb(255, 210, 60), rgb(120, 220, 255), rgb(200, 120, 255) }, 45, 0.5)
		tint(rgb(255, 235, 245), 0.02, 0.15)
	end,
}

local function stopEffects()
	for _, fn in cleanup do
		fn()
	end
	table.clear(cleanup)
	table.clear(followers)
	effects:ClearAllChildren()
end

local shownEvent: string? = nil
local function updateEffects()
	local event = Events.current()
	local id = event and event.id
	if id == shownEvent then
		return
	end
	shownEvent = id
	stopEffects()
	if event then
		effects.Parent = workspace.CurrentCamera
		local look = LOOKS[event.look]
		if look then
			look()
		end
	end
end

workspace:GetAttributeChangedSignal("EventId"):Connect(updateEffects)
updateEffects()

RunService.RenderStepped:Connect(function()
	local camera = workspace.CurrentCamera
	if camera and #followers > 0 then
		local position = camera.CFrame.Position
		for _, follower in followers do
			follower.part.CFrame = CFrame.new(position + follower.offset)
		end
	end
end)

task.spawn(function()
	while gui.Parent do
		local now = workspace:GetServerTimeNow()
		local event = Events.current()
		local edge = banner:FindFirstChild("Edge") :: UIStroke
		if event then
			title.Text = event.name
			title.TextColor3 = event.color
			timer.Text = formatTime((workspace:GetAttribute("EventEndsAt") or now) - now) .. " left"
			perks.Text = perkText(event)
			edge.Color = event.color
		else
			title.Text = "Next event"
			title.TextColor3 = Ui.WHITE
			timer.Text = "in " .. formatTime((workspace:GetAttribute("NextEventAt") or now) - now)
			perks.Text = ""
			edge.Color = Ui.GOLD
		end
		task.wait(0.5)
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="48">
          <Properties>
            <string name="Name">Garage</string>
            <string name="Source"><![CDATA[-- Vehicle windows:
--   Gaari button      : your vehicles. Drive one, park, and pick a paint job.
--   Gaari Showroom    : buy vehicles (at the Rickshaw Stand in the bazaar).
--   Ustad's Workshop  : upgrade Engine, Fuel Tank, Egg Space and Tyres
--                       (in the Chai Dhaba Bazaar), and buy Robux paint jobs.
-- The server checks you are at the right place before anything happens.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Vehicles = require(Shared:WaitForChild("Vehicles"))
local Ui = require(script.Parent:WaitForChild("Ui"))

local rgb, create, label = Ui.rgb, Ui.create, Ui.label
local player = Players.LocalPlayer
local gui = player:WaitForChild("PlayerGui"):WaitForChild("ChaiChaosHud")
local buttons = gui:WaitForChild("Buttons")
local rupeesValue = player:WaitForChild("leaderstats"):WaitForChild("Rupees") :: IntValue

local ROW = rgb(60, 45, 35)
local GREEN = rgb(30, 140, 80)
local GREY = rgb(110, 105, 100)
local BLUE = rgb(50, 120, 200)
local RED = rgb(190, 70, 50)
local ROBUX = rgb(40, 170, 90)

-- "Motorbike:2:1:0:0:1450,...": owned vehicles with their upgrade levels and fuel
local function owned(): { [string]: { speed: number, tank: number, eggs: number, grip: number, fuel: number } }
	local list = {}
	for item in string.gmatch(player:GetAttribute("Vehicles") or "", "[^,]+") do
		local id, speed, tank, eggs, grip, fuel = item:match("^(%w+):(%d+):(%d+):(%d+):(%d+):(%d+)$")
		if id and Vehicles.byId[id] then
			list[id] = {
				speed = tonumber(speed) :: number,
				tank = tonumber(tank) :: number,
				eggs = tonumber(eggs) :: number,
				grip = tonumber(grip) :: number,
				fuel = tonumber(fuel) :: number,
			}
		end
	end
	return list
end

local function row(parent: Instance, name: string, order: number, height: number?)
	local frame = create("Frame", {
		Name = name,
		Size = UDim2.new(1, -8, 0, height or 70),
		BackgroundColor3 = ROW,
		LayoutOrder = order,
		Parent = parent,
	}, { Ui.corner(10) })
	local title = label({
		Name = "Title",
		Position = UDim2.fromOffset(10, 4),
		Size = UDim2.new(1, -150, 0, 28),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})
	local text = label({
		Name = "Text",
		Position = UDim2.fromOffset(10, 32),
		Size = UDim2.new(1, -150, 0, (height or 70) - 38),
		TextColor3 = rgb(255, 230, 170),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		Parent = frame,
	})
	local button = Ui.textButton({
		Name = "Button",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(130, 42),
		BackgroundColor3 = GREEN,
		Parent = frame,
	})
	return frame, title, text, button
end

local function info(parent: Instance, name: string, order: number, height: number, color: Color3?): TextLabel
	return label({
		Name = name,
		Size = UDim2.new(1, -8, 0, height),
		TextColor3 = color or rgb(90, 55, 30),
		TextWrapped = true,
		LayoutOrder = order,
		Parent = parent,
	})
end

local function stats(def, levels): string
	return ("Speed %d  ·  Range %d  ·  Boot %d eggs  ·  Tyres %d"):format(
		math.floor(Vehicles.speed(def, levels)),
		Vehicles.tank(def, levels),
		Vehicles.eggs(def, levels),
		Vehicles.grip(def, levels)
	)
end

local function clear(content: Instance)
	for _, child in content:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

---------------------------------------------------------------------------
-- Gaari: your vehicles
---------------------------------------------------------------------------
local garageButton = Ui.sideButton(buttons, "Gaari", "Gaari", rgb(60, 150, 70), 5)
local garagePanel, garageContent = Ui.panel(gui, "GaragePanel", "Meri Gaari", Vector2.new(500, 600))

local function paintRows(parent: Instance, start: number, atWorkshop: boolean)
	local have = {}
	for id in string.gmatch(player:GetAttribute("Paints") or "", "[^,]+") do
		have[id] = true
	end
	local current = player:GetAttribute("Paint") or "Factory"
	info(parent, "PaintTitle", start, 30, rgb(130, 50, 160)).Text = "Paint jobs (looks only)"
	for i, paint in Vehicles.PAINTS do
		local productId = Config.PAINT_PRODUCTS[paint.id]
		local mine = paint.id == "Factory" or have[paint.id]
		if mine or (atWorkshop and productId and productId ~= 0) then
			local _, title, text, button = row(parent, "Paint" .. paint.id, start + i, 62)
			title.Text = paint.name
			text.Text = paint.text
			if paint.id == current then
				button.Text = "Painted"
				button.BackgroundColor3 = GREY
			elseif mine then
				button.Text = "Use"
				button.BackgroundColor3 = BLUE
				button.Activated:Connect(function()
					Remotes.SetPaint:FireServer(paint.id)
				end)
			else
				button.Text = "Robux"
				button.BackgroundColor3 = ROBUX
				button.Activated:Connect(function()
					Remotes.BuyProduct:FireServer("paint", paint.id)
				end)
			end
		end
	end
end

local function refreshGarage()
	clear(garageContent)
	local mine = owned()
	local driving = player:GetAttribute("Driving") or ""
	local any = false
	if driving ~= "" then
		local park = Ui.textButton({
			Name = "Park",
			Size = UDim2.new(1, -8, 0, 44),
			BackgroundColor3 = RED,
			Text = "Park and get out",
			LayoutOrder = 1,
			Parent = garageContent,
		})
		park.Activated:Connect(function()
			Remotes.Drive:FireServer(nil)
			garagePanel.Visible = false
		end)
	end
	for i, def in Vehicles.list do
		local levels = mine[def.id]
		if levels then
			any = true
			local tank = Vehicles.tank(def, Vehicles.levels(levels))
			local _, title, text, button = row(garageContent, def.id, 10 + i, 74)
			title.Text = def.name
			text.Text = ("%s\nPetrol: %d / %d"):format(stats(def, Vehicles.levels(levels)), levels.fuel, tank)
			if driving == def.id then
				button.Text = "Driving"
				button.BackgroundColor3 = GREY
			else
				button.Text = "Drive"
				button.Activated:Connect(function()
					Remotes.Drive:FireServer(def.id)
					garagePanel.Visible = false
				end)
			end
		end
	end
	if not any then
		info(garageContent, "None", 10, 70, nil).Text = "No vehicle yet! Visit the Gaari Showroom at the Rickshaw Stand in the bazaar. A Motorbike costs "
			.. Format.rupees(Vehicles.byId.Motorbike.cost)
			.. "."
	end
	paintRows(garageContent, 40, false)
end

garageButton.Activated:Connect(function()
	if not garagePanel.Visible then
		refreshGarage()
	end
	Ui.toggle(garagePanel)
end)

---------------------------------------------------------------------------
-- Gaari Showroom
---------------------------------------------------------------------------
local showroomPanel, showroomContent = Ui.panel(gui, "ShowroomPanel", "Gaari Showroom", Vector2.new(500, 600))

local function refreshShowroom()
	clear(showroomContent)
	info(showroomContent, "Intro", 0, 46, nil).Text =
		"Vehicles are yours forever, even after a Naya Safar. Faster than walking, and eggs ride in the boot!"
	local mine = owned()
	for i, def in Vehicles.list do
		local _, title, text, button = row(showroomContent, def.id, i, 92)
		title.Text = def.name
		text.Text = def.text .. "\n" .. stats(def, Vehicles.levels(nil))
		if mine[def.id] then
			button.Text = "Owned"
			button.BackgroundColor3 = GREY
		else
			button.Text = Format.rupees(def.cost)
			button.BackgroundColor3 = if rupeesValue.Value >= def.cost then GREEN else GREY
			button.Activated:Connect(function()
				Remotes.BuyVehicle:FireServer(def.id)
			end)
		end
	end
end

---------------------------------------------------------------------------
-- Ustad's Workshop
---------------------------------------------------------------------------
local workshopPanel, workshopContent = Ui.panel(gui, "WorkshopPanel", "Ustad's Workshop", Vector2.new(500, 620))

local function refreshWorkshop()
	clear(workshopContent)
	local mine = owned()
	local order = 0
	local any = false
	for _, def in Vehicles.list do
		local saved = mine[def.id]
		if saved then
			any = true
			order += 1
			info(workshopContent, def.id .. "Title", order, 30, rgb(40, 90, 150)).Text = def.name
			local levels = Vehicles.levels(saved)
			for _, upgrade in Vehicles.UPGRADES do
				order += 1
				local level = (levels :: any)[upgrade.id]
				local max = Vehicles.maxLevel(def, upgrade.id)
				local _, title, text, button = row(workshopContent, def.id .. upgrade.id, order, 62)
				title.Text = ("%s  ·  level %d/%d"):format(upgrade.name, level, max)
				text.Text = upgrade.text
				if max == 0 then
					text.Text = "Already the best tyres there are!"
					button.Text = "Max"
					button.BackgroundColor3 = GREY
				elseif level >= max then
					button.Text = "Max"
					button.BackgroundColor3 = GREY
				else
					local cost = Vehicles.upgradeCost(def, upgrade.id, level + 1)
					button.Text = Format.rupees(cost)
					button.BackgroundColor3 = if rupeesValue.Value >= cost then GREEN else GREY
					button.Activated:Connect(function()
						Remotes.UpgradeVehicle:FireServer(def.id, upgrade.id)
					end)
				end
			end
		end
	end
	if not any then
		info(workshopContent, "None", 1, 60, nil).Text =
			"Ustad says: bring me a vehicle! Buy one at the Gaari Showroom first."
	end
	paintRows(workshopContent, 100, true)
end

---------------------------------------------------------------------------
-- Opening and refreshing
---------------------------------------------------------------------------
ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, who: Player)
	if who ~= player or prompt.Name ~= "ShopPrompt" then
		return
	end
	local shop = prompt:GetAttribute("Shop")
	if shop == "Showroom" then
		refreshShowroom()
		Ui.open(showroomPanel)
	elseif shop == "Workshop" then
		refreshWorkshop()
		Ui.open(workshopPanel)
	end
end)

local function refreshOpen()
	if garagePanel.Visible then
		refreshGarage()
	end
	if showroomPanel.Visible then
		refreshShowroom()
	end
	if workshopPanel.Visible then
		refreshWorkshop()
	end
end
for _, name in { "Vehicles", "Driving", "Paint", "Paints" } do
	player:GetAttributeChangedSignal(name):Connect(refreshOpen)
end
rupeesValue.Changed:Connect(function()
	if showroomPanel.Visible then
		refreshShowroom()
	end
	if workshopPanel.Visible then
		refreshWorkshop()
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="49">
          <Properties>
            <string name="Name">Haveli</string>
            <string name="Source"><![CDATA[-- The Haveli window: upgrade your haveli and pick its theme.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Themes = require(Shared:WaitForChild("Themes"))
local Ui = require(script.Parent:WaitForChild("Ui"))

local rgb = Ui.rgb
local player = Players.LocalPlayer
local gui = player:WaitForChild("PlayerGui"):WaitForChild("ChaiChaosHud")
local buttons = gui:WaitForChild("Buttons")
local leaderstats = player:WaitForChild("leaderstats")
local rupeesValue = leaderstats:WaitForChild("Rupees") :: IntValue
local rebirthsValue = leaderstats:WaitForChild("Rebirths") :: IntValue

local CARD_COLOR = rgb(60, 45, 35)
local GREEN = rgb(40, 160, 80)
local GREY = rgb(110, 105, 100)

local haveliButton = Ui.sideButton(buttons, "Haveli", "Haveli", rgb(200, 120, 40), 2)
local panel, content = Ui.panel(gui, "HaveliPanel", "Meri Haveli", Vector2.new(460, 560))
haveliButton.Activated:Connect(function()
	Ui.toggle(panel)
end)

local order = 0
local function add(props)
	order += 1
	props.LayoutOrder = order
	props.Parent = content
	return props
end

local levelLabel = Ui.label(add({ Name = "Level", Size = UDim2.new(1, 0, 0, 30), TextColor3 = Ui.GOLD }))
local nextLabel = Ui.label(add({ Name = "Next", Size = UDim2.new(1, 0, 0, 44), TextWrapped = true }))
local upgradeButton = Ui.textButton(add({ Name = "Upgrade", Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = GREEN }))
upgradeButton.Activated:Connect(function()
	Remotes.UpgradeHaveli:FireServer()
end)
Ui.label(add({
	Name = "ThemesTitle",
	Size = UDim2.new(1, 0, 0, 28),
	Text = "Haveli Themes",
	TextColor3 = Ui.GOLD,
}))

local cards = {}
for _, theme in Themes.list do
	local card =
		Ui.create("Frame", add({ Name = theme.id, Size = UDim2.new(1, 0, 0, 74), BackgroundColor3 = CARD_COLOR }), {
			Ui.corner(10),
		})
	for i, color in { theme.wall, theme.trim, theme.accent } do
		Ui.create("Frame", {
			Name = "Swatch",
			Size = UDim2.fromOffset(16, 16),
			Position = UDim2.fromOffset(8 + (i - 1) * 20, 8),
			BackgroundColor3 = color,
			Parent = card,
		}, { Ui.corner(8) })
	end
	Ui.label({
		Name = "Name",
		Size = UDim2.new(1, -170, 0, 22),
		Position = UDim2.fromOffset(72, 4),
		Text = theme.name,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	})
	Ui.label({
		Name = "Perk",
		Size = UDim2.new(1, -120, 0, 40),
		Position = UDim2.fromOffset(8, 30),
		Text = theme.perkText,
		TextWrapped = true,
		TextColor3 = rgb(255, 230, 150),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	})
	local use = Ui.textButton({
		Name = "Use",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(100, 40),
		BackgroundColor3 = GREEN,
		Parent = card,
	})
	use.Activated:Connect(function()
		Remotes.SetTheme:FireServer(theme.id)
	end)
	cards[theme.id] = { theme = theme, button = use }
end

local function refresh()
	local level = player:GetAttribute("HaveliLevel") or 1
	local info = Config.HAVELI_LEVELS[level]
	levelLabel.Text = ("Level %d · %s · %d plots · %d %s"):format(
		level,
		info.name,
		info.plots,
		info.incubators,
		if info.incubators == 1 then "incubator" else "incubators"
	)
	local nextInfo = Config.HAVELI_LEVELS[level + 1]
	if nextInfo then
		nextLabel.Text = ("Next: %s · %d plots · %d incubators%s"):format(
			nextInfo.name,
			nextInfo.plots,
			nextInfo.incubators,
			if nextInfo.unlock then " · " .. nextInfo.unlock else ""
		)
		upgradeButton.Text = "Upgrade for " .. Format.rupees(nextInfo.cost)
		upgradeButton.BackgroundColor3 = if rupeesValue.Value >= nextInfo.cost then GREEN else GREY
	else
		nextLabel.Text = "Your haveli is as big and fancy as it gets. Shahi!"
		upgradeButton.Text = "Max level!"
		upgradeButton.BackgroundColor3 = GREY
	end

	local current = player:GetAttribute("Theme")
	local rebirths = rebirthsValue.Value
	for id, card in cards do
		local button = card.button
		if id == current then
			button.Text = "Using"
			button.BackgroundColor3 = Ui.GOLD:Lerp(rgb(0, 0, 0), 0.3)
		elseif rebirths >= card.theme.rebirths then
			button.Text = "Use"
			button.BackgroundColor3 = GREEN
		else
			button.Text = ("Safar %d"):format(card.theme.rebirths)
			button.BackgroundColor3 = GREY
		end
	end
	haveliButton.Text = ("Haveli Lv %d"):format(level)
end

for _, name in { "HaveliLevel", "Theme" } do
	player:GetAttributeChangedSignal(name):Connect(refresh)
end
rupeesValue.Changed:Connect(refresh)
rebirthsValue.Changed:Connect(refresh)
refresh()
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="50">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[-- The on-screen HUD: rupees, income, the Taala button, the Collection Book
-- and pop-up messages from the server.
-- (Kismat Roll and Chor Pass: Kismat.client.luau. The Chowk shops and the
-- Brainrots window: Shops.client.luau. The radar: Radar.client.luau.)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Brainrots = require(Shared:WaitForChild("Brainrots"))
local Format = require(Shared:WaitForChild("Format"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Ui = require(script.Parent:WaitForChild("Ui"))
local Mutations = require(Shared:WaitForChild("Mutations"))
local Biomes = require(Shared:WaitForChild("Biomes"))

local player = Players.LocalPlayer
local leaderstats = player:WaitForChild("leaderstats")
local rupeesValue = leaderstats:WaitForChild("Rupees") :: IntValue

local WHITE, GOLD, FONT = Ui.WHITE, Ui.GOLD, Ui.FONT
local rgb, create, corner, label = Ui.rgb, Ui.create, Ui.corner, Ui.label

local gui = create("ScreenGui", {
	Name = "ChaiChaosHud",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})

---------------------------------------------------------------------------
-- Money panel
---------------------------------------------------------------------------
local panelScale = create("UIScale", {})
local panel = create("Frame", {
	Name = "Money",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 8),
	Size = UDim2.fromOffset(300, 74),
	BackgroundColor3 = rgb(45, 30, 22),
	BackgroundTransparency = 0.1,
	Parent = gui,
}, {
	corner(14),
	create("UIStroke", { Thickness = 2, Color = GOLD, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
	panelScale,
})
local rupeesLabel = label({
	Size = UDim2.new(1, -16, 0, 40),
	Position = UDim2.fromOffset(8, 4),
	TextColor3 = GOLD,
	Text = "Rs 0",
	Parent = panel,
})
local incomeLabel = label({
	Size = UDim2.new(1, -16, 0, 22),
	Position = UDim2.fromOffset(8, 46),
	Text = "+0/s",
	Parent = panel,
})
local statusLabel = label({
	AnchorPoint = Vector2.new(0.5, 0),
	Size = UDim2.fromOffset(300, 20),
	Position = UDim2.new(0.5, 0, 0, 86),
	TextColor3 = rgb(160, 230, 255),
	Text = "",
	Parent = gui,
})

-- the rupee number counts up smoothly instead of jumping
local shown = create("NumberValue", { Value = rupeesValue.Value })
shown.Changed:Connect(function()
	rupeesLabel.Text = Format.rupees(math.floor(shown.Value + 0.5))
end)
rupeesLabel.Text = Format.rupees(rupeesValue.Value)

local lastRupees = rupeesValue.Value
local function updateRupees()
	local value = rupeesValue.Value
	TweenService:Create(shown, TweenInfo.new(0.4, Enum.EasingStyle.Quad), { Value = value }):Play()
	if value > lastRupees then
		panelScale.Scale = 1.07
		TweenService:Create(panelScale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end
	lastRupees = value
end

local function updateIncome()
	local income = player:GetAttribute("Income") or 0
	local galla = player:GetAttribute("Galla") or 0
	incomeLabel.Text = ("+%s/s   ·   Galla %s"):format(Format.short(income), Format.rupees(galla))
end

rupeesValue.Changed:Connect(updateRupees)
player:GetAttributeChangedSignal("Income"):Connect(updateIncome)
player:GetAttributeChangedSignal("Galla"):Connect(updateIncome)
updateRupees()
updateIncome()

---------------------------------------------------------------------------
-- Pop-up messages
---------------------------------------------------------------------------
local toasts = create("Frame", {
	Name = "Toasts",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 112),
	Size = UDim2.new(0.9, 0, 0, 300),
	BackgroundTransparency = 1,
	Parent = gui,
}, {
	create("UISizeConstraint", { MaxSize = Vector2.new(480, 300) }),
	create("UIListLayout", {
		Padding = UDim.new(0, 6),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
	}),
})

local TOAST_COLORS = {
	info = rgb(40, 40, 55),
	good = rgb(30, 130, 70),
	bad = rgb(165, 75, 40),
	alert = rgb(215, 30, 40),
	rare = rgb(135, 60, 195),
}
local MAX_TOASTS = 5
local toastCount = 0

local function toast(kind: string, text: string)
	toastCount += 1
	local isAlert = kind == "alert"
	local item = label({
		Size = UDim2.new(1, 0, 0, if isAlert then 50 else 34),
		BackgroundColor3 = TOAST_COLORS[kind] or TOAST_COLORS.info,
		BackgroundTransparency = 0.1,
		TextWrapped = true,
		Text = text,
		LayoutOrder = -toastCount, -- newest on top
		Parent = toasts,
	})
	corner(10).Parent = item
	create("UIPadding", {
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
		PaddingTop = UDim.new(0, 4),
		PaddingBottom = UDim.new(0, 4),
		Parent = item,
	})

	local items = {}
	for _, child in toasts:GetChildren() do
		if child:IsA("TextLabel") then
			table.insert(items, child)
		end
	end
	table.sort(items, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	for i = MAX_TOASTS + 1, #items do
		items[i]:Destroy()
	end

	task.delay(if isAlert then 6 else 4, function()
		if item.Parent then
			local fade =
				TweenService:Create(item, TweenInfo.new(0.4), { BackgroundTransparency = 1, TextTransparency = 1 })
			fade:Play()
			fade.Completed:Wait()
			item:Destroy()
		end
	end)
end

Remotes.Notify.OnClientEvent:Connect(toast)

---------------------------------------------------------------------------
-- Buttons on the left
---------------------------------------------------------------------------
local buttons = create("Frame", {
	Name = "Buttons",
	AnchorPoint = Vector2.new(0, 0.5),
	Position = UDim2.new(0, 10, 0.5, 0),
	Size = UDim2.fromOffset(276, 0),
	AutomaticSize = Enum.AutomaticSize.Y,
	BackgroundTransparency = 1,
	Parent = gui,
}, {
	create("UIGridLayout", {
		CellSize = UDim2.fromOffset(134, 40),
		CellPadding = UDim2.fromOffset(8, 6),
		FillDirectionMaxCells = 2,
		SortOrder = Enum.SortOrder.LayoutOrder,
	}),
})

local function button(name: string, text: string, color: Color3, order: number): TextButton
	return Ui.sideButton(buttons, name, text, color, order)
end

local LOCK_READY = rgb(190, 70, 50)
local LOCK_ON = rgb(40, 150, 80)
local LOCK_WAIT = rgb(100, 100, 110)
local lockButton = button("Taala", "Taala (Lock)", LOCK_READY, 1)
local bookButton = button("Collection", "Collection", rgb(60, 120, 195), 5)

lockButton.Activated:Connect(function()
	Remotes.LockHaveli:FireServer()
end)

local function formatTime(seconds: number): string
	seconds = math.ceil(seconds)
	return ("%d:%02d"):format(seconds // 60, seconds % 60)
end

task.spawn(function()
	while gui.Parent do
		local now = workspace:GetServerTimeNow()
		local lockedUntil = player:GetAttribute("LockedUntil") or 0
		local readyAt = player:GetAttribute("LockReadyAt") or 0
		if now < lockedUntil then
			lockButton.Text = ("Locked %ds"):format(math.ceil(lockedUntil - now))
			lockButton.BackgroundColor3 = LOCK_ON
		elseif now < readyAt then
			lockButton.Text = ("Taala in %ds"):format(math.ceil(readyAt - now))
			lockButton.BackgroundColor3 = LOCK_WAIT
		else
			lockButton.Text = "Taala (Lock)"
			lockButton.BackgroundColor3 = LOCK_READY
		end

		local protectedUntil = player:GetAttribute("ProtectedUntil") or 0
		statusLabel.Text = if now < protectedUntil then "Steal protection " .. formatTime(protectedUntil - now) else ""
		task.wait(0.2)
	end
end)

---------------------------------------------------------------------------
-- Collection Book
---------------------------------------------------------------------------
local book = create("Frame", {
	Name = "CollectionBook",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromScale(0.9, 0.8),
	BackgroundColor3 = rgb(250, 238, 210),
	Visible = false,
	ZIndex = 5,
	Parent = gui,
}, {
	corner(16),
	create("UISizeConstraint", { MaxSize = Vector2.new(680, 480) }),
	create("UIStroke", { Thickness = 3, Color = rgb(120, 70, 40), ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
})
local bookTitle = label({
	Size = UDim2.new(1, -70, 0, 40),
	Position = UDim2.fromOffset(14, 8),
	TextColor3 = GOLD,
	TextXAlignment = Enum.TextXAlignment.Left,
	Text = "Collection Book",
	ZIndex = 6,
	Parent = book,
})
local closeButton = create("TextButton", {
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -10, 0, 8),
	Size = UDim2.fromOffset(40, 40),
	BackgroundColor3 = rgb(200, 60, 50),
	Font = FONT,
	TextScaled = true,
	TextColor3 = WHITE,
	Text = "X",
	ZIndex = 6,
	Parent = book,
}, { corner(10) })
local grid = create("ScrollingFrame", {
	Position = UDim2.fromOffset(10, 56),
	Size = UDim2.new(1, -20, 1, -66),
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	ScrollBarThickness = 8,
	CanvasSize = UDim2.new(),
	AutomaticCanvasSize = Enum.AutomaticSize.Y,
	ZIndex = 6,
	Parent = book,
}, {
	create("UIGridLayout", {
		CellSize = UDim2.fromOffset(150, 104),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
	}),
})

-- which biomes' eggs each brainrot hatches from
local hatchesIn: { [string]: { string } } = {}
for _, biome in Biomes.list do
	for _, id in biome.pool do
		hatchesIn[id] = hatchesIn[id] or {}
		table.insert(hatchesIn[id], biome.name)
	end
end

local cards = {}
local order = 0
for _, rarity in Brainrots.BOOK_ORDER do
	for _, def in Brainrots.byRarity[rarity] do
		order += 1
		local card = create("Frame", {
			Name = def.id,
			BackgroundColor3 = rgb(60, 45, 35),
			LayoutOrder = order,
			ZIndex = 6,
			Parent = grid,
		}, {
			corner(10),
			create("Frame", {
				Name = "Strip",
				Size = UDim2.new(1, 0, 0, 8),
				BackgroundColor3 = Brainrots.RARITY_COLORS[rarity],
				BorderSizePixel = 0,
				ZIndex = 7,
			}, { corner(10) }),
		})
		local nameLabel = label({
			Size = UDim2.new(1, -10, 0, 30),
			Position = UDim2.fromOffset(5, 12),
			ZIndex = 7,
			Parent = card,
		})
		local infoLabel = label({
			Size = UDim2.new(1, -10, 0, 20),
			Position = UDim2.fromOffset(5, 44),
			TextColor3 = Brainrots.RARITY_COLORS[rarity],
			ZIndex = 7,
			Parent = card,
		})
		local phraseLabel = label({
			Size = UDim2.new(1, -10, 0, 26),
			Position = UDim2.fromOffset(5, 64),
			TextColor3 = rgb(255, 230, 150),
			TextWrapped = true,
			ZIndex = 7,
			Parent = card,
		})
		-- G D R badges for the Golden, Diamond and Rainbow versions found
		local badges = {}
		for i, m in Mutations.list do
			badges[m.id] = label({
				Name = m.id,
				Size = UDim2.fromOffset(18, 14),
				Position = UDim2.new(1, -66 + (i - 1) * 20, 1, -16),
				Text = m.id:sub(1, 1),
				TextColor3 = m.color,
				TextTransparency = 0.8,
				ZIndex = 7,
				Parent = card,
			})
		end
		table.insert(
			cards,
			{ def = def, frame = card, name = nameLabel, info = infoLabel, phrase = phraseLabel, badges = badges }
		)
	end
end

local function refreshBook()
	local found = {}
	for id in string.gmatch(player:GetAttribute("Discovered") or "", "[^,]+") do
		found[id] = true
	end
	local count = 0
	for _, card in cards do
		local def = card.def
		if found[def.id] then
			count += 1
			card.name.Text = def.name
			card.info.Text = ("%s  ·  +%s/s"):format(Format.rupees(def.price), Format.short(def.income))
			card.phrase.Text = '"' .. def.phrase .. '"'
			card.frame.BackgroundColor3 = rgb(70, 50, 38)
		else
			card.name.Text = "???"
			card.info.Text = def.rarity
			card.phrase.Text = if def.questOnly
				then "Collection Book reward"
				elseif hatchesIn[def.id] then "Eggs in " .. table.concat(hatchesIn[def.id], ", ")
				else "Kismat Roll only"
			card.frame.BackgroundColor3 = rgb(35, 32, 38)
		end
		for id, badge in card.badges do
			badge.TextTransparency = if found[def.id .. ":" .. id] then 0 else 0.8
		end
	end
	bookTitle.Text = ("Collection Book  %d/%d"):format(count, #Brainrots.list)
end

player:GetAttributeChangedSignal("Discovered"):Connect(refreshBook)
refreshBook()

Ui.register(book)
bookButton.Activated:Connect(function()
	Ui.toggle(book)
end)
closeButton.Activated:Connect(function()
	book.Visible = false
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="51">
          <Properties>
            <string name="Name">Kismat</string>
            <string name="Source"><![CDATA[-- Kismat Roll and Chor Pass windows, and the roll reveal animation.
-- The odds are shown before anyone spends rupees or Robux.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Config = require(Shared:WaitForChild("Config"))
local Brainrots = require(Shared:WaitForChild("Brainrots"))
local Format = require(Shared:WaitForChild("Format"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Mutations = require(Shared:WaitForChild("Mutations"))
local Themes = require(Shared:WaitForChild("Themes"))
local Events = require(Shared:WaitForChild("Events"))
local Ui = require(script.Parent:WaitForChild("Ui"))
local SoundPlayer = require(script.Parent:WaitForChild("SoundPlayer"))

local rgb = Ui.rgb
local player = Players.LocalPlayer
local gui = player:WaitForChild("PlayerGui"):WaitForChild("ChaiChaosHud")
local buttons = gui:WaitForChild("Buttons")

local ROW_COLOR = rgb(60, 45, 35)
local BUY_COLOR = rgb(30, 140, 80)

local function attribute(name: string, default: any): any
	local value = player:GetAttribute(name)
	if value == nil then
		return default
	end
	return value
end

local function plural(count: number, one: string, many: string): string
	return ("%d %s"):format(count, if count == 1 then one else many)
end

-- Fills in "R$ 25" once Roblox tells us the price set on the Creator Dashboard.
local function showPrice(button: TextButton, productId: number, text: string)
	button.Text = text .. "  ·  R$ ..."
	task.spawn(function()
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfo(productId, Enum.InfoType.Product)
		end)
		if ok and type(info) == "table" and info.PriceInRobux then
			button.Text = ("%s  ·  R$ %s"):format(text, Format.commas(info.PriceInRobux))
		else
			button.Text = text .. "  ·  Robux"
		end
	end)
end

---------------------------------------------------------------------------
-- Odds
---------------------------------------------------------------------------
local totalWeight = 0
for _, weight in Config.ROLL_ODDS do
	totalWeight += weight
end

local function chance(rarity: string): number
	return (Config.ROLL_ODDS[rarity] or 0) / totalWeight
end

local function percent(rarity: string): string
	local text = string.format("%.1f", chance(rarity) * 100):gsub("%.0$", "")
	return text .. "%"
end

local function oneIn(rarity: string): string
	local p = chance(rarity)
	if p <= 0 then
		return "never"
	end
	return "1 in " .. Format.commas(math.max(1, math.floor(1 / p + 0.5)))
end

---------------------------------------------------------------------------
-- Kismat Roll window
---------------------------------------------------------------------------
local kismatButton = Ui.sideButton(buttons, "Kismat", "Kismat Roll", rgb(230, 140, 30), 3)
local panel, content = Ui.panel(gui, "KismatPanel", "Kismat Roll", Vector2.new(440, 560))
local order = 0
local function nextOrder(): number
	order += 1
	return order
end

Ui.label({
	Size = UDim2.new(1, 0, 0, 22),
	Text = "Roll for a random brainrot. The odds:",
	TextXAlignment = Enum.TextXAlignment.Left,
	LayoutOrder = nextOrder(),
	Parent = content,
})
for _, rarity in Brainrots.RARITY_ORDER do
	if not Config.ROLL_ODDS[rarity] then
		continue -- Secret brainrots never come from rolls
	end
	local row = Ui.create("Frame", {
		Name = rarity,
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = ROW_COLOR,
		LayoutOrder = nextOrder(),
		Parent = content,
	}, { Ui.corner(8) })
	local color = Brainrots.RARITY_COLORS[rarity]
	Ui.label({
		Size = UDim2.new(0.42, -8, 1, -4),
		Position = UDim2.fromOffset(8, 2),
		Text = rarity,
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})
	Ui.label({
		Name = "Percent",
		Size = UDim2.new(0.25, 0, 1, -4),
		Position = UDim2.new(0.42, 0, 0, 2),
		Text = percent(rarity),
		Parent = row,
	})
	Ui.label({
		Name = "OneIn",
		Size = UDim2.new(0.33, -8, 1, -4),
		Position = UDim2.new(0.67, 0, 0, 2),
		Text = oneIn(rarity),
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = row,
	})
end
Ui.label({
	Size = UDim2.new(1, 0, 0, 48),
	Text = "Every brainrot in a rarity is equally likely. Chand Raat Cheetah only comes out at night, "
		.. "Pakora Panda only during Baarish and Gajar Halwa Gorilla only during Sardi.",
	TextWrapped = true,
	TextColor3 = rgb(255, 235, 170),
	LayoutOrder = nextOrder(),
	Parent = content,
})

-- Mutation chances, for this player right now (theme perk and event included)
local mutationTitle = Ui.label({
	Name = "MutationTitle",
	Size = UDim2.new(1, 0, 0, 22),
	TextXAlignment = Enum.TextXAlignment.Left,
	LayoutOrder = nextOrder(),
	Parent = content,
})
local mutationRows = {}
for _, m in Mutations.list do
	local row = Ui.create("Frame", {
		Name = m.id,
		Size = UDim2.new(1, 0, 0, 24),
		BackgroundColor3 = ROW_COLOR,
		LayoutOrder = nextOrder(),
		Parent = content,
	}, { Ui.corner(8) })
	Ui.label({
		Size = UDim2.new(0.5, -8, 1, -4),
		Position = UDim2.fromOffset(8, 2),
		Text = ("%s (x%d income)"):format(m.name, m.income),
		TextColor3 = m.color,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})
	mutationRows[m.id] = Ui.label({
		Name = "Chance",
		Size = UDim2.new(0.5, -8, 1, -4),
		Position = UDim2.new(0.5, 0, 0, 2),
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = row,
	})
end

local function mutationBoost(): number
	local event = Events.current()
	return (Themes.perk(player:GetAttribute("Theme"), "rollMutation") or 1)
		* (if event then event.mutationMult or 1 else 1)
end

local function rollCost(): number
	local event = Events.current()
	local discount = (1 - (Themes.perk(player:GetAttribute("Theme"), "rollDiscount") or 0))
		* (1 - (if event then event.rollDiscount or 0 else 0))
	return math.floor(Config.ROLL_RUPEE_COST * discount)
end

local function refreshMutations()
	local boost = mutationBoost()
	mutationTitle.Text = if boost > 1
		then ("Mutation chances (x%s right now!):"):format(tostring(boost))
		else "Mutation chances:"
	for _, m in Mutations.list do
		local odds = m.roll * boost
		local pct = string.format("%.2f", odds * 100):gsub("0+$", ""):gsub("%.$", "")
		mutationRows[m.id].Text = ("%s%%  ·  1 in %s"):format(pct, Format.commas(math.floor(1 / odds + 0.5)))
	end
end
local pityLabel = Ui.label({
	Name = "Pity",
	Size = UDim2.new(1, 0, 0, 24),
	TextColor3 = rgb(200, 150, 255),
	LayoutOrder = nextOrder(),
	Parent = content,
})
local rollsLabel = Ui.label({
	Name = "Rolls",
	Size = UDim2.new(1, 0, 0, 24),
	LayoutOrder = nextOrder(),
	Parent = content,
})

local function contentButton(name: string, text: string, color: Color3): TextButton
	return Ui.textButton({
		Name = name,
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundColor3 = color,
		Text = text,
		LayoutOrder = nextOrder(),
		Parent = content,
	})
end

local rollRupees = contentButton("RollRupees", "Roll for " .. Format.rupees(Config.ROLL_RUPEE_COST), rgb(230, 140, 30))
local rollToken = contentButton("RollToken", "Use a Kismat Roll", rgb(150, 70, 205))

local rollPacks = {}
for index, pack in Config.ROLL_PRODUCTS do
	if pack.id ~= 0 then
		local packButton = contentButton("BuyRolls" .. index, "", BUY_COLOR)
		showPrice(packButton, pack.id, plural(pack.amount, "Kismat Roll", "Kismat Rolls"))
		packButton.Activated:Connect(function()
			Remotes.BuyProduct:FireServer("rolls", index)
		end)
		table.insert(rollPacks, packButton)
	end
end

local busyUntil = 0
local function roll(method: string)
	if os.clock() < busyUntil then
		return
	end
	busyUntil = os.clock() + Config.ROLL_COOLDOWN
	Remotes.Roll:FireServer(method)
end
rollRupees.Activated:Connect(function()
	roll("rupees")
end)
rollToken.Activated:Connect(function()
	roll("token")
end)
kismatButton.Activated:Connect(function()
	Ui.toggle(panel)
end)

local function refreshKismat()
	local tokens = attribute("RollTokens", 0)
	local left = math.max(1, Config.ROLL_PITY - attribute("RollPity", 0))
	pityLabel.Text = ("Epic or better guaranteed within %s"):format(plural(left, "roll", "rolls"))
	rollsLabel.Text = "Your Kismat Rolls: " .. tokens
	rollToken.Visible = tokens > 0
	rollToken.Text = ("Use a Kismat Roll (%d left)"):format(tokens)
	kismatButton.Text = if tokens > 0 then ("Kismat Roll (%d)"):format(tokens) else "Kismat Roll"
	local cost = rollCost()
	rollRupees.Text = if cost < Config.ROLL_RUPEE_COST
		then ("Roll for %s (sale!)"):format(Format.rupees(cost))
		else "Roll for " .. Format.rupees(cost)
	refreshMutations()
	local paidAllowed = attribute("PaidRollsAllowed", false) == true
	for _, packButton in rollPacks do
		packButton.Visible = paidAllowed
	end
end
for _, name in { "RollTokens", "RollPity", "PaidRollsAllowed", "Theme" } do
	player:GetAttributeChangedSignal(name):Connect(refreshKismat)
end
workspace:GetAttributeChangedSignal("EventId"):Connect(refreshKismat)
refreshKismat()

---------------------------------------------------------------------------
-- Chor Pass window (only when stealing costs Robux)
---------------------------------------------------------------------------
if Config.stealsCostRobux() then
	local chorButton = Ui.sideButton(buttons, "ChorPass", "Chor Pass", rgb(200, 50, 70), 7)
	local chorPanel, chorContent = Ui.panel(gui, "ChorPanel", "Chor Pass", Vector2.new(420, 340))
	local chorOrder = 0
	local function add(props)
		chorOrder += 1
		props.LayoutOrder = chorOrder
		props.Parent = chorContent
		return props
	end
	local refundText = if Config.STEAL_REFUND_ON_FAIL
		then " If you get bonked, die, or the owner leaves, you get it back."
		else ""
	Ui.label(add({
		Size = UDim2.new(1, 0, 0, 54),
		Text = "Every steal uses 1 Chor Pass." .. refundText,
		TextWrapped = true,
	}))
	local passesLabel = Ui.label(add({ Name = "Passes", Size = UDim2.new(1, 0, 0, 26) }))
	for index, pack in Config.STEAL_PRODUCTS do
		if pack.id ~= 0 then
			local packButton = Ui.textButton(add({
				Name = "BuyPasses" .. index,
				Size = UDim2.new(1, 0, 0, 44),
				BackgroundColor3 = BUY_COLOR,
				Text = "",
			}))
			showPrice(packButton, pack.id, plural(pack.amount, "Chor Pass", "Chor Passes"))
			packButton.Activated:Connect(function()
				Remotes.BuyProduct:FireServer("steals", index)
			end)
		end
	end
	local function refreshChor()
		local passes = attribute("StealTokens", 0)
		passesLabel.Text = "Your Chor Passes: " .. passes
		chorButton.Text = ("Chor Pass (%d)"):format(passes)
	end
	player:GetAttributeChangedSignal("StealTokens"):Connect(refreshChor)
	refreshChor()
	chorButton.Activated:Connect(function()
		Ui.toggle(chorPanel)
	end)
end

---------------------------------------------------------------------------
-- Roll reveal
---------------------------------------------------------------------------
local revealScale = Ui.create("UIScale", {})
local reveal = Ui.create("Frame", {
	Name = "KismatReveal",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.42),
	Size = UDim2.fromOffset(380, 170),
	BackgroundColor3 = rgb(40, 25, 20),
	BackgroundTransparency = 0.05,
	Visible = false,
	ZIndex = 20,
	Parent = gui,
}, {
	Ui.corner(18),
	Ui.create("UIStroke", { Thickness = 3, Color = Ui.GOLD, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
	revealScale,
})
local revealHeader = Ui.label({
	Size = UDim2.new(1, -20, 0, 28),
	Position = UDim2.fromOffset(10, 8),
	TextColor3 = Ui.GOLD,
	Parent = reveal,
})
local revealName = Ui.label({
	Name = "BrainrotName",
	Size = UDim2.new(1, -20, 0, 56),
	Position = UDim2.fromOffset(10, 40),
	Parent = reveal,
})
local revealRarity = Ui.label({
	Name = "Rarity",
	Size = UDim2.new(1, -20, 0, 28),
	Position = UDim2.fromOffset(10, 100),
	Parent = reveal,
})
local revealNew = Ui.label({
	Name = "New",
	Size = UDim2.new(1, -20, 0, 26),
	Position = UDim2.fromOffset(10, 134),
	TextColor3 = rgb(120, 255, 140),
	Text = "NEW! Added to your Collection Book",
	Parent = reveal,
})

local revealCount = 0
local function showRoll(id: string, mutationId: string, isNew: boolean, wasPity: boolean)
	local def = Brainrots.byId[id]
	if not def then
		return
	end
	local mutation = Mutations.byId[mutationId]
	revealCount += 1
	local mine = revealCount
	reveal.Visible = true
	revealHeader.Text = "Rolling..."
	revealRarity.Text = ""
	revealNew.Visible = false

	-- flick through random brainrots, slowing down like a spinning wheel
	local step, elapsed = 0.04, 0
	while elapsed < 1.6 do
		local fake = Brainrots.list[math.random(#Brainrots.list)]
		revealName.Text = fake.name
		revealName.TextColor3 = Brainrots.RARITY_COLORS[fake.rarity]
		SoundPlayer.play("RollSpin")
		elapsed += task.wait(step)
		step *= 1.15
		if mine ~= revealCount then
			return
		end
	end

	revealHeader.Text = if mutation
		then ("%s! Kismat says..."):format(mutation.name:upper())
		elseif wasPity then "Pity roll! Kismat says..."
		else "Kismat says..."
	revealName.Text = Mutations.displayName(def, mutation and mutation.id)
	revealName.TextColor3 = if mutation then mutation.color else Brainrots.RARITY_COLORS[def.rarity]
	revealRarity.Text = ("%s  ·  %s"):format(def.rarity, oneIn(def.rarity))
	revealRarity.TextColor3 = Brainrots.RARITY_COLORS[def.rarity]
	revealNew.Visible = isNew
	SoundPlayer.play("RollReveal")
	revealScale.Scale = 1.15
	TweenService:Create(revealScale, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Scale = 1 }):Play()

	task.delay(2.5, function()
		if mine == revealCount then
			reveal.Visible = false
		end
	end)
end

Remotes.RollResult.OnClientEvent:Connect(function(id, mutationId, isNew, wasPity)
	task.spawn(showRoll, id, mutationId, isNew, wasPity)
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="52">
          <Properties>
            <string name="Name">Prompts</string>
            <string name="Source"><![CDATA[-- Shows each ProximityPrompt only to the right players: "Steal" is only for
-- people who do not own the brainrot (prompts can also be owner-only).
-- The server marks prompts with attributes: ShowFor ("owner"/"others"),
-- OwnerId and Active. The server still checks everything when a prompt is used.

local Players = game:GetService("Players")

local player = Players.LocalPlayer

local function update(prompt: ProximityPrompt)
	local showFor = prompt:GetAttribute("ShowFor")
	if showFor == nil then
		return
	end
	local mine = prompt:GetAttribute("OwnerId") == player.UserId
	local active = prompt:GetAttribute("Active") ~= false
	if showFor == "owner" then
		prompt.Enabled = active and mine
	else
		prompt.Enabled = active and not mine and (prompt:GetAttribute("OwnerId") or 0) ~= 0
	end
end

local function watch(instance: Instance)
	if instance:IsA("ProximityPrompt") then
		update(instance)
		instance.AttributeChanged:Connect(function()
			update(instance)
		end)
	end
end

workspace.DescendantAdded:Connect(watch)
for _, descendant in workspace:GetDescendants() do
	watch(descendant)
end
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="53">
          <Properties>
            <string name="Name">Quests</string>
            <string name="Source"><![CDATA[-- The Quests window: today's quests and the Collection Book rewards.

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Config = require(Shared:WaitForChild("Config"))
local Brainrots = require(Shared:WaitForChild("Brainrots"))
local Format = require(Shared:WaitForChild("Format"))
local Quests = require(Shared:WaitForChild("Quests"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Ui = require(script.Parent:WaitForChild("Ui"))

local rgb = Ui.rgb
local player = Players.LocalPlayer
local gui = player:WaitForChild("PlayerGui"):WaitForChild("ChaiChaosHud")
local buttons = gui:WaitForChild("Buttons")

local CARD_COLOR = rgb(60, 45, 35)
local GREEN = rgb(40, 160, 80)
local GREY = rgb(110, 105, 100)
local BAR_COLOR = rgb(255, 190, 40)

local questButton = Ui.sideButton(buttons, "Quests", "Quests", rgb(40, 150, 140), 4)
local panel, content = Ui.panel(gui, "QuestPanel", "Quests", Vector2.new(460, 560))
questButton.Activated:Connect(function()
	Ui.toggle(panel)
end)

local order = 0
local function add(props)
	order += 1
	props.LayoutOrder = order
	props.Parent = content
	return props
end

local resetLabel = Ui.label(add({ Name = "Reset", Size = UDim2.new(1, 0, 0, 22), TextColor3 = rgb(160, 230, 255) }))

local function claimButton(parent: Instance, onClick: () -> ()): TextButton
	local button = Ui.textButton({
		Name = "Claim",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(90, 36),
		BackgroundColor3 = GREEN,
		Text = "Claim",
		Parent = parent,
	})
	button.Activated:Connect(onClick)
	return button
end

local questRows = {}
for i = 1, Config.QUESTS_PER_DAY do
	local row =
		Ui.create("Frame", add({ Name = "Quest" .. i, Size = UDim2.new(1, 0, 0, 70), BackgroundColor3 = CARD_COLOR }), {
			Ui.corner(10),
		})
	local text = Ui.label({
		Name = "Text",
		Size = UDim2.new(1, -112, 0, 26),
		Position = UDim2.fromOffset(8, 4),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		Parent = row,
	})
	local barBack = Ui.create("Frame", {
		Name = "Bar",
		Size = UDim2.new(1, -112, 0, 10),
		Position = UDim2.fromOffset(8, 34),
		BackgroundColor3 = rgb(35, 28, 22),
		Parent = row,
	}, { Ui.corner(5) })
	local fill = Ui.create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = BAR_COLOR,
		Parent = barBack,
	}, { Ui.corner(5) })
	local reward = Ui.label({
		Name = "Reward",
		Size = UDim2.new(1, -112, 0, 18),
		Position = UDim2.fromOffset(8, 48),
		TextColor3 = rgb(255, 230, 150),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})
	local claim = claimButton(row, function()
		Remotes.ClaimQuest:FireServer(i)
	end)
	questRows[i] = { row = row, text = text, fill = fill, reward = reward, claim = claim }
end

local bonusRow =
	Ui.create("Frame", add({ Name = "Bonus", Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = CARD_COLOR }), {
		Ui.corner(10),
	})
local bonusText = Ui.label({
	Size = UDim2.new(1, -112, 1, -8),
	Position = UDim2.fromOffset(8, 4),
	Text = ("Finish all quests: +%d Kismat Rolls"):format(Config.QUEST_BONUS_ROLLS),
	TextXAlignment = Enum.TextXAlignment.Left,
	TextWrapped = true,
	Parent = bonusRow,
})
local bonusClaim = claimButton(bonusRow, function()
	Remotes.ClaimQuest:FireServer("bonus")
end)

Ui.label(add({
	Name = "CollectionTitle",
	Size = UDim2.new(1, 0, 0, 28),
	Text = "Collection Book Rewards",
	TextColor3 = Ui.GOLD,
}))

local collectionRows = {}
for _, rarity in Brainrots.RARITY_ORDER do
	local reward = Config.COLLECTION_REWARDS[rarity]
	local special = Brainrots.byId[reward.special]
	local row =
		Ui.create("Frame", add({ Name = rarity, Size = UDim2.new(1, 0, 0, 56), BackgroundColor3 = CARD_COLOR }), {
			Ui.corner(10),
		})
	local title = Ui.label({
		Name = "Title",
		Size = UDim2.new(1, -112, 0, 24),
		Position = UDim2.fromOffset(8, 4),
		TextColor3 = Brainrots.RARITY_COLORS[rarity],
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})
	Ui.label({
		Name = "Prize",
		Size = UDim2.new(1, -112, 0, 20),
		Position = UDim2.fromOffset(8, 30),
		Text = if special
			then ("%s + %d rolls + %s"):format(Format.rupees(reward.rupees), reward.rolls, special.name)
			else ("%s + %d rolls"):format(Format.rupees(reward.rupees), reward.rolls),
		TextColor3 = rgb(255, 230, 150),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})
	local claim = claimButton(row, function()
		Remotes.ClaimCollection:FireServer(rarity)
	end)
	collectionRows[rarity] = { title = title, claim = claim }
end

local state = nil

local function tidy(n: number): number
	if n < 100 then
		return math.floor(n)
	end
	local step = 10 ^ (math.floor(math.log10(n)) - 1)
	return math.floor(n / step) * step
end

local function refresh()
	local ok, decoded = pcall(function()
		return HttpService:JSONDecode(player:GetAttribute("QuestState") or "{}")
	end)
	state = if ok and type(decoded) == "table" then decoded else {}
	local quests = (state.quests and state.quests.list) or {}
	local claimable = false

	local reward =
		tidy(math.max(Config.QUEST_MIN_REWARD, (player:GetAttribute("Income") or 0) * Config.QUEST_REWARD_SECONDS))
	local allClaimed = #quests > 0
	for i, rowInfo in questRows do
		local quest = quests[i]
		local def = quest and Quests.byId[quest.id]
		rowInfo.row.Visible = def ~= nil
		if quest and def then
			local target = if def.money then Format.rupees(quest.target) else tostring(quest.target)
			rowInfo.text.Text = def.text:format(target)
			local progress = math.min(quest.progress, quest.target)
			rowInfo.fill.Size = UDim2.fromScale(progress / math.max(quest.target, 1), 1)
			local rolls = def.rolls or 0
			rowInfo.reward.Text = ("Reward: %s%s  ·  %s/%s"):format(
				Format.rupees(reward),
				if rolls > 0 then (" + %d Kismat Roll"):format(rolls) else "",
				if def.money then Format.short(progress) else tostring(progress),
				if def.money then Format.short(quest.target) else tostring(quest.target)
			)
			local done = quest.progress >= quest.target
			rowInfo.claim.Text = if quest.claimed then "Done" elseif done then "Claim" else "..."
			rowInfo.claim.BackgroundColor3 = if done and not quest.claimed then GREEN else GREY
			claimable = claimable or (done and not quest.claimed)
			allClaimed = allClaimed and quest.claimed
		end
	end
	local bonusDone = state.quests and state.quests.bonusClaimed
	bonusClaim.Text = if bonusDone then "Done" elseif allClaimed then "Claim" else "..."
	bonusClaim.BackgroundColor3 = if allClaimed and not bonusDone then GREEN else GREY
	bonusText.TextTransparency = if bonusDone then 0.5 else 0
	claimable = claimable or (allClaimed and not bonusDone)

	local found = {}
	for id in string.gmatch(player:GetAttribute("Discovered") or "", "[^,]+") do
		found[id] = true
	end
	local rebirths = state.rebirths or 0
	for rarity, rowInfo in collectionRows do
		local have, total = 0, 0
		for _, def in Brainrots.byRarity[rarity] do
			total += 1
			if found[def.id] then
				have += 1
			end
		end
		local entry = state.collection and state.collection[rarity]
		local complete = have >= total
		local open = complete and (not entry or not entry.rewarded or entry.specialRebirth ~= rebirths)
		rowInfo.title.Text = ("%s  %d/%d"):format(rarity, have, total)
		rowInfo.claim.Text = if open then "Claim" elseif complete then "Done" else "..."
		rowInfo.claim.BackgroundColor3 = if open then GREEN else GREY
		claimable = claimable or open
	end

	questButton.Text = if claimable then "Quests (!)" else "Quests"
end

local function formatTime(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	return ("%d:%02d:%02d"):format(seconds // 3600, (seconds // 60) % 60, seconds % 60)
end

for _, name in { "QuestState", "Discovered", "Income" } do
	player:GetAttributeChangedSignal(name):Connect(refresh)
end
refresh()

task.spawn(function()
	while gui.Parent do
		local untilReset = 86400 - (os.time() % 86400)
		resetLabel.Text = "New quests in " .. formatTime(untilReset)
		task.wait(1)
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="54">
          <Properties>
            <string name="Name">Radar</string>
            <string name="Source"><![CDATA[-- The radar in the bottom right corner.
--
-- * Egg dots for every zone you have unlocked, as far as your tracker's range
--   reaches. The nearest egg out of range shows as a pip on the edge, so you
--   always know where to go.
-- * Golden eggs from tracker level 3, treasure chests from level 5.
-- * A house for your haveli and a dot for the Chowk.
-- * The countdown of the egg you are carrying, hazard warnings and egg rushes.
-- * A big title when you walk into a zone or a bazaar sector.
--
-- The radar turns with the camera: straight up is the way you are looking.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Config = require(Shared:WaitForChild("Config"))
local Biomes = require(Shared:WaitForChild("Biomes"))
local Ui = require(script.Parent:WaitForChild("Ui"))

local rgb, create, label = Ui.rgb, Ui.create, Ui.label
local player = Players.LocalPlayer
local gui = player:WaitForChild("PlayerGui"):WaitForChild("ChaiChaosHud")

local SIZE = 190
local RADIUS = SIZE / 2 - 8
local GOLD = rgb(255, 205, 50)
local HOME = rgb(255, 120, 60)

---------------------------------------------------------------------------
-- Layout
---------------------------------------------------------------------------
local holder = create("Frame", {
	Name = "RadarHolder",
	AnchorPoint = Vector2.new(1, 1),
	Position = UDim2.new(1, -12, 1, -12),
	Size = UDim2.fromOffset(SIZE, SIZE + 46),
	BackgroundTransparency = 1,
	Parent = gui,
})
local radar = create("Frame", {
	Name = "Radar",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.fromScale(0.5, 1),
	Size = UDim2.fromOffset(SIZE, SIZE),
	BackgroundColor3 = rgb(25, 45, 35),
	BackgroundTransparency = 0.15,
	Parent = holder,
}, {
	create("UICorner", { CornerRadius = UDim.new(1, 0) }),
	create("UIStroke", { Thickness = 3, Color = rgb(120, 230, 150), ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
})
for _, ring in { 0.33, 0.66 } do
	create("Frame", {
		Name = "Ring",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(ring, ring),
		BackgroundTransparency = 1,
		Parent = radar,
	}, {
		create("UICorner", { CornerRadius = UDim.new(1, 0) }),
		create("UIStroke", { Thickness = 1, Color = rgb(90, 170, 110), Transparency = 0.4 }),
	})
end
local dots = create("Frame", {
	Name = "Dots",
	Size = UDim2.fromScale(1, 1),
	BackgroundTransparency = 1,
	Parent = radar,
})
label({
	Name = "You",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(18, 18),
	Text = "▲",
	ZIndex = 3,
	Parent = radar,
})
local levelLabel = label({
	Name = "Level",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 6),
	Size = UDim2.fromOffset(120, 16),
	TextColor3 = rgb(160, 255, 180),
	ZIndex = 3,
	Parent = radar,
})
local areaLabel = label({
	Name = "Area",
	Position = UDim2.fromOffset(0, 0),
	Size = UDim2.new(1, 0, 0, 20),
	Parent = holder,
})
local tracksLabel = label({
	Name = "Tracks",
	Position = UDim2.fromOffset(0, 22),
	Size = UDim2.new(1, 0, 0, 16),
	TextColor3 = rgb(200, 230, 210),
	Parent = holder,
})

-- carried egg, hazard and egg rush, stacked above the radar
local status = create("Frame", {
	Name = "RadarStatus",
	AnchorPoint = Vector2.new(1, 1),
	Position = UDim2.new(1, -12, 1, -(SIZE + 64)),
	Size = UDim2.fromOffset(260, 0),
	AutomaticSize = Enum.AutomaticSize.Y,
	BackgroundTransparency = 1,
	Parent = gui,
}, {
	create("UIListLayout", {
		Padding = UDim.new(0, 4),
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		SortOrder = Enum.SortOrder.LayoutOrder,
	}),
})
local rushLabel = label({
	Name = "Rush",
	Size = UDim2.new(1, 0, 0, 26),
	BackgroundColor3 = rgb(200, 60, 160),
	BackgroundTransparency = 0.1,
	LayoutOrder = 1,
	Visible = false,
	Parent = status,
})
Ui.corner(8).Parent = rushLabel
local hazardLabel = label({
	Name = "Hazard",
	Size = UDim2.new(1, 0, 0, 24),
	BackgroundColor3 = rgb(190, 70, 40),
	BackgroundTransparency = 0.1,
	LayoutOrder = 2,
	Visible = false,
	Parent = status,
})
Ui.corner(8).Parent = hazardLabel
local eggBar = create("Frame", {
	Name = "EggBar",
	Size = UDim2.new(1, 0, 0, 30),
	BackgroundColor3 = rgb(40, 30, 25),
	BackgroundTransparency = 0.1,
	LayoutOrder = 3,
	Visible = false,
	Parent = status,
}, { Ui.corner(8) })
local eggFill = create("Frame", {
	Name = "Fill",
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = rgb(70, 200, 90),
	Parent = eggBar,
}, { Ui.corner(8) })
local eggText = label({
	Name = "Text",
	Size = UDim2.new(1, -10, 1, -4),
	Position = UDim2.fromOffset(5, 2),
	ZIndex = 2,
	Parent = eggBar,
})

-- the big title when you walk into a biome
local areaTitle = label({
	Name = "AreaTitle",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.fromScale(0.5, 0.2),
	Size = UDim2.new(0.8, 0, 0, 54),
	TextTransparency = 1,
	Parent = gui,
})
local areaBlurb = label({
	Name = "AreaBlurb",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0.2, 56),
	Size = UDim2.new(0.8, 0, 0, 26),
	TextColor3 = rgb(255, 240, 200),
	TextTransparency = 1,
	Parent = gui,
})
for _, item in { areaTitle, areaBlurb, rushLabel, hazardLabel, eggText } do
	create("UISizeConstraint", { MaxSize = Vector2.new(640, 60) }).Parent = item
end

---------------------------------------------------------------------------
-- Dots
---------------------------------------------------------------------------
local pool: { Frame } = {}
local used = 0

local function dot(x: number, y: number, size: number, color: Color3, text: string?): Frame
	used += 1
	local d = pool[used]
	if not d then
		d = create("Frame", {
			Name = "Dot",
			AnchorPoint = Vector2.new(0.5, 0.5),
			BorderSizePixel = 0,
			ZIndex = 2,
			Parent = dots,
		}, {
			create("UICorner", { CornerRadius = UDim.new(1, 0) }),
			label({ Name = "Icon", Size = UDim2.fromScale(1, 1), ZIndex = 3 }),
		})
		pool[used] = d
	end
	d.Visible = true
	d.Position = UDim2.new(0.5, x, 0.5, y)
	d.Size = UDim2.fromOffset(size, size)
	d.BackgroundColor3 = color
	local icon = d:FindFirstChild("Icon") :: TextLabel
	icon.Text = text or ""
	return d
end

-- Where a world position goes on the radar, and whether it fits inside.
local function project(me: Vector3, look: Vector3, right: Vector3, position: Vector3, range: number)
	local offset = position - me
	local x = (offset.X * right.X + offset.Z * right.Z) / range * RADIUS
	local y = -(offset.X * look.X + offset.Z * look.Z) / range * RADIUS
	local distance = math.sqrt(x * x + y * y)
	if distance > RADIUS then
		return x / distance * RADIUS, y / distance * RADIUS, false
	end
	return x, y, true
end

local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return if f.Magnitude > 1e-3 then f.Unit else Vector3.new(0, 0, -1)
end

local function trackerLevel(): number
	return math.clamp(player:GetAttribute("TrackerLevel") or 1, 1, #Config.TRACKER_LEVELS)
end

local openZones: { [string]: boolean } = {}
local function refreshOpen()
	openZones = Biomes.decode(player:GetAttribute("OpenZones") or "")
end
player:GetAttributeChangedSignal("OpenZones"):Connect(refreshOpen)
refreshOpen()

local function isTracked(biome, _level: number): boolean
	return biome ~= nil and openZones[biome.id] == true
end

local function eggShown(model: Instance, level: number, info): (boolean, any, boolean)
	if not model:IsA("Model") then
		return false, nil, false
	end
	local shell = model.PrimaryPart
	if not shell or not shell.Anchored then
		return false, nil, false -- being carried
	end
	local biome = Biomes.byId[model:GetAttribute("Biome") or ""]
	local golden = model:GetAttribute("Golden") == true
	if not isTracked(biome, level) or (golden and not info.golden) then
		return false, biome, golden
	end
	return true, biome, golden
end

local function refreshDots()
	for i = 1, used do
		pool[i].Visible = false
	end
	used = 0
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return
	end
	local camera = workspace.CurrentCamera
	local look = flat(camera.CFrame.LookVector)
	local right = Vector3.new(-look.Z, 0, look.X)
	local me = root.Position
	local level = trackerLevel()
	local info = Config.TRACKER_LEVELS[level]
	local range = info.range

	-- treasure first so eggs draw on top
	local treasure = workspace:FindFirstChild("ChaiChaosTreasure")
	if info.treasure and treasure then
		for _, chest in treasure:GetChildren() do
			if chest:IsA("Model") then
				local x, y, inside = project(me, look, right, chest:GetPivot().Position, range)
				if inside then
					dot(x, y, 10, rgb(140, 85, 40), "$")
				end
			end
		end
	end

	local eggs = workspace:FindFirstChild("ChaiChaosEggs")
	local nearest, nearestDistance = nil, math.huge
	local eggDots = 0
	if eggs then
		for _, model in eggs:GetChildren() do
			local shown, biome, golden = eggShown(model, level, info)
			if shown then
				local position = (model :: Model):GetPivot().Position
				local x, y, inside = project(me, look, right, position, range)
				if inside then
					eggDots += 1
					dot(x, y, if golden then 12 else 8, if golden then GOLD else biome.eggColor)
				else
					local distance = (position - me).Magnitude
					if distance < nearestDistance then
						nearest, nearestDistance = position, distance
					end
				end
			end
		end
	end
	if nearest and eggDots == 0 then
		-- no egg in range: a pip on the edge points to the nearest one
		local x, y = project(me, look, right, nearest, range)
		dot(x, y, 10, rgb(255, 255, 255), "•")
	end

	local chowkX, chowkY = project(me, look, right, Vector3.zero, range)
	dot(chowkX, chowkY, 10, rgb(255, 215, 90), "C")
	local home = player:GetAttribute("HomePosition")
	if typeof(home) == "Vector3" then
		local x, y = project(me, look, right, home, range)
		dot(x, y, 16, HOME, "H")
	end
end

---------------------------------------------------------------------------
-- Labels
---------------------------------------------------------------------------
local shownArea: string? = nil

local function showAreaTitle(title: string, blurb: string, color: Color3)
	areaTitle.Text = title
	areaTitle.TextColor3 = color
	areaBlurb.Text = blurb
	areaTitle.TextTransparency = 0
	areaBlurb.TextTransparency = 0
	task.delay(3, function()
		if areaTitle.Text == title then
			TweenService:Create(areaTitle, TweenInfo.new(0.8), { TextTransparency = 1 }):Play()
			TweenService:Create(areaBlurb, TweenInfo.new(0.8), { TextTransparency = 1 }):Play()
		end
	end)
end

local function refreshLabels()
	local level = trackerLevel()
	local info = Config.TRACKER_LEVELS[level]
	levelLabel.Text = ("Radar Lv %d"):format(level)
	local count = 0
	for _ in openZones do
		count += 1
	end
	tracksLabel.Text = ("Tracks: %d open zone%s"):format(count, if count == 1 then "" else "s")
		.. (if info.golden then " + golden eggs" else "")
		.. (if info.treasure then " + treasure" else "")

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local position = if root and root:IsA("BasePart") then root.Position else nil
	local biome = if position then Biomes.at(position) else nil
	local sector = if position then Biomes.townSectorAt(position) else nil
	local area
	if biome then
		local tracked = isTracked(biome, level)
		area = biome.name .. (if tracked then "" else " (locked)")
		areaLabel.TextColor3 = biome.color
	elseif sector then
		area = sector.name
		areaLabel.TextColor3 = Ui.GOLD
	else
		area = "Chowk"
		areaLabel.TextColor3 = Ui.GOLD
	end
	areaLabel.Text = area
	local areaId = if biome then biome.id else area
	if areaId ~= shownArea then
		shownArea = areaId
		if biome then
			showAreaTitle(("%s · %s"):format(biome.name:upper(), biome.title), biome.blurb, biome.color)
		elseif sector then
			showAreaTitle(sector.name:upper(), "Lahore bazaar", Ui.GOLD)
		end
	end

	-- the egg you are carrying
	local eggBiome = Biomes.byId[player:GetAttribute("EggBiome") or ""]
	local total = player:GetAttribute("EggTimeTotal") or 0
	if eggBiome and total > 0 then
		local left = math.max(0, player:GetAttribute("EggTimeLeft") or 0)
		local share = math.clamp(left / total, 0, 1)
		eggBar.Visible = true
		eggFill.Size = UDim2.fromScale(share, 1)
		eggFill.BackgroundColor3 = if share > 0.5
			then rgb(70, 200, 90)
			elseif share > 0.25 then rgb(240, 190, 40)
			else rgb(220, 60, 50)
		local golden = player:GetAttribute("EggGolden") == true
		local carried = player:GetAttribute("EggCount") or 1
		eggText.Text = ("%s%s: %ds  ·  %s"):format(
			if golden then "Golden egg" else eggBiome.name .. " egg",
			if carried > 1 then (" (+%d more)"):format(carried - 1) else "",
			math.ceil(left),
			if share > 0.25 then "Take it home!" else "HURRY!"
		)
	else
		eggBar.Visible = false
	end

	local hazard = player:GetAttribute("Hazard") or ""
	hazardLabel.Visible = hazard ~= ""
	hazardLabel.Text = hazard

	local rush = Biomes.byId[workspace:GetAttribute("EggRush") or ""]
	rushLabel.Visible = rush ~= nil
	if rush then
		local left = math.max(0, (workspace:GetAttribute("EggRushEndsAt") or 0) - workspace:GetServerTimeNow())
		rushLabel.Text = ("EGG RUSH in %s! %d:%02d"):format(rush.name, left // 60, math.floor(left % 60))
	end
end

task.spawn(function()
	while gui.Parent do
		refreshLabels()
		refreshDots()
		task.wait(0.1)
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="55">
          <Properties>
            <string name="Name">Shops</string>
            <string name="Source"><![CDATA[-- The Chowk's shops and the Brainrots window.
--
-- Walk up to a stall in the Chowk and press E to open its window:
--   BECHO (Sell)  : the Brainrots window, where you can sell
--   GEAR SHOP     : speed, egg, treasure and hazard gear
--   RADAR WALA    : tracker upgrades
--   NAYA SAFAR    : rebirth
--   KISMAT KETTLE : the Kismat Roll window
--   QUESTS board  : the Quests window
-- The Brainrots button opens the Brainrots window anywhere.
-- (The Gaari Showroom, Ustad's Workshop and your Garage are in Garage.client.luau.)
-- The server checks that you are at the right stall before anything happens.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Config = require(Shared:WaitForChild("Config"))
local Brainrots = require(Shared:WaitForChild("Brainrots"))
local Biomes = require(Shared:WaitForChild("Biomes"))
local Format = require(Shared:WaitForChild("Format"))
local Gear = require(Shared:WaitForChild("Gear"))
local Mutations = require(Shared:WaitForChild("Mutations"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Themes = require(Shared:WaitForChild("Themes"))
local Ui = require(script.Parent:WaitForChild("Ui"))

local rgb, create, label = Ui.rgb, Ui.create, Ui.label
local player = Players.LocalPlayer
local gui = player:WaitForChild("PlayerGui"):WaitForChild("ChaiChaosHud")
local buttons = gui:WaitForChild("Buttons")
local rupeesValue = player:WaitForChild("leaderstats"):WaitForChild("Rupees") :: IntValue
local rebirthsValue = player:WaitForChild("leaderstats"):WaitForChild("Rebirths") :: IntValue

local ROW = rgb(60, 45, 35)
local GREEN = rgb(30, 140, 80)
local GREY = rgb(110, 105, 100)
local BLUE = rgb(50, 120, 200)
local RED = rgb(190, 70, 50)

local function attribute(name: string, default: any): any
	local value = player:GetAttribute(name)
	if value == nil then
		return default
	end
	return value
end

-- A list row: a dark box with a title line, a small text line and a button on the right.
local function row(parent: Instance, name: string, order: number, height: number?)
	local frame = create("Frame", {
		Name = name,
		Size = UDim2.new(1, -8, 0, height or 62),
		BackgroundColor3 = ROW,
		LayoutOrder = order,
		Parent = parent,
	}, { Ui.corner(10) })
	local title = label({
		Name = "Title",
		Position = UDim2.fromOffset(10, 4),
		Size = UDim2.new(1, -150, 0, 28),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})
	local text = label({
		Name = "Text",
		Position = UDim2.fromOffset(10, 32),
		Size = UDim2.new(1, -150, 0, 22),
		TextColor3 = rgb(255, 230, 170),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})
	local button = Ui.textButton({
		Name = "Button",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(130, 40),
		BackgroundColor3 = GREEN,
		Parent = frame,
	})
	return frame, title, text, button
end

local function info(parent: Instance, name: string, order: number, height: number, color: Color3?): TextLabel
	return label({
		Name = name,
		Size = UDim2.new(1, -8, 0, height),
		TextColor3 = color or rgb(90, 55, 30),
		TextWrapped = true,
		LayoutOrder = order,
		Parent = parent,
	})
end

-- the stall parts in the Chowk, to know whether we are standing at one
local stalls: { [string]: BasePart } = {}
local function shopPart(shop: string): BasePart?
	local known = stalls[shop]
	if known and known.Parent then
		return known
	end
	local map = workspace:FindFirstChild("ChaiChaosMap")
	if not map then
		return nil
	end
	for _, d in map:GetDescendants() do
		if d:IsA("BasePart") and type(d:GetAttribute("Shop")) == "string" then
			stalls[d:GetAttribute("Shop")] = d
		end
	end
	return stalls[shop]
end

local function isNear(shop: string, distance: number): boolean
	local part = shopPart(shop)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return part ~= nil
		and root ~= nil
		and root:IsA("BasePart")
		and (root.Position - part.Position).Magnitude <= distance
end

---------------------------------------------------------------------------
-- Gear shop
---------------------------------------------------------------------------
local gearPanel, gearContent = Ui.panel(gui, "GearPanel", "Gear Shop", Vector2.new(480, 580))
info(gearContent, "Intro", 0, 40, nil).Text = "Gear is yours forever, even after a Naya Safar. It works by itself!"
local KIND_TEXT = { speed = "Speed", egg = "Egg care", treasure = "Treasure", hazard = "Hazard" }
local gearRows = {}
for i, item in Gear.list do
	local _, title, text, button = row(gearContent, item.id, i)
	title.Text = ("%s  ·  %s"):format(item.name, KIND_TEXT[item.kind] or item.kind)
	text.Text = item.text
	button.Activated:Connect(function()
		Remotes.BuyGear:FireServer(item.id)
	end)
	gearRows[item.id] = { item = item, button = button }
end

local function refreshGear()
	local owned = Gear.decode(attribute("Gear", ""))
	for id, r in gearRows do
		if owned[id] then
			r.button.Text = "Owned"
			r.button.BackgroundColor3 = GREY
		else
			r.button.Text = Format.rupees(r.item.cost)
			r.button.BackgroundColor3 = if rupeesValue.Value >= r.item.cost then GREEN else GREY
		end
	end
end

---------------------------------------------------------------------------
-- Radar Wala (tracker)
---------------------------------------------------------------------------
local trackerPanel, trackerContent = Ui.panel(gui, "TrackerPanel", "Radar Wala", Vector2.new(480, 580))
local trackerNow = info(trackerContent, "Now", 1, 50, nil)
local trackerNext = info(trackerContent, "Next", 2, 50, rgb(40, 110, 60))
local trackerButton = Ui.textButton({
	Name = "Upgrade",
	Size = UDim2.new(1, -8, 0, 46),
	BackgroundColor3 = GREEN,
	LayoutOrder = 3,
	Parent = trackerContent,
})
trackerButton.Activated:Connect(function()
	Remotes.UpgradeTracker:FireServer()
end)

local function levelText(level: number): string
	local t = Config.TRACKER_LEVELS[level]
	local extras = {}
	if t.golden then
		table.insert(extras, "golden eggs")
	end
	if t.treasure then
		table.insert(extras, "treasure")
	end
	return ("Finds eggs %d studs away%s"):format(
		t.range,
		if #extras > 0 then " · shows " .. table.concat(extras, " and ") else ""
	)
end

local trackerRows = {}
for level, t in Config.TRACKER_LEVELS do
	local _, title, text, button = row(trackerContent, "Level" .. level, 10 + level, 58)
	title.Text = ("Level %d"):format(level)
	text.Text = levelText(level)
	button.Text = if t.cost > 0 then Format.rupees(t.cost) else "Free"
	button.AutoButtonColor = false
	trackerRows[level] = button
end

local function refreshTracker()
	local level = attribute("TrackerLevel", 1)
	local open = Biomes.decode(attribute("OpenZones", ""))
	local count = 0
	for _ in open do
		count += 1
	end
	trackerNow.Text = ("Your radar: Level %d. It tracks eggs in your %d open zone%s."):format(
		level,
		count,
		if count == 1 then "" else "s"
	)
	local nextLevel = Config.TRACKER_LEVELS[level + 1]
	if nextLevel then
		trackerNext.Text = ("Next: %s"):format(levelText(level + 1))
		trackerButton.Text = "Upgrade for " .. Format.rupees(nextLevel.cost)
		trackerButton.BackgroundColor3 = if rupeesValue.Value >= nextLevel.cost then GREEN else GREY
	else
		trackerNext.Text = "Your radar finds everything. Kamaal!"
		trackerButton.Text = "Max level!"
		trackerButton.BackgroundColor3 = GREY
	end
	for i, button in trackerRows do
		button.BackgroundColor3 = if i <= level then GREEN elseif i == level + 1 then BLUE else GREY
		button.Text = if i <= level
			then "Have it"
			else (if Config.TRACKER_LEVELS[i].cost > 0
				then Format.rupees(Config.TRACKER_LEVELS[i].cost)
				else "Free")
	end
end

---------------------------------------------------------------------------
-- Brainrots (see them all, and sell at the BECHO stall)
---------------------------------------------------------------------------
local brainrotButton = Ui.sideButton(buttons, "Brainrots", "Brainrots", rgb(220, 90, 140), 6)
local brainrotPanel, brainrotContent = Ui.panel(gui, "BrainrotPanel", "Meri Brainrots", Vector2.new(500, 600))
local sellInfo = info(brainrotContent, "SellInfo", 3, 40, nil)

local brainrotRows: { Frame } = {}
local NEAR_SELL = Config.SELL_DISTANCE - 2

local function parseOwned()
	local list = {}
	for item in string.gmatch(attribute("Owned", ""), "[^,]+") do
		local uid, key, carried = item:match("^(%d+)|([^|]+)|(%d)$")
		if uid then
			local id, mutation = Mutations.parse(key)
			local def = Brainrots.byId[id]
			if def then
				table.insert(list, { uid = tonumber(uid), def = def, mutation = mutation, carried = carried == "1" })
			end
		end
	end
	table.sort(list, function(a, b)
		local av, bv = Mutations.value(a.def, a.mutation), Mutations.value(b.def, b.mutation)
		if av ~= bv then
			return av > bv
		end
		return a.uid < b.uid
	end)
	return list
end

local function refreshBrainrots()
	local nearSell = isNear("Sell", NEAR_SELL)
	sellInfo.Text = if nearSell
		then "You are at the BECHO stall: sell for half the value."
		else "To sell, come to the BECHO stall in the Chowk."

	for _, frame in brainrotRows do
		frame:Destroy()
	end
	table.clear(brainrotRows)
	for i, item in parseOwned() do
		local def, mutation = item.def, item.mutation
		local frame, title, text, stealButton = row(brainrotContent, "Brainrot" .. i, 10 + i, 62)
		stealButton:Destroy()
		title.Text = Mutations.displayName(def, mutation)
		title.TextColor3 = if mutation then Mutations.byId[mutation].color else Brainrots.RARITY_COLORS[def.rarity]
		text.Text = ("%s · +%s/s · worth %s"):format(
			def.rarity,
			Format.short(Mutations.income(def, mutation)),
			Format.short(Mutations.value(def, mutation))
		)
		if nearSell and not def.questOnly then
			local sell = Ui.textButton({
				Name = "Sell",
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -8, 0.5, 0),
				Size = UDim2.fromOffset(64, 40),
				BackgroundColor3 = if item.carried then GREY else RED,
				Text = Format.short(math.floor(Mutations.value(def, mutation) * Config.SELL_RATE)),
				Parent = frame,
			})
			sell.Activated:Connect(function()
				if not item.carried then
					Remotes.SellBrainrot:FireServer(item.uid)
				end
			end)
		end
		table.insert(brainrotRows, frame)
	end
	if #brainrotRows == 0 then
		local empty = info(brainrotContent, "Empty", 10, 40, nil)
		empty.Text = "No brainrots yet! Bring eggs home from the zones to hatch some."
		table.insert(brainrotRows, empty :: any)
	end
end

brainrotButton.Activated:Connect(function()
	if not brainrotPanel.Visible then
		refreshBrainrots()
	end
	Ui.toggle(brainrotPanel)
end)

---------------------------------------------------------------------------
-- Naya Safar (rebirth)
---------------------------------------------------------------------------
local rebirthPanel, rebirthContent = Ui.panel(gui, "RebirthPanel", "Naya Safar", Vector2.new(480, 560))
local rebirthCost = info(rebirthContent, "Cost", 1, 50, nil)
local rebirthBonus = info(rebirthContent, "Bonus", 2, 40, rgb(40, 110, 60))
info(rebirthContent, "Resets", 3, 56, rgb(150, 60, 40)).Text =
	"Starts over: rupees, haveli level, radar level, brainrots and eggs."
info(rebirthContent, "Keeps", 4, 56, rgb(40, 90, 150)).Text =
	"You keep: gear, vehicles, unlocked zones, haveli themes, the Collection Book, Kismat Rolls and Chor Passes."
local rebirthTheme = info(rebirthContent, "Theme", 5, 40, rgb(130, 50, 160))
local rebirthButton = Ui.textButton({
	Name = "Rebirth",
	Size = UDim2.new(1, -8, 0, 50),
	BackgroundColor3 = rgb(150, 70, 205),
	LayoutOrder = 6,
	Parent = rebirthContent,
})

local confirmUntil = 0
local function refreshRebirth()
	local cost = attribute("RebirthCost", Config.REBIRTH_COST)
	local rebirths = rebirthsValue.Value
	rebirthCost.Text = ("Naya Safar %d costs %s. You have %s."):format(
		rebirths + 1,
		Format.rupees(cost),
		Format.rupees(rupeesValue.Value)
	)
	rebirthBonus.Text = ("Income bonus: +%d%% now, +%d%% after."):format(
		math.floor(Config.REBIRTH_BONUS * rebirths * 100 + 0.5),
		math.floor(Config.REBIRTH_BONUS * (rebirths + 1) * 100 + 0.5)
	)
	local unlock = nil
	for _, theme in Themes.list do
		if theme.rebirths == rebirths + 1 then
			unlock = theme
		end
	end
	local zone = nil
	for _, biome in Biomes.list do
		if biome.rebirths == rebirths + 1 then
			zone = biome
		end
	end
	local texts = {}
	if zone then
		table.insert(texts, ("Opens the gate to %s!"):format(zone.name))
	end
	if unlock then
		table.insert(texts, ("Unlocks the %s haveli theme: %s"):format(unlock.name, unlock.perkText))
	end
	rebirthTheme.Text = if #texts > 0
		then table.concat(texts, " ")
		else "Every Naya Safar makes you earn more, forever."
	if os.clock() >= confirmUntil then
		rebirthButton.Text = if rupeesValue.Value >= cost then "Start Naya Safar!" else "Not enough rupees yet"
	end
	rebirthButton.BackgroundColor3 = if rupeesValue.Value >= cost then rgb(150, 70, 205) else GREY
end

rebirthButton.Activated:Connect(function()
	if rupeesValue.Value < attribute("RebirthCost", Config.REBIRTH_COST) then
		return
	end
	if os.clock() < confirmUntil then
		confirmUntil = 0
		Remotes.Rebirth:FireServer()
		rebirthPanel.Visible = false
	else
		confirmUntil = os.clock() + 4
		rebirthButton.Text = "Sure? Tap again"
		task.delay(4.1, refreshRebirth)
	end
end)

---------------------------------------------------------------------------
-- Opening windows from the stalls
---------------------------------------------------------------------------
local OPEN = {
	Gear = function()
		refreshGear()
		Ui.open(gearPanel)
	end,
	Tracker = function()
		refreshTracker()
		Ui.open(trackerPanel)
	end,
	Sell = function()
		refreshBrainrots()
		Ui.open(brainrotPanel)
	end,
	Rebirth = function()
		refreshRebirth()
		Ui.open(rebirthPanel)
	end,
	Kismat = function()
		local panel = gui:FindFirstChild("KismatPanel")
		if panel then
			Ui.open(panel)
		end
	end,
	Quests = function()
		local panel = gui:FindFirstChild("QuestPanel")
		if panel then
			Ui.open(panel)
		end
	end,
}

ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, who: Player)
	if who ~= player or prompt.Name ~= "ShopPrompt" then
		return
	end
	local open = OPEN[prompt:GetAttribute("Shop") or ""]
	if open then
		open()
	end
end)

for _, name in { "Gear", "TrackerLevel" } do
	player:GetAttributeChangedSignal(name):Connect(function()
		refreshGear()
		refreshTracker()
	end)
end
player:GetAttributeChangedSignal("Owned"):Connect(function()
	if brainrotPanel.Visible then
		refreshBrainrots()
	end
end)
player:GetAttributeChangedSignal("OpenZones"):Connect(refreshTracker)
rupeesValue.Changed:Connect(function()
	refreshGear()
	refreshTracker()
	if rebirthPanel.Visible then
		refreshRebirth()
	end
end)
refreshGear()
refreshTracker()
refreshRebirth()

-- the Sell buttons appear and disappear as you walk to and from the stall
task.spawn(function()
	local wasNear = false
	while gui.Parent do
		if brainrotPanel.Visible then
			local near = isNear("Sell", NEAR_SELL)
			if near ~= wasNear then
				wasNear = near
				refreshBrainrots()
			end
		end
		task.wait(0.5)
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="56">
          <Properties>
            <string name="Name">Smooth</string>
            <string name="Source"><![CDATA[-- Makes brainrots move smoothly on this player's screen.
--
-- Walking brainrots are animated every frame from the attributes the server
-- sets (MoveFrom, MoveTo, MoveStart, MoveSpeed), with a little hop. Brainrots
-- standing on a plot gently bob and sway. Rainbow brainrots change colour.
-- None of this changes anything for other players or the server.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Motion = require(Shared:WaitForChild("Motion"))

local IDLE_DISTANCE = 90 -- only animate idle brainrots this close to the camera (they have ~40 parts each)
local TAG = "ChaiBrainrot"

local tracked: { [Model]: { phase: number, tinted: { BasePart }? } } = {}

local function add(instance: Instance)
	if not instance:IsA("Model") then
		return
	end
	local info = { phase = math.random() * math.pi * 2, tinted = nil }
	tracked[instance] = info
	if instance:GetAttribute("Mutation") == "Rainbow" then
		local parts = {}
		for _, p in instance:GetDescendants() do
			if p:IsA("BasePart") and p:GetAttribute("Tint") then
				table.insert(parts, p)
			end
		end
		info.tinted = parts
	end
end

CollectionService:GetInstanceAddedSignal(TAG):Connect(add)
CollectionService:GetInstanceRemovedSignal(TAG):Connect(function(instance)
	tracked[instance :: Model] = nil
end)
for _, instance in CollectionService:GetTagged(TAG) do
	add(instance)
end

local frame = 0
RunService.RenderStepped:Connect(function()
	frame += 1
	local t = os.clock()
	local serverNow = workspace:GetServerTimeNow()
	local camera = workspace.CurrentCamera
	local cameraPosition = if camera then camera.CFrame.Position else Vector3.zero
	local idleFrame = frame % 2 == 0 -- idle animation at half rate is plenty

	for model, info in tracked do
		if model.Parent == nil or not model.PrimaryPart or model:GetAttribute("Carried") then
			continue
		end
		local speed = model:GetAttribute("MoveSpeed")
		local from, to, started =
			model:GetAttribute("MoveFrom"), model:GetAttribute("MoveTo"), model:GetAttribute("MoveStart")
		if
			type(speed) == "number"
			and speed > 0
			and typeof(from) == "CFrame"
			and typeof(to) == "CFrame"
			and type(started) == "number"
		then
			local cf, arrived = Motion.at(from, to, started, speed, serverNow)
			local hop = if arrived then 0 else math.abs(math.sin(t * 8 + info.phase)) * 0.6
			model:PivotTo(cf + Vector3.new(0, hop, 0))
		elseif idleFrame then
			local restCF = model:GetAttribute("Rest")
			if typeof(restCF) == "CFrame" and (restCF.Position - cameraPosition).Magnitude < IDLE_DISTANCE then
				local bob = (math.sin(t * 2 + info.phase) + 1) * 0.15
				local sway = math.sin(t * 1.3 + info.phase) * 0.08
				model:PivotTo(restCF * CFrame.new(0, bob, 0) * CFrame.Angles(0, sway, 0))
			end
		end
		if info.tinted and idleFrame then
			local color = Color3.fromHSV((t * 0.25 + info.phase) % 1, 0.65, 1)
			for _, p in info.tinted do
				p.Color = color
			end
		end
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">SoundPlayer</string>
            <string name="Source"><![CDATA[-- Plays the sounds from Sounds.luau on this player's screen.
--
-- One Sound instance per name lives in SoundService. A sound with a position
-- (an egg hatching, a treasure chest) gets quieter the further away it is.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Sounds = require(Shared:WaitForChild("Sounds"))

local SoundPlayer = {}

local HEARING_RANGE = 120 -- studs; further away than this a positioned sound is silent

local folder = Instance.new("Folder")
folder.Name = "ChaiChaosSounds"
folder.Parent = SoundService

local made: { [string]: Sound } = {}

-- The Sound for a name, or nil if the name is unknown or has no id yet.
function SoundPlayer.get(name: string): Sound?
	local info = Sounds.list[name]
	if not info or info.id == "" then
		return nil
	end
	local sound = made[name]
	if not sound then
		local created = Instance.new("Sound")
		created.Name = name
		created.SoundId = info.id
		created.Volume = info.volume
		created.PlaybackSpeed = info.pitch or 1
		created.Looped = info.looped == true
		created.Parent = folder
		made[name] = created
		sound = created
	end
	return sound
end

local function distanceVolume(position: Vector3?): number
	if not position then
		return 1
	end
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return 1
	end
	local distance = (root.Position - position).Magnitude
	return math.clamp(1 - distance / HEARING_RANGE, 0, 1)
end

function SoundPlayer.play(name: string, position: Vector3?)
	local sound = SoundPlayer.get(name)
	if not sound then
		return
	end
	local fade = distanceVolume(position)
	if fade <= 0 then
		return
	end
	sound.Volume = Sounds.list[name].volume * fade
	sound.TimePosition = 0
	sound:Play()
end

-- Starts or stops a looping sound (wind, music).
function SoundPlayer.loop(name: string, on: boolean)
	local sound = SoundPlayer.get(name)
	if not sound then
		return
	end
	if on and not sound.IsPlaying then
		sound:Play()
	elseif not on and sound.IsPlaying then
		sound:Stop()
	end
end

return SoundPlayer
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="58">
          <Properties>
            <string name="Name">Sounds</string>
            <string name="Source"><![CDATA[-- Sounds on this player's screen:
-- * sounds the server asks for (eggs, coins, bonks, treasure...)
-- * a click for every button in the HUD
-- * music for where you are (bazaar, biomes, events) once you add music ids
--   to Sounds.luau, and wind up in the mountains and the desert

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Remotes = require(Shared:WaitForChild("Remotes"))
local Biomes = require(Shared:WaitForChild("Biomes"))
local Events = require(Shared:WaitForChild("Events"))
local SoundPlayer = require(script.Parent:WaitForChild("SoundPlayer"))

local player = Players.LocalPlayer
local gui = player:WaitForChild("PlayerGui"):WaitForChild("ChaiChaosHud")

Remotes.PlaySound.OnClientEvent:Connect(function(name: any, position: any)
	if type(name) == "string" then
		SoundPlayer.play(name, if typeof(position) == "Vector3" then position else nil)
	end
end)

-- a click for every HUD button, including ones made later
local function hook(instance: Instance)
	if instance:IsA("GuiButton") then
		instance.Activated:Connect(function()
			SoundPlayer.play("Click")
		end)
	end
end
gui.DescendantAdded:Connect(hook)
for _, descendant in gui:GetDescendants() do
	hook(descendant)
end

local function update()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local biome = if root and root:IsA("BasePart") then Biomes.at(root.Position) else nil
	local music = if Events.current() then "MusicEvent" elseif biome then "MusicBiome" else "MusicBazaar"
	for _, name in { "MusicBazaar", "MusicBiome", "MusicEvent" } do
		SoundPlayer.loop(name, name == music)
	end
	-- windy in the snowy mountains, and in the desert during a sandstorm
	local windy = biome ~= nil
		and (
			table.find(biome.hazards, "snowballs") ~= nil
			or (table.find(biome.hazards, "sandstorm") ~= nil and workspace:GetAttribute("Sandstorm") == true)
		)
	SoundPlayer.loop("Wind", windy)
end

task.spawn(function()
	while gui.Parent do
		update()
		task.wait(1)
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">Ui</string>
            <string name="Source"><![CDATA[-- Small helpers for building the HUD out of code.

local TweenService = game:GetService("TweenService")

local Ui = {}

-- Pop-up windows. Only one is open at a time and they pop in smoothly.
Ui.panels = {} :: { GuiObject }

function Ui.open(frame: GuiObject)
	for _, other in Ui.panels do
		if other ~= frame then
			other.Visible = false
		end
	end
	frame.Visible = true
	local scale = frame:FindFirstChild("Pop")
	if scale and scale:IsA("UIScale") then
		scale.Scale = 0.85
		TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end
end

function Ui.toggle(frame: GuiObject)
	if frame.Visible then
		frame.Visible = false
	else
		Ui.open(frame)
	end
end

function Ui.register(frame: GuiObject)
	if not frame:FindFirstChild("Pop") then
		local scale = Instance.new("UIScale")
		scale.Name = "Pop"
		scale.Parent = frame
	end
	table.insert(Ui.panels, frame)
end

Ui.WHITE = Color3.new(1, 1, 1)
Ui.GOLD = Color3.fromRGB(255, 215, 90)
Ui.FONT = Enum.Font.FredokaOne

function Ui.rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

function Ui.create(className: string, props: { [string]: any }, children: { Instance }?): any
	local instance = Instance.new(className)
	for name, value in props do
		if name ~= "Parent" then
			(instance :: any)[name] = value
		end
	end
	if children then
		for _, c in children do
			c.Parent = instance
		end
	end
	if props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

function Ui.corner(radius: number): UICorner
	return Ui.create("UICorner", { CornerRadius = UDim.new(0, radius) })
end

function Ui.textStroke(): UIStroke
	return Ui.create("UIStroke", { Thickness = 1.5, Color = Ui.rgb(20, 15, 10) })
end

function Ui.label(props: { [string]: any }): TextLabel
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.Font = Ui.FONT
	props.TextScaled = true
	props.TextColor3 = props.TextColor3 or Ui.WHITE
	return Ui.create("TextLabel", props, { Ui.textStroke() })
end

function Ui.textButton(props: { [string]: any }): TextButton
	props.Font = Ui.FONT
	props.TextScaled = true
	props.TextColor3 = props.TextColor3 or Ui.WHITE
	props.AutoButtonColor = true
	return Ui.create("TextButton", props, {
		Ui.corner(12),
		Ui.textStroke(),
		Ui.create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }),
	})
end

-- A button in the grid on the left of the screen.
function Ui.sideButton(parent: Instance, name: string, text: string, color: Color3, order: number): TextButton
	return Ui.textButton({
		Name = name,
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundColor3 = color,
		Text = text,
		LayoutOrder = order,
		Parent = parent,
	})
end

-- A pop-up window with a title, a close button and a scrolling list inside.
function Ui.panel(parent: Instance, name: string, title: string, maxSize: Vector2)
	local frame = Ui.create("Frame", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.9, 0.85),
		BackgroundColor3 = Ui.rgb(250, 238, 210),
		Visible = false,
		ZIndex = 5,
		Parent = parent,
	}, {
		Ui.corner(16),
		Ui.create("UISizeConstraint", { MaxSize = maxSize }),
		Ui.create(
			"UIStroke",
			{ Thickness = 3, Color = Ui.rgb(120, 70, 40), ApplyStrokeMode = Enum.ApplyStrokeMode.Border }
		),
	})
	local titleLabel = Ui.label({
		Name = "Title",
		Size = UDim2.new(1, -70, 0, 40),
		Position = UDim2.fromOffset(14, 8),
		TextColor3 = Ui.GOLD,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = title,
		Parent = frame,
	})
	local close = Ui.create("TextButton", {
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 8),
		Size = UDim2.fromOffset(40, 40),
		BackgroundColor3 = Ui.rgb(200, 60, 50),
		Font = Ui.FONT,
		TextScaled = true,
		TextColor3 = Ui.WHITE,
		Text = "X",
		Parent = frame,
	}, { Ui.corner(10) })
	close.Activated:Connect(function()
		frame.Visible = false
	end)
	Ui.register(frame)
	local content = Ui.create("ScrollingFrame", {
		Name = "Content",
		Position = UDim2.fromOffset(12, 56),
		Size = UDim2.new(1, -24, 1, -66),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = frame,
	}, {
		Ui.create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	return frame, content, titleLabel
end

return Ui
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="60">
          <Properties>
            <string name="Name">Weather</string>
            <string name="Source"><![CDATA[-- How the zones look and feel on this player's screen:
-- * Thar Desert and Mohenjo-daro: a dusty sandstorm every so often (Sand Goggles let you see)
-- * Namak Caves: dark, pink salt caves (a Lantern lights the way)
-- * Barfani Pahar: snow drifting down
-- * Sahil Beach: a splash when a big wave rolls in
-- The server decides what actually happens; this is only the look.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Biomes = require(Shared:WaitForChild("Biomes"))
local Gear = require(Shared:WaitForChild("Gear"))
local Ui = require(script.Parent:WaitForChild("Ui"))

local rgb = Ui.rgb
local player = Players.LocalPlayer

-- one tint for every biome effect, blended towards the look we want
local tint = Instance.new("ColorCorrectionEffect")
tint.Name = "ChaiChaosBiomeTint"
tint.Parent = Lighting

-- particles that follow the camera
local cloud = Instance.new("Part")
cloud.Name = "ChaiChaosWeather"
cloud.Anchored = true
cloud.CanCollide = false
cloud.CanQuery = false
cloud.CanTouch = false
cloud.Transparency = 1
cloud.Size = Vector3.new(120, 1, 120)

local function emitter(name: string, color: Color3, size: number, speed: number, rate: number): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Name = name
	e.Color = ColorSequence.new(color)
	e.Size = NumberSequence.new(size)
	e.Speed = NumberRange.new(speed, speed * 1.4)
	e.Lifetime = NumberRange.new(2, 3.5)
	e.Rate = rate
	e.Enabled = false
	e.EmissionDirection = Enum.NormalId.Bottom
	e.Transparency = NumberSequence.new(0.3)
	e.Parent = cloud
	return e
end
local snow = emitter("Snow", rgb(255, 255, 255), 0.4, 6, 220)
local sand = emitter("Sand", rgb(225, 180, 110), 0.8, 30, 500)
sand.Acceleration = Vector3.new(40, 0, 10)
local salt = emitter("Salt", rgb(255, 200, 215), 0.25, 4, 60)

-- the lantern glow, on your character in the salt caves
local glow = Instance.new("PointLight")
glow.Name = "LanternGlow"
glow.Color = rgb(255, 220, 160)
glow.Range = 28
glow.Brightness = 2.2
glow.Shadows = false

local LOOKS = {
	none = { tint = rgb(255, 255, 255), brightness = 0, saturation = 0, contrast = 0 },
	sandstorm = { tint = rgb(255, 215, 160), brightness = -0.06, saturation = -0.35, contrast = -0.15 },
	goggles = { tint = rgb(255, 235, 200), brightness = 0, saturation = -0.1, contrast = 0 },
	cave = { tint = rgb(255, 170, 200), brightness = -0.32, saturation = -0.1, contrast = 0.1 },
	lantern = { tint = rgb(255, 205, 220), brightness = -0.1, saturation = 0, contrast = 0.05 },
	snow = { tint = rgb(225, 238, 255), brightness = 0.03, saturation = -0.15, contrast = 0 },
}

local shownLook = ""
local function setLook(name: string)
	if name == shownLook then
		return
	end
	shownLook = name
	local look = LOOKS[name]
	TweenService:Create(tint, TweenInfo.new(1.2), {
		TintColor = look.tint,
		Brightness = look.brightness,
		Saturation = look.saturation,
		Contrast = look.contrast,
	}):Play()
end

local lastWave = workspace:GetAttribute("WaveAt") or 0

local function update()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local biome = if root and root:IsA("BasePart") then Biomes.at(root.Position) else nil
	local hazards = if biome then biome.hazards else {}
	local function has(hazard: string): boolean
		return table.find(hazards, hazard) ~= nil
	end
	local owned = Gear.decode(player:GetAttribute("Gear") or "")
	local storm = has("sandstorm") and workspace:GetAttribute("Sandstorm") == true
	local dark = has("dark")
	local snowy = has("snowballs")

	snow.Enabled = snowy
	sand.Enabled = storm
	sand.Rate = if owned.SandGoggles then 150 else 500
	salt.Enabled = dark
	cloud.Parent = if snow.Enabled or sand.Enabled or salt.Enabled then workspace.CurrentCamera else nil

	if storm then
		setLook(if owned.SandGoggles then "goggles" else "sandstorm")
	elseif dark then
		setLook(if owned.Lantern then "lantern" else "cave")
	elseif snowy then
		setLook("snow")
	else
		setLook("none")
	end
	glow.Parent = if dark and owned.Lantern and root then root else nil

	-- a big wave: splash if we are on the beach
	local waveAt = workspace:GetAttribute("WaveAt") or 0
	if waveAt ~= lastWave then
		lastWave = waveAt
		if has("waves") and root and root:IsA("BasePart") then
			local splash = Instance.new("Part")
			splash.Name = "Splash"
			splash.Anchored = true
			splash.CanCollide = false
			splash.CanQuery = false
			splash.CanTouch = false
			splash.Transparency = 1
			splash.Size = Vector3.new(16, 1, 16)
			splash.Position = root.Position
			local drops = Instance.new("ParticleEmitter")
			drops.Color = ColorSequence.new(rgb(140, 210, 255))
			drops.Size = NumberSequence.new(0.6, 0.1)
			drops.Speed = NumberRange.new(14, 22)
			drops.SpreadAngle = Vector2.new(50, 50)
			drops.Acceleration = Vector3.new(0, -35, 0)
			drops.Lifetime = NumberRange.new(0.8, 1.2)
			drops.Rate = 0
			drops.EmissionDirection = Enum.NormalId.Top
			drops.Parent = splash
			splash.Parent = workspace.CurrentCamera
			drops:Emit(120)
			task.delay(2, function()
				splash:Destroy()
			end)
		end
	end
end

RunService.RenderStepped:Connect(function()
	if cloud.Parent then
		cloud.CFrame = CFrame.new(workspace.CurrentCamera.CFrame.Position + Vector3.new(0, 30, 0))
	end
end)

task.spawn(function()
	while true do
		update()
		task.wait(0.25)
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="61">
          <Properties>
            <string name="Name">Zones</string>
            <string name="Source"><![CDATA[-- The zone gates, shortcut doors and the train, on this player's screen.
--
-- * Gate barriers and shortcut doors are solid for everyone on the server.
--   Here they let you through the ones you have unlocked (OpenZones), and hide
--   the "Unlock" prompt on gates you can already walk through.
-- * The Railway Junction train and its crossing light move from the clock
--   (Biomes.trainAt), so every screen shows the same thing as the server.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("ChaiChaos")
local Config = require(Shared:WaitForChild("Config"))
local Biomes = require(Shared:WaitForChild("Biomes"))

local player = Players.LocalPlayer

local GREEN = Color3.fromRGB(80, 220, 80)
local RED = Color3.fromRGB(255, 50, 50)
local DARK = Color3.fromRGB(80, 20, 20)

local open: { [string]: boolean } = {}
local barriers: { [BasePart]: boolean } = {}

local function apply(part: BasePart)
	local passable
	if part.Name == "GateBarrier" then
		passable = open[part:GetAttribute("Zone") or ""] == true
		local prompt = part:FindFirstChild("GatePrompt")
		if prompt and prompt:IsA("ProximityPrompt") then
			prompt.Enabled = not passable
		end
	else
		passable = open[part:GetAttribute("ZoneA") or ""] == true and open[part:GetAttribute("ZoneB") or ""] == true
	end
	part.CanCollide = not passable
	part.Transparency = if passable then 0.85 else 0.45
end

local function watch(instance: Instance)
	if instance:IsA("BasePart") and (instance.Name == "GateBarrier" or instance.Name == "ShortcutDoor") then
		barriers[instance] = true
		apply(instance)
	end
end

local function refresh()
	open = Biomes.decode(player:GetAttribute("OpenZones") or "")
	for part in barriers do
		if part.Parent then
			apply(part)
		else
			barriers[part] = nil
		end
	end
end

player:GetAttributeChangedSignal("OpenZones"):Connect(refresh)
refresh()
-- with streaming, gates and doors load in as you get near them
workspace.DescendantAdded:Connect(watch)
for _, d in workspace:GetDescendants() do
	watch(d)
end

---------------------------------------------------------------------------
-- The train
---------------------------------------------------------------------------
local function findTrain(): (Model?, { BasePart })
	local map = workspace:FindFirstChild("ChaiChaosMap")
	local biomes = map and map:FindFirstChild("Biomes")
	local folder = biomes and biomes:FindFirstChild(Biomes.TRAIN.zone)
	if not folder then
		return nil, {}
	end
	local lights = {}
	for _, d in folder:GetChildren() do
		if d:IsA("BasePart") and d.Name == "CrossingLight" then
			table.insert(lights, d)
		end
	end
	local train = folder:FindFirstChild("Train")
	return if train and train:IsA("Model") then train else nil, lights
end

local train, lights = nil, {}
local lastLook = 0
RunService.RenderStepped:Connect(function()
	local t = os.clock()
	if (not train or not train.Parent) and t - lastLook > 2 then
		lastLook = t
		train, lights = findTrain()
	end
	if not train then
		return
	end
	local angle, _, light, dir =
		Biomes.trainAt(workspace:GetServerTimeNow(), Config.TRAIN_WAIT, Config.TRAIN_BLINK, Config.TRAIN_SPEED)
	local a = math.rad(angle)
	local position = Biomes.polar(angle, Biomes.TRAIN.radius) + Vector3.new(0, 0.6, 0)
	local tangent = Vector3.new(-math.sin(a), 0, math.cos(a)) * dir
	train:PivotTo(CFrame.lookAt(position, position + tangent))
	local color = if light == "green"
		then GREEN
		elseif light == "red" then RED
		elseif math.floor(t / 0.4) % 2 == 0 then RED
		else DARK
	for _, lamp in lights do
		lamp.Color = color
	end
end)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="62">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">true</bool>
    </Properties>
  </Item>
</roblox>